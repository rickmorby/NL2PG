# ==============================================================================
# NL2PG - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Unit test / coverage / linter caches
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Secrets, Tokens, and Credentials
providers.json
*.env
*.env.*
*.pem
*.key

# Temporary files and personal thesis notes
thesis/
tmp/
REVISIONE_CAP1_REPORT.md

# Generated model weights / embeddings cache
*.bin
*.pt
*.pth
*.onnx
*.safetensors

# ==============================================================================
# NL2PG Benchmark Generated Artifacts
# ==============================================================================
NL2PG/bench/logs/*
!NL2PG/bench/logs/.gitkeep
NL2PG/bench/output/benchmarks/*.json
!NL2PG/bench/output/benchmarks/.gitkeep
NL2PG/bench/output/plots/*
!NL2PG/bench/output/plots/.gitkeep
NL2PG/bench/output/curation/

# ==============================================================================
# NL2PG Solver Generated Artifacts
# ==============================================================================
NL2PG/solver/logs/*
!NL2PG/solver/logs/.gitkeep
NL2PG/solver/input/*.json
!NL2PG/solver/input/.gitkeep
NL2PG/solver/output/runs/*.json
!NL2PG/solver/output/runs/.gitkeep
NL2PG/solver/output/plots/*
!NL2PG/solver/output/plots/.gitkeep

# General logs
*.log
