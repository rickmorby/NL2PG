{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "solver": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "file": {
      "class": "logging.FileHandler",
      "mode": "w",
      "encoding": "utf-8",
      "formatter": "solver",
      "level": "DEBUG"
    },
    "console": {
      "class": "solver.adapters.outbound.logging.handlers.TqdmHandler",
      "formatter": "solver",
      "level": "ERROR"
    }
  },
  "root": {
    "handlers": ["file", "console"],
    "level": "DEBUG"
  }
}
