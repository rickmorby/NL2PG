{
  "schema_ddl": "CREATE TABLE pazienti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    eta INT CHECK (eta >= 0 AND eta <= 120),\n    sesso TEXT CHECK (sesso IN ('M', 'F', 'Altro')),\n    data_nascita DATE,\n    gruppo_sanguigno TEXT CHECK (gruppo_sanguigno IN ('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', '0+', '0-')),\n    altezza_cm NUMERIC(5,2) CHECK (altezza_cm > 0),\n    peso_kg NUMERIC(5,2) CHECK (peso_kg > 0),\n    bmi NUMERIC(4,2) GENERATED ALWAYS AS (ROUND(peso_kg / (altezza_cm * altezza_cm / 10000)::NUMERIC, 2)) STORED\n);",
