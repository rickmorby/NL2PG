  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "WITH pazienti_bmi AS (\n    SELECT \n        nome,\n        cognome,\n        eta,\n        sesso,\n        gruppo_sanguigno,\n        altezza_cm,\n        peso_kg,\n        bmi,\n        CASE \n            WHEN bmi < 18.5 THEN 'Sottopeso'\n            WHEN bmi BETWEEN 18.5 AND 24.9 THEN 'Normopeso'\n            WHEN bmi BETWEEN 25 AND 29.9 THEN 'Sovrappeso'\n            ELSE 'Obesità'\n        END AS categoria_peso\n    FROM pazienti\n    WHERE altezza_cm IS NOT NULL AND peso_kg IS NOT NULL\n)\nSELECT \n    categoria_peso,\n    COUNT(*) AS numero_pazienti,\n    ROUND(AVG(eta), 1) AS eta_media,\n    ROUND(AVG(bmi), 2) AS bmi_medio,\n    STRING_AGG(DISTINCT sesso, ', ' ORDER BY sesso) AS sessi_presenti,\n    STRING_AGG(DISTINCT gruppo_sanguigno, ', ' ORDER BY gruppo_sanguigno) AS gruppi_sanguigni_presenti\nFROM pazienti_bmi\nGROUP BY categoria_peso\nHAVING COUNT(*) > 5\nORDER BY bmi_medio;"
}