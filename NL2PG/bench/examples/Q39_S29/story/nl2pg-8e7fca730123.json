  "schema_ddl": "CREATE TABLE corsi (\n    id_corso INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_corso TEXT NOT NULL,\n    crediti INT NOT NULL CHECK (crediti BETWEEN 1 AND 30)\n);\n\nCREATE TABLE studenti (\n    id_studente INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    identificativo_nominativo_primario TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    id_corso INT REFERENCES corsi(id_corso)\n);",
