    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "dipartimenti",
        "obsolete_value": "aree_organizzative",
        "description": "La tabella padre dipartimenti viene denominata aree_organizzative nella prosa aziendale. Il solver deve mappare aree_organizzative alla tabella fisica dipartimenti per costruire correttamente l'anti-join con NOT EXISTS sulle FK nullable dei dipendenti."
      },
      {
        "twist_type": "synonym",
        "target_value": "valutazioni",
        "obsolete_value": "revisioni_periodiche_delle_prestazioni",
        "description": "La tabella valutazioni (figlia collegata ai dipendenti) viene indicata come revisioni_periodiche_delle_prestazioni. Le query di anti-join devono identificare i dipendenti privi di valutazioni tramite WHERE NOT EXISTS (SELECT 1 FROM valutazioni WHERE valutazioni.dipendente_id = dipendenti.id)."
      },
      {
        "twist_type": "jargon",
        "target_value": "dipendenti.dipartimento_id",
        "obsolete_value": "assegnazione organica",
        "description": "La colonna FK nullable dipartimento_id della tabella dipendenti viene descritta con il gergo HR 'assegnazione organica'. Essendo nullable, i dipendenti senza assegnazione organica presentano dipartimento_id IS NULL e vanno gestiti esplicitamente con IS NULL o join esterni oltre all'anti-join verso dipartimenti."
      }
    ],
    "spec_hash": "d2a119b4a9a88800"
  },
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    codice TEXT NOT NULL UNIQUE,\n    budget_annuo NUMERIC(12,2) CHECK (budget_annuo >= 0),\n    sede TEXT\n);\n\nCREATE TABLE ruoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    livello INT NOT NULL CHECK (livello BETWEEN 1 AND 10),\n    stipendio_minimo NUMERIC(10,2) CHECK (stipendio_minimo >= 0),\n    stipendio_massimo NUMERIC(10,2) CHECK (stipendio_massimo >= stipendio_minimo)\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    data_assunzione DATE NOT NULL,\n    stipendio_annuo NUMERIC(10,2) CHECK (stipendio_annuo > 0),\n    dipartimento_id INT REFERENCES dipartimenti(id),\n    ruolo_id INT REFERENCES ruoli(id),\n    manager_id INT REFERENCES dipendenti(id),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE valutazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id),\n    valutatore_id INT REFERENCES dipendenti(id),\n    data_valutazione DATE NOT NULL,\n    periodo_riferimento TEXT NOT NULL,\n    punteggio NUMERIC(4,2) CHECK (punteggio BETWEEN 0 AND 100),\n    note TEXT\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id),\n    tipo_contratto TEXT NOT NULL CHECK (tipo_contratto IN ('tempo_indeterminato', 'tempo_determinato', 'part_time', 'apprendistato')), \n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    retribuzione_mensile NUMERIC(10,2) NOT NULL CHECK (retribuzione_mensile > 0),\n    CHECK (data_fine IS NULL OR data_fine >= data_inizio)\n);",
