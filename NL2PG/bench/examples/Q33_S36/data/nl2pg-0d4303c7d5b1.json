  "schema_ddl": "CREATE TYPE specifiche_articolo AS (\n    blurb TEXT,\n    peso_grammi INT,\n    altezza_cm NUMERIC(5,2),\n    larghezza_cm NUMERIC(5,2),\n    profondita_cm NUMERIC(5,2)\n);\n\nCREATE TABLE prodotti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    prezzo NUMERIC(10,2) NOT NULL CHECK (prezzo >= 0),\n    dettagli_prodotto specifiche_articolo,\n    codice_articolo TEXT NOT NULL UNIQUE\n);",
