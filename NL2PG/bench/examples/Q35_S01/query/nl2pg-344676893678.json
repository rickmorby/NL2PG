  "feature_sql": [
    "case"
  ],
  "query": "SELECT s.data_registrazione, s.conto, CASE s.stato_pagamento WHEN 'pagato' THEN 'Movimento regolarizzato' WHEN 'sospeso' THEN 'Pagamento in attesa di verifica' ELSE 'Insoluto da sollecitare' END AS classificazione_stato, ROUND(s.importo_dare - s.importo_avere, 2) AS saldo_movimento FROM scritture_contabili s WHERE s.stato_pagamento <> 'insoluto' AND s.importo_dare >= 1000.00 ORDER BY saldo_movimento DESC, s.id_scrittura ASC;"
}