  "schema_ddl": "CREATE TABLE scritture_contabili (\n    id_scrittura INT PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    conto TEXT NOT NULL,\n    importo_dare NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    stato_pagamento TEXT NOT NULL CHECK (stato_pagamento IN ('pagato', 'sospeso', 'insoluto'))\n);",
