    "spec_hash": "288bf5263383a096"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    citta TEXT NOT NULL,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    CONSTRAINT identita_nominativa_unica UNIQUE (nome, cognome),\n    CONSTRAINT ck_nome_non_vuoto CHECK (LENGTH(TRIM(nome)) > 0),\n    CONSTRAINT ck_cognome_non_vuoto CHECK (LENGTH(TRIM(cognome)) > 0)\n);",
