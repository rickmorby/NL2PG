{
  "schema_ddl": "CREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL DEFAULT CURRENT_DATE,\n    reparto TEXT NOT NULL,\n    stipendio NUMERIC(10,2) CHECK (stipendio >= 0)\n);\n\nCREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    indirizzo TEXT,\n    telefono TEXT,\n    email TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    indirizzo TEXT,\n    email TEXT,\n    telefono TEXT,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE categorie_prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_prodotto TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    descrizione TEXT,\n    categoria_id INT NOT NULL REFERENCES categorie_prodotti(id),\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza_minima INT NOT NULL DEFAULT 0 CHECK (giacenza_minima >= 0)\n);\n\nCREATE TABLE magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_magazzino TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    capienza_max INT NOT NULL CHECK (capienza_max > 0),\n    responsabile_id INT REFERENCES dipendenti(id)\n);\n\nCREATE TABLE movimentazioni_magazzino (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    magazzino_id INT NOT NULL REFERENCES magazzini(id),\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id),\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('carico', 'scarico', 'trasferimento')),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    data_movimento TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    note TEXT\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato TEXT NOT NULL DEFAULT 'aperto' CHECK (stato IN ('aperto', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) CHECK (importo_totale >= 0)\n);",
