  "feature_sql": [
    "cross_join"
  ],
  "query": "SELECT m.indirizzo AS indirizzo_magazzino, t.tipo_movimento AS tipo_movimento, COUNT(mm.id) AS totale_movimenti, ROUND(AVG(mm.quantita), 2) AS quantita_media FROM magazzini m CROSS JOIN (VALUES ('carico'), ('scarico'), ('trasferimento')) AS t(tipo_movimento) LEFT JOIN movimentazioni_magazzino mm ON mm.magazzino_id = m.id AND mm.tipo_movimento = t.tipo_movimento WHERE m.indirizzo LIKE '%Brescia%' AND t.tipo_movimento IN ('carico', 'scarico') GROUP BY m.indirizzo, t.tipo_movimento ORDER BY totale_movimenti DESC, indirizzo_magazzino;"
}