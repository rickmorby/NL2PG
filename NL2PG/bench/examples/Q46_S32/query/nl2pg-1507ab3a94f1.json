  "feature_sql": [
    "relative_time"
  ],
  "query": "SELECT c.nome AS nome_corso, c.crediti AS crediti_formativi, COUNT(DISTINCT i.studente_id) AS numero_studenti_iscritti, MIN(i.data_iscrizione) AS data_prima_iscrizione FROM corsi c JOIN iscrizioni i ON c.id = i.corso_id WHERE i.data_iscrizione >= DATE '2025-09-30' - INTERVAL '365 days' AND c.crediti >= 6 GROUP BY c.nome, c.crediti ORDER BY numero_studenti_iscritti DESC, nome_corso ASC;"
}