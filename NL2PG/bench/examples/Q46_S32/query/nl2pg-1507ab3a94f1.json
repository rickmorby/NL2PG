{
  "schema_ddl": "CREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_corso TEXT NOT NULL UNIQUE,\n    crediti INT NOT NULL CHECK (crediti > 0),\n    data_creazione TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP WITH TIME ZONE,\n    utente_modificatore TEXT\n);\n\nCREATE TABLE iscrizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    studente_id INT NOT NULL,\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    data_iscrizione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_creazione TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP WITH TIME ZONE,\n    utente_modificatore TEXT,\n    UNIQUE (studente_id, corso_id)\n);",
