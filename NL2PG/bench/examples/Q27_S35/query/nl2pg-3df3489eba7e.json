  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT CASE WHEN GROUPING(d.nome) = 1 AND GROUPING(d.citta) = 1 THEN 'Totale generale' WHEN GROUPING(d.citta) = 1 THEN 'Totale dipartimento' ELSE 'Dettaglio dipartimento e sede' END AS livello_aggregazione, d.nome AS nome_dipartimento, d.citta AS citta_sede, COUNT(*) AS numero_esami, ROUND(AVG(e.voto), 2) AS voto_medio FROM esami e JOIN corsi c ON e.corso_id = c.id JOIN dipartimenti d ON c.dipartimento_id = d.id JOIN sessioni s ON e.sessione_id = s.id WHERE s.anno_accademico = '2024/2025' AND s.tipo_sessione IN ('prima', 'seconda') GROUP BY GROUPING SETS ((d.nome, d.citta), (d.nome), ());"
}