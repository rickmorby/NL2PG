{
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    citta TEXT\n);\n\nCREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu > 0)\n);\n\nCREATE TABLE docenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE studenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE,\n    corso_id INT REFERENCES corsi(id)\n);\n\nCREATE TABLE sessioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    anno_accademico TEXT NOT NULL,\n    tipo_sessione TEXT NOT NULL CHECK (tipo_sessione IN ('prima', 'seconda', 'terza', 'straordinaria')),\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL,\n    CHECK (data_inizio <= data_fine)\n);\n\nCREATE TABLE esami (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    studente_id INT NOT NULL REFERENCES studenti(id),\n    docente_id INT NOT NULL REFERENCES docenti(id),\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    sessione_id INT NOT NULL REFERENCES sessioni(id),\n    data_esame DATE NOT NULL,\n    voto NUMERIC(4,1) NOT NULL CHECK (voto >= 18 AND voto <= 30),\n    PRIMARY KEY (id, data_esame)\n) PARTITION BY RANGE (data_esame);\n\nCREATE TABLE esami_storico PARTITION OF esami FOR VALUES FROM ('2000-01-01') TO ('2100-01-01');\nCREATE TABLE esami_default PARTITION OF esami DEFAULT;",
