{
  "schema_ddl": "CREATE TABLE depositi (\n    id INT PRIMARY KEY,\n    codice_deposito TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    capacita_pallet INT CHECK (capacita_pallet >= 0),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE spedizioni (\n    id INT PRIMARY KEY,\n    deposito_id INT NOT NULL REFERENCES depositi(id),\n    codice_spedizione TEXT NOT NULL UNIQUE,\n    destinatario TEXT NOT NULL,\n    citta_destinazione TEXT NOT NULL,\n    peso_kg NUMERIC(8,2) CHECK (peso_kg > 0),\n    stato TEXT NOT NULL DEFAULT 'in_preparazione' CHECK (stato IN ('in_preparazione', 'in_transito', 'consegnata', 'annullata')),\n    data_partenza DATE,\n    data_consegna_prevista DATE\n);\n\nCREATE TABLE eventi_tracciamento (\n    id_spedizione INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    num_evento INT NOT NULL CHECK (num_evento > 0),\n    tipo_evento TEXT NOT NULL,\n    descrizione TEXT,\n    istante_evento TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    operatore TEXT,\n    PRIMARY KEY (id_spedizione, num_evento)\n);",
