        "obsolete_value": "registro_movimenti_liquidity",
        "description": "La tabella piatta transazioni, che contiene le operazioni finanziarie con gli attributi ridondanti incorporati category_name e supplier_name, viene denominata nel testo aziendale registro_movimenti_liquidity. L'utente deve risalire al nome reale della tabella per formulare la query disgiuntiva."
      },
      {
        "twist_type": "synonym",
        "target_value": "category_name",
        "obsolete_value": "classe_attivo",
        "description": "La colonna incorporata category_name della tabella denormalizzata viene indicata nella prosa con il sinonimo classe_attivo. La condizione OR della WHERE deve comunque riferirsi alla colonna reale category_name (es. WHERE category_name = 'obbligazioni')."
      },
      {
        "twist_type": "jargon",
        "target_value": "supplier_name",
        "obsolete_value": "controparte_emittente",
        "description": "La colonna incorporata supplier_name viene descritta nella documentazione aziendale con il gergo finanziario controparte_emittente. Il solver deve mappare questo termine tecnico alla colonna reale supplier_name per costruire il ramo alternativo della condizione OR (es. OR supplier_name = 'forn1')."
      }
    ],
    "spec_hash": "92b1f199520bb8e2"
  },
  "schema_ddl": "CREATE TABLE conti (\n    id INT PRIMARY KEY,\n    iban TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    istituto_credito TEXT NOT NULL,\n    saldo_disponibile NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_disponibile >= 0)\n);\n\nCREATE TABLE transazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti(id),\n    data_transazione DATE NOT NULL,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('versamento', 'prelievo', 'bonifico_in_entrata', 'bonifico_in_uscita', 'commissione')),\n    nome_categoria TEXT NOT NULL,\n    nome_fornitore TEXT NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale > 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR',\n    descrizione TEXT\n);",
