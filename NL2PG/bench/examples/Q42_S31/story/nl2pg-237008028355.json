{
  "schema_ddl": "CREATE TABLE conti (\n    id INT PRIMARY KEY,\n    iban TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    istituto_credito TEXT NOT NULL,\n    saldo_disponibile NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_disponibile >= 0)\n);\n\nCREATE TABLE transazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti(id),\n    data_transazione DATE NOT NULL,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('versamento', 'prelievo', 'bonifico_in_entrata', 'bonifico_in_uscita', 'commissione')),\n    nome_categoria TEXT NOT NULL,\n    nome_fornitore TEXT NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale > 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR',\n    descrizione TEXT\n);",
