  "feature_sql": [],
  "query": "SELECT v.nome AS nome_vettore, s.stato AS stato_spedizione, COUNT(*) AS numero_spedizioni, ROUND(AVG(s.peso_kg), 2) AS peso_medio_kg, ROUND(SUM(s.volume_m3), 3) AS volume_totale_m3 FROM spedizioni s JOIN vettori v ON s.vettore_id = v.id WHERE v.attivo IS TRUE AND s.data_spedizione BETWEEN '2026-01-01' AND '2026-01-31' AND s.stato IN ('in_transito', 'consegnato', 'ritardato') GROUP BY v.nome, s.stato ORDER BY numero_spedizioni DESC, nome_vettore ASC;"
}