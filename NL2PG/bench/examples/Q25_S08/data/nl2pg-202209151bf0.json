  "schema_ddl": "CREATE TABLE clienti (\n    cliente_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    telefono TEXT NOT NULL,\n    CHECK (char_length(codice_fiscale) = 16),\n    CHECK (char_length(telefono) >= 8)\n);\n\nCREATE TABLE contratti_telefonia (\n    cliente_id INT PRIMARY KEY REFERENCES clienti(cliente_id) ON DELETE CASCADE,\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_attivazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    piano_tariffario TEXT NOT NULL,\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    minuti_inclusi INT CHECK (minuti_inclusi >= 0),\n    giga_inclusi INT CHECK (giga_inclusi >= 0),\n    stato_contratto TEXT NOT NULL CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato'))\n);",
