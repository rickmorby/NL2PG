        "obsolete_value": "flussi_di_cassa",
        "description": "La tabella figlia transazioni, collegata tramite FK conto_id alla tabella padre conti, viene denominata flussi_di_cassa nella prosa aziendale. Il solver deve riconoscere che flussi_di_cassa corrisponde alla tabella transazioni su cui applicare il JOIN con l'alias derivato da FROM (VALUES ...) AS alias(c1,c2)."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo",
        "obsolete_value": "controvalore",
        "description": "La colonna importo della tabella transazioni viene indicata nella documentazione aziendale con il gergo finanziario controvalore. Il solver deve mappare il termine tecnico di settore alla colonna reale da aggregare o filtrare nella query costruita con la clausola VALUES inline."
      }
    ],
    "spec_hash": "7d888bf408e0c8c3"
  },
  "schema_ddl": "CREATE TABLE conti (\n    id INT PRIMARY KEY,\n    iban TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    valuta CHAR(3) NOT NULL DEFAULT 'EUR',\n    saldo_iniziale NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_iniziale >= 0),\n    data_apertura DATE NOT NULL\n);\n\nCREATE TABLE transazioni (\n    id BIGINT PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti(id),\n    data_valuta DATE NOT NULL,\n    importo NUMERIC(14,2) NOT NULL CHECK (importo <> 0),\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('accredito', 'addebito')),\n    causale TEXT\n);",
