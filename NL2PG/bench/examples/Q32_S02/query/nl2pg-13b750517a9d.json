  "query": "WITH soglie_vigilanza(valuta, soglia_minima) AS (SELECT * FROM (VALUES ('EUR', 50000.00), ('USD', 40000.00), ('GBP', 30000.00)) AS _values) SELECT c.denominazione, c.valuta, c.saldo_iniziale AS saldo_attuale, s.soglia_minima, ROUND(c.saldo_iniziale - s.soglia_minima, 2) AS scostamento_soglia, CASE WHEN c.saldo_iniziale >= s.soglia_minima THEN 'sopra soglia' ELSE 'sotto soglia' END AS stato_soglia FROM conti AS c JOIN soglie_vigilanza AS s ON c.valuta = s.valuta WHERE c.valuta IN ('EUR', 'USD', 'GBP') ORDER BY scostamento_soglia DESC, c.id"
}