  "feature_sql": [],
  "query": "SELECT p.nome AS nome_prodotto, COUNT(*) AS numero_ordini, SUM(o.quantita) AS quantita_venduta, SUM(o.importo_totale) AS ricavo_totale, ROUND(AVG(o.importo_totale), 2) AS scontrino_medio FROM prodotti p JOIN ordini o ON o.prodotto_id = p.id WHERE o.data_ordine BETWEEN '2025-03-01' AND '2025-04-30' GROUP BY p.nome ORDER BY ricavo_totale DESC;"
}