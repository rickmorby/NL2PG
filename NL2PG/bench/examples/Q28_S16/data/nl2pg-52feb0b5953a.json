    "twist_rules": [
      {
        "twist_type": "rephrase",
        "target_value": "valido_dal",
        "obsolete_value": "apertura della finestra tariffaria",
        "description": "Nella prosa aziendale l'istante di inizio validità del prezzo, memorizzato nella colonna valido_dal della tabella dei listini storici, viene descritto con la perifrasi 'apertura della finestra tariffaria'. Il solver deve ricondurre questa espressione indiretta alla colonna reale valido_dal per calcolare correttamente gli intervalli temporali e le sovrapposizioni tra periodi di prezzo."
      },
      {
        "twist_type": "synonym",
        "target_value": "ordini",
        "obsolete_value": "transazioni",
        "description": "Nei documenti e nelle richieste aziendali la tabella ordini è costantemente indicata con il sinonimo 'transazioni'. Il solver deve mappare il termine sinonimo presente nel testo sulla tabella fisica ordini per collegare correttamente le righe d'ordine ai prezzi storicizzati vigenti nel periodo."
      }
    ],
    "spec_hash": "d36082fcb772722c"
  },
  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    sku TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE listini_prezzi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario > 0),\n    valido_dal DATE NOT NULL,\n    valido_al DATE,\n    CHECK (valido_al IS NULL OR valido_al >= valido_dal)\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_transazione TEXT NOT NULL UNIQUE,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    data_ordine DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
