  "query": "WITH RECURSIVE albero_hub AS (SELECT h.id, h.codice_hub, h.nome_hub, h.citta, h.tipo_hub, 0 AS livello FROM hub_logistici h WHERE h.codice_hub = 'HUB-001' UNION ALL SELECT f.id, f.codice_hub, f.nome_hub, f.citta, f.tipo_hub, a.livello + 1 FROM hub_logistici f JOIN albero_hub a ON f.hub_padre_id = a.id) SELECT a.codice_hub, a.nome_hub, a.citta, a.tipo_hub, a.livello, COUNT(s.id) AS spedizioni_partite, COALESCE(ROUND(SUM(s.peso_kg), 2), 0) AS peso_totale_kg FROM albero_hub a LEFT JOIN spedizioni s ON s.hub_partenza_id = a.id GROUP BY a.codice_hub, a.nome_hub, a.citta, a.tipo_hub, a.livello ORDER BY a.livello ASC, peso_totale_kg DESC, a.codice_hub ASC;"
}