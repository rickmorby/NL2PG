  "feature_sql": [
    "overlaps"
  ],
  "query": "SELECT DISTINCT c.titolo, a.aula, LOWER(a.finestra_svolgimento)::date AS data_appello FROM corsi c JOIN appelli a ON a.corso_id = c.id JOIN iscrizioni_corsi ic ON ic.corso_id = c.id WHERE c.anno_accademico = '2023/2024' AND ic.voto >= 27 AND (LOWER(a.finestra_svolgimento)::date, UPPER(a.finestra_svolgimento)::date) OVERLAPS (LOWER(ic.periodo_validita), UPPER(ic.periodo_validita)) ORDER BY data_appello, c.titolo;"
}