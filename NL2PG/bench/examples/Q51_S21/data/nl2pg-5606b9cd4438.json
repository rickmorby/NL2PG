    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "iscrizioni_corsi",
        "obsolete_value": "fogli_di_registro",
        "description": "La tabella iscrizioni_corsi, che registra l'associazione studente-corso con un intervallo di validità modellato tramite daterange (colonna periodo_validita), viene denominata nei documenti aziendali fogli_di_registro."
      },
      {
        "twist_type": "synonym",
        "target_value": "periodo_validita",
        "obsolete_value": "arco temporale attivo",
        "description": "La colonna periodo_validita di tipo daterange, presente nelle tabelle iscrizioni_corsi e docenze, viene indicata nella prosa come 'arco temporale attivo'. Le query di sovrapposizione devono usare WHERE (inizio_a, fine_a) OVERLAPS (inizio_b, fine_b) oppure l'operatore && sui range nativi riferendosi a tale colonna."
      },
      {
        "twist_type": "jargon",
        "target_value": "appelli",
        "obsolete_value": "sedute d'esame",
        "description": "La tabella appelli, che contiene le sessioni d'esame con slot temporali modellati tramite tsrange (colonna finestra_svolgimento), viene indicata nel gergo accademico dei documenti come 'sedute d'esame'. Le richieste di individuazione di conflitti o coincidenze temporali tra sedute e prenotazioni delle aule richiedono il confronto OVERLAPS tra gli intervalli."
      }
    ],
    "spec_hash": "96a9e488a7be7956"
  },
  "schema_ddl": "CREATE TABLE studenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT NOT NULL UNIQUE,\n    data_immatricolazione DATE NOT NULL\n);\n\nCREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_corso TEXT NOT NULL UNIQUE,\n    titolo TEXT NOT NULL,\n    crediti_formativi INT NOT NULL CHECK (crediti_formativi BETWEEN 1 AND 30),\n    anno_accademico TEXT NOT NULL\n);\n\nCREATE TABLE docenze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    docente TEXT NOT NULL,\n    ruolo_docenza TEXT NOT NULL DEFAULT 'titolare',\n    periodo_validita daterange NOT NULL,\n    CHECK (NOT isempty(periodo_validita)),\n    CHECK (upper(periodo_validita) > lower(periodo_validita))\n);\n\nCREATE TABLE iscrizioni_corsi (\n    studente_id INT NOT NULL REFERENCES studenti(id),\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    periodo_validita daterange NOT NULL,\n    voto INT CHECK (voto IS NULL OR voto BETWEEN 18 AND 30),\n    PRIMARY KEY (studente_id, corso_id),\n    CHECK (NOT isempty(periodo_validita))\n);\n\nCREATE TABLE appelli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    aula TEXT NOT NULL,\n    finestra_svolgimento tsrange NOT NULL,\n    CHECK (NOT isempty(finestra_svolgimento)),\n    CHECK (upper(finestra_svolgimento) > lower(finestra_svolgimento))\n);",
