  "schema_ddl": "CREATE TABLE sped (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cod_sped TEXT NOT NULL UNIQUE,\n    dest TEXT NOT NULL,\n    peso_kg NUMERIC(10,3) NOT NULL CHECK (peso_kg > 0),\n    vol_m3 NUMERIC(10,3) CHECK (vol_m3 >= 0),\n    stat TEXT NOT NULL,\n    data_sped TIMESTAMP NOT NULL,\n    data_cons TIMESTAMP,\n    vett_id INT,\n    costo NUMERIC(10,2) GENERATED ALWAYS AS (peso_kg * 1.5 + vol_m3 * 0.8) STORED CHECK (costo >= 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE INDEX idx_sped_stat ON sped(stat);\nCREATE INDEX idx_sped_data ON sped(data_sped);",
