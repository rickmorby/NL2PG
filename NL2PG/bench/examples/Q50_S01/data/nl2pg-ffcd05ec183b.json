        "target_value": "pazienti",
        "obsolete_value": "schede_cliniche",
        "description": "La tabella pazienti viene denominata schede_cliniche nella prosa aziendale. Le query devono quindi risolvere il riferimento schede_cliniche verso la tabella fisica pazienti, unica entità autonoma dello schema con PK id_paziente e nessuna relazione."
      },
      {
        "twist_type": "synonym",
        "target_value": "ricoverato",
        "obsolete_value": "ospedalizzato",
        "description": "La colonna booleana ricoverato viene indicata nella prosa aziendale con il sinonimo ospedalizzato. Le query di filtraggio con WHERE ricoverato IS TRUE, NOT ricoverato oppure ricoverato devono interpretare il termine ospedalizzato come riferimento alla colonna booleana ricoverato."
      }
    ],
    "spec_hash": "56b3da1403946814"
  },
  "schema_ddl": "CREATE TABLE pazienti (\n    id_paziente BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    ricoverato BOOLEAN NOT NULL DEFAULT FALSE,\n    reparto TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_nascita >= DATE '1900-01-01'),\n    CHECK (reparto IS NULL OR TRIM(reparto) <> '')\n);",
