  "feature_sql": [
    "boolean_predicate"
  ],
  "query": "SELECT INITCAP(p.nome) AS nome, INITCAP(p.cognome) AS cognome, p.reparto, DATE_PART('year', AGE(DATE '2026-08-20', p.data_nascita))::INT AS eta_anni, CASE WHEN p.data_nascita <= DATE '2026-08-20' - INTERVAL '65 years' THEN 'Over 65' ELSE 'Under 65' END AS fascia_eta FROM pazienti p WHERE p.ricoverato IS TRUE AND p.reparto IN ('Cardiologia', 'Neurologia', 'Ortopedia') ORDER BY p.reparto, p.cognome, p.nome, p.id_paziente ASC;"
}