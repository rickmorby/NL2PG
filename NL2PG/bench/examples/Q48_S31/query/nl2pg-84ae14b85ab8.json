{
  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_prodotto TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria_prodotto TEXT NOT NULL,\n    fornitore TEXT NOT NULL,\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE movimenti_vendita (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    data_vendita DATE NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    categoria_prodotto TEXT NOT NULL,\n    fornitore TEXT NOT NULL,\n    totale_riga NUMERIC(12,2) NOT NULL CHECK (totale_riga >= 0)\n);",
