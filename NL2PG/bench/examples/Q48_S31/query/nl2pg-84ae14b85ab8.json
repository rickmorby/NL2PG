  "query": "SELECT DISTINCT mv.fornitore, mv.categoria_prodotto AS categoria_venduta FROM movimenti_vendita mv WHERE mv.categoria_prodotto IN ('Elettronica', 'Informatica') AND mv.data_vendita BETWEEN DATE '2025-12-01' AND DATE '2026-01-31' ORDER BY mv.fornitore ASC, mv.categoria_prodotto ASC;"
}