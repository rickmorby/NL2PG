{
  "schema_ddl": "CREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    provvigione NUMERIC(4,2) CHECK (provvigione >= 0 AND provvigione <= 100)\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    agente_id INT REFERENCES agenti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);",
