{
  "schema_ddl": "CREATE TABLE clienti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, codice_fiscale TEXT NOT NULL UNIQUE);\n\nCREATE TABLE polizze (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, cliente_id INT NOT NULL REFERENCES clienti(id), carico_tariffario_ricorrente NUMERIC(12,2) NOT NULL CHECK (carico_tariffario_ricorrente >= 0), data_inizio DATE NOT NULL);\n\nCREATE TABLE eventi_avversi (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT NOT NULL REFERENCES polizze(id), data_sinistro DATE NOT NULL, importo_liquidato NUMERIC(12,2) DEFAULT 0 CHECK (importo_liquidato >= 0));\n\nCREATE TABLE periti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_perito TEXT NOT NULL, specializzazione TEXT NOT NULL, evento_id INT REFERENCES eventi_avversi(id));",
