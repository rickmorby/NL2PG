  "schema_ddl": "CREATE TABLE aziende (\n    id SERIAL PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta_sede TEXT NOT NULL\n);\n\nCREATE TABLE dipartimenti (\n    id SERIAL PRIMARY KEY,\n    azienda_id INT NOT NULL REFERENCES aziende(id) ON DELETE CASCADE,\n    nome TEXT NOT NULL,\n    budget_annuo NUMERIC(12,2) NOT NULL CHECK (budget_annuo >= 0),\n    UNIQUE (azienda_id, nome)\n);\n\nCREATE TABLE dipendenti (\n    id SERIAL PRIMARY KEY,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_assunzione DATE NOT NULL,\n    stipendio_mensile NUMERIC(10,2) NOT NULL CHECK (stipendio_mensile > 0)\n);\n\nCREATE TABLE valutazioni (\n    id SERIAL PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id) ON DELETE CASCADE,\n    data_valutazione DATE NOT NULL,\n    punteggio NUMERIC(5,2) NOT NULL CHECK (punteggio BETWEEN 0 AND 100),\n    commento TEXT\n);",
