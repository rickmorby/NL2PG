        "twist_type": "jargon",
        "target_value": "linea_telefonica",
        "obsolete_value": "circuito_di_accesso",
        "description": "La tabella che rappresenta le linee telefoniche viene indicata come 'circuito_di_accesso' nei report tecnici, un termine gergale interno che non corrisponde al nome reale della tabella."
      }
