  "feature_sql": [],
  "query": "SELECT CONCAT(u.nome_utente, ' ', u.cognome_utente) AS nominativo_utente, COUNT(*) AS linee_attive FROM utenze_attive u JOIN linea_telefonica l ON u.id = l.utenza_id WHERE l.is_attiva IS TRUE AND l.data_attivazione >= '2022-01-01' GROUP BY u.nome_utente, u.cognome_utente ORDER BY linee_attive DESC, nominativo_utente;"
}