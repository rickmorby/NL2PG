{
  "schema_ddl": "CREATE TABLE utenze_attive (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_utente TEXT NOT NULL,\n    cognome_utente TEXT NOT NULL,\n    codice_fiscale TEXT UNIQUE CHECK (codice_fiscale ~ '^[A-Z]{6}\\d{2}[A-Z]\\d{2}[A-Z]\\d{3}[A-Z]$'),\n    email TEXT CHECK (email ~ '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+[.][A-Za-z]+$'),\n    data_attivazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE linea_telefonica (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    utenza_id INT REFERENCES utenze_attive(id) ON DELETE SET NULL,\n    numero_telefono TEXT NOT NULL UNIQUE CHECK (numero_telefono ~ '^\\+?[0-9]{6,15}$'),\n    tipo_linea TEXT NOT NULL CHECK (tipo_linea IN ('mobile', 'fisso', 'voip')),\n    data_attivazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_disattivazione DATE CHECK (data_disattivazione IS NULL OR data_disattivazione >= data_attivazione),\n    is_attiva BOOLEAN NOT NULL DEFAULT TRUE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
