  "feature_sql": [
    "values"
  ],
  "query": "WITH fasce_peso(fascia, limite_inferiore, limite_superiore) AS (\n    VALUES ('Leggero fino a 10 kg', 0.00::numeric(8,2), 10.00::numeric(8,2)),\n           ('Medio da 10 a 50 kg', 10.01::numeric(8,2), 50.00::numeric(8,2)),\n           ('Pesante oltre 50 kg', 50.01::numeric(8,2), 200.00::numeric(8,2))\n)\nSELECT fp.fascia,\n       COUNT(cl.id) AS numero_colli,\n       ROUND(AVG(cl.peso_kg), 2) AS peso_medio_kg,\n       ROUND(MAX(cl.peso_kg), 2) AS peso_massimo_kg\nFROM fasce_peso fp\nJOIN colli cl\n  ON cl.peso_kg BETWEEN fp.limite_inferiore AND fp.limite_superiore\nWHERE cl.descrizione_contenuto IN ('Componenti elettronici', 'Attrezzatura sportiva')\nGROUP BY fp.fascia\nORDER BY peso_medio_kg DESC;"
}