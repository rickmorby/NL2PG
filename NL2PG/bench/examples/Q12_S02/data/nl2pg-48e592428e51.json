        "target_value": "pagamenti",
        "obsolete_value": "incassi registrati",
        "description": "La tabella pagamenti è descritta nella prosa aziendale come 'incassi registrati'. Si tratta di un sinonimo contabile: ogni menzione degli incassi registrati va mappata sulla tabella pagamenti."
      }
    ],
    "spec_hash": "d3b783aa0225ae1f"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    codice_fiscale TEXT UNIQUE,\n    indirizzo_sede TEXT NOT NULL,\n    citta_sede TEXT NOT NULL,\n    cap_sede TEXT NOT NULL,\n    email_contatto TEXT UNIQUE\n);\n\nCREATE TABLE fatture (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_documento TEXT NOT NULL UNIQUE,\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva BETWEEN 0 AND 100),\n    stato_fattura TEXT NOT NULL DEFAULT 'emessa' CHECK (stato_fattura IN ('emessa', 'inviata', 'pagata', 'annullata')),\n    note TEXT,\n    CHECK (data_scadenza >= data_emissione)\n);\n\nCREATE TABLE righe_fattura (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id),\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    descrizione_prestazione TEXT NOT NULL,\n    quantita NUMERIC(10,3) NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(12,4) NOT NULL CHECK (prezzo_unitario >= 0),\n    totale_imponibile NUMERIC(14,2) NOT NULL CHECK (totale_imponibile >= 0),\n    UNIQUE (fattura_id, numero_riga)\n);\n\nCREATE TABLE pagamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id),\n    data_pagamento DATE NOT NULL,\n    importo_pagamento NUMERIC(14,2) NOT NULL CHECK (importo_pagamento > 0),\n    modalita_pagamento TEXT NOT NULL CHECK (modalita_pagamento IN ('bonifico_bancario', 'contanti', 'assegno', 'carta_credito', 'riba')),\n    riferimento_transazione TEXT UNIQUE\n);",
