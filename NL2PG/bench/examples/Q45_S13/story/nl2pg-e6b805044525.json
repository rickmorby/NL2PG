{
  "schema_ddl": "CREATE TABLE filiali (\n    id INT PRIMARY KEY,\n    filiale TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE ordini (\n    id_ordine INT PRIMARY KEY,\n    filiale_id INT NOT NULL REFERENCES filiali(id),\n    nome_filiale TEXT NOT NULL,\n    cliente TEXT NOT NULL,\n    data_ordine DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    regione_spedizione TEXT NOT NULL\n);\n\nCREATE TABLE righe_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    prodotto TEXT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
