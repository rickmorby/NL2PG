  "feature_sql": [],
  "query": "SELECT o.cliente, f.filiale, o.data_ordine, o.importo_totale, CASE WHEN o.importo_totale >= 3000 THEN 'Ordine Alto' WHEN o.importo_totale >= 1500 THEN 'Ordine Medio' ELSE 'Ordine Base' END AS classe_ordine, RANK() OVER (ORDER BY o.importo_totale DESC) AS posizione_fatturato FROM ordini o JOIN filiali f ON f.id = o.filiale_id WHERE o.regione_spedizione = 'Nord' AND o.data_ordine >= DATE '2026-01-01' ORDER BY o.importo_totale DESC, o.id_ordine ASC LIMIT 10;"
}