        "obsolete_value": "registrazione_transazioni",
        "description": "La tabella ordini viene denominata registrazione_transazioni nella prosa aziendale; il solutore deve mappare la perifrasi alla tabella reale prima di formulare la query."
      },
      {
        "twist_type": "polysemy",
        "target_value": "importo_totale",
        "obsolete_value": "valore",
        "description": "Il termine generico 'valore' indica talvolta la colonna importo_totale dell'ordine e talvolta il campo prezzo_unitario delle righe d'ordine; la dipendenza funzionale id_ordine -> importo_totale consente di dedurre quale colonna aggregare (SUM) e quale significato attribuire al termine nel contesto della domanda sotto-specificata."
      },
      {
        "twist_type": "ambiguity",
        "target_value": "filiale",
        "obsolete_value": "sede del Nord",
        "description": "L'espressione 'sede del Nord' non precisa se filtrare la colonna filiale con valore 'Nord' oppure la colonna regione_spedizione; il filtro corretto va dedotto dalla dipendenza funzionale id_filiale -> filiale presente nello schema ridondante prima dell'esecuzione."
      }
    ],
    "spec_hash": "247580e446bb2a15"
  },
  "schema_ddl": "CREATE TABLE filiali (\n    id INT PRIMARY KEY,\n    filiale TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE ordini (\n    id_ordine INT PRIMARY KEY,\n    filiale_id INT NOT NULL REFERENCES filiali(id),\n    nome_filiale TEXT NOT NULL,\n    cliente TEXT NOT NULL,\n    data_ordine DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    regione_spedizione TEXT NOT NULL\n);\n\nCREATE TABLE righe_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    prodotto TEXT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
