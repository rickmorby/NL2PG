{
  "schema_ddl": "CREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_completo TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL,\n    stipendio NUMERIC(10,2) CHECK (stipendio >= 0)\n);\n\nCREATE TABLE forza_lavoro (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id),\n    superior_node INT REFERENCES forza_lavoro(id),\n    ruolo_aziendale TEXT NOT NULL,\n    livello_gerarchico INT CHECK (livello_gerarchico >= 1)\n);",
