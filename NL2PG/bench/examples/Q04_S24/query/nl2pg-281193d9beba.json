{
  "schema_ddl": "CREATE TABLE corrieri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_identificativo TEXT UNIQUE NOT NULL,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE veicoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    corriere_id INT NOT NULL REFERENCES corrieri(id) ON DELETE CASCADE,\n    targa TEXT NOT NULL UNIQUE,\n    modello TEXT NOT NULL,\n    capacita_kg NUMERIC(10,2) CHECK (capacita_kg > 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TYPE stato_spedizione AS ENUM ('in_preparazione', 'in_transito', 'consegnato', 'annullato');\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    corriere_id INT NOT NULL REFERENCES corrieri(id) ON DELETE RESTRICT,\n    veicolo_id INT REFERENCES veicoli(id) ON DELETE SET NULL,\n    codice_spedizione TEXT NOT NULL UNIQUE,\n    stato_consegna stato_spedizione NOT NULL DEFAULT 'in_preparazione',\n    peso_kg NUMERIC(10,2) CHECK (peso_kg > 0),\n    volume_m3 NUMERIC(10,2) CHECK (volume_m3 > 0),\n    data_creazione TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    data_consegna_prevista DATE,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE destinatari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT NOT NULL,\n    provincia TEXT NOT NULL,\n    telefono TEXT,\n    email TEXT,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE dettagli_spedizione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    destinatario_id INT NOT NULL REFERENCES destinatari(id) ON DELETE RESTRICT,\n    data_consegna_effettiva DATE,\n    firma_richiesta BOOLEAN DEFAULT FALSE,\n    note TEXT,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
