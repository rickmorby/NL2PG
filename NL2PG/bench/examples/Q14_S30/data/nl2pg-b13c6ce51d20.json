  "schema_ddl": "CREATE TABLE clienti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, codice_fiscale TEXT UNIQUE NOT NULL);\n\nCREATE TABLE polizze (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, cliente_id INT REFERENCES clienti(id), premio NUMERIC(12,2) CHECK (premio >= 0), data_inizio DATE NOT NULL, data_fine DATE NOT NULL, CHECK (data_fine > data_inizio));\n\nCREATE TABLE tipologie_polizza (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, descrizione TEXT NOT NULL);\n\nCREATE TABLE polizze_dettaglio (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT REFERENCES polizze(id), tipologia_id INT REFERENCES tipologie_polizza(id));\n\nCREATE TABLE sinistri (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT REFERENCES polizze(id), data_sinistro TIMESTAMP NOT NULL, importo_liquidato NUMERIC(12,2) DEFAULT 0);\n\nCREATE TABLE sinistri_archivio (id INT PRIMARY KEY, polizza_id INT, data_sinistro TIMESTAMP, importo_liquidato NUMERIC(12,2));\n\nCREATE TABLE agenti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_agente TEXT NOT NULL);\n\nCREATE TABLE mandati (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, agente_id INT REFERENCES agenti(id), polizza_id INT REFERENCES polizze(id));\n\nCREATE TABLE pagamenti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT REFERENCES polizze(id), importo NUMERIC(12,2) NOT NULL, data_pagamento DATE DEFAULT CURRENT_DATE);\n\nCREATE TABLE rimborsi (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, sinistro_id INT REFERENCES sinistri(id), importo_rimborsato NUMERIC(12,2) NOT NULL, data_rimborso DATE DEFAULT CURRENT_DATE);",
