{
  "schema_ddl": "CREATE TABLE dimensioni_clienti (\n    cliente_key INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_cliente TEXT NOT NULL UNIQUE,\n    nome_cliente TEXT NOT NULL,\n    segmento_cliente TEXT NOT NULL CHECK (segmento_cliente IN ('consumer', 'business', 'enterprise')),\n    paese TEXT NOT NULL,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE dimensioni_prodotti (\n    prodotto_key INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sku TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_listino NUMERIC(12,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE dimensioni_tempo (\n    data_ordine DATE PRIMARY KEY,\n    anno INT NOT NULL CHECK (anno BETWEEN 1900 AND 2100),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    giorno INT NOT NULL CHECK (giorno BETWEEN 1 AND 31),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    giorno_settimana TEXT NOT NULL CHECK (giorno_settimana IN ('Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab', 'Dom'))\n);\n\nCREATE TABLE fatti_ordini (\n    ordine_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_key INT NOT NULL REFERENCES dimensioni_clienti(cliente_key) ON DELETE RESTRICT ON UPDATE CASCADE,\n    prodotto_key INT NOT NULL REFERENCES dimensioni_prodotti(prodotto_key) ON DELETE RESTRICT ON UPDATE CASCADE,\n    data_ordine DATE NOT NULL REFERENCES dimensioni_tempo(data_ordine) ON DELETE RESTRICT ON UPDATE CASCADE,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(12,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    importo_netto NUMERIC(14,2) NOT NULL CHECK (importo_netto >= 0)\n);",
