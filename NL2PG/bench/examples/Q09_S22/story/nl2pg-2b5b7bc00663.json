{
  "schema_ddl": "CREATE TABLE dim_tempo (id_tempo INT PRIMARY KEY, data DATE NOT NULL, anno INT NOT NULL, mese INT NOT NULL, trimestre INT NOT NULL);\n\nCREATE TABLE dim_prodotti (id_prodotto INT PRIMARY KEY, codice_prodotto TEXT NOT NULL, categoria TEXT NOT NULL, costo_standard NUMERIC(12,2) CHECK (costo_standard >= 0));\n\nCREATE TABLE dim_clienti (id_cliente INT PRIMARY KEY, nome_azienda TEXT NOT NULL, regione TEXT NOT NULL, segmento_mercato TEXT NOT NULL);\n\nCREATE TABLE dim_stabilimenti (id_stabilimento INT PRIMARY KEY, nome_stabilimento TEXT NOT NULL, citta TEXT NOT NULL, capacità_produttiva INT CHECK (capacità_produttiva > 0));\n\nCREATE TABLE dim_risorse (id_risorsa INT PRIMARY KEY, nome_risorsa TEXT NOT NULL, tipo_risorsa TEXT NOT NULL);\n\nCREATE TABLE dim_fornitori (id_fornitore INT PRIMARY KEY, nome_fornitore TEXT NOT NULL, rating_qualita INT CHECK (rating_qualita BETWEEN 1 AND 5));\n\nCREATE TABLE dim_canali_vendita (id_canale INT PRIMARY KEY, nome_canale TEXT NOT NULL, tipologia_canale TEXT NOT NULL);\n\nCREATE TABLE dim_stato_lavorazione (id_stato INT PRIMARY KEY, bucket_di_completamento TEXT NOT NULL);\n\nCREATE TABLE fatti_ordini_produzione (id_fatto BIGINT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, id_tempo INT NOT NULL REFERENCES dim_tempo(id_tempo), id_prodotto INT NOT NULL REFERENCES dim_prodotti(id_prodotto), id_cliente INT NOT NULL REFERENCES dim_clienti(id_cliente), id_stabilimento INT NOT NULL REFERENCES dim_stabilimenti(id_stabilimento), id_risorsa INT NOT NULL REFERENCES dim_risorse(id_risorsa), id_fornitore INT NOT NULL REFERENCES dim_fornitori(id_fornitore), id_canale INT NOT NULL REFERENCES dim_canali_vendita(id_canale), id_stato INT NOT NULL REFERENCES dim_stato_lavorazione(id_stato), quantita_prodotta INT NOT NULL CHECK (quantita_prodotta >= 0), costo_totale NUMERIC(15,2) NOT NULL CHECK (costo_totale >= 0));",
