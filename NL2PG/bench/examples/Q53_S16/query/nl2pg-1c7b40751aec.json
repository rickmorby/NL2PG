{
  "schema_ddl": "CREATE TYPE stato_movimento AS ENUM ('bozza', 'confermato', 'annullato', 'archiviato');\n\nCREATE TABLE conti (\n    id SERIAL PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    tipo_conto TEXT NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'patrimoniale')),\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);\n\nCREATE TABLE registrazioni (\n    id SERIAL PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti(id),\n    importo NUMERIC(15, 2) NOT NULL,\n    segno CHAR(1) NOT NULL CHECK (segno IN ('D', 'A')),\n    descrizione TEXT,\n    stato stato_movimento NOT NULL DEFAULT 'bozza',\n    data_validita TIMESTAMP NOT NULL,\n    valid_from TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    valid_to TIMESTAMP,\n    CHECK (valid_to IS NULL OR valid_to > valid_from),\n    CHECK (importo > 0)\n);\n\nCREATE TABLE causali (\n    id SERIAL PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    tipo TEXT NOT NULL CHECK (tipo IN ('ricavo', 'costo', 'patrimoniale')),\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);\n\nCREATE TABLE documenti (\n    id SERIAL PRIMARY KEY,\n    numero TEXT NOT NULL,\n    tipo TEXT NOT NULL CHECK (tipo IN ('fattura', 'nota_credito', 'nota_debito', 'ricevuta')),\n    data_emissione DATE NOT NULL,\n    fornitore_cliente TEXT NOT NULL,\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);\n\nCREATE TABLE collegamenti (\n    id SERIAL PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni(id),\n    causale_id INT NOT NULL REFERENCES causali(id),\n    documento_id INT REFERENCES documenti(id),\n    note TEXT,\n    valid_from TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    valid_to TIMESTAMP,\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);",
