  "feature_sql": [
    "ordered_set_agg"
  ],
  "query": "SELECT c.nome AS nome_conto, PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY r.importo) AS mediana_importi FROM conti c JOIN registrazioni r ON c.id = r.conto_id WHERE c.tipo_conto IN ('attivo', 'passivo') AND r.stato = 'confermato' GROUP BY c.nome;"
}