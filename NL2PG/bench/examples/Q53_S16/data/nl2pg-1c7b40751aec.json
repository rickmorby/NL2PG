      {
        "twist_type": "jargon",
        "target_value": "data_validita",
        "obsolete_value": "timestamp_operativo",
        "description": "Il campo data_validita viene riferito come timestamp_operativo nei documenti tecnici."
      },
      {
        "twist_type": "polysemy",
        "target_value": "importo",
        "obsolete_value": "valore",
