  "schema_ddl": "CREATE TABLE esami (\n    id INT PRIMARY KEY,\n    matricola_studente TEXT NOT NULL,\n    cognome_studente TEXT NOT NULL,\n    nome_studente TEXT NOT NULL,\n    denominazione_corso TEXT NOT NULL,\n    docente_presidente TEXT NOT NULL,\n    data_appello DATE NOT NULL,\n    voto TEXT NOT NULL CHECK (voto ~ '^(1[8-9]|2[0-9]|30)L?$'),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
