  "feature_sql": [
    "string_funcs"
  ],
  "query": "SELECT INITCAP(cognome_studente) AS cognome, INITCAP(nome_studente) AS nome, COUNT(*) AS numero_esami_superati, ROUND(AVG(REPLACE(voto, 'L', '')::numeric), 2) AS media_voti, MAX(voto) AS miglior_voto FROM esami WHERE denominazione_corso IN ('Anatomia Umana', 'Chimica Organica') GROUP BY matricola_studente, cognome_studente, nome_studente ORDER BY media_voti DESC, numero_esami_superati DESC;"
}