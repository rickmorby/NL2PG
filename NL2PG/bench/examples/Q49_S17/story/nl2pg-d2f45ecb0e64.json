{
  "schema_ddl": "CREATE TYPE stato_polizza AS ENUM ('attiva', 'sospesa', 'annullata', 'scaduta');\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL,\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    stato stato_polizza NOT NULL DEFAULT 'attiva',\n    premio_annuale NUMERIC(10,2) NOT NULL CHECK (premio_annuale > 0),\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    email TEXT,\n    telefono TEXT,\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE veicoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    targa TEXT NOT NULL UNIQUE,\n    marca TEXT NOT NULL,\n    modello TEXT NOT NULL,\n    anno_immatricolazione INT NOT NULL CHECK (anno_immatricolazione BETWEEN 1900 AND EXTRACT(YEAR FROM CURRENT_DATE)),\n    polizza_id INT REFERENCES polizze(id),\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE sinistri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_sinistro TEXT NOT NULL UNIQUE,\n    polizza_id INT NOT NULL REFERENCES polizze(id),\n    data_denuncia TIMESTAMP NOT NULL,\n    descrizione TEXT,\n    importo_richiesto NUMERIC(12,2) CHECK (importo_richiesto >= 0),\n    importo_liquidato NUMERIC(12,2) CHECK (importo_liquidato >= 0),\n    stato TEXT NOT NULL CHECK (stato IN ('aperto', 'in_liquidazione', 'chiuso', 'respinto')),\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE liquidazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sinistro_id INT NOT NULL REFERENCES sinistri(id),\n    data_liquidazione TIMESTAMP NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    note TEXT,\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Vincoli di integrità aggiuntivi\nALTER TABLE polizze ADD CONSTRAINT fk_polizze_clienti FOREIGN KEY (cliente_id) REFERENCES clienti(id);\n\nALTER TABLE sinistri ADD CONSTRAINT chk_sinistro_dates CHECK (data_denuncia <= CURRENT_TIMESTAMP);\n\nALTER TABLE liquidazioni ADD CONSTRAINT chk_liquidazione_dates CHECK (data_liquidazione <= CURRENT_TIMESTAMP);",
