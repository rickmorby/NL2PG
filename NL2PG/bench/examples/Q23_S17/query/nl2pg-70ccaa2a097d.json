  "feature_sql": [
    "filtered_agg"
  ],
  "query": "SELECT p.nome AS nome_prodotto, COUNT(*) AS numero_righe_ordine, SUM(ro.quantita) AS quantita_totale_venduta, ROUND(SUM(ro.quantita * ro.prezzo_unitario), 2) AS fatturato_totale, ROUND(SUM(ro.quantita * ro.prezzo_unitario) FILTER (WHERE o.stato_ordine = 'consegnato'), 2) AS fatturato_da_ordini_consegnati, COUNT(*) FILTER (WHERE o.stato_ordine = 'consegnato') AS righe_da_ordini_consegnati FROM prodotti p JOIN righe_ordine ro ON ro.prodotto_id = p.id JOIN ordini o ON o.id = ro.ordine_id WHERE o.stato_ordine <> 'annullato' GROUP BY p.nome ORDER BY fatturato_totale DESC LIMIT 5;"
}