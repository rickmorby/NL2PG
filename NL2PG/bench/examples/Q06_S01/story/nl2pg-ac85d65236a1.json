  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_sku TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_unitario NUMERIC(12,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza INT NOT NULL DEFAULT 0 CHECK (giacenza >= 0),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    data_inserimento DATE NOT NULL DEFAULT CURRENT_DATE\n);",
