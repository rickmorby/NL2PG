        "twist_type": "rename",
        "target_value": "categoria_immobile",
        "obsolete_value": "tipologia_di_bene",
        "description": "La colonna categoria_immobile della tabella denormalizzata immobili viene denominata tipologia_di_bene nella prosa aziendale. La query deve raggruppare per categoria_immobile anche se il testo parla di tipologia_di_bene."
      },
      {
        "twist_type": "jargon",
        "target_value": "fornitore_manutenzione",
        "obsolete_value": "impresa appaltatrice dei lavori",
        "description": "La colonna fornitore_manutenzione della tabella immobili viene indicata nella documentazione aziendale con il gergo 'impresa appaltatrice dei lavori'. Il conteggio DISTINCT deve essere applicato su fornitore_manutenzione riconoscendo la corrispondenza semantica."
      }
    ],
    "spec_hash": "8da90e4d067ff5e0"
  },
  "schema_ddl": "CREATE TABLE gestori_immobili (\n    id INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    citta_sede TEXT NOT NULL\n);\n\nCREATE TABLE immobili (\n    id INT PRIMARY KEY,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    categoria_immobile TEXT NOT NULL,\n    superficie_mq NUMERIC(8,2) CHECK (superficie_mq > 0),\n    valore_stimato NUMERIC(12,2) CHECK (valore_stimato >= 0),\n    fornitore_manutenzione TEXT,\n    gestore_id INT REFERENCES gestori_immobili(id),\n    n_interventi_manutenzione INT NOT NULL DEFAULT 0 CHECK (n_interventi_manutenzione >= 0)\n);",
