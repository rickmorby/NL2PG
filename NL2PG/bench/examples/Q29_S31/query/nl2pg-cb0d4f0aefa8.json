  ],
  "query": "SELECT i.categoria_immobile, COUNT(DISTINCT i.fornitore_manutenzione) AS fornitori_distinti, COUNT(*) AS totale_immobili FROM immobili i WHERE i.citta IN ('Milano', 'Roma') AND i.valore_stimato IS NOT NULL GROUP BY i.categoria_immobile ORDER BY fornitori_distinti DESC;"
}