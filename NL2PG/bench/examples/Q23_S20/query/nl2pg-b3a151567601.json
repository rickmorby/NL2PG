  "feature_sql": [
    "filtered_agg"
  ],
  "query": "SELECT lp.nome_linea, COUNT(*) AS totale_ordini_attivi, COUNT(*) FILTER (WHERE op.priorita = 'urgente') AS ordini_urgenti, COUNT(*) FILTER (WHERE op.stato_ordine = 'completato') AS ordini_completati, ROUND(AVG(op.quantita_richiesta), 2) AS quantita_media_richiesta FROM linee_produzione lp JOIN ordini_produzione op ON lp.id = op.linea_id WHERE op.stato_ordine <> 'annullato' GROUP BY lp.id, lp.nome_linea ORDER BY ordini_urgenti DESC, lp.id ASC;"
}