{
  "schema_ddl": "CREATE TYPE stato_ordine AS ENUM ('pianificato', 'in_corso', 'sospeso', 'completato', 'annullato');\n\nCREATE TYPE priorita_ordine AS ENUM ('bassa', 'normale', 'urgente');\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE articoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    unita_misura TEXT NOT NULL\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    matricola TEXT NOT NULL UNIQUE,\n    reparto TEXT NOT NULL\n);\n\nCREATE TABLE linee_produzione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_linea TEXT NOT NULL UNIQUE,\n    nome_linea TEXT NOT NULL,\n    capacita_giornaliera INT NOT NULL CHECK (capacita_giornaliera > 0)\n);\n\nCREATE TABLE ordini_produzione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    articolo_id INT NOT NULL REFERENCES articoli(id),\n    responsabile_id INT REFERENCES dipendenti(id),\n    linea_id INT REFERENCES linee_produzione(id),\n    stato_ordine stato_ordine NOT NULL DEFAULT 'pianificato',\n    priorita priorita_ordine NOT NULL DEFAULT 'normale',\n    quantita_richiesta INT NOT NULL CHECK (quantita_richiesta > 0),\n    data_avvio DATE,\n    data_consegna DATE,\n    CHECK (data_consegna IS NULL OR data_avvio IS NULL OR data_consegna >= data_avvio)\n);",
