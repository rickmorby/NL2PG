    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "visite_ambulatoriali",
        "obsolete_value": "registro_attivita_clinica",
        "description": "La tabella partizionata per RANGE sulla colonna data_visita, nominalmente visite_ambulatoriali, viene indicata nella prosa aziendale come registro_attivita_clinica. Le query devono risolvere il nome reale della tabella per applicare correttamente il filtro temporale relativo CURRENT_DATE - INTERVAL 'n days' e sfruttare il pruning delle partizioni."
      },
      {
        "twist_type": "jargon",
        "target_value": "reparti",
        "obsolete_value": "unita_operative_nosologiche",
        "description": "La tabella reparti viene descritta nella documentazione aziendale con il gergo sanitario 'unità operative nosologiche' (U.O.). Il lettore deve riconoscere che il termine tecnico del dominio clinico corrisponde alla tabella reparti per poter effettuare i join corretti con la tabella partizionata visite_ambulatoriali."
      }
    ],
    "spec_hash": "43c196dba0b03dba"
  },
  "schema_ddl": "CREATE TABLE reparti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_reparto TEXT NOT NULL UNIQUE,\n    nome_reparto TEXT NOT NULL,\n    edificio TEXT,\n    numero_letti INT CHECK (numero_letti >= 0)\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    reparto_id INT NOT NULL REFERENCES reparti(id)\n);\n\nCREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    telefono TEXT,\n    CHECK (data_nascita >= DATE '1900-01-01')\n);\n\nCREATE TABLE visite_ambulatoriali (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    data_visita DATE NOT NULL,\n    ora_visita TIME NOT NULL DEFAULT TIME '09:00',\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    motivo_visita TEXT NOT NULL,\n    esito_visita TEXT,\n    costo_visita NUMERIC(8,2) CHECK (costo_visita >= 0),\n    PRIMARY KEY (id, data_visita)\n) PARTITION BY RANGE (data_visita);\n\nCREATE TABLE visite_ambulatoriali_precedenti PARTITION OF visite_ambulatoriali\n    FOR VALUES FROM (DATE '2010-01-01') TO (DATE '2024-01-01');\n\nCREATE TABLE visite_ambulatoriali_2024 PARTITION OF visite_ambulatoriali\n    FOR VALUES FROM (DATE '2024-01-01') TO (DATE '2025-01-01');\n\nCREATE TABLE visite_ambulatoriali_2025 PARTITION OF visite_ambulatoriali\n    FOR VALUES FROM (DATE '2025-01-01') TO (DATE '2026-01-01');\n\nCREATE TABLE visite_ambulatoriali_default PARTITION OF visite_ambulatoriali\n    DEFAULT;",
