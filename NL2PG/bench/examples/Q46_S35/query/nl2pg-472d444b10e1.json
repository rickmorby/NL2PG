  "feature_sql": [
    "relative_time"
  ],
  "query": "SELECT r.nome_reparto AS reparto, r.edificio AS padiglione, COUNT(*) AS numero_visite, COUNT(DISTINCT v.paziente_id) AS pazienti_unici, ROUND(SUM(v.costo_visita), 2) AS ricavo_totale_euro, ROUND(AVG(v.costo_visita), 2) AS costo_medio_visita FROM visite_ambulatoriali v JOIN reparti r ON r.id = v.reparto_id WHERE v.data_visita >= (DATE '2025-12-01' - INTERVAL '30 days')::date AND v.data_visita < DATE '2025-12-01' AND v.motivo_visita IN ('Controllo cardiologico di routine', 'Dispnea da sforzo') AND v.esito_visita IS NOT NULL GROUP BY r.nome_reparto, r.edificio ORDER BY ricavo_totale_euro DESC, r.nome_reparto ASC, r.edificio ASC;"
}