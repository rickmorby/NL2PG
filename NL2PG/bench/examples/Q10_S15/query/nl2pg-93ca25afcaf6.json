  "feature_sql": [],
  "query": "SELECT c.nome_conto, c.categoria_contabile, SUM(s.importo) AS totale_importo, COUNT(*) AS numero_movimenti FROM conti c JOIN scritture_contabili s ON c.id = s.conto_id WHERE s.tipo_movimento = 'DARE' AND s.data_registrazione BETWEEN DATE '2025-07-12' AND DATE '2026-06-25' GROUP BY c.nome_conto, c.categoria_contabile;"
