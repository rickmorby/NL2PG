{
  "schema_ddl": "CREATE TABLE conti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    nome_conto TEXT NOT NULL,\n    categoria_contabile TEXT NOT NULL CHECK (categoria_contabile IN ('ATTIVITA', 'PASSIVITA', 'PATRIMONIO_NETTO', 'RICAVO', 'COSTO')),\n    descrizione TEXT\n);\n\nCREATE TABLE scritture_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti(id) ON DELETE CASCADE,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    descrizione TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo >= 0),\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('DARE', 'AVERE'))\n);",
