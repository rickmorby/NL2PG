  "query": "SELECT c.titolo AS titolo_corso, c.crediti AS crediti_corso, c.semestre AS semestre, p.titolo AS titolo_prerequisito, p.crediti AS crediti_prerequisito FROM corsi AS c JOIN corsi AS p ON c.corso_prerequisito_id = p.id WHERE c.anno_accademico = '2024/2025' ORDER BY c.titolo, c.crediti DESC, c.id"
}