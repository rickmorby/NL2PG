    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "corsi",
        "obsolete_value": "offerta_didattica",
        "description": "La tabella corsi, che contiene la colonna autoriferita corso_prerequisito_id per modellare i prerequisiti tra corsi, viene denominata offerta_didattica nella prosa aziendale."
      },
      {
        "twist_type": "jargon",
        "target_value": "crediti",
        "obsolete_value": "CFU",
        "description": "La colonna crediti della tabella corsi viene indicata nel testo con l'acronimo gergale CFU (Crediti Formativi Universitari), richiedendo la decodifica del termine tecnico."
      },
      {
        "twist_type": "synonym",
        "target_value": "iscrizioni",
        "obsolete_value": "verbalizzazioni",
        "description": "La tabella iscrizioni, che registra gli esami sostenuti dagli studenti, viene indicata nella prosa come verbalizzazioni, usando un sinonimo amministrativo del dominio accademico."
      }
    ],
    "spec_hash": "2e4754c72a81b1d3"
  },
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT PRIMARY KEY,\n    codice_dipartimento TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    sede TEXT\n);\n\nCREATE TABLE docenti (\n    id INT PRIMARY KEY,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    ruolo TEXT NOT NULL CHECK (ruolo IN ('ordinario', 'associato', 'ricercatore'))\n);\n\nCREATE TABLE studenti (\n    id INT PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_immatricolazione DATE NOT NULL,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE corsi (\n    id INT PRIMARY KEY,\n    docente_id INT NOT NULL REFERENCES docenti(id),\n    corso_prerequisito_id INT REFERENCES corsi(id),\n    titolo TEXT NOT NULL,\n    crediti INT NOT NULL CHECK (crediti BETWEEN 1 AND 30),\n    semestre INT NOT NULL CHECK (semestre IN (1, 2)),\n    anno_accademico TEXT NOT NULL\n);\n\nCREATE TABLE iscrizioni (\n    id INT PRIMARY KEY,\n    studente_id INT NOT NULL REFERENCES studenti(id),\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    data_esame DATE NOT NULL,\n    voto INT NOT NULL CHECK (voto BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    UNIQUE (studente_id, corso_id, data_esame)\n);",
