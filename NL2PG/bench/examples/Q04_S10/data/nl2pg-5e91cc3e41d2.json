  "schema_ddl": "CREATE TABLE ospedali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_ospedale TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    indirizzo TEXT NOT NULL\n);\n\nCREATE TABLE reparti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ospedale_id INT NOT NULL REFERENCES ospedali(id),\n    codice_struttura_operativa VARCHAR(50) NOT NULL UNIQUE,\n    nome_reparto TEXT NOT NULL,\n    numero_posti_letto INT NOT NULL CHECK (numero_posti_letto >= 0)\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_struttura_operativa VARCHAR(50) NOT NULL REFERENCES reparti(codice_struttura_operativa),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_struttura_operativa VARCHAR(50) NOT NULL REFERENCES reparti(codice_struttura_operativa),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    codice_fiscale CHAR(16) NOT NULL UNIQUE\n);",
