      }
    ],
    "spec_hash": "957d49bc65129b32"
  },
  "schema_ddl": "CREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE,\n    citta TEXT,\n    creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE visite_mediche (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    data_visita DATE NOT NULL,\n    reparto TEXT NOT NULL,\n    medico TEXT,\n    costo_visita NUMERIC(10,2) NOT NULL CHECK (costo_visita >= 0),\n    note_cliniche TEXT,\n    creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
