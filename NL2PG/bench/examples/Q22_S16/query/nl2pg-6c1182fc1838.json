  "feature_sql": [
    "distinct_on"
  ],
  "query": "SELECT DISTINCT ON (c.citta) c.citta, c.nome || ' ' || c.cognome AS cliente, o.data_ordine::date AS data_ultimo_ordine, o.totale AS importo_ordine FROM clienti c JOIN ordini o ON o.cliente_id = c.id WHERE o.stato_ordine IN ('consegnato', 'spedito') ORDER BY c.citta ASC, o.data_ordine DESC, o.id DESC;"
}