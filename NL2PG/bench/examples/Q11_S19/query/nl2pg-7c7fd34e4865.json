  "feature_sql": [
    "subquery"
  ],
  "query": "SELECT c.nome, c.cognome, co.tipo_conto, co.saldo_disponibile AS saldo_conto, ROUND(co.saldo_disponibile - (SELECT AVG(saldo_disponibile) FROM conti WHERE tipo_conto = 'corrente'), 2) AS scostamento_dalla_media FROM conti co JOIN clienti c ON c.id = co.cliente_id WHERE co.tipo_conto = 'corrente' AND co.saldo_disponibile > (SELECT AVG(saldo_disponibile) FROM conti WHERE tipo_conto = 'corrente') ORDER BY co.saldo_disponibile DESC;"
}