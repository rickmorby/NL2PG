  "feature_sql": [
    "join",
    "left_outer_join"
  ],
  "query": "SELECT c.ragione_sociale, COUNT(s.id) AS numero_spedizioni_consegnate, COALESCE(SUM(a.tariffa_tratta), 0) AS ricavo_totale_tratte, ROUND(AVG(a.tariffa_tratta), 2) AS tariffa_media_tratta FROM corrieri c LEFT JOIN assegnazioni_tratta a ON c.id = a.corriere_id LEFT JOIN spedizioni s ON s.id = a.spedizione_id AND s.stato = 'consegnata' WHERE c.attivo = TRUE GROUP BY c.ragione_sociale ORDER BY ricavo_totale_tratte DESC;"
}