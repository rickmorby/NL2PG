  "schema_ddl": "CREATE TYPE stato_spedizione AS ENUM ('in_preparazione', 'in_transito', 'consegnata');\n\nCREATE TABLE corrieri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    email TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_tracciamento TEXT NOT NULL UNIQUE,\n    stato stato_spedizione NOT NULL DEFAULT 'in_preparazione',\n    destinatario_nome TEXT NOT NULL,\n    destinatario_citta TEXT NOT NULL,\n    destinatario_stato TEXT NOT NULL,\n    indirizzo_destinazione TEXT NOT NULL,\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    data_spedizione DATE NOT NULL DEFAULT CURRENT_DATE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE assegnazioni_tratta (\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    corriere_id INT NOT NULL REFERENCES corrieri(id) ON DELETE CASCADE,\n    numero_tratta INT NOT NULL CHECK (numero_tratta >= 1),\n    tariffa_tratta NUMERIC(10,2) NOT NULL CHECK (tariffa_tratta >= 0),\n    PRIMARY KEY (spedizione_id, corriere_id)\n);",
