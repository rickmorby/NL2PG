  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT f.citta, COUNT(c.id) AS numero_conti, COUNT(DISTINCT c.cliente_id) AS clienti_distinti, ROUND(SUM(c.saldo), 2) AS saldo_totale, ROUND(AVG(c.fido_concesso), 2) AS fido_medio FROM filiali f JOIN conti c ON c.filiale_id = f.id WHERE c.data_apertura >= DATE '2018-01-01' GROUP BY f.citta HAVING COUNT(c.id) >= 10 ORDER BY saldo_totale DESC;"
}