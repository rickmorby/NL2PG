{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_apertura_relazione DATE NOT NULL\n);\n\nCREATE TABLE filiali (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    codice_abi TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE conti (\n    id INT PRIMARY KEY,\n    cliente_id INT NOT NULL,\n    filiale_id INT NOT NULL,\n    iban TEXT NOT NULL UNIQUE,\n    fido_concesso NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (fido_concesso >= 0),\n    saldo NUMERIC(12,2) NOT NULL DEFAULT 0,\n    data_apertura DATE NOT NULL\n);\n\nCREATE TABLE transazioni (\n    id BIGINT PRIMARY KEY,\n    conto_id INT NOT NULL,\n    data_transazione DATE NOT NULL,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('accredito', 'addebito')),\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    descrizione TEXT\n);",
