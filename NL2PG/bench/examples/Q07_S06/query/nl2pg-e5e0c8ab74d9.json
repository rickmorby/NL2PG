{
  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    prezzo NUMERIC(10, 2) NOT NULL CHECK (prezzo >= 0),\n    descrizione TEXT\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE CHECK (email ~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,4}$')\n);\n\nCREATE TABLE ordini_clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    data_ordine TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    totale_riga NUMERIC(10, 2) ,\n    PRIMARY KEY (cliente_id, prodotto_id, data_ordine)\n);",
