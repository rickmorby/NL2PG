  "feature_sql": [
    "multi_join"
  ],
  "query": "WITH prodotti_popolari AS (\n    SELECT \n        p.id AS prodotto_id, \n        p.nome AS nome_prodotto, \n        SUM(oc.quantita) AS quantita_totale_venduta\n    FROM \n        prodotti p\n    JOIN \n        ordini_clienti oc ON p.id = oc.prodotto_id\n    GROUP BY \n        p.id, p.nome\n    HAVING \n        SUM(oc.quantita) > 5\n), \nclienti_fedeli AS (\n    SELECT \n        c.id AS cliente_id, \n        c.nome AS nome_cliente, \n        COUNT(DISTINCT oc.prodotto_id) AS prodotti_distinti_acquistati\n    FROM \n        clienti c\n    JOIN \n        ordini_clienti oc ON c.id = oc.cliente_id\n    WHERE \n        oc.data_ordine >= DATE '2027-03-01' - INTERVAL '30 days'\n    GROUP BY \n        c.id, c.nome\n    HAVING \n        COUNT(DISTINCT oc.prodotto_id) > 1\n)\nSELECT \n    cf.nome_cliente, \n    pp.nome_prodotto, \n    SUM(oc.quantita) AS quantita_acquistata,\n    RANK() OVER (PARTITION BY cf.nome_cliente ORDER BY SUM(oc.quantita) DESC) AS posizione_per_cliente\nFROM \n    clienti_fedeli cf\nJOIN \n    ordini_clienti oc ON cf.cliente_id = oc.cliente_id\nJOIN \n    prodotti_popolari pp ON oc.prodotto_id = pp.prodotto_id\nWHERE \n    oc.data_ordine >= DATE '2027-03-01' - INTERVAL '30 days'\n    AND pp.quantita_totale_venduta > ANY (\n        SELECT quantita_totale_venduta \n        FROM prodotti_popolari \n        WHERE quantita_totale_venduta < 50\n    )\nGROUP BY \n    cf.nome_cliente, pp.nome_prodotto\nORDER BY \n    cf.nome_cliente, quantita_acquistata DESC;"
}