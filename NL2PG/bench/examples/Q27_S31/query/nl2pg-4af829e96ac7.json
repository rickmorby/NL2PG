{
  "schema_ddl": "CREATE TABLE registrazioni (\n    id SERIAL PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo != 0),\n    tipo_voce TEXT NOT NULL,\n    fornitore TEXT,\n    totale_per_fornitore NUMERIC(12,2) GENERATED ALWAYS AS (\n        CASE WHEN fornitore IS NOT NULL THEN importo ELSE NULL END\n    ) STORED,\n    totale_per_tipo NUMERIC(12,2) GENERATED ALWAYS AS (\n        CASE WHEN tipo_voce IS NOT NULL THEN importo ELSE NULL END\n    ) STORED,\n    totale_generale NUMERIC(12,2) GENERATED ALWAYS AS (importo) STORED\n);\n\nCREATE TABLE categorie_contabili (\n    id SERIAL PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE fornitori (\n    id SERIAL PRIMARY KEY,\n    nome_fornitore TEXT NOT NULL UNIQUE,\n    partiva_iva TEXT CHECK (partiva_iva ~ '^[A-Z]{2}[0-9]{11}$|^$'),\n    data_inserimento TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE riepiloghi (\n    id SERIAL PRIMARY KEY,\n    periodo DATE NOT NULL,\n    somma_totale NUMERIC(12,2) NOT NULL DEFAULT 0,\n    conteggio_registrazioni INT NOT NULL DEFAULT 0,\n    CHECK (somma_totale >= 0 AND conteggio_registrazioni >= 0)\n);",
