  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT CASE WHEN GROUPING(tipo_voce) = 1 AND GROUPING(fornitore) = 1 THEN 'Totale generale' WHEN GROUPING(fornitore) = 1 THEN 'Totale per tipo voce' ELSE 'Dettaglio per fornitore' END AS livello_aggregazione, tipo_voce, fornitore, SUM(importo) AS totale_importo, COUNT(*) AS conteggio_registrazioni FROM registrazioni WHERE tipo_voce IN ('Spese generali', 'Amortamenti', 'Costi di produzione') AND fornitore IN ('Beta SpA', 'Delta Logistics', 'Epsilon Tech', 'Fornitore Alpha Srl') GROUP BY GROUPING SETS ((tipo_voce, fornitore), (tipo_voce), ());"
}