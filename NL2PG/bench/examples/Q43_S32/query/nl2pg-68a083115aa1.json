  ],
  "query": "SELECT motivo_visita, COUNT(*) AS numero_prenotazioni, SUM(CASE WHEN stato_prenotazione = 'confermata' THEN 1 ELSE 0 END) AS confermate, SUM(CASE WHEN stato_prenotazione = 'completata' THEN 1 ELSE 0 END) AS completate FROM prenotazioni WHERE stato_prenotazione IN ('confermata', 'completata') AND data_ora_prenotazione BETWEEN '2026-02-25' AND '2026-04-14' GROUP BY motivo_visita ORDER BY numero_prenotazioni DESC;"
