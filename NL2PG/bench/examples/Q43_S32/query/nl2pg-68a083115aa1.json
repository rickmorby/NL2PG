{
  "schema_ddl": "CREATE TABLE prenotazioni (\n    id BIGSERIAL PRIMARY KEY,\n    paziente_id INT NOT NULL,\n    medico_id INT NOT NULL,\n    ambulatorio_id INT NOT NULL,\n    data_ora_prenotazione TIMESTAMP NOT NULL,\n    motivo_visita TEXT NOT NULL,\n    stato_prenotazione TEXT NOT NULL CHECK (stato_prenotazione IN ('prenotata', 'confermata', 'annullata', 'completata')),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_ora_prenotazione > CURRENT_TIMESTAMP - INTERVAL '5 years'),\n    CHECK (data_ora_prenotazione < CURRENT_TIMESTAMP + INTERVAL '1 year')\n);",
