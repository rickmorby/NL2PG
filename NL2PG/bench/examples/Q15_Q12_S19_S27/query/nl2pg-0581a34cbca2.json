  "feature_sql": [
    "cte",
    "subquery"
  ],
  "query": "WITH ricoveri_target AS (\n    SELECT reparto, costo_totale\n    FROM ricoveri\n    WHERE reparto IN ('Cardiologia', 'Neurologia', 'Oncologia')\n      AND data_dimissione IS NOT NULL\n),\ncosti_reparto AS (\n    SELECT reparto,\n           COUNT(*) AS numero_ricoveri,\n           ROUND(AVG(costo_totale), 2) AS costo_medio_reparto\n    FROM ricoveri_target\n    GROUP BY reparto\n)\nSELECT cr.reparto,\n       cr.numero_ricoveri,\n       cr.costo_medio_reparto,\n       ROUND((SELECT AVG(costo_totale) FROM ricoveri WHERE data_dimissione IS NOT NULL), 2) AS costo_medio_ospedale,\n       ROUND(cr.costo_medio_reparto - (SELECT AVG(costo_totale) FROM ricoveri WHERE data_dimissione IS NOT NULL), 2) AS scostamento_dalla_media\nFROM costi_reparto cr\nORDER BY scostamento_dalla_media DESC;"
}