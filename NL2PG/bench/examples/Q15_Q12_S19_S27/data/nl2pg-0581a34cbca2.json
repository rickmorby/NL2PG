        "twist_type": "synonym",
        "target_value": "costo_totale",
        "obsolete_value": "onere complessivo della degenza",
        "description": "La colonna costo_totale della tabella ricoveri viene indicata nei requisiti come 'onere complessivo della degenza'; la CTE deve filtrare i ricoveri il cui costo supera la media calcolata tramite subquery scalare annidata sullo stesso dataset."
      }
    ],
    "spec_hash": "883d81b72c1e0135"
  },
  "schema_ddl": "CREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE ricoveri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    data_ingresso DATE NOT NULL,\n    data_dimissione DATE,\n    reparto TEXT NOT NULL,\n    costo_totale NUMERIC(10,2) NOT NULL CHECK (costo_totale >= 0),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_dimissione IS NULL OR data_dimissione >= data_ingresso)\n);",
