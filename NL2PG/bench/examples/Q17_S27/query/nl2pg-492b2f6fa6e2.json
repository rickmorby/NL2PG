  "feature_sql": [
    "window"
  ],
  "query": "WITH movimenti_per_conto AS (\n    SELECT conto_id,\n           COUNT(*) AS numero_movimenti,\n           COALESCE(SUM(importo) FILTER (WHERE tipo_movimento = 'accredito'), 0) AS totale_accrediti,\n           COALESCE(SUM(importo) FILTER (WHERE tipo_movimento = 'addebito'), 0) AS totale_addebiti\n    FROM transazioni\n    GROUP BY conto_id\n)\nSELECT c.iban,\n       c.intestatario,\n       c.valuta,\n       c.saldo_iniziale,\n       COALESCE(m.numero_movimenti, 0) AS numero_movimenti,\n       COALESCE(m.totale_accrediti, 0) AS totale_accrediti,\n       COALESCE(m.totale_addebiti, 0) AS totale_addebiti,\n       RANK() OVER (ORDER BY c.saldo_iniziale DESC) AS posizione_classifica\nFROM conti c\nLEFT JOIN movimenti_per_conto m ON m.conto_id = c.id\nWHERE c.valuta = 'EUR'\nORDER BY posizione_classifica ASC, c.saldo_iniziale DESC, c.iban ASC;"
}