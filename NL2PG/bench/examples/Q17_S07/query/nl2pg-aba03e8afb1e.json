  "query": "SELECT descrizione, saldo_iniziale, RANK() OVER (ORDER BY saldo_iniziale DESC) AS posizione_saldo FROM conti_finanziari WHERE livello BETWEEN 1 AND 2 AND descrizione LIKE '%Banca%' OR descrizione = 'Stipendi' ORDER BY posizione_saldo, conti_finanziari.id"
