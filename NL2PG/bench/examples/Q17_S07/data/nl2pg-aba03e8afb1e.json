  "schema_ddl": "CREATE TYPE tipo_movimento AS ENUM ('ACCREDITO', 'ADDEBITO');\n\nCREATE TABLE conti_finanziari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    livello INT NOT NULL CHECK (livello >= 0),\n    conto_padre_id INT REFERENCES conti_finanziari(id) ON DELETE CASCADE,\n    saldo_iniziale NUMERIC(15,2) NOT NULL CHECK (saldo_iniziale >= 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
