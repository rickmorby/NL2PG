{
  "schema_ddl": "CREATE TABLE docenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola_docente TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    dipartimento TEXT NOT NULL,\n    qualifica TEXT NOT NULL CHECK (qualifica IN ('professore_ordinario', 'professore_associato', 'ricercatore', 'docente_a_contratto')),\n    data_assunzione DATE NOT NULL,\n    coordinatore_id INT REFERENCES docenti(id),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
