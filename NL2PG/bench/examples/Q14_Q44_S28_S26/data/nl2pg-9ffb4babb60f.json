    "spec_hash": "b24a0c8072ca9f69"
  },
  "schema_ddl": "CREATE TABLE sim (\n    id INT PRIMARY KEY,\n    iccid TEXT NOT NULL UNIQUE,\n    numero_telefono TEXT NOT NULL,\n    operatore TEXT NOT NULL,\n    stato TEXT NOT NULL DEFAULT 'attiva' CHECK (stato IN ('attiva', 'sospesa', 'disattivata')),\n    data_attivazione DATE NOT NULL\n);\n\nCREATE TABLE contratti (\n    id INT PRIMARY KEY,\n    sim_id INT NOT NULL UNIQUE REFERENCES sim(id),\n    denominazione_piano TEXT NOT NULL,\n    gigabyte INT NOT NULL CHECK (gigabyte > 0),\n    minuti_inclusi INT NOT NULL CHECK (minuti_inclusi >= 0),\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    data_sottoscrizione DATE NOT NULL,\n    data_cessazione DATE,\n    CHECK (data_cessazione IS NULL OR data_cessazione >= data_sottoscrizione)\n);",
