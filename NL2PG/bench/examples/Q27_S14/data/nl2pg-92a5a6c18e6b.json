  "schema_ddl": "CREATE DOMAIN importo_premio AS NUMERIC(12,2) CHECK (VALUE > 0);\n\nCREATE DOMAIN stato_polizza AS TEXT CHECK (VALUE IN ('attiva', 'sospesa', 'scaduta'));\n\nCREATE TABLE polizze (\n    id INT PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    tipo_polizza TEXT NOT NULL,\n    regione TEXT NOT NULL,\n    premio_annuo importo_premio NOT NULL,\n    stato stato_polizza NOT NULL,\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    CHECK (data_scadenza > data_emissione)\n);",
