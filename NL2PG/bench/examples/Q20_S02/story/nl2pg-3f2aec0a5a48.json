{
  "schema_ddl": "CREATE TABLE conti_correnti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_conto TEXT NOT NULL UNIQUE,\n    titolare TEXT NOT NULL,\n    saldo NUMERIC(12,2) NOT NULL CHECK (saldo >= 0)\n);\n\nCREATE TABLE transazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti_correnti(id),\n    importo NUMERIC(12,2) NOT NULL,\n    data_transazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    tipo_operazione TEXT NOT NULL CHECK (tipo_operazione IN ('BONIFICO', 'ACCREDITO', 'PAGAMENTO', 'PRELIEVO'))\n);\n\nCREATE TABLE registri_audit (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    transazione_id INT REFERENCES transazioni(id),\n    dettagli TEXT NOT NULL,\n    registrato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
