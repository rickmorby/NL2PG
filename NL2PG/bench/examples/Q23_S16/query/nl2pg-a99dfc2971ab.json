  "feature_sql": [
    "filtered_agg"
  ],
  "query": "SELECT c.nome_corso, SUM(c.crediti) AS crediti_totali, COUNT(*) FILTER (WHERE v.stato_iscrizione = 'attiva') AS iscrizioni_attive, COUNT(*) FILTER (WHERE v.stato_iscrizione = 'sospesa') AS iscrizioni_sospese, COUNT(*) FILTER (WHERE v.stato_iscrizione = 'ritirata') AS iscrizioni_ritirate FROM corsi c JOIN versioni_iscrizione v ON c.id = v.corso_id WHERE c.codice_corso LIKE 'INF-%' AND v.valid_from >= DATE '2023-08-01' GROUP BY c.nome_corso ORDER BY iscrizioni_attive DESC, c.nome_corso ASC;"
}