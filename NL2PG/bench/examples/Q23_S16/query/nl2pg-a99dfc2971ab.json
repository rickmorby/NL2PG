{
  "schema_ddl": "CREATE TYPE stato_iscrizione_enum AS ENUM ('attiva', 'sospesa', 'ritirata');\n\nCREATE TABLE studenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE,\n    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_corso TEXT NOT NULL UNIQUE,\n    nome_corso TEXT NOT NULL,\n    crediti INT CHECK (crediti > 0),\n    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE versioni_iscrizione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    studente_id INT NOT NULL REFERENCES studenti(id) ON DELETE CASCADE,\n    corso_id INT NOT NULL REFERENCES corsi(id) ON DELETE CASCADE,\n    stato_iscrizione stato_iscrizione_enum NOT NULL,\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    CHECK (valid_to IS NULL OR valid_from <= valid_to)\n);",
