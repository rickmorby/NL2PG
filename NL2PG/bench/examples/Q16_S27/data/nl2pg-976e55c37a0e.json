    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "ordini",
        "obsolete_value": "movimenti_transazionali",
        "description": "La tabella ordini viene denominata movimenti_transazionali nella prosa aziendale. Il risolutore deve mappare 'movimenti_transazionali' alla tabella reale ordini, che contiene le colonne id, utente_id, ordine_padre_id, totale e stato, senza alcun vincolo REFERENCES dichiarato."
      },
      {
        "twist_type": "synonym",
        "target_value": "totale",
        "obsolete_value": "valore_complessivo",
        "description": "La colonna totale della tabella ordini viene indicata nei documenti aziendali con il sinonimo 'valore_complessivo'. Le query di aggregazione lungo la catena ricorsiva degli ordini devono riferirsi alla colonna reale totale."
      },
      {
        "twist_type": "jargon",
        "target_value": "articoli_ordine",
        "obsolete_value": "righe SKU",
        "description": "La prosa commerciale usa il gergo del settore retail 'righe SKU' per indicare la tabella articoli_ordine (colonne id, ordine_id, prodotto, quantita, prezzo_unitario). Il risolutore deve riconoscere che ogni 'riga SKU' corrisponde a una riga della tabella articoli_ordine collegata concettualmente tramite la colonna compatibile ordine_id."
      }
    ],
    "spec_hash": "aa785fa039c41a23"
  },
  "schema_ddl": "CREATE TABLE utenti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE ordini (\n    id SERIAL PRIMARY KEY,\n    utente_id INT NOT NULL,\n    ordine_padre_id INT,\n    totale NUMERIC(12,2) NOT NULL CHECK (totale >= 0),\n    stato TEXT NOT NULL CHECK (stato IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato'))\n);\n\nCREATE TABLE articoli_ordine (\n    id SERIAL PRIMARY KEY,\n    ordine_id INT NOT NULL,\n    prodotto TEXT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0)\n);",
