  "feature_sql": [
    "recursive_cte"
  ],
  "query": "WITH RECURSIVE catena_ordini (ordine_radice, ordine_corrente, utente_id, stato, livello, totale_ordine, totale_cumulato) AS (SELECT o.id, o.id, o.utente_id, o.stato, 0::int AS livello, o.totale::numeric AS totale_ordine, o.totale::numeric AS totale_cumulato FROM ordini o WHERE o.ordine_padre_id IS NULL AND o.stato IN ('confermato', 'spedito', 'consegnato') UNION ALL SELECT c.ordine_radice, f.id, f.utente_id, f.stato, c.livello + 1, f.totale::numeric, c.totale_cumulato + f.totale::numeric FROM catena_ordini c JOIN ordini f ON f.ordine_padre_id = c.ordine_corrente) SELECT u.nome AS nome_utente, COUNT(*) AS ordini_in_catena, MAX(c.livello) AS profondita_massima, ROUND(SUM(c.totale_ordine), 2) AS valore_totale_catena, COUNT(DISTINCT c.stato) AS stati_distinti_catena FROM catena_ordini c JOIN utenti u ON u.id = c.utente_id GROUP BY u.nome ORDER BY valore_totale_catena DESC, nome_utente ASC;"
}