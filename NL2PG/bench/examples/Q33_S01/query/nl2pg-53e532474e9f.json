  "feature_sql": [
    "like"
  ],
  "query": "SELECT citta_destinazione, COUNT(*) AS spedizioni_tracciate, ROUND(AVG(costo_spedizione), 2) AS costo_medio_euro, SUM(CASE WHEN stato_spedizione = 'consegnata' THEN 1 ELSE 0 END) AS consegne_andate_a_buon_fine FROM spedizioni WHERE codice_tracciamento LIKE 'TRK-2026-0001%' AND stato_spedizione IN ('consegnata', 'in_transito') GROUP BY citta_destinazione ORDER BY spedizioni_tracciate DESC, citta_destinazione ASC;"
}