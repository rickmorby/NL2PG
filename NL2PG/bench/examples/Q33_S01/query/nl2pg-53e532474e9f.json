  "schema_ddl": "CREATE TABLE spedizioni (\n    id INT PRIMARY KEY,\n    codice_tracciamento TEXT NOT NULL UNIQUE,\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione <> ''),\n    nome_destinatario TEXT NOT NULL,\n    citta_destinazione TEXT NOT NULL,\n    cap_destinazione TEXT,\n    peso_chilogrammi NUMERIC(8,2) CHECK (peso_chilogrammi > 0),\n    data_ritiro DATE NOT NULL,\n    data_consegna_prevista DATE,\n    data_consegna_effettiva DATE,\n    costo_spedizione NUMERIC(10,2) CHECK (costo_spedizione >= 0)\n);",
