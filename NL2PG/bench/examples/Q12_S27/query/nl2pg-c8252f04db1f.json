  "feature_sql": [
    "correlated_subquery"
  ],
  "query": "SELECT c.nome, ROUND(SUM(v.importo), 2) AS totale_importo_sopra_media, COUNT(v.id) AS numero_vendite_sopra_media FROM clienti c JOIN vendite v ON v.cliente_id = c.id WHERE c.nome IN ('Giuseppe Verdi', 'Anna Neri', 'Laura Bianchi', 'Alessandro Greco', 'Martina Conti') AND v.importo > (SELECT AVG(v2.importo) FROM vendite v2 WHERE v2.cliente_id = c.id) GROUP BY c.nome ORDER BY totale_importo_sopra_media DESC LIMIT 5;"
}