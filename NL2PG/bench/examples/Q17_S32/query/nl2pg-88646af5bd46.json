  "feature_sql": [
    "window"
  ],
  "query": "WITH valore_ordini AS (SELECT oa.numero_ordine, oa.fornitore, oa.stato_ordine, ROUND(SUM(r.quantita * r.prezzo_unitario * (1 - r.sconto_percentuale / 100.0)), 2) AS valore_totale FROM ordini_acquisto oa JOIN righe_ordini_acquisto r ON r.ordine_acquisto_id = oa.id WHERE oa.stato_ordine IN ('approvato', 'inviato') AND oa.data_ordine BETWEEN DATE '2026-01-01' AND DATE '2026-02-28' GROUP BY oa.numero_ordine, oa.fornitore, oa.stato_ordine) SELECT vo.numero_ordine, vo.fornitore, vo.valore_totale, RANK() OVER (ORDER BY vo.valore_totale DESC) AS posizione_classifica FROM valore_ordini vo ORDER BY posizione_classifica ASC, vo.numero_ordine ASC LIMIT 10;"
}