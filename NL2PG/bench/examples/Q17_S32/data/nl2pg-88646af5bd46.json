        "obsolete_value": "documenti_di_approvvigionamento",
        "description": "La tabella ordini_acquisto (con colonne di audit created_at, created_by, updated_at, updated_by) viene denominata documenti_di_approvvigionamento nella prosa aziendale; il solver deve mappare la perifrasi al nome reale della tabella."
      },
      {
        "twist_type": "jargon",
        "target_value": "updated_by",
        "obsolete_value": "responsabile ultima revisione",
        "description": "La colonna di audit updated_by viene indicata nella prosa con il gergo ERP 'responsabile ultima revisione'; il solver deve riconoscere che si tratta dell'utente che ha eseguito l'ultima modifica e usarla per filtri di responsabilità o partizioni nelle finestre temporali."
      }
    ],
    "spec_hash": "46c6918b245c8067"
  },
  "schema_ddl": "CREATE TABLE ordini_acquisto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    fornitore TEXT NOT NULL,\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL DEFAULT 'aperto' CHECK (stato_ordine IN ('aperto', 'in_approvazione', 'approvato', 'inviato', 'chiuso', 'annullato')),\n    note TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    created_by TEXT NOT NULL,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_by TEXT\n);\n\nCREATE TABLE righe_ordini_acquisto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_acquisto_id INT NOT NULL REFERENCES ordini_acquisto(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    codice_articolo TEXT NOT NULL,\n    descrizione_articolo TEXT NOT NULL,\n    quantita NUMERIC(12,3) NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(12,4) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    created_by TEXT NOT NULL,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_by TEXT,\n    UNIQUE (ordine_acquisto_id, numero_riga)\n);",
