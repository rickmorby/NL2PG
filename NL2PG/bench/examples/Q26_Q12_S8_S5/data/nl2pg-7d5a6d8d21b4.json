  "schema_ddl": "CREATE TABLE entita_finanziarie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_identificativo TEXT NOT NULL UNIQUE,\n    tipo_entita TEXT NOT NULL CHECK (tipo_entita IN ('societa', 'filiale', 'dipartimento', 'ufficio')),\n    entita_padre_id INT REFERENCES entita_finanziarie(id) ON DELETE CASCADE,\n    data_creazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    data_modifica TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (id != entita_padre_id)\n);",
