  "query": "WITH gerarchia_entita AS (\n    SELECT \n        id,\n        nome,\n        codice_identificativo,\n        tipo_entita,\n        entita_padre_id,\n        data_creazione\n    FROM \n        entita_finanziarie\n    WHERE \n        tipo_entita IN ('societa', 'filiale')\n        AND EXISTS (\n            SELECT 1 \n            FROM entita_finanziarie e2 \n            WHERE e2.entita_padre_id = entita_finanziarie.id\n            AND e2.tipo_entita = 'dipartimento'\n        )\n)\nSELECT \n    ge.nome AS entita_principale,\n    ge.codice_identificativo AS codice_entita,\n    ge.tipo_entita,\n    ge.data_creazione,\n    COUNT(DISTINCT CASE WHEN ef.tipo_entita = 'dipartimento' THEN ef.id END) AS numero_dipartimenti,\n    COUNT(DISTINCT CASE WHEN ef.tipo_entita = 'ufficio' THEN ef.id END) AS numero_uffici\nFROM \n    gerarchia_entita ge\nLEFT JOIN \n    entita_finanziarie ef ON ge.id = ef.entita_padre_id\nWHERE \n    NOT EXISTS (\n        SELECT 1 \n        FROM entita_finanziarie ef_anti\n        WHERE ef_anti.entita_padre_id = ge.id\n        AND ef_anti.tipo_entita = 'ufficio'\n        AND ef_anti.data_creazione < ge.data_creazione - INTERVAL '1 year'\n    )\nGROUP BY \n    ge.id, ge.nome, ge.codice_identificativo, ge.tipo_entita, ge.data_creazione\nORDER BY \n    numero_dipartimenti DESC, numero_uffici DESC;"
}