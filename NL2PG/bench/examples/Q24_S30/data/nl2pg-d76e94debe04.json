{
  "spec": {
    "domain": "logistica",
    "n_tables": 12,
    "hierarchy": "path_routing",
    "sql_features": [
      "join",
      "left_outer_join"
    ],
    "twist": [
      "distractor"
    ],
    "twist_rules": [
      {
        "twist_type": "distractor",
        "target_value": "corrieri",
        "obsolete_value": "consorzi_trasporto_terzi",
        "description": "Lo schema logistico è volutamente ampio (12 tabelle) e contiene molte entità irrilevanti che fungono da distrattori: contratti_corrieri, flotta_veicoli, assegnazioni_autisti, resi e fatture condividono colonne dall'aspetto simile (id_corriere, data_registrazione, importo). Nella prosa aziendale i vettori vengono citati con la perifrasi consorzi_trasporto_terzi, spingendo verso un join errato su contratti_corrieri o assegnazioni_autisti. L'unica tabella con l'anagrafica completa dei corrieri è corrieri: la soluzione corretta richiede di individuare il percorso rilevante (spedizioni -> corrieri) ignorando le tabelle esca, applicando un LEFT JOIN per includere tutte le spedizioni, anche quelle prive di corriere assegnato."
      }
    ],
    "spec_hash": "88b31dfa22719b0e"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id SERIAL PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT UNIQUE,\n    partita_iva TEXT UNIQUE,\n    email TEXT,\n    telefono TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE magazzini (\n    id SERIAL PRIMARY KEY,\n    codice_magazzino TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    capacita_pallet INT NOT NULL CHECK (capacita_pallet > 0)\n);\n\nCREATE TABLE destinazioni (\n    id SERIAL PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    provincia TEXT,\n    cap TEXT,\n    paese TEXT NOT NULL DEFAULT 'Italia'\n);\n\nCREATE TABLE corrieri (\n    id SERIAL PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    partita_iva TEXT UNIQUE,\n    telefono TEXT,\n    email TEXT,\n    zona_copertura TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE contratti_corrieri (\n    id SERIAL PRIMARY KEY,\n    corriere_id INT NOT NULL REFERENCES corrieri(id),\n    data_registrazione DATE NOT NULL,\n    data_scadenza DATE,\n    tipo_tariffa TEXT NOT NULL DEFAULT 'chilometrica',\n    importo_canone NUMERIC(10,2) NOT NULL CHECK (importo_canone >= 0)\n);\n\nCREATE TABLE flotta_veicoli (\n    id SERIAL PRIMARY KEY,\n    targa TEXT NOT NULL UNIQUE,\n    modello TEXT NOT NULL,\n    capacita_kg INT NOT NULL CHECK (capacita_kg > 0),\n    corriere_id INT REFERENCES corrieri(id),\n    data_registrazione DATE NOT NULL,\n    importo_valore NUMERIC(10,2) CHECK (importo_valore >= 0)\n);\n\nCREATE TABLE autisti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    numero_patente TEXT NOT NULL UNIQUE,\n    corriere_id INT REFERENCES corrieri(id),\n    data_assunzione DATE\n);\n\nCREATE TABLE assegnazioni_autisti (\n    id SERIAL PRIMARY KEY,\n    autista_id INT NOT NULL REFERENCES autisti(id),\n    veicolo_id INT NOT NULL REFERENCES flotta_veicoli(id),\n    data_registrazione DATE NOT NULL,\n    turno TEXT NOT NULL CHECK (turno IN ('mattina', 'pomeriggio', 'notte')),\n    importo_indennita NUMERIC(8,2) CHECK (importo_indennita >= 0)\n);\n\nCREATE TABLE spedizioni (\n    id SERIAL PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    destinazione_id INT NOT NULL REFERENCES destinazioni(id),\n    magazzino_partenza_id INT NOT NULL REFERENCES magazzini(id),\n    corriere_id INT REFERENCES corrieri(id),\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    stato TEXT NOT NULL DEFAULT 'in_preparazione',\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_consegna_prevista DATE,\n    costo_trasporto NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (costo_trasporto >= 0)\n);\n\nCREATE TABLE colli (\n    id SERIAL PRIMARY KEY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    numero_progressivo INT NOT NULL,\n    peso_kg NUMERIC(6,2) NOT NULL CHECK (peso_kg > 0),\n    fragile BOOLEAN NOT NULL DEFAULT FALSE,\n    descrizione_contenuto TEXT,\n    UNIQUE (spedizione_id, numero_progressivo)\n);\n\nCREATE TABLE resi (\n    id SERIAL PRIMARY KEY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id),\n    motivo_reso TEXT NOT NULL,\n    data_registrazione DATE NOT NULL,\n    importo_rimborso NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (importo_rimborso >= 0),\n    stato_reso TEXT NOT NULL DEFAULT 'aperto'\n);\n\nCREATE TABLE fatture (\n    id SERIAL PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_fattura TEXT NOT NULL UNIQUE,\n    data_registrazione DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    pagata BOOLEAN NOT NULL DEFAULT FALSE\n);",
