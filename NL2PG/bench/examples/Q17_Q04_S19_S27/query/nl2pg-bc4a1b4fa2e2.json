  ],
  "query": "SELECT c.nome, c.cognome, c.citta, c.codice_fiscale, COUNT(*) AS numero_transazioni, ROUND(SUM(t.importo_totale), 2) AS totale_speso, RANK() OVER (ORDER BY SUM(t.importo_totale) DESC) AS posizione FROM clienti c JOIN transazioni t ON t.cliente_id = c.id WHERE c.citta = 'Milano' AND t.canale_vendita = 'online' GROUP BY c.nome, c.cognome, c.citta, c.codice_fiscale ORDER BY posizione ASC, totale_speso DESC, c.codice_fiscale ASC;"
}