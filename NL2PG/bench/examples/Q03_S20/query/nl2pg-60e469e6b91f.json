{
  "schema_ddl": "CREATE TYPE stato_ordine AS ENUM ('in_attesa', 'in_lavorazione', 'completato');\n\nCREATE TABLE ordini_produzione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_commessa TEXT NOT NULL UNIQUE,\n    descrizione_commessa TEXT,\n    reparto TEXT NOT NULL,\n    linea_produzione TEXT,\n    quantita_prevista INT NOT NULL CHECK (quantita_prevista > 0),\n    quantita_prodotta INT NOT NULL DEFAULT 0 CHECK (quantita_prodotta >= 0),\n    data_apertura_commessa DATE NOT NULL,\n    data_consegna_richiesta DATE,\n    stato_ordine stato_ordine NOT NULL DEFAULT 'in_attesa',\n    priorita INT NOT NULL DEFAULT 3 CHECK (priorita BETWEEN 1 AND 5)\n);\n\nALTER TABLE ordini_produzione\n    ADD CONSTRAINT chk_quantita_prodotta_valida\n    CHECK (quantita_prodotta <= quantita_prevista);",
