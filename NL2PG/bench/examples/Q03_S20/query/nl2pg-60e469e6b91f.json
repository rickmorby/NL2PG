  "query": "SELECT codice_commessa, descrizione_commessa, reparto, linea_produzione, quantita_prevista, quantita_prodotta, data_consegna_richiesta FROM ordini_produzione WHERE stato_ordine = 'in_lavorazione' AND priorita IN (1, 2) ORDER BY data_consegna_richiesta ASC, priorita ASC, ordini_produzione.id LIMIT 10"
