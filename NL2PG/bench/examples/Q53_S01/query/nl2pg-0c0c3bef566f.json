  "feature_sql": [
    "ordered_set_agg"
  ],
  "query": "SELECT e.docente, ROUND((PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY e.voto))::numeric, 2) AS voto_mediano, ROUND(AVG(e.voto), 2) AS voto_medio, COUNT(*) AS numero_esami, SUM(e.cfu) AS totale_cfu_erogato FROM esami e WHERE e.cfu IN (6, 9) GROUP BY e.docente ORDER BY voto_mediano DESC, numero_esami DESC;"
