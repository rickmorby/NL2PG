  "schema_ddl": "CREATE TABLE esami (\n    id_esame INT PRIMARY KEY,\n    matricola_studente TEXT NOT NULL,\n    corso TEXT NOT NULL,\n    voto NUMERIC(4,1) NOT NULL CHECK (voto >= 0 AND voto <= 30),\n    cfu INT NOT NULL CHECK (cfu > 0 AND cfu <= 30),\n    docente TEXT NOT NULL,\n    data_esame DATE NOT NULL,\n    UNIQUE (matricola_studente, corso, data_esame)\n);",
