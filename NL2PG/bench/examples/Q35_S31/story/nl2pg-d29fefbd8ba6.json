{
  "schema_ddl": "CREATE TABLE fornitori (\n    id INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT,\n    email TEXT\n);\n\nCREATE TABLE magazzini (\n    id INT PRIMARY KEY,\n    codice_magazzino TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    capacita_massima INT NOT NULL CHECK (capacita_massima > 0)\n);\n\nCREATE TABLE articoli_magazzino (\n    id INT PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    nome_categoria TEXT NOT NULL,\n    unita_misura TEXT NOT NULL DEFAULT 'PZ',\n    costo_unitario NUMERIC(10,2) NOT NULL CHECK (costo_unitario >= 0),\n    prezzo_vendita NUMERIC(10,2) NOT NULL CHECK (prezzo_vendita >= 0),\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    nome_fornitore TEXT,\n    giacenza_disponibile INT NOT NULL DEFAULT 0 CHECK (giacenza_disponibile >= 0),\n    valore_totale_giacenza NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (valore_totale_giacenza >= 0),\n    scorta_minima INT NOT NULL DEFAULT 0 CHECK (scorta_minima >= 0)\n);\n\nCREATE TABLE ordini_acquisto (\n    id INT PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    magazzino_id INT NOT NULL REFERENCES magazzini(id),\n    data_ordine DATE NOT NULL,\n    data_consegna_prevista DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'aperto' CHECK (stato_ordine IN ('aperto', 'confermato', 'evaso', 'annullato')),\n    totale_ordine NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (totale_ordine >= 0)\n);\n\nCREATE TABLE righe_ordine_acquisto (\n    ordine_id INT NOT NULL REFERENCES ordini_acquisto(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    articolo_id INT NOT NULL REFERENCES articoli_magazzino(id),\n    quantita_ordinata INT NOT NULL CHECK (quantita_ordinata > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    subtotale_riga NUMERIC(12,2) NOT NULL CHECK (subtotale_riga >= 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);\n\nCREATE TABLE movimenti_magazzino (\n    id INT PRIMARY KEY,\n    articolo_id INT NOT NULL REFERENCES articoli_magazzino(id),\n    magazzino_id INT NOT NULL REFERENCES magazzini(id),\n    data_movimento TIMESTAMP NOT NULL,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('carico', 'scarico', 'rettifica')),\n    quantita_mossa INT NOT NULL CHECK (quantita_mossa <> 0),\n    causale TEXT\n);",
