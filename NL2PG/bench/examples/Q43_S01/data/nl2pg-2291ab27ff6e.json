  "schema_ddl": "CREATE TABLE registrazioni_contabili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    descrizione TEXT,\n    importo_netto NUMERIC(15,2) NOT NULL CHECK (importo_netto >= 0),\n    importo_iva NUMERIC(15,2) NOT NULL CHECK (importo_iva >= 0),\n    importo_totale NUMERIC(15,2) GENERATED ALWAYS AS (importo_netto + importo_iva) STORED,\n    segno CHAR(1) NOT NULL CHECK (segno IN ('D', 'A')),\n    codice_conto TEXT NOT NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);",
