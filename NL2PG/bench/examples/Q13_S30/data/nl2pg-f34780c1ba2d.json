{
  "spec": {
    "domain": "erp",
    "n_tables": 9,
    "hierarchy": "many_to_many",
    "sql_features": [
      "exists"
    ],
    "twist": [
      "rename",
      "distractor",
      "synonym"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "ordini",
        "obsolete_value": "commesse",
        "description": "La tabella ordini viene denominata commesse nello schema ERP, ma rappresenta gli ordini di acquisto."
      },
      {
        "twist_type": "distractor",
        "target_value": "dettagli_ordini",
        "obsolete_value": "righe_commesse",
        "description": "La tabella dettagli_ordini è una distrazione: contiene dati irrilevanti per la query EXISTS, ma ha un nome simile a commesse."
      },
      {
        "twist_type": "synonym",
        "target_value": "fornitore_id",
        "obsolete_value": "partner_id",
        "description": "Il campo fornitore_id nella tabella ordini è sinonimo di partner_id, ma solo il primo è rilevante per il join con la tabella fornitori."
      }
    ],
    "spec_hash": "af90b774888e3b2a"
  },
  "schema_ddl": "CREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT CHECK (email ~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,4}$'),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    indirizzo TEXT,\n    citta TEXT,\n    cap TEXT CHECK (cap ~ '^[0-9]{5}$'),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE commesse (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_commessa TEXT NOT NULL UNIQUE,\n    data_ordine DATE NOT NULL,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    cliente_id INT REFERENCES clienti(id),\n    stato TEXT NOT NULL CHECK (stato IN ('aperta', 'confermata', 'chiusa', 'annullata')),\n    totale NUMERIC(12,2) CHECK (totale >= 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE dettagli_commesse (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    commessa_id INT NOT NULL REFERENCES commesse(id),\n    prodotto_id INT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(12,2) GENERATED ALWAYS AS (quantita * prezzo_unitario) STORED,\n    note TEXT\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    descrizione TEXT,\n    categoria TEXT NOT NULL,\n    prezzo_base NUMERIC(10,2) CHECK (prezzo_base >= 0),\n    fornitore_id INT REFERENCES fornitori(id),\n    attivo BOOLEAN DEFAULT TRUE\n);\n\nCREATE TABLE magazzino (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita_disponibile INT NOT NULL DEFAULT 0 CHECK (quantita_disponibile >= 0),\n    ubicazione TEXT,\n    data_aggiornamento TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_commesse (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    commessa_id INT NOT NULL,\n    codice_distrazione TEXT,\n    valore_distrazione NUMERIC(10,2),\n    note_distrazione TEXT,\n    FOREIGN KEY (commessa_id) REFERENCES commesse(id) ON DELETE CASCADE\n);\n\nCREATE TABLE pagamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    commessa_id INT NOT NULL REFERENCES commesse(id),\n    importo NUMERIC(12,2) NOT NULL CHECK (importo >= 0),\n    data_pagamento DATE NOT NULL,\n    metodo_pagamento TEXT NOT NULL CHECK (metodo_pagamento IN ('bonifico', 'contanti', 'carta', 'assegno')),\n    stato TEXT NOT NULL DEFAULT 'pendente' CHECK (stato IN ('pendente', 'completato', 'fallito')),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE documenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    commessa_id INT NOT NULL REFERENCES commesse(id),\n    tipo_documento TEXT NOT NULL CHECK (tipo_documento IN ('fattura', 'ddt', 'ordine', 'nota_credito')),\n    numero_documento TEXT NOT NULL,\n    data_emissione DATE NOT NULL,\n    path_file TEXT,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
