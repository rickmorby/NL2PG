  "query": "SELECT p.nome AS nome_paziente, p.cognome AS cognome_paziente, v.data_vis AS data_visita, v.diagnosi, pr.farmaco, pr.dosaggio FROM paz p JOIN vis v ON v.paz_id = p.id JOIN pre pr ON pr.vis_id = v.id WHERE v.esito = 'patologico' AND v.tipo_vis = 'urgenza' ORDER BY v.data_vis DESC, p.cognome;"
