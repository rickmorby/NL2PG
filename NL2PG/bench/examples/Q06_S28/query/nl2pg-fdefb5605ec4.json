{
  "schema_ddl": "CREATE TABLE paz (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    sesso CHAR(1) CHECK (sesso IN ('M', 'F'))\n);\n\nCREATE TABLE vis (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paz_id INT NOT NULL REFERENCES paz(id),\n    data_vis DATE NOT NULL,\n    tipo_vis TEXT NOT NULL,\n    esito TEXT,\n    diagnosi TEXT\n);\n\nCREATE TABLE pre (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    vis_id INT NOT NULL REFERENCES vis(id),\n    farmaco TEXT NOT NULL,\n    dosaggio TEXT NOT NULL,\n    durata_giorni INT NOT NULL CHECK (durata_giorni > 0)\n);",
