  "feature_sql": [
    "join",
    "left_outer_join"
  ],
  "query": "SELECT d.nome_dipartimento, e.nome, e.cognome, COALESCE(SUM(a.valore_mensile), 0) AS totale_valore_benefit FROM dipendenti e JOIN dipartimenti d ON e.dipartimento_id = d.id LEFT JOIN assegnazioni_accessorie_personale a ON e.id = a.dipendente_id GROUP BY d.nome_dipartimento, e.nome, e.cognome ORDER BY totale_valore_benefit DESC, e.cognome ASC, e.nome ASC;"
}