  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_assunzione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE assegnazioni_accessorie_personale (\n    id INT GENERATED BY DEFAULT AS IDENTITY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id) ON DELETE CASCADE,\n    nome_benefit TEXT NOT NULL,\n    valore_mensile NUMERIC(10, 2) NOT NULL CHECK (valore_mensile >= 0),\n    PRIMARY KEY (id, dipendente_id)\n);",
