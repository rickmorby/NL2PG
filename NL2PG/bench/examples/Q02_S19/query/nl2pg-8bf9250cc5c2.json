{
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    sede TEXT\n);\n\nCREATE TABLE corsi_di_laurea (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti(id),\n    durata_anni INT NOT NULL CHECK (durata_anni BETWEEN 1 AND 6),\n    livello TEXT NOT NULL CHECK (livello IN ('triennale', 'magistrale', 'ciclo_unico'))\n);\n\nCREATE TABLE studenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE,\n    corso_di_laurea_id INT NOT NULL REFERENCES corsi_di_laurea(id),\n    anno_iscrizione INT NOT NULL CHECK (anno_iscrizione >= 1900)\n);\n\nCREATE TABLE insegnamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu BETWEEN 1 AND 30),\n    corso_di_laurea_id INT NOT NULL REFERENCES corsi_di_laurea(id)\n);\n\nCREATE TABLE esami (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    studente_id INT NOT NULL REFERENCES studenti(id) ON DELETE CASCADE,\n    insegnamento_id INT NOT NULL REFERENCES insegnamenti(id) ON DELETE CASCADE,\n    voto INT NOT NULL CHECK (voto BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    data_appello DATE NOT NULL,\n    UNIQUE (studente_id, insegnamento_id, data_appello)\n);",
