  ],
  "query": "SELECT UPPER(nome) || ' ' || UPPER(cognome) AS nome_completo_maiuscolo, LOWER(email) AS email_normalizzata, INITCAP(nome_reparto) AS reparto, stipendio_mensile FROM dipendenti WHERE nome_reparto = 'Finanza' AND livello_inquadramento IN ('senior', 'lead') AND email IS NOT NULL ORDER BY stipendio_mensile DESC, cognome ASC;"
}