{
  "schema_ddl": "CREATE TABLE sedi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_sede TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    indirizzo TEXT\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE CHECK (char_length(codice_fiscale) = 16),\n    email TEXT,\n    data_assunzione DATE NOT NULL,\n    sede_id INT REFERENCES sedi(id),\n    nome_sede TEXT NOT NULL,\n    nome_reparto TEXT NOT NULL,\n    livello_inquadramento TEXT NOT NULL CHECK (livello_inquadramento IN ('junior', 'mid', 'senior', 'lead')),\n    stipendio_mensile NUMERIC(10,2) NOT NULL CHECK (stipendio_mensile >= 0),\n    totale_ore_formazione NUMERIC(7,2) NOT NULL DEFAULT 0 CHECK (totale_ore_formazione >= 0),\n    CONSTRAINT chk_nome_reparto_non_vuoto CHECK (TRIM(nome_reparto) <> '')\n);",
