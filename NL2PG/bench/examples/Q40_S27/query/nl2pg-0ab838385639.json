  "feature_sql": [
    "in_condition"
  ],
  "query": "SELECT d.nome, d.cognome, v.esito, COUNT(*) AS numero_valutazioni, ROUND(AVG(v.punteggio), 2) AS punteggio_medio FROM dipendenti d JOIN valutazioni v ON v.dipendente_id = d.id WHERE v.esito IN ('buono', 'ottimo') AND v.anno IN (2023, 2024) GROUP BY d.nome, d.cognome, v.esito ORDER BY punteggio_medio DESC, numero_valutazioni DESC;"
}