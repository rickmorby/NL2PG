  "query": "SELECT nome, cognome, stipendio_mensile, data_assunzione, 'retribuzione_alta' AS fascia_retributiva FROM dipendenti WHERE stipendio_mensile >= 3500 AND deleted_at IS NULL UNION ALL SELECT nome, cognome, stipendio_mensile, data_assunzione, 'retribuzione_standard' AS fascia_retributiva FROM dipendenti WHERE stipendio_mensile < 3500 AND deleted_at IS NULL ORDER BY stipendio_mensile DESC, cognome ASC, nome ASC;"
}