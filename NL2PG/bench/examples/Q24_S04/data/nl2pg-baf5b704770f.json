  "schema_ddl": "CREATE TYPE stato_contratto AS ENUM ('attivo', 'sospeso', 'terminato', 'annullato');\n\nCREATE TABLE contratti (\n    id_contratto INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_contratto TEXT NOT NULL UNIQUE,\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    stato stato_contratto NOT NULL DEFAULT 'attivo',\n    importo_mensile NUMERIC(10,2) CHECK (importo_mensile > 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_fine IS NULL OR data_fine > data_inizio)\n);\n\nCREATE TABLE dettagli_contratto (\n    id_dettaglio INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    id_contratto INT NOT NULL UNIQUE REFERENCES contratti(id_contratto) ON DELETE CASCADE,\n    descrizione_servizio TEXT NOT NULL,\n    condizioni_particolari TEXT,\n    data_attivazione_servizio DATE NOT NULL,\n    data_disattivazione_servizio DATE,\n    costo_attivazione NUMERIC(10,2) CHECK (costo_attivazione >= 0),\n    CHECK (data_disattivazione_servizio IS NULL OR data_disattivazione_servizio >= data_attivazione_servizio),\n    FOREIGN KEY (id_contratto) REFERENCES contratti(id_contratto)\n);",
