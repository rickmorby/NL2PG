  "query": "SELECT s.codice_isin, s.denominazione, s.emittente, s.mercato_quotazione, COUNT(*) AS numero_acquisti, SUM(t.quantita) AS quantita_totale, SUM(t.quantita * (t.prezzo_esecuzione).valore) AS controvalore_totale FROM transazioni t JOIN strumenti_finanziari s ON s.id = t.strumento_id WHERE t.tipo_operazione = 'acquisto' AND ROW((t.prezzo_esecuzione).valore, (t.prezzo_esecuzione).valuta) = ROW(178.95, 'EUR') GROUP BY s.codice_isin, s.denominazione, s.emittente, s.mercato_quotazione ORDER BY controvalore_totale DESC, s.codice_isin ASC;"
}