  "query": "SELECT DISTINCT ON (s.nome, s.cognome) s.nome, s.cognome, e.voto_esame, e.data_appello FROM studenti s JOIN esami e ON s.id = e.studente_id WHERE e.voto_esame IS NOT NULL AND (e.voto_esame BETWEEN 24 AND 30 OR e.data_appello >= DATE '2025-03-20' - INTERVAL '30 days') ORDER BY s.nome, s.cognome, e.data_appello DESC, e.id DESC;"
}