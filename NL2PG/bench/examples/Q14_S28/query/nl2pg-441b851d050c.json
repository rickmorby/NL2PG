  "query": "WITH dipendenti_it AS (\n    SELECT e.matricola, e.nome, e.id_reparto\n    FROM dipendenti e\n    JOIN reparti d ON e.id_reparto = d.id_reparto\n    WHERE d.nome_reparto = 'IT'\n),\nprogetti_it AS (\n    SELECT p.id_progetto, p.nome_progetto, p.matricola\n    FROM progetti p\n    JOIN dipendenti_it di ON p.matricola = di.matricola\n)\nSELECT nome AS dipendente, nome_progetto AS progetto\nFROM dipendenti_it di\nJOIN progetti_it pi ON di.matricola = pi.matricola\nUNION\nSELECT nome AS dipendente, NULL AS progetto\nFROM dipendenti_it di\nWHERE NOT EXISTS (\n    SELECT 1 FROM progetti_it pi WHERE pi.matricola = di.matricola\n)\nORDER BY dipendente, progetto;"
}