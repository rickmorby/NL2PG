  "schema_ddl": "CREATE TABLE dipendenti (\n    matricola INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    id_reparto INT,\n    responsabile_reparto INT REFERENCES dipendenti(matricola)\n);\n\nCREATE TABLE reparti (\n    id_reparto INT PRIMARY KEY,\n    nome_reparto TEXT NOT NULL,\n    sede TEXT\n);\n\nCREATE TABLE progetti (\n    id_progetto INT PRIMARY KEY,\n    nome_progetto TEXT NOT NULL,\n    matricola INT REFERENCES dipendenti(matricola)\n);",
