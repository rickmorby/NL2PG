  "feature_sql": [
    "offset_fetch"
  ],
  "query": "SELECT c.cli_nm AS nome_cliente, o.dt_ord AS data_ordine, o.ord_tot AS totale_ordine, o.ord_st AS stato_ordine FROM ord_hdr o JOIN cli_mst c ON c.cli_id = o.cli_id WHERE o.ord_st = 'CONF' ORDER BY o.ord_tot DESC, o.dt_ord ASC OFFSET 10 ROWS FETCH FIRST 5 ROWS ONLY;"
}