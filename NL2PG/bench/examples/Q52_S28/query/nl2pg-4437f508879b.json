{
  "schema_ddl": "CREATE TABLE cli_mst (\n    cli_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cli_nm TEXT NOT NULL,\n    vat_no TEXT NOT NULL UNIQUE,\n    citta_codice TEXT NOT NULL,\n    ins_dt DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE emp_mst (\n    emp_no INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    emp_nm TEXT NOT NULL,\n    codice_reparto TEXT NOT NULL,\n    hire_dt DATE NOT NULL,\n    active_fl BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE ord_hdr (\n    ord_no BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cli_id INT NOT NULL REFERENCES cli_mst(cli_id),\n    emp_no INT NOT NULL REFERENCES emp_mst(emp_no),\n    dt_ord DATE NOT NULL,\n    ord_tot NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (ord_tot >= 0),\n    ord_st TEXT NOT NULL CHECK (ord_st IN ('OPEN', 'CONF', 'SHIPD', 'CLOS', 'CANC'))\n);\n\nCREATE TABLE dettagli_ordini (\n    ord_no BIGINT NOT NULL REFERENCES ord_hdr(ord_no) ON DELETE CASCADE,\n    ln_no INT NOT NULL,\n    codice_prodotto TEXT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    unit_pr NUMERIC(10,2) NOT NULL CHECK (unit_pr >= 0),\n    ln_amt NUMERIC(12,2) GENERATED ALWAYS AS (quantita * unit_pr) STORED,\n    PRIMARY KEY (ord_no, ln_no)\n);",
