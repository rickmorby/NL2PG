  "schema_ddl": "CREATE TABLE studenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    matricola TEXT NOT NULL UNIQUE,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE,\n    citta_residenza TEXT,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE tesi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    studente_id INT NOT NULL UNIQUE REFERENCES studenti(id) ON DELETE CASCADE,\n    titolo TEXT NOT NULL,\n    relatore TEXT NOT NULL,\n    correlatore TEXT,\n    voto_finale INT CHECK (voto_finale >= 18 AND voto_finale <= 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    data_discussione DATE\n);",
