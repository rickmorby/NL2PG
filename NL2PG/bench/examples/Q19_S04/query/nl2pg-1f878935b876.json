  "feature_sql": [
    "full_outer_join"
  ],
  "query": "SELECT s.nome, s.cognome, s.matricola, s.citta_residenza, COALESCE(t.titolo, 'Nessuna tesi registrata') AS titolo_tesi, t.voto_finale AS voto_tesi, CASE WHEN t.data_discussione IS NOT NULL THEN 'Discussa' ELSE 'Da discutere' END AS stato_tesi, CASE WHEN t.lode IS TRUE THEN 'Con lode' ELSE 'Senza lode' END AS menzione_lode FROM studenti s FULL OUTER JOIN tesi t ON s.id = t.studente_id WHERE s.citta_residenza IN ('Milano', 'Bologna') OR s.id IS NULL ORDER BY stato_tesi ASC, voto_tesi DESC NULLS LAST, s.matricola ASC;"
}