        "twist_type": "jargon",
        "target_value": "valutazione_performance",
        "obsolete_value": "score_review",
        "description": "Il campo che registra il punteggio della valutazione periodica è noto in gergo HR come score_review, mentre nel database la colonna si chiama valutazione_performance."
      }
