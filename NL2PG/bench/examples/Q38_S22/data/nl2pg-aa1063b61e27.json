      },
      {
        "twist_type": "polysemy",
        "target_value": "sinistro",
        "obsolete_value": "evento",
        "description": "La parola 'sinistro' (incidente coperto dalla polizza) può essere ambigua e confusa con 'evento' in contesti generici."
      }
