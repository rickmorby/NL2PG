  "feature_sql": [
    "cte",
    "recursive_cte"
  ],
  "query": "WITH RECURSIVE gerarchia_agenzie AS ( SELECT id, nome_agenzia, agenzia_madre_id, data_apertura, 1 AS livello FROM agenzie_immobiliari WHERE agenzia_madre_id IS NULL UNION ALL SELECT a.id, a.nome_agenzia, a.agenzia_madre_id, a.data_apertura, g.livello + 1 FROM agenzie_immobiliari a JOIN gerarchia_agenzie g ON a.agenzia_madre_id = g.id ), conteggio_agenti AS ( SELECT agenzia_id, COUNT(*) AS numero_agenti FROM agenti_immobiliari GROUP BY agenzia_id ) SELECT g.nome_agenzia AS nome_filiale, g.livello AS profondita_gerarchica, g.data_apertura AS data_fondazione, COALESCE(c.numero_agenti, 0) AS numero_agenti_attivi FROM gerarchia_agenzie g LEFT JOIN conteggio_agenti c ON g.id = c.agenzia_id ORDER BY profondita_gerarchica ASC, nome_filiale ASC, g.id ASC;"
}