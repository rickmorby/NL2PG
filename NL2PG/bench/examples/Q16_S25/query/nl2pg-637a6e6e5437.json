  "schema_ddl": "CREATE TABLE agenzie_immobiliari (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_agenzia TEXT NOT NULL, agenzia_madre_id INT REFERENCES agenzie_immobiliari(id), data_apertura DATE DEFAULT CURRENT_DATE, CHECK (id <> agenzia_madre_id));\n\nCREATE TABLE agenti_immobiliari (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, agenzia_id INT NOT NULL REFERENCES agenzie_immobiliari(id) ON DELETE CASCADE, supervisore_id INT REFERENCES agenti_immobiliari(id), email TEXT UNIQUE NOT NULL, CHECK (id <> supervisore_id));",
