  "schema_ddl": "CREATE TABLE tempo_dimensione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_giorno DATE NOT NULL UNIQUE,\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    anno INT NOT NULL CHECK (anno >= 2000),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4)\n);\n\nCREATE TABLE dipartimenti_dimensione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL,\n    sede TEXT NOT NULL\n);\n\nCREATE TABLE forza_lavoro_attiva (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    emolumento_base_retributivo NUMERIC(10,2) NOT NULL CHECK (emolumento_base_retributivo >= 0),\n    dipartimento_id INT NOT NULL REFERENCES dipartimenti_dimensione(id),\n    data_assunzione DATE NOT NULL\n);\n\nCREATE TABLE eventi_presenza_fatti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES forza_lavoro_attiva(id),\n    tempo_id INT NOT NULL REFERENCES tempo_dimensione(id),\n    ore_lavorate NUMERIC(4,2) NOT NULL CHECK (ore_lavorate >= 0 AND ore_lavorate <= 24),\n    presente BOOLEAN NOT NULL,\n    straordinario BOOLEAN NOT NULL\n);",
