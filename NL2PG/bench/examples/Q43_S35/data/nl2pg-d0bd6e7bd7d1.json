    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "ordini",
        "obsolete_value": "registro_vendite",
        "description": "La tabella logica ordini, implementata come tabella unica partizionata dichiarativamente (RANGE sulla data_ordine, con partizioni LIST e HASH di supporto), viene denominata registro_vendite nella prosa aziendale. Il risolutore deve capire che tutte le richieste di ordinamento si riferiscono a questa singola tabella logica, indipendentemente dalle partizioni fisiche in cui le righe sono distribuite."
      },
      {
        "twist_type": "synonym",
        "target_value": "totale_ordine",
        "obsolete_value": "importo_complessivo",
        "description": "La colonna totale_ordine della tabella ordini è indicata nella documentazione aziendale come importo_complessivo. Le clausole ORDER BY multi-colonna richieste dal task (es. ordinamento per stato e poi per importo decrescente, senza LIMIT) devono utilizzare il nome reale della colonna presente nello schema fisico."
      }
    ],
    "spec_hash": "63d4a3cdf2fb020f"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    citta TEXT,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL CHECK (stato_ordine IN ('in_attesa', 'pagato', 'spedito', 'consegnato', 'annullato')),\n    totale_ordine NUMERIC(12,2) NOT NULL CHECK (totale_ordine >= 0),\n    PRIMARY KEY (id, data_ordine)\n) PARTITION BY RANGE (data_ordine);\n\nCREATE TABLE ordini_storico PARTITION OF ordini\n    FOR VALUES FROM ('1900-01-01') TO ('2100-01-01');",
