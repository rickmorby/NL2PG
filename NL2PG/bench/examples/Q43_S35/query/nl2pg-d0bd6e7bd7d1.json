  "feature_sql": [
    "sorting"
  ],
  "query": "SELECT c.nome,\n       c.cognome,\n       c.citta,\n       COUNT(o.id) AS numero_ordini_consegnati,\n       ROUND(SUM(o.totale_ordine), 2) AS totale_speso,\n       CASE WHEN SUM(o.totale_ordine) >= 500 THEN 'alto valore' ELSE 'standard' END AS segmento_spesa\nFROM clienti c\nJOIN ordini o ON o.cliente_id = c.id\nWHERE o.stato_ordine = 'consegnato'\nGROUP BY c.id, c.nome, c.cognome, c.citta\nORDER BY c.citta ASC, totale_speso DESC, c.id ASC;"
}