  ],
  "query": "SELECT DISTINCT ON (cl.citta) cl.citta AS citta_cliente, cl.ragione_sociale AS cliente_della_spedizione, sp.data_spedizione AS data_ultima_spedizione, sp.peso_totale_kg AS peso_spedizione_kg, sp.indirizzo_destinazione AS indirizzo_destinazione FROM spedizioni AS sp JOIN clienti AS cl ON sp.cliente_id = cl.id WHERE sp.stato = 'consegnata' AND sp.corriere_id IS NOT NULL ORDER BY cl.citta, sp.data_spedizione DESC, sp.id"
