  "query": "SELECT p.nome AS nome_prodotto, p.categoria, SUM(r.importo_riga) AS ricavo_totale, COUNT(DISTINCT r.ordine_id) AS numero_ordini FROM prodotti p JOIN righe_ordine r ON p.id = r.prodotto_id JOIN ordini o ON o.id = r.ordine_id WHERE o.stato_ordine IN ('confermato', 'consegnato', 'spedito') GROUP BY p.nome, p.categoria ORDER BY ricavo_totale DESC LIMIT 10;"
}