{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono TEXT,\n    citta TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sku TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    unita_misura TEXT NOT NULL DEFAULT 'PZ',\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE prezzi_storico (\n    prodotto_id INT NOT NULL REFERENCES prodotti(id) ON DELETE CASCADE,\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    PRIMARY KEY (prodotto_id, valid_from),\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    totale_ordine NUMERIC(12,2) CHECK (totale_ordine >= 0),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_applicato NUMERIC(10,2) NOT NULL CHECK (prezzo_applicato >= 0),\n    sconto_riga NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_riga BETWEEN 0 AND 100),\n    importo_riga NUMERIC(12,2) NOT NULL CHECK (importo_riga >= 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
