{
  "schema_ddl": "CREATE TABLE mezzi_di_trasporto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    targa TEXT NOT NULL UNIQUE,\n    tipo_mezzo TEXT NOT NULL CHECK (tipo_mezzo IN ('autocarro', 'furgone', 'autovettura', 'motociclo')),\n    modello TEXT NOT NULL,\n    anno_immatricolazione INT CHECK (anno_immatricolazione BETWEEN 1990 AND EXTRACT(YEAR FROM CURRENT_DATE)),\n    capacita_carico_kg NUMERIC(10,2) CHECK (capacita_carico_kg > 0),\n    mezzo_superiore_id INT REFERENCES mezzi_di_trasporto(id) ON DELETE SET NULL,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);",
