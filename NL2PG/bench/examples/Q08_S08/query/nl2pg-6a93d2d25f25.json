    "self_join"
  ],
  "query": "SELECT m.targa AS targa_mezzo, m.modello AS modello_mezzo, m.capacita_carico_kg AS capacita_carico_kg, p.targa AS targa_mezzo_superiore, p.modello AS modello_mezzo_superiore, p.tipo_mezzo AS tipo_mezzo_superiore FROM mezzi_di_trasporto m JOIN mezzi_di_trasporto p ON m.mezzo_superiore_id = p.id WHERE m.tipo_mezzo = 'furgone' AND p.tipo_mezzo = 'autocarro' ORDER BY m.capacita_carico_kg DESC LIMIT 20;"
}