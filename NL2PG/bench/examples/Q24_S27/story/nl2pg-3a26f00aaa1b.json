{
  "schema_ddl": "CREATE TABLE ospedali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    indirizzo TEXT,\n    numero_letti INT CHECK (numero_letti >= 0)\n);\n\nCREATE TABLE reparti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ospedale_id INT NOT NULL REFERENCES ospedali(id),\n    nome TEXT NOT NULL,\n    piano INT CHECK (piano >= 0)\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    numero_albo TEXT UNIQUE\n);\n\nCREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    telefono TEXT\n);\n\nCREATE TABLE visite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_id INT REFERENCES medici(id),\n    reparto_id INT REFERENCES reparti(id),\n    data_visita DATE NOT NULL,\n    ora_visita TIME NOT NULL,\n    tipo_visita TEXT NOT NULL,\n    diagnosi TEXT,\n    costo_visita NUMERIC(8,2) CHECK (costo_visita >= 0)\n);",
