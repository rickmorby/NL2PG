{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT CHECK (email ~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,4}$'),\n    data_nascita DATE CHECK (data_nascita <= CURRENT_DATE)\n);\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_polizza TEXT NOT NULL UNIQUE,\n    tipo_copertura TEXT NOT NULL,\n    premio_annuo NUMERIC(10, 2) NOT NULL CHECK (premio_annuo > 0),\n    data_stipula DATE NOT NULL CHECK (data_stipula <= CURRENT_DATE),\n    data_scadenza DATE NOT NULL CHECK (data_scadenza > data_stipula),\n    stato TEXT NOT NULL DEFAULT 'attiva' CHECK (stato IN ('attiva', 'sospesa', 'scaduta', 'annullata'))\n);",
