  "query": "WITH clienti_attivi AS (\n    SELECT c.id, c.nome, c.cognome, c.email\n    FROM clienti c\n    WHERE c.id IN (SELECT DISTINCT cliente_id FROM polizze WHERE stato = 'attiva')\n),\npolizze_per_cliente AS (\n    SELECT \n        cliente_id,\n        COUNT(*) AS numero_polizze,\n        SUM(premio_annuo) AS premio_totale,\n        STRING_AGG(tipo_copertura, ', ' ORDER BY tipo_copertura) AS coperture\n    FROM polizze\n    WHERE stato IN ('attiva', 'sospesa')\n    GROUP BY cliente_id\n)\nSELECT \n    ca.nome || ' ' || ca.cognome AS cliente,\n    ca.email,\n    ppc.numero_polizze,\n    ppc.premio_totale,\n    ppc.coperture,\n    CASE \n        WHEN ppc.premio_totale > 1000 THEN 'Premium'\n        WHEN ppc.premio_totale BETWEEN 500 AND 1000 THEN 'Standard'\n        ELSE 'Base'\n    END AS fascia_premio\nFROM clienti_attivi ca\nJOIN polizze_per_cliente ppc ON ca.id = ppc.cliente_id\nUNION\nSELECT \n    'NESSUN CLIENTE' AS cliente,\n    NULL AS email,\n    0 AS numero_polizze,\n    0 AS premio_totale,\n    'Nessuna copertura' AS coperture,\n    'Senza polizze' AS fascia_premio\nFROM (SELECT 1 AS dummy) d\nWHERE NOT EXISTS (SELECT 1 FROM polizze WHERE stato IN ('attiva', 'sospesa'))\nORDER BY premio_totale DESC, cliente;"
}