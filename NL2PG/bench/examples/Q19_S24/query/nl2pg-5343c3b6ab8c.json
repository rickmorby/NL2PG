  "feature_sql": [
    "full_outer_join"
  ],
  "query": "WITH agenzie_target AS (\n    SELECT id_agenzia, nome_rete, citta_sede, email_ufficio\n    FROM agenzie\n    WHERE citta_sede IN ('Milano', 'Torino', 'Bologna')\n       OR nome_rete LIKE '%Immobiliare%'\n),\nportafoglio_disponibile AS (\n    SELECT agenzia_id,\n           COUNT(*) AS numero_immobili,\n           ROUND(AVG(prezzo_richiesto), 2) AS prezzo_medio_richiesto,\n           SUM(superficie_mq) AS superficie_complessiva_mq\n    FROM immobili\n    WHERE stato_vendita = 'disponibile'\n      AND prezzo_richiesto BETWEEN 100000 AND 500000\n    GROUP BY agenzia_id\n)\nSELECT COALESCE(a.nome_rete, 'Agenzia non registrata') AS rete_commerciale,\n       COALESCE(a.citta_sede, 'Non specificata') AS citta_riferimento,\n       COALESCE(p.numero_immobili, 0) AS immobili_disponibili,\n       COALESCE(p.prezzo_medio_richiesto, 0) AS prezzo_medio_richiesto,\n       COALESCE(p.superficie_complessiva_mq, 0) AS superficie_complessiva_mq,\n       CASE\n           WHEN a.id_agenzia IS NULL THEN 'immobili privi di agenzia'\n           WHEN p.agenzia_id IS NULL THEN 'agenzia senza disponibilita'\n           ELSE 'portafoglio attivo'\n       END AS stato_portafoglio\nFROM agenzie_target a\nFULL OUTER JOIN portafoglio_disponibile p\n    ON a.id_agenzia = p.agenzia_id\nORDER BY immobili_disponibili DESC, a.email_ufficio ASC NULLS LAST, p.agenzia_id ASC NULLS LAST;"
}