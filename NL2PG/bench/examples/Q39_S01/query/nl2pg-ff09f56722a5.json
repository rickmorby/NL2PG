  "query": "SELECT tipo_movimento, conto_contabile, COUNT(*) AS numero_movimenti, SUM(importo) AS totale_importo, ROUND(AVG(importo), 2) AS importo_medio FROM movimenti WHERE importo BETWEEN 1000 AND 10000 AND tipo_movimento = 'entrata' GROUP BY tipo_movimento, conto_contabile ORDER BY totale_importo DESC, conto_contabile;"
