  "schema_ddl": "CREATE TABLE movimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_protocollo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    conto_contabile TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo BETWEEN 0 AND 9999999999.99),\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('entrata', 'uscita')),\n    data_registrazione DATE NOT NULL,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
