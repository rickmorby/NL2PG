  "schema_ddl": "CREATE TABLE conti_finanziari (\n    id_conto INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    nome_conto TEXT NOT NULL,\n    saldo_iniziale NUMERIC(15,2) NOT NULL CHECK (saldo_iniziale >= 0),\n    data_apertura DATE NOT NULL,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE categorie_movimenti (\n    id_categoria INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    nome_categoria TEXT NOT NULL,\n    descrizione TEXT,\n    parent_id INT REFERENCES categorie_movimenti(id_categoria) ON DELETE CASCADE,\n    CHECK (id_categoria != parent_id)\n);\n\nCREATE TABLE movimenti_finanziari (\n    id_movimento INT GENERATED BY DEFAULT AS IDENTITY NOT NULL,\n    id_conto INT NOT NULL REFERENCES conti_finanziari(id_conto) ON DELETE CASCADE,\n    id_categoria INT REFERENCES categorie_movimenti(id_categoria) ON DELETE SET NULL,\n    importo NUMERIC(15,2) NOT NULL CHECK (importo != 0),\n    data_movimento TIMESTAMP NOT NULL,\n    descrizione TEXT,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    importo_assoluto NUMERIC(15,2) GENERATED ALWAYS AS (ABS(importo)) STORED,\n    PRIMARY KEY (id_conto, id_movimento),\n    UNIQUE (id_movimento)\n);",
