  "schema_ddl": "CREATE TABLE immobili (\n    id_immobile INT PRIMARY KEY,\n    tipo TEXT NOT NULL,\n    quartiere TEXT NOT NULL,\n    indirizzo TEXT,\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani BETWEEN 1 AND 30),\n    prezzo NUMERIC(12,2) NOT NULL CHECK (prezzo >= 0),\n    disponibile BOOLEAN NOT NULL DEFAULT TRUE\n);",
