  "query": "SELECT tipo, quartiere, indirizzo, superficie_mq, numero_vani, ROUND(prezzo / 1000000, 2) AS prezzo_milioni FROM immobili WHERE disponibile IS TRUE AND tipo IN ('attico', 'loft') AND quartiere IN ('Brera', 'Navigli', 'Isola') ORDER BY prezzo DESC, id_immobile ASC LIMIT 10;"
