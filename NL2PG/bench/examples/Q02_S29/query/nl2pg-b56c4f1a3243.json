  "feature_sql": [
    "scalar_agg"
  ],
  "query": "SELECT ROUND(AVG(r.stipendio_base + r.bonus_annuo), 2) AS retribuzione_media_annua, COUNT(*) AS numero_dipendenti, MIN(r.stipendio_base) AS stipendio_minimo, MAX(r.stipendio_base) AS stipendio_massimo FROM dipendenti d JOIN retribuzioni r ON d.id = r.dipendente_id WHERE d.data_assunzione >= DATE '2018-01-01' AND r.valuta = 'EUR';"
