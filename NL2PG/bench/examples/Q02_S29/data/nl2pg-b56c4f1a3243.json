    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "dipendenti",
        "obsolete_value": "anagrafica_personale",
        "description": "La tabella fisica dipendenti viene denominata anagrafica_personale nella prosa aziendale. I dati anagrafici dell'entità logica dipendente sono suddivisi in più colonne fisiche (nome e cognome separati) e la tabella complementare retribuzioni completa il profilo tramite relazione uno-a-uno."
      },
      {
        "twist_type": "jargon",
        "target_value": "stipendio_base",
        "obsolete_value": "RAL",
        "description": "La colonna stipendio_base della tabella retribuzioni viene indicata nella documentazione aziendale con il gergo HR 'RAL' (Retribuzione Annua Lorda). Le query di aggregazione scalare (es. AVG o MAX sulla retribuzione complessiva) devono combinare stipendio_base e bonus_annuo, colonne fisiche separate che insieme compongono il valore logico unitario."
      }
    ],
    "spec_hash": "c276df67b989cb8a"
  },
  "schema_ddl": "DROP TABLE IF EXISTS retribuzioni;\nDROP TABLE IF EXISTS dipendenti;\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL,\n    email_aziendale TEXT UNIQUE\n);\n\nCREATE TABLE retribuzioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL UNIQUE REFERENCES dipendenti(id) ON DELETE CASCADE,\n    stipendio_base NUMERIC(10,2) NOT NULL CHECK (stipendio_base >= 0),\n    bonus_annuo NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (bonus_annuo >= 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR',\n    data_decorrenza DATE NOT NULL,\n    CHECK (stipendio_base + bonus_annuo > 0)\n);",
