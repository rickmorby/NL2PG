  "schema_ddl": "CREATE TABLE conti_contabili (\n    conto_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    saldo_iniziale NUMERIC(15, 2) NOT NULL CHECK (saldo_iniziale >= 0),\n    conto_padre_id INT REFERENCES conti_contabili(conto_id),\n    CONSTRAINT fk_conto_padre CHECK (conto_id <> conto_padre_id)\n);\n\nCREATE TABLE registrazioni_contabili (\n    registrazione_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti_contabili(conto_id),\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    importo NUMERIC(15, 2) NOT NULL CHECK (importo <> 0),\n    descrizione TEXT,\n    segno CHAR(1) NOT NULL CHECK (segno IN ('D', 'A')),\n    CONSTRAINT chk_importo_segno CHECK (\n        (segno = 'D' AND importo > 0) OR \n        (segno = 'A' AND importo < 0)\n    )\n);",
