  "schema_ddl": "CREATE TABLE categorie_prodotti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    descrizione TEXT,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE fornitori (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT,\n    email TEXT,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE prodotti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    categoria_id BIGINT REFERENCES categorie_prodotti(id),\n    fornitore_id BIGINT REFERENCES fornitori(id),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    costo_acquisto NUMERIC(10,2) CHECK (costo_acquisto >= 0),\n    giacenza INT NOT NULL DEFAULT 0 CHECK (giacenza >= 0),\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE clienti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    citta TEXT,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE ordini_vendita (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL CHECK (stato_ordine IN ('bozza', 'confermato', 'spedito', 'fatturato', 'annullato')),\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE righe_ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id BIGINT NOT NULL REFERENCES ordini_vendita(id) ON DELETE CASCADE,\n    prodotto_id BIGINT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    deleted_at TIMESTAMP\n);",
