  "feature_sql": [
    "like"
  ],
  "query": "SELECT c.rag_soc, c.citta_cli, SUM(o.qta_ord) AS quantita_totale, ROUND(SUM(o.qta_ord * o.prz_unit), 2) AS valore_totale_ordini, RANK() OVER (ORDER BY SUM(o.qta_ord * o.prz_unit) DESC) AS posizione FROM clt_mstr c JOIN dettagli_ordini o ON c.cod_cli = o.cod_cli WHERE c.citta_cli = 'Roma' AND o.art_desc LIKE 'CAFFE%' GROUP BY c.rag_soc, c.citta_cli ORDER BY posizione, valore_totale_ordini DESC LIMIT 10;"
}