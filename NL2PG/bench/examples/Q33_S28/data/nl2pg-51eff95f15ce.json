  "schema_ddl": "CREATE TABLE clt_mstr (\n    cod_cli TEXT PRIMARY KEY,\n    rag_soc TEXT NOT NULL,\n    ind_cli TEXT,\n    cap_cli TEXT,\n    citta_cli TEXT NOT NULL\n);\n\nCREATE TABLE dettagli_ordini (\n    ord_no INT NOT NULL,\n    riga_no INT NOT NULL,\n    cod_cli TEXT NOT NULL REFERENCES clt_mstr(cod_cli),\n    art_desc TEXT NOT NULL,\n    qta_ord INT NOT NULL CHECK (qta_ord > 0),\n    prz_unit NUMERIC(10,2) NOT NULL CHECK (prz_unit >= 0),\n    PRIMARY KEY (ord_no, riga_no)\n);",
