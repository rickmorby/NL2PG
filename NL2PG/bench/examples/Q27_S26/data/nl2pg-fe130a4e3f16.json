  "schema_ddl": "CREATE TABLE negozi (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    telefono TEXT\n);\n\nCREATE TABLE transazioni (\n    id INT PRIMARY KEY,\n    negozio_id INT NOT NULL REFERENCES negozi(id),\n    data_transazione TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL,\n    regione TEXT NOT NULL,\n    canale TEXT NOT NULL,\n    CHECK (data_transazione ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\n    CHECK (canale IN ('online', 'store', 'rivenditori'))\n);",
