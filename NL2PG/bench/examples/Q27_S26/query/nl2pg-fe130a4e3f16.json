  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT COALESCE(t.regione, 'TOTALE COMPLESSIVO') AS regione, COALESCE(t.canale, 'TUTTI I CANALI') AS canale, CASE WHEN GROUPING(t.regione) = 0 AND GROUPING(t.canale) = 0 THEN 'dettaglio regione e canale' WHEN GROUPING(t.regione) = 0 AND GROUPING(t.canale) = 1 THEN 'subtotale regione' ELSE 'totale generale' END AS tipo_riga, COUNT(*) AS numero_transazioni, ROUND(SUM(t.importo::numeric), 2) AS fatturato_totale, ROUND(AVG(t.importo::numeric), 2) AS scontrino_medio FROM transazioni t WHERE t.data_transazione BETWEEN '2026-01-19' AND '2026-03-08' AND t.regione IN ('Lombardia', 'Lazio', 'Emilia-Romagna', 'Campania') GROUP BY GROUPING SETS ((t.regione, t.canale), (t.regione), ()) ORDER BY fatturato_totale DESC;"
}