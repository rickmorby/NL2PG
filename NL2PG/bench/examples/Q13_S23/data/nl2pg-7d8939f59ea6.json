    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "eventi_rete",
        "obsolete_value": "registro_anomalie",
        "description": "La tabella eventi_rete, che contiene gli eventi di rete con tre FK opzionali mutuamente esclusive (verso contratti, clienti e impianti) vincolate da un CHECK che impone una sola FK popolata per riga, viene denominata registro_anomalie nella prosa aziendale."
      },
      {
        "twist_type": "jargon",
        "target_value": "impianti",
        "obsolete_value": "siti_ricetrasmittenti",
        "description": "La tabella impianti, che rappresenta le stazioni radio di rete referenziate da una delle FK esclusive della tabella eventi_rete, è indicata nella documentazione tecnica con il gergo del settore come siti_ricetrasmittenti."
      }
    ],
    "spec_hash": "488a56b9b16a3c8e"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    numero_telefono TEXT,\n    citta_residenza TEXT,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_contratto TEXT NOT NULL UNIQUE,\n    tipologia_offerta TEXT NOT NULL CHECK (tipologia_offerta IN ('voce_mobile', 'dati_mobile', 'fibra', 'aziendale')),\n    stato_contratto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato')),\n    data_attivazione DATE NOT NULL,\n    data_scadenza DATE,\n    CHECK (data_scadenza IS NULL OR data_scadenza > data_attivazione)\n);\n\nCREATE TABLE impianti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_impianto TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    comune TEXT NOT NULL,\n    provincia CHAR(2),\n    quota_altitudine_m INT CHECK (quota_altitudine_m >= 0),\n    potenza_trasmessa_watt NUMERIC(8,2) CHECK (potenza_trasmessa_watt > 0),\n    operativo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE eventi_rete (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT REFERENCES contratti(id),\n    cliente_id INT REFERENCES clienti(id),\n    impianto_id INT REFERENCES impianti(id),\n    severita TEXT NOT NULL CHECK (severita IN ('informativo', 'minore', 'maggiore', 'critico')),\n    codice_anomalia TEXT NOT NULL,\n    descrizione_evento TEXT NOT NULL,\n    rilevato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK ((contratto_id IS NOT NULL)::INT + (cliente_id IS NOT NULL)::INT + (impianto_id IS NOT NULL)::INT = 1)\n);",
