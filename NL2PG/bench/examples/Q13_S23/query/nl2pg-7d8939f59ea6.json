  "query": "SELECT cl.nome, cl.cognome, ct.numero_contratto, ct.tipologia_offerta FROM clienti cl JOIN contratti ct ON ct.cliente_id = cl.id WHERE ct.stato_contratto = 'attivo' AND EXISTS (SELECT 1 FROM eventi_rete er WHERE er.contratto_id = ct.id AND er.severita = 'critico') ORDER BY cl.cognome ASC, cl.nome ASC, ct.numero_contratto ASC;"
}