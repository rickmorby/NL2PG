{
  "schema_ddl": "CREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    nome_categoria TEXT NOT NULL,\n    reparto_nome TEXT NOT NULL,\n    sede_nome TEXT NOT NULL,\n    qualifica_nome TEXT NOT NULL,\n    data_assunzione DATE NOT NULL,\n    stipendio_annuo NUMERIC(10,2) NOT NULL CHECK (stipendio_annuo BETWEEN 0 AND 10000000),\n    eta SMALLINT CHECK (eta BETWEEN 18 AND 100),\n    n_progetti_assegnati INT NOT NULL DEFAULT 0 CHECK (n_progetti_assegnati >= 0),\n    totale_ferie_giorni INT NOT NULL DEFAULT 0 CHECK (totale_ferie_giorni >= 0),\n    ultimo_stipendio_importo NUMERIC(10,2) CHECK (ultimo_stipendio_importo >= 0),\n    data_ultimo_stipendio DATE\n);\n\nCREATE TABLE riepiloghi_categoria (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    n_dipendenti INT NOT NULL DEFAULT 0 CHECK (n_dipendenti >= 0),\n    monte_stipendi_annuo NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (monte_stipendi_annuo >= 0),\n    stipendio_medio_annuo NUMERIC(10,2) CHECK (stipendio_medio_annuo >= 0)\n);\n\nCREATE TABLE riepiloghi_reparto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    reparto_nome TEXT NOT NULL UNIQUE,\n    n_dipendenti INT NOT NULL DEFAULT 0 CHECK (n_dipendenti >= 0),\n    costo_annuo_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (costo_annuo_totale >= 0),\n    stipendio_medio_annuo NUMERIC(10,2) CHECK (stipendio_medio_annuo >= 0)\n);\n\nCREATE TABLE riepiloghi_sede (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sede_nome TEXT NOT NULL UNIQUE,\n    n_dipendenti INT NOT NULL DEFAULT 0 CHECK (n_dipendenti >= 0),\n    monte_stipendi_annuo NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (monte_stipendi_annuo >= 0),\n    costo_medio_mensile NUMERIC(10,2) CHECK (costo_medio_mensile >= 0)\n);\n\nCREATE TABLE riepiloghi_qualifica (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    qualifica_nome TEXT NOT NULL UNIQUE,\n    n_dipendenti INT NOT NULL DEFAULT 0 CHECK (n_dipendenti >= 0),\n    stipendio_minimo_annuo NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (stipendio_minimo_annuo >= 0),\n    stipendio_massimo_annuo NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (stipendio_massimo_annuo >= 0),\n    CHECK (stipendio_massimo_annuo >= stipendio_minimo_annuo)\n);",
