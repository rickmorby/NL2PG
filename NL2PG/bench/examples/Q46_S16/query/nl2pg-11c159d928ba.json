{
  "schema_ddl": "CREATE TABLE facolta (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, valid_from DATE NOT NULL DEFAULT CURRENT_DATE, valid_to DATE);\n\nCREATE TABLE matricole (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, cognome TEXT NOT NULL, facolta_id INT REFERENCES facolta(id), valid_from DATE NOT NULL DEFAULT CURRENT_DATE, valid_to DATE);\n\nCREATE TABLE corsi (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, titolo TEXT NOT NULL, crediti INT CHECK (crediti > 0), valid_from DATE NOT NULL DEFAULT CURRENT_DATE, valid_to DATE);\n\nCREATE TABLE iscrizioni (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, matricola_id INT NOT NULL REFERENCES matricole(id), corso_id INT NOT NULL REFERENCES corsi(id), valid_from DATE NOT NULL DEFAULT CURRENT_DATE, valid_to DATE);\n\nCREATE TABLE registro_variazioni (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, entita_riferimento TEXT NOT NULL, descrizione_modifica TEXT NOT NULL, data_modifica TIMESTAMP DEFAULT CURRENT_TIMESTAMP, valid_from DATE NOT NULL DEFAULT CURRENT_DATE, valid_to DATE);",
