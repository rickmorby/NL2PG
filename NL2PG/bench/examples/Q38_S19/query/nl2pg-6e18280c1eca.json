  "query": "SELECT c.ragione_sociale, c.citta, COUNT(*) AS spedizioni_consegnate, ROUND(SUM(s.peso_totale_kg), 2) AS peso_totale_kg FROM clienti c JOIN spedizioni s ON c.cliente_id = s.cliente_id WHERE s.stato_consegna = 'consegnata' AND s.peso_totale_kg > ANY (SELECT s2.peso_totale_kg FROM spedizioni s2 JOIN magazzini m ON s2.magazzino_id = m.magazzino_id WHERE m.nome_deposito = 'Hub Nord Milano' AND s2.stato_consegna = 'fallita') GROUP BY c.ragione_sociale, c.citta ORDER BY peso_totale_kg DESC;"
}