{
  "schema_ddl": "CREATE TABLE clienti (\n    cliente_id INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE vettori (\n    vettore_id INT PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    codice_abilitazione TEXT NOT NULL UNIQUE,\n    telefono_contatto TEXT\n);\n\nCREATE TABLE magazzini (\n    magazzino_id INT PRIMARY KEY,\n    nome_deposito TEXT NOT NULL,\n    capacita_pallet INT NOT NULL CHECK (capacita_pallet > 0),\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE spedizioni (\n    spedizione_id INT PRIMARY KEY,\n    vettore_id INT NOT NULL REFERENCES vettori(vettore_id),\n    magazzino_id INT NOT NULL REFERENCES magazzini(magazzino_id),\n    cliente_id INT NOT NULL REFERENCES clienti(cliente_id),\n    data_spedizione DATE NOT NULL,\n    peso_totale_kg NUMERIC(10,2) NOT NULL CHECK (peso_totale_kg >= 0),\n    stato_consegna TEXT NOT NULL CHECK (stato_consegna IN ('pianificata', 'in_transito', 'consegnata', 'fallita'))\n);\n\nCREATE TABLE colli (\n    collo_id INT PRIMARY KEY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(spedizione_id),\n    peso_collo_kg NUMERIC(8,2) NOT NULL CHECK (peso_collo_kg > 0),\n    descrizione_contenuto TEXT\n);",
