  "query": "SELECT s.matricola AS matricola_studente, s.nome AS nome_studente, s.cognome AS cognome_studente, t.matricola AS matricola_tutor, t.nome AS nome_tutor, t.cognome AS cognome_tutor FROM studenti s JOIN studenti t ON s.tutor_id = t.id WHERE s.data_immatricolazione BETWEEN '2022-08-01' AND '2022-09-30' ORDER BY t.cognome, s.cognome, s.nome, s.matricola;"
