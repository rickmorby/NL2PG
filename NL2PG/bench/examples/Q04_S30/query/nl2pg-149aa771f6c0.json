  "query": "SELECT c.nome AS cliente, o.data_ordine, o.stato, o.totale AS importo_ordine, s.corriere, s.stato_spedizione, s.tracking_number, CASE WHEN r.id IS NOT NULL THEN 'Sì' ELSE 'No' END AS reso_presente FROM clienti c JOIN ordini o ON c.id = o.cliente_id LEFT JOIN spedizioni s ON o.id = s.ordine_id LEFT JOIN resi r ON o.id = r.ordine_id WHERE o.stato IN ('confermato', 'spedito', 'consegnato') AND o.data_ordine BETWEEN '2025-12-01' AND '2026-01-31' AND (s.stato_spedizione = 'in_transito' OR s.stato_spedizione IS NULL) ORDER BY o.data_ordine DESC, c.nome, o.id DESC, COALESCE(s.id, 0) DESC, COALESCE(r.id, 0) DESC;"
}