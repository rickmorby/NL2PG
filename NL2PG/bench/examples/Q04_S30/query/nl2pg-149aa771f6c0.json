{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    indirizzo TEXT,\n    creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL,\n    stato TEXT NOT NULL CHECK (stato IN ('pendente', 'confermato', 'spedito', 'consegnato')),\n    totale NUMERIC(10, 2) NOT NULL CHECK (totale >= 0)\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id),\n    data_spedizione DATE NOT NULL,\n    corriere TEXT NOT NULL,\n    tracking_number TEXT UNIQUE,\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnato', 'annullato'))\n);\n\nCREATE TABLE magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    capacita_max INT CHECK (capacita_max > 0)\n);\n\nCREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    partiva_iva TEXT UNIQUE,\n    email TEXT,\n    telefono TEXT\n);\n\nCREATE TABLE trasportatori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    tipo_servizio TEXT CHECK (tipo_servizio IN ('standard', 'espresso', 'internazionale')),\n    costo_per_kg NUMERIC(8, 2) CHECK (costo_per_kg >= 0)\n);\n\nCREATE TABLE resi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT REFERENCES ordini(id),\n    data_richiesta DATE NOT NULL,\n    motivo TEXT NOT NULL,\n    stato_reso TEXT CHECK (stato_reso IN ('aperto', 'in_lavorazione', 'chiuso', 'rifiutato'))\n);",
