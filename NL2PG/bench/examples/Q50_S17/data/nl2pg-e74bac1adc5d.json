  "schema_ddl": "CREATE TABLE anagrafica_risorse_umane (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_assunzione DATE,\n    attivo BOOLEAN DEFAULT TRUE,\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE progetti (\n    id INT PRIMARY KEY,\n    nome_progetto TEXT NOT NULL,\n    budget NUMERIC(12,2) CHECK (budget >= 0),\n    data_inizio DATE,\n    data_fine DATE,\n    completato BOOLEAN DEFAULT FALSE,\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE assegnazioni_progetto (\n    id INT PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES anagrafica_risorse_umane(id),\n    progetto_id INT NOT NULL REFERENCES progetti(id),\n    data_assegnazione DATE DEFAULT CURRENT_DATE,\n    percentuale_allocazione NUMERIC(5,2) CHECK (percentuale_allocazione > 0 AND percentuale_allocazione <= 100),\n    attiva BOOLEAN DEFAULT TRUE,\n    eliminato BOOLEAN NOT NULL DEFAULT FALSE\n);",
