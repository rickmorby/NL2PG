{
  "schema_ddl": "CREATE TABLE logistica_spedizioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    identificativo_ordine TEXT NOT NULL,\n    finestra_di_evasione DATE NOT NULL,\n    stato_consegna TEXT NOT NULL,\n    peso_kg NUMERIC(10, 2) NOT NULL CHECK (peso_kg > 0),\n    destinazione_codice_postale TEXT NOT NULL,\n    CONSTRAINT check_stato_consegna CHECK (stato_consegna IN ('IN_TRANSITO', 'CONSEGNATO', 'IN_ATTESA', 'FALLITO'))\n);\n\nCREATE INDEX idx_spedizioni_temporali ON logistica_spedizioni (finestra_di_evasione, stato_consegna);",
