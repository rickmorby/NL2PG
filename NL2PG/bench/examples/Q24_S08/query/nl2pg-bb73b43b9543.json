  "feature_sql": [
    "left_outer_join"
  ],
  "query": "SELECT p.nome, p.cognome, p.codice_fiscale, s.matricola, s.corso_di_laurea, CASE WHEN s.id IS NULL THEN 'Non immatricolato' ELSE 'Immatricolato' END AS stato_immatricolazione FROM persone p LEFT JOIN studenti s ON s.id = p.id WHERE p.cognome IN ('Rossi', 'Bianchi') ORDER BY p.cognome ASC, p.nome ASC, p.codice_fiscale ASC;"
}