    "spec_hash": "2b97dc312da27e0f"
  },
  "schema_ddl": "CREATE DOMAIN stato_ordine AS TEXT CHECK (VALUE IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato'));\n\nCREATE DOMAIN percentuale_sconto AS NUMERIC(5,2) CHECK (VALUE >= 0 AND VALUE <= 100);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    descrizione TEXT,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza_magazzino INT NOT NULL DEFAULT 0 CHECK (giacenza_magazzino >= 0)\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE,\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine stato_ordine NOT NULL DEFAULT 'in_attesa',\n    importo_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_totale >= 0)\n);\n\nCREATE TABLE righe_ordine (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario_riga NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario_riga >= 0),\n    sconto percentuale_sconto NOT NULL DEFAULT 0\n);",
