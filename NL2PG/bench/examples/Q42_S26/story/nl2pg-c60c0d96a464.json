{
  "schema_ddl": "CREATE TABLE conti_correnti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_conto TEXT NOT NULL UNIQUE,\n    intestatario TEXT NOT NULL,\n    saldo_disponibile NUMERIC(15,2) NOT NULL CHECK (saldo_disponibile >= 0)\n);\n\nCREATE TABLE transazioni_finanziarie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti_correnti(id) ON DELETE CASCADE,\n    importo_transazione NUMERIC(12,2) NOT NULL,\n    data_valuta TEXT NOT NULL,\n    stato_operazione TEXT NOT NULL CHECK (stato_operazione IN ('COMPLETATA', 'PENDENTE', 'ANNULLATA'))\n);\n\nCREATE TABLE categorie_operazione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_categoria TEXT NOT NULL UNIQUE,\n    descrizione_categoria TEXT NOT NULL\n);\n\nCREATE TABLE dettagli_transazione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    transazione_id INT NOT NULL REFERENCES transazioni_finanziarie(id) ON DELETE CASCADE,\n    categoria_id INT REFERENCES categorie_operazione(id) ON DELETE SET NULL,\n    note_aggiuntive TEXT\n);",
