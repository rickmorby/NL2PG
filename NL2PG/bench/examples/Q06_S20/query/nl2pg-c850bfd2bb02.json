  "query": "SELECT c.nome, c.cognome, cc.iban, cc.saldo AS saldo_attuale, cc.data_apertura FROM conti_correnti cc JOIN clienti c ON cc.cliente_id = c.id WHERE cc.stato_conto = 'ATTIVO' AND c.nome = 'Alessandro' AND cc.saldo >= 1000 ORDER BY cc.saldo DESC;"
