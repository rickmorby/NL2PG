  "query": "WITH nomi_target(nome) AS (VALUES ('Anna'), ('Luca'), ('Davide')) SELECT c.nome AS nome_cliente, c.cognome AS cognome_cliente, COUNT(o.data_ordine) AS numero_ordini, ROUND(COALESCE(SUM(o.importo_totale), 0), 2) AS totale_importo FROM clienti c LEFT JOIN ordini o ON o.cliente_id = c.id AND o.stato IN ('confermato', 'spedito') WHERE c.nome IN (SELECT nome FROM nomi_target) AND c.attivo IS TRUE GROUP BY c.nome, c.cognome ORDER BY totale_importo DESC, numero_ordini DESC, cognome_cliente LIMIT 20;"
}