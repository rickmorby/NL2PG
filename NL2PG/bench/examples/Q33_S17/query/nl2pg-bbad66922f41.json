  "query": "SELECT t.causale, t.tipo_movimento, COUNT(*) AS numero_movimenti, SUM(t.importo) AS totale_importo FROM transazioni t WHERE t.causale LIKE 'Bonifico%' AND t.valuta = 'EUR' GROUP BY t.causale, t.tipo_movimento ORDER BY totale_importo DESC;"
}