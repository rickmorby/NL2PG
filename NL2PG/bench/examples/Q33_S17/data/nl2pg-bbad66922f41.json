        "twist_type": "rename",
        "target_value": "transazioni",
        "obsolete_value": "registro_operazioni",
        "description": "La tabella transazioni viene denominata registro_operazioni nella prosa aziendale. Le query devono risolvere la perifrasi verso la tabella reale transazioni."
      },
      {
        "twist_type": "jargon",
        "target_value": "deleted_at",
        "obsolete_value": "data_di_stralcio",
        "description": "La colonna di cancellazione logica deleted_at è indicata con il gergo finanziario data_di_stralcio. Le operazioni ancora valide sono descritte come 'in essere' o 'non stralciate': le query devono applicare il predicato di visibilità WHERE deleted_at IS NULL per escludere i record logicamente eliminati."
      }
    ],
    "spec_hash": "ebbc60cf30f0d45d"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE conti_correnti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    iban TEXT NOT NULL UNIQUE,\n    alias_conto TEXT NOT NULL,\n    saldo_disponibile NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_disponibile >= 0),\n    data_apertura DATE NOT NULL,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE transazioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id BIGINT NOT NULL REFERENCES conti_correnti(id),\n    causale TEXT NOT NULL,\n    riferimento_esterno TEXT,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('accredito', 'addebito')),\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    valuta CHAR(3) NOT NULL DEFAULT 'EUR',\n    data_valuta DATE NOT NULL,\n    data_registrazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);",
