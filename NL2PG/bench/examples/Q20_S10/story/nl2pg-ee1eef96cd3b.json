{
  "schema_ddl": "CREATE TABLE clienti (\n    cliente_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT NOT NULL UNIQUE,\n    telefono_contatto TEXT,\n    citta_residenza TEXT NOT NULL,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE contratti (\n    contratto_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(cliente_id),\n    numero_contratto TEXT NOT NULL UNIQUE,\n    tipologia_piano TEXT NOT NULL CHECK (tipologia_piano IN ('voce', 'dati', 'bundle_voce_dati', 'fibra')),\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    data_sottoscrizione DATE NOT NULL,\n    stato_contratto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato'))\n);\n\nCREATE TABLE linee_telefoniche (\n    linea_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti(contratto_id),\n    numero_msisdn TEXT NOT NULL UNIQUE,\n    minuti_consumati INT NOT NULL DEFAULT 0 CHECK (minuti_consumati >= 0),\n    giga_consumati NUMERIC(9,2) NOT NULL DEFAULT 0 CHECK (giga_consumati >= 0),\n    stato_linea TEXT NOT NULL DEFAULT 'operativa' CHECK (stato_linea IN ('operativa', 'sospesa', 'disattivata'))\n);\n\nCREATE TABLE fatture (\n    fattura_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti(contratto_id),\n    numero_fattura TEXT NOT NULL UNIQUE,\n    periodo_riferimento TEXT NOT NULL,\n    importo_totale NUMERIC(10,2) NOT NULL CHECK (importo_totale >= 0),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva BETWEEN 0 AND 100),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    pagata BOOLEAN NOT NULL DEFAULT FALSE\n);",
