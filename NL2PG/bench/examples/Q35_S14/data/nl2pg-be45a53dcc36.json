        "twist_type": "jargon",
        "target_value": "pressione_sistolica",
        "obsolete_value": "valore pressorio massimo in fase di contrazione (PAS)",
        "description": "La colonna pressione_sistolica della tabella pazienti viene indicata nella prosa aziendale esclusivamente con il gergo clinico 'valore pressorio massimo in fase di contrazione (PAS)'. Le query devono mappare questa perifrasi alla colonna reale per classificare i pazienti con CASE WHEN pressione_sistolica > 140 THEN 'valido' ELSE 'fuori dominio' END secondo la soglia ipertensiva del protocollo clinico."
      },
      {
        "twist_type": "synonym",
        "target_value": "anamnesi_note",
        "obsolete_value": "osservazioni cliniche registrate",
        "description": "La colonna nullable anamnesi_note viene denominata sinonimicamente 'osservazioni cliniche registrate' nella documentazione aziendale. Poiché la colonna può essere NULL per pazienti senza anamnesi compilata, le proiezioni devono gestire i valori mancanti con COALESCE(anamnesi_note, 'non rilevata') per evitare nulli nel risultato."
      }
    ],
    "spec_hash": "0d756c4c027eba08"
  },
  "schema_ddl": "CREATE DOMAIN pressione_mmhg AS INT CHECK (VALUE BETWEEN 40 AND 300);\n\nCREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE,\n    pressione_sistolica pressione_mmhg,\n    anamnesi_note TEXT,\n    creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
