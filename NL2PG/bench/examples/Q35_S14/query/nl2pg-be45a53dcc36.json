  "feature_sql": [
    "case"
  ],
  "query": "SELECT p.nome, p.cognome, p.codice_fiscale, p.pressione_sistolica, CASE WHEN p.pressione_sistolica < 130 THEN 'Normoteso' WHEN p.pressione_sistolica BETWEEN 130 AND 139 THEN 'Ipertensione di grado 1' ELSE 'Ipertensione di grado 2' END AS classe_pressoria FROM pazienti AS p WHERE p.pressione_sistolica >= 125 ORDER BY p.pressione_sistolica DESC, p.cognome ASC, p.nome ASC, p.id"
}