  "schema_ddl": "CREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE ordini_fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato TEXT NOT NULL CHECK (stato IN ('emesso', 'evaso', 'annullato'))\n);\n\nCREATE TABLE articoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    costo_unitario NUMERIC(10,2) NOT NULL CHECK (costo_unitario >= 0)\n);\n\nCREATE TABLE dettagli_ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini_fornitori(id),\n    articolo_id INT NOT NULL REFERENCES articoli(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_concordato NUMERIC(10,2) NOT NULL CHECK (prezzo_concordato >= 0)\n);",
