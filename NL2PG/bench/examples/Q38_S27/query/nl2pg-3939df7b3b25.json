  "query": "SELECT c.nome, c.cognome, c.citta, o.data_ordine, o.totale_ordine AS importo_ordine FROM ordini o JOIN clienti c ON c.id = o.cliente_id WHERE o.stato_ordine = 'consegnato' AND o.totale_ordine > ALL (SELECT o2.totale_ordine FROM ordini o2 WHERE o2.stato_ordine = 'annullato') ORDER BY o.totale_ordine DESC, o.data_ordine ASC;"
