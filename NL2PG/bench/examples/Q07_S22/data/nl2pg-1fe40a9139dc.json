    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "clienti",
        "obsolete_value": "anagrafica_acquirenti",
        "description": "La tabella dimensionale clienti viene denominata anagrafica_acquirenti nella prosa aziendale. Le query devono risolvere il riferimento alla tabella reale clienti per joinare la tabella dei fatti righe_ordine sulla chiave cliente_id."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_totale",
        "obsolete_value": "GMV",
        "description": "La colonna importo_totale della tabella dei fatti righe_ordine viene indicata con il gergo e-commerce GMV (Gross Merchandise Value). Le query di aggregazione devono mappare GMV sulla colonna reale importo_totale quando calcolano ricavi per prodotto, cliente o periodo."
      }
    ],
    "spec_hash": "80f3887df766226a"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    regione TEXT NOT NULL,\n    data_registrazione DATE NOT NULL\n);\n\nCREATE TABLE prodotti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    marca TEXT NOT NULL,\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE tempo (\n    id INT PRIMARY KEY,\n    data_calendario DATE NOT NULL UNIQUE,\n    anno INT NOT NULL CHECK (anno BETWEEN 2000 AND 2100),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    giorno_settimana TEXT NOT NULL\n);\n\nCREATE TABLE ordini (\n    id INT PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL CHECK (stato_ordine IN ('in_attesa', 'spedito', 'consegnato', 'annullato')),\n    canale_vendita TEXT NOT NULL CHECK (canale_vendita IN ('web', 'mobile', 'negozio_fisico'))\n);\n\nCREATE TABLE righe_ordine (\n    id BIGINT PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    tempo_id INT NOT NULL REFERENCES tempo(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);",
