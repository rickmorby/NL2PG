  "query": "SELECT c.regione, p.categoria, o.canale_vendita, SUM(r.importo_totale) AS ricavo_totale, COUNT(DISTINCT r.cliente_id) AS clienti_distinti, ROUND(AVG(r.importo_totale), 2) AS scontrino_medio FROM righe_ordine r JOIN ordini o ON r.ordine_id = o.id JOIN prodotti p ON r.prodotto_id = p.id JOIN clienti c ON r.cliente_id = c.id WHERE o.stato_ordine = 'consegnato' AND o.data_ordine BETWEEN '2026-01-01' AND '2026-03-31' GROUP BY c.regione, p.categoria, o.canale_vendita ORDER BY ricavo_totale DESC;"
}