  "schema_ddl": "CREATE TABLE sedi (\n    sede_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_sede TEXT NOT NULL,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE uffici (\n    ufficio_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sede_id INT NOT NULL REFERENCES sedi(sede_id) ON DELETE CASCADE,\n    nome_ufficio TEXT NOT NULL,\n    CONSTRAINT uq_uffici_sede_nome UNIQUE (sede_id, nome_ufficio)\n);\n\nCREATE TABLE dipendenti (\n    dipendente_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ufficio_id INT NOT NULL REFERENCES uffici(ufficio_id) ON DELETE RESTRICT,\n    nome_dipendente TEXT NOT NULL,\n    cognome_dipendente TEXT NOT NULL,\n    codice_fiscale_dipendente TEXT NOT NULL,\n    data_ingresso_in_forza DATE NOT NULL,\n    stipendio_base NUMERIC(10,2) NOT NULL,\n    CONSTRAINT uq_dipendenti_codice_fiscale UNIQUE (codice_fiscale_dipendente),\n    CONSTRAINT chk_dipendenti_stipendio_base CHECK (stipendio_base >= 0)\n);\n\nCREATE TABLE nucleo_familiare_carico (\n    dipendente_id INT NOT NULL REFERENCES dipendenti(dipendente_id) ON DELETE CASCADE,\n    progressivo INT NOT NULL,\n    nome_familiare TEXT NOT NULL,\n    cognome_familiare TEXT NOT NULL,\n    codice_fiscale_familiare TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    grado_parentela TEXT NOT NULL,\n    PRIMARY KEY (dipendente_id, progressivo),\n    CONSTRAINT uq_nucleo_familiare_carico_cf UNIQUE (dipendente_id, codice_fiscale_familiare),\n    CONSTRAINT chk_nucleo_familiare_carico_progressivo CHECK (progressivo > 0),\n    CONSTRAINT chk_nucleo_familiare_carico_grado CHECK (grado_parentela IN ('coniuge', 'figlio', 'genitore', 'altro'))\n);",
