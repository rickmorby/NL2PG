  "schema_ddl": "CREATE TABLE articoli_magazzino (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    unita_misura TEXT NOT NULL,\n    categoria TEXT,\n    quantita_giacenza NUMERIC(12,3) NOT NULL DEFAULT 0 CHECK (quantita_giacenza >= 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    ubicazione_stoccaggio TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
