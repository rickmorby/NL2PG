{
  "schema_ddl": "CREATE DOMAIN stato_immobile AS TEXT\n    CHECK (VALUE IN ('nuova_costruzione', 'abitabile', 'ristrutturare'));\n\nCREATE DOMAIN classe_energetica AS TEXT\n    CHECK (VALUE IN ('A', 'B', 'C', 'D', 'E', 'F', 'G'));\n\nCREATE DOMAIN importo_euro AS NUMERIC(12,2)\n    CHECK (VALUE >= 0);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_immobile TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT,\n    prezzo_vendita importo_euro NOT NULL,\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani >= 1),\n    numero_bagni INT CHECK (numero_bagni >= 0),\n    piano INT,\n    stato stato_immobile NOT NULL,\n    certificazione_energetica classe_energetica,\n    data_inserimento DATE DEFAULT CURRENT_DATE\n);",
