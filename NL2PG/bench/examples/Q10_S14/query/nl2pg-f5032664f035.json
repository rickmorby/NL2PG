  "feature_sql": [],
  "query": "SELECT i.codice_immobile AS codice_immobile, i.indirizzo, i.citta, i.prezzo_vendita, i.superficie_mq, ROUND(i.prezzo_vendita / i.superficie_mq, 2) AS prezzo_al_mq FROM immobili i WHERE i.citta = 'Roma' AND i.stato IN ('abitabile', 'nuova_costruzione') ORDER BY prezzo_al_mq DESC, i.codice_immobile ASC;"
}