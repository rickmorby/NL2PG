    "twist_rules": [
      {
        "twist_type": "jargon",
        "target_value": "certificazione_energetica",
        "obsolete_value": "attestato APE",
        "description": "La colonna certificazione_energetica della tabella immobili viene denominata nella prosa aziendale con il gergo del settore 'attestato APE' (Attestato di Prestazione Energetica). Il solver deve riconoscere che i riferimenti alle classi energetiche citate nel testo (es. 'classe B o migliore') si traducono in condizioni WHERE esplicite sulla scala A-G memorizzata nella colonna, applicando l'ordinamento esterno delle classi non dichiarato nello schema."
      },
      {
        "twist_type": "rephrase",
        "target_value": "stato",
        "obsolete_value": "unità pronta consegna senza lavori",
        "description": "La prosa aziendale descrive lo stato dell'immobile con la perifrasi 'unità pronta consegna senza lavori', che corrisponde al valore canonico 'abitabile' della colonna stato. Il solver deve tradurre questa formulazione commerciale nella condizione concreta stato = 'abitabile', evitando di confonderla con gli altri valori ammessi dalla colonna (es. 'ristrutturare', 'nuova_costruzione')."
      }
    ],
    "spec_hash": "615c7ed4e5c7fe30"
  },
  "schema_ddl": "CREATE DOMAIN stato_immobile AS TEXT\n    CHECK (VALUE IN ('nuova_costruzione', 'abitabile', 'ristrutturare'));\n\nCREATE DOMAIN classe_energetica AS TEXT\n    CHECK (VALUE IN ('A', 'B', 'C', 'D', 'E', 'F', 'G'));\n\nCREATE DOMAIN importo_euro AS NUMERIC(12,2)\n    CHECK (VALUE >= 0);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_immobile TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT,\n    prezzo_vendita importo_euro NOT NULL,\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani >= 1),\n    numero_bagni INT CHECK (numero_bagni >= 0),\n    piano INT,\n    stato stato_immobile NOT NULL,\n    certificazione_energetica classe_energetica,\n    data_inserimento DATE DEFAULT CURRENT_DATE\n);",
