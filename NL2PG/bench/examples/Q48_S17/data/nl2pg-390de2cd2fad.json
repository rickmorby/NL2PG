        "target_value": "spedizioni",
        "obsolete_value": "registro_partenze",
        "description": "La tabella reale spedizioni viene indicata nella prosa aziendale come registro_partenze, mantenendo però la stessa struttura e gli stessi dati."
      },
      {
        "twist_type": "synonym",
        "target_value": "deleted_at",
        "obsolete_value": "data_disattivazione",
        "description": "Il timestamp di cancellazione logica deleted_at viene chiamato data_disattivazione; una spedizione è considerata visibile solo quando data_disattivazione è NULL, ovvero deleted_at IS NULL."
      }
    ],
    "spec_hash": "9f1e8671f96c711a"
  },
  "schema_ddl": "CREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_tracciamento TEXT NOT NULL UNIQUE,\n    mittente TEXT NOT NULL,\n    destinatario TEXT NOT NULL,\n    indirizzo_partenza TEXT NOT NULL,\n    indirizzo_destinazione TEXT NOT NULL,\n    data_partenza DATE NOT NULL,\n    data_consegna_prevista DATE,\n    peso_kg NUMERIC(10,3) CHECK (peso_kg > 0),\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnata', 'fallita', 'reso')),\n    corriere TEXT NOT NULL,\n    costo NUMERIC(10,2) CHECK (costo >= 0),\n    deleted_at TIMESTAMP,\n    data_disattivazione TIMESTAMP,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (deleted_at IS NULL OR data_disattivazione IS NULL OR deleted_at = data_disattivazione)\n);\n\nCREATE INDEX idx_spedizioni_deleted_at ON spedizioni(deleted_at);\nCREATE INDEX idx_spedizioni_data_partenza ON spedizioni(data_partenza);",
