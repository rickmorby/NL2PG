{
  "schema_ddl": "CREATE TABLE spedizioni (\n    codice_spedizione INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    destinazione TEXT NOT NULL,\n    peso_netto TEXT NOT NULL,\n    data_partenza DATE NOT NULL,\n    CONSTRAINT check_peso_numerico CHECK (peso_netto ~ '^[0-9]+(\\.[0-9]+)?$')\n);\n\nCREATE TABLE colli (\n    id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(codice_spedizione),\n    descrizione TEXT NOT NULL,\n    volume_occupato NUMERIC(10, 2) CHECK (volume_occupato BETWEEN 0.01 AND 1000.00)\n);",
