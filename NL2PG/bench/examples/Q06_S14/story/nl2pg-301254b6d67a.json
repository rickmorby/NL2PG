  "schema_ddl": "CREATE DOMAIN peso_non_negativo AS NUMERIC(8,2) CHECK (VALUE > 0);\n\nCREATE TABLE magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    capienza_massima INT NOT NULL CHECK (capienza_massima > 0),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    magazzino_id INT NOT NULL REFERENCES magazzini(id) ON DELETE CASCADE,\n    codice_tracciamento TEXT NOT NULL UNIQUE,\n    destinatario TEXT NOT NULL,\n    peso_kg peso_non_negativo NOT NULL,\n    stato TEXT NOT NULL DEFAULT 'in_preparazione' CHECK (stato IN ('in_preparazione', 'in_transito', 'consegnata', 'annullata')),\n    costo_spedizione NUMERIC(10,2) NOT NULL CHECK (costo_spedizione >= 0),\n    data_spedizione DATE NOT NULL,\n    data_consegna DATE,\n    CONSTRAINT chk_data_consegna CHECK (data_consegna IS NULL OR data_consegna >= data_spedizione)\n);",
