{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    deleted_at TIMESTAMP,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_polizza TEXT NOT NULL UNIQUE,\n    premio_annuale NUMERIC(10,2) NOT NULL CHECK (premio_annuale >= 0),\n    deleted_at TIMESTAMP,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE sinistri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    polizza_id INT NOT NULL REFERENCES polizze(id),\n    data_evento DATE NOT NULL,\n    descrizione TEXT NOT NULL,\n    deleted_at TIMESTAMP,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE liquidazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sinistro_id INT NOT NULL REFERENCES sinistri(id),\n    importo_liquidato NUMERIC(10,2) NOT NULL CHECK (importo_liquidato >= 0),\n    data_liquidazione DATE NOT NULL,\n    deleted_at TIMESTAMP,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE periti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_perito TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    deleted_at TIMESTAMP,\n    is_deleted BOOLEAN NOT NULL DEFAULT FALSE\n);",
