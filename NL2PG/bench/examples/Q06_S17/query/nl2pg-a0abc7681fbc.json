  "feature_sql": [
    "conjunctive"
  ],
  "query": "SELECT c.nome, c.cognome, c.citta, COUNT(o.id) AS numero_ordini_consegnati, ROUND(SUM(o.importo_totale), 2) AS totale_speso FROM clienti c JOIN ordini o ON o.cliente_id = c.id WHERE c.flag_eliminato = 0 AND o.flag_eliminato = 0 AND o.stato_ordine = 'consegnato' AND o.data_ordine BETWEEN DATE '2025-11-01' AND DATE '2026-01-31' AND c.citta IN ('Milano', 'Torino') GROUP BY c.nome, c.cognome, c.citta, c.codice_fiscale HAVING SUM(o.importo_totale) >= 100 ORDER BY totale_speso DESC, c.codice_fiscale ASC;"
}