  "feature_sql": [
    "agg_distinct"
  ],
  "query": "WITH statistiche_reparto AS (\n    SELECT numero_reparto,\n           COUNT(DISTINCT nome) AS nomi_distinti,\n           COUNT(DISTINCT cognome) AS cognomi_distinti,\n           ROUND(AVG(salario), 2) AS salario_medio\n    FROM emp\n    WHERE salario IS NOT NULL\n    GROUP BY numero_reparto\n)\nSELECT e.nome,\n       e.cognome,\n       sr.nomi_distinti,\n       sr.cognomi_distinti,\n       sr.salario_medio,\n       RANK() OVER (PARTITION BY e.numero_reparto ORDER BY e.salario DESC) AS posizione_salario_reparto\nFROM emp e\nJOIN statistiche_reparto sr ON sr.numero_reparto = e.numero_reparto\nWHERE e.salario BETWEEN 40000 AND 80000\n  AND e.nome IN ('Alessandro', 'Andrea', 'Anna', 'Chiara', 'Davide')\nORDER BY posizione_salario_reparto ASC, e.salario DESC, e.emp_no ASC;"
}