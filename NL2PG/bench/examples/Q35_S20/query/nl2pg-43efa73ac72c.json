{
  "schema_ddl": "CREATE TYPE stato_polizza AS ENUM ('attiva', 'sospesa', 'cessata');\n\nCREATE TABLE contratti_assicurativi (\n    id SERIAL PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    cliente TEXT NOT NULL,\n    massimale NUMERIC(12, 2) NOT NULL CHECK (massimale > 0),\n    stato_polizza stato_polizza NOT NULL,\n    data_inizio DATE NOT NULL,\n    data_fine DATE CHECK (data_fine IS NULL OR data_fine > data_inizio)\n);\n\nCREATE TABLE sinistri (\n    id SERIAL PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti_assicurativi(id),\n    data_sinistro DATE NOT NULL,\n    importo_richiesto NUMERIC(12, 2) NOT NULL CHECK (importo_richiesto > 0),\n    importo_liquidato NUMERIC(12, 2) CHECK (importo_liquidato >= 0 AND importo_liquidato <= importo_richiesto),\n    stato_sinistro TEXT NOT NULL\n);",
