  "query": "SELECT cliente, numero_polizza, CASE WHEN stato_polizza = 'attiva' THEN 'Polizza attiva' WHEN stato_polizza = 'sospesa' THEN 'Polizza sospesa' ELSE 'Polizza cessata' END AS stato_descrizione FROM contratti_assicurativi WHERE stato_polizza IS NOT NULL;"
