  "feature_sql": [
    "left_outer_join"
  ],
  "query": "SELECT c.nome, COUNT(DISTINCT o.id) AS numero_ordini, SUM(po.totale_riga) AS totale_speso FROM clienti c LEFT OUTER JOIN ordini o ON c.id = o.cliente_id LEFT OUTER JOIN prodotti_ordine po ON o.id = po.ordine_id WHERE c.data_registrazione BETWEEN '2024-10-01' AND '2025-01-31' GROUP BY c.nome ORDER BY totale_speso DESC NULLS LAST;"
}