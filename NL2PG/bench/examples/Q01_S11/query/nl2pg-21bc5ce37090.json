  "feature_sql": [],
  "query": "WITH paz_visite AS (\n    SELECT\n        p.nome,\n        p.cognome,\n        COUNT(v.id) AS numero_visite,\n        SUM(v.costo) AS totale_speso,\n        ROW_NUMBER() OVER (ORDER BY SUM(v.costo) DESC) AS posizione\n    FROM pazienti p\n    JOIN visite v ON p.id = v.paziente_id\n    WHERE p.nome = 'Laura'\n    GROUP BY p.nome, p.cognome\n)\nSELECT nome, cognome, numero_visite, totale_speso, posizione\nFROM paz_visite\nORDER BY totale_speso DESC\nLIMIT 10;"
}