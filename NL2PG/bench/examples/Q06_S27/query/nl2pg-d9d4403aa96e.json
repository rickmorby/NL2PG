  "query": "SELECT UPPER(c.ragione_sociale) AS compagnia, ROUND(AVG(p.premio_annuale), 2) AS premio_medio FROM compagnie_assicurative c JOIN polizze p ON c.id = p.compagnia_id WHERE p.premio_annuale > 500 AND p.premio_annuale <= 2500 GROUP BY c.ragione_sociale;"
}