  "feature_sql": [
    "in_condition"
  ],
  "query": "SELECT c.codice_dipartimento AS dipartimento, COUNT(DISTINCT e.id_studente) AS studenti_distinti, COUNT(*) AS iscrizioni_attive, ROUND(AVG(e.voto), 2) AS media_voto, MAX(e.voto) AS voto_massimo FROM catalogo_corsi c JOIN iscrizioni_studenti e ON c.codice_corso = e.codice_corso WHERE c.codice_dipartimento IN ('DINFO', 'DMAT') AND e.stato_iscrizione = 'ACT' GROUP BY c.codice_dipartimento ORDER BY media_voto DESC;"
}