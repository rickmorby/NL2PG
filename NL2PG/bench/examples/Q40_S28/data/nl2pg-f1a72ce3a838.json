      {
        "twist_type": "jargon",
        "target_value": "crs_cd",
        "obsolete_value": "chiave didattica dell'offerta formativa",
        "description": "La colonna crs_cd della tabella crs_cat (catalogo dei corsi) è indicata nel gergo interno dell'ateneo come 'chiave didattica dell'offerta formativa'. La condizione WHERE ... IN (v1, v2) dovrà essere applicata su questa colonna utilizzando i codici corso reali presenti nel database."
      }
    ],
    "spec_hash": "ea16e7e633b2ca4d"
  },
  "schema_ddl": "CREATE TABLE registro_studenti (\n    id_studente INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_facolta TEXT NOT NULL UNIQUE,\n    data_nascita DATE,\n    email TEXT NOT NULL UNIQUE,\n    data_iscrizione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE catalogo_corsi (\n    codice_corso TEXT PRIMARY KEY,\n    titolo_corso TEXT NOT NULL,\n    crediti INT NOT NULL CHECK (crediti BETWEEN 1 AND 30),\n    codice_dipartimento TEXT NOT NULL,\n    livello_corso TEXT NOT NULL CHECK (livello_corso IN ('BSC', 'MSC', 'PHD'))\n);\n\nCREATE TABLE iscrizioni_studenti (\n    id_iscrizione BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    id_studente INT NOT NULL REFERENCES registro_studenti(id_studente) ON DELETE CASCADE,\n    codice_corso TEXT NOT NULL REFERENCES catalogo_corsi(codice_corso),\n    anno_accademico TEXT NOT NULL,\n    data_iscrizione DATE NOT NULL DEFAULT CURRENT_DATE,\n    voto NUMERIC(4,1) CHECK (voto IS NULL OR voto BETWEEN 18 AND 30),\n    stato_iscrizione TEXT NOT NULL DEFAULT 'ACT' CHECK (stato_iscrizione IN ('ACT', 'WDR', 'FIN')),\n    UNIQUE (id_studente, codice_corso, anno_accademico)\n);",
