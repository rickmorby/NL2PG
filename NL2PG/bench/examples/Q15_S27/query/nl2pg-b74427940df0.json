  "feature_sql": [
    "cte"
  ],
  "query": "WITH performance_agenti AS (\n    SELECT ag.nome AS nome_agente,\n           ag.cognome AS cognome_agente,\n           ag.agenzia,\n           COUNT(ct.id) AS numero_rogiti,\n           SUM(ct.prezzo_concordato) AS volume_affari,\n           ROUND(SUM(ct.prezzo_concordato * ag.quota_commissione / 100), 2) AS commissione_stimata\n    FROM agenti ag\n    JOIN contratti ct ON ct.agente_id = ag.id\n    WHERE ct.stato = 'rogito'\n    GROUP BY ag.nome, ag.cognome, ag.agenzia\n)\nSELECT pa.nome_agente,\n       pa.cognome_agente,\n       pa.agenzia,\n       pa.numero_rogiti,\n       pa.volume_affari,\n       pa.commissione_stimata,\n       RANK() OVER (ORDER BY pa.commissione_stimata DESC) AS posizione_classifica\nFROM performance_agenti pa\nORDER BY posizione_classifica ASC, cognome_agente ASC;"
}