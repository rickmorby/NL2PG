  "feature_sql": [
    "group_agg"
  ],
  "query": "SELECT categoria, COUNT(*) AS numero_vendite, SUM(quantita) AS pezzi_venduti, ROUND(SUM(importo_totale), 2) AS fatturato_totale FROM vendite WHERE canale = 'online' AND data_vendita >= DATE '2025-12-08' GROUP BY categoria ORDER BY fatturato_totale DESC;"
