{
  "schema_ddl": "CREATE TABLE vendite (\n    id INT GENERATED BY DEFAULT AS IDENTITY,\n    codice_vendita TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    regione TEXT NOT NULL,\n    canale TEXT NOT NULL DEFAULT 'negozio',\n    data_vendita DATE NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto BETWEEN 0 AND 100),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    PRIMARY KEY (id)\n);",
