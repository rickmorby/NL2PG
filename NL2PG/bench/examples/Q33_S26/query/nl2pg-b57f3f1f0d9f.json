  "feature_sql": [
    "like"
  ],
  "query": "SELECT c.codice_conto AS codice_conto,\n       c.denominazione AS denominazione_conto,\n       COUNT(*) AS numero_movimenti,\n       SUM(m.importo::numeric) FILTER (WHERE m.sezione_dare_avere = 'dare') AS totale_dare,\n       SUM(m.importo::numeric) FILTER (WHERE m.sezione_dare_avere = 'avere') AS totale_avere,\n       ROUND(SUM(CASE WHEN m.sezione_dare_avere = 'dare' THEN m.importo::numeric ELSE -m.importo::numeric END), 2) AS saldo_netto\nFROM conti c\nJOIN movimenti m ON m.conto_id = c.id\nJOIN registrazioni r ON r.id = m.registrazione_id\nWHERE c.codice_conto LIKE '10%'\n  AND c.natura_conto = 'attivo'\n  AND r.causale IN ('Fattura vendita', 'Fattura acquisto')\nGROUP BY c.codice_conto, c.denominazione\nORDER BY saldo_netto DESC;"
}