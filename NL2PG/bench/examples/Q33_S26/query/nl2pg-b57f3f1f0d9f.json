{
  "schema_ddl": "CREATE TABLE conti (\n    id SERIAL PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    natura_conto TEXT NOT NULL CHECK (natura_conto IN ('attivo', 'passivo', 'costo', 'ricavo'))\n);\n\nCREATE TABLE registrazioni (\n    id SERIAL PRIMARY KEY,\n    numero_protocollo INT NOT NULL UNIQUE CHECK (numero_protocollo > 0),\n    data_registrazione DATE NOT NULL,\n    causale TEXT NOT NULL,\n    descrizione_scrittura TEXT\n);\n\nCREATE TABLE movimenti (\n    id SERIAL PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni(id),\n    conto_id INT NOT NULL REFERENCES conti(id),\n    importo NUMERIC(12,2) NOT NULL,\n    sezione_dare_avere TEXT NOT NULL CHECK (sezione_dare_avere IN ('dare', 'avere'))\n);",
