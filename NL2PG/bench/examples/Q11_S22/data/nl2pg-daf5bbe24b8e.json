        "twist_type": "rename",
        "target_value": "fatto_ordini",
        "obsolete_value": "registro_transazioni",
        "description": "La tabella dei fatti centrale dello star schema, denominata fisicamente fatto_ordini, viene indicata nella prosa aziendale come registro_transazioni. Le query devono risolvere il nome reale della tabella per calcolare gli aggregati di vendita."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_totale",
        "obsolete_value": "GMV lordo",
        "description": "La colonna importo_totale nella tabella dei fatti viene descritta nei documenti aziendali con il gergo finanziario 'GMV lordo' (Gross Merchandise Value). Il solver deve mappare il termine tecnico di settore alla colonna reale per filtrare o aggregare correttamente."
      },
      {
        "twist_type": "synonym",
        "target_value": "dim_clienti",
        "obsolete_value": "anagrafica_acquirenti",
        "description": "La tabella dimensionale dim_clienti viene riferita nella prosa come anagrafica_acquirenti. La subquery interna (SELECT cliente_id FROM ...) deve puntare alla chiave reale della dimensione clienti per costruire la condizione WHERE ... IN (...)."
      }
    ],
    "spec_hash": "0d256db56894d4b0"
  },
  "schema_ddl": "CREATE TABLE dim_clienti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    data_registrazione DATE NOT NULL\n);\n\nCREATE TABLE dim_prodotti (\n    id SERIAL PRIMARY KEY,\n    nome_prodotto TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE dim_tempo (\n    id SERIAL PRIMARY KEY,\n    data_completa DATE NOT NULL UNIQUE,\n    anno INT NOT NULL CHECK (anno BETWEEN 2000 AND 2100),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    giorno_settimana TEXT NOT NULL\n);\n\nCREATE TABLE dim_negozi (\n    id SERIAL PRIMARY KEY,\n    nome_negozio TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    regione TEXT NOT NULL\n);\n\nCREATE TABLE fatto_ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES dim_clienti(id),\n    prodotto_id INT NOT NULL REFERENCES dim_prodotti(id),\n    tempo_id INT NOT NULL REFERENCES dim_tempo(id),\n    negozio_id INT NOT NULL REFERENCES dim_negozi(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);",
