  "feature_sql": [
    "subquery"
  ],
  "query": "SELECT c.nome, c.cognome, COUNT(*) AS numero_ordini_sopra_media, SUM(o.importo_totale) AS totale_speso FROM dim_clienti c JOIN fatto_ordini o ON c.id = o.cliente_id WHERE c.citta = 'Milano' AND o.importo_totale > (SELECT AVG(importo_totale) FROM fatto_ordini) GROUP BY c.nome, c.cognome ORDER BY totale_speso DESC;"
}