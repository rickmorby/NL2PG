        "obsolete_value": "registro_numerazioni_attive",
        "description": "La tabella linee, contenente le numerazioni telefoniche con la colonna autoriferita per la catena di sostituzione del numero, viene denominata registro_numerazioni_attive nella prosa aziendale."
      },
      {
        "twist_type": "synonym",
        "target_value": "linea_precedente_id",
        "obsolete_value": "identificativo_storico_di_origine",
        "description": "La colonna autoriferita linea_precedente_id, chiave per il self-join che collega ciascuna numerazione alla numerazione da cui deriva (es. portabilità o rimpiazzo SIM), viene indicata nella documentazione come identificativo_storico_di_origine."
      },
      {
        "twist_type": "rephrase",
        "target_value": "contratti",
        "obsolete_value": "documentazione_amministrativa_della_fornitura",
        "description": "La tabella contratti, estensione 1:1 delle linee tramite FK con vincolo UNIQUE, viene descritta nella prosa aziendale come documentazione_amministrativa_della_fornitura."
      }
    ],
    "spec_hash": "040f128a7bc82742"
  },
  "schema_ddl": "CREATE TABLE linee (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_telefonico TEXT NOT NULL UNIQUE,\n    operatore TEXT NOT NULL,\n    stato_linea TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_linea IN ('attiva', 'sospesa', 'disdetta')),\n    tipo_numerazione TEXT NOT NULL CHECK (tipo_numerazione IN ('fissa', 'mobile', 'voip')),\n    data_attivazione DATE NOT NULL,\n    linea_precedente_id INT REFERENCES linee(id),\n    CHECK (linea_precedente_id IS NULL OR linea_precedente_id <> id)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    linea_id INT NOT NULL UNIQUE REFERENCES linee(id),\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_firma DATE NOT NULL,\n    data_scadenza DATE,\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    stato_contratto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato')),\n    CHECK (data_scadenza IS NULL OR data_scadenza >= data_firma)\n);",
