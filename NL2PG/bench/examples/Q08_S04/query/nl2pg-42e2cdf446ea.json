  "feature_sql": [
    "self_join"
  ],
  "query": "SELECT l.numero_telefonico AS numero_linea_attuale, lp.numero_telefonico AS numero_linea_precedente, lp.operatore AS operatore_precedente, l.operatore AS operatore_attuale, l.data_attivazione AS data_attivazione_attuale FROM linee l JOIN linee lp ON l.linea_precedente_id = lp.id WHERE l.stato_linea = 'attiva' ORDER BY l.data_attivazione DESC, l.numero_telefonico ASC LIMIT 15;"
}