{
  "schema_ddl": "CREATE TABLE linee (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_telefonico TEXT NOT NULL UNIQUE,\n    operatore TEXT NOT NULL,\n    stato_linea TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_linea IN ('attiva', 'sospesa', 'disdetta')),\n    tipo_numerazione TEXT NOT NULL CHECK (tipo_numerazione IN ('fissa', 'mobile', 'voip')),\n    data_attivazione DATE NOT NULL,\n    linea_precedente_id INT REFERENCES linee(id),\n    CHECK (linea_precedente_id IS NULL OR linea_precedente_id <> id)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    linea_id INT NOT NULL UNIQUE REFERENCES linee(id),\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_firma DATE NOT NULL,\n    data_scadenza DATE,\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    stato_contratto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato')),\n    CHECK (data_scadenza IS NULL OR data_scadenza >= data_firma)\n);",
