    "sql_features": [
      "group_agg"
    ],
    "twist": [
      "rename",
      "jargon",
      "distractor"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "registrazioni_contabili",
        "obsolete_value": "movimenti di prima nota",
        "description": "La tabella registrazioni_contabili viene denominata 'movimenti di prima nota' nella prosa aziendale. Chi scrive la query deve riconoscere che ogni riga di prima nota corrisponde a una registrazione contabile e agganciarsi alla chiave primaria id_registrazione."
      },
      {
        "twist_type": "jargon",
        "target_value": "totale_imponibile",
        "obsolete_value": "base imponibile ai fini liquidazione IVA",
        "description": "La colonna totale_imponibile della tabella fatture è indicata nella documentazione con il gergo contabile 'base imponibile ai fini liquidazione IVA'. Il solver deve mappare questa perifrasi tecnica direttamente sulla colonna totale_imponibile quando aggrega per gruppo."
      },
      {
        "twist_type": "distractor",
        "target_value": "preventivi",
        "obsolete_value": "impegni di spesa previsionali",
        "description": "La prosa aziendale menziona gli 'impegni di spesa previsionali', che corrispondono alla tabella preventivi. Questa tabella è un distrattore: pur essendo collegata tramite FK ai centri di costo, non deve essere inclusa nel percorso di join né nel GROUP BY, perché il calcolo richiesto riguarda solo i documenti contabili effettivi."
      }
    ],
    "spec_hash": "bcbf4db337c8dcff"
  },
  "schema_ddl": "CREATE TABLE piani_conto (\n    id_conto INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    descrizione_conto TEXT NOT NULL,\n    tipo_conto TEXT NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'costo', 'ricavo'))\n);\n\nCREATE TABLE centri_costo (\n    id_centro_costo INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_centro TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    responsabile TEXT\n);\n\nCREATE TABLE clienti (\n    id_cliente INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE fatture (\n    id_fattura INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_fattura TEXT NOT NULL UNIQUE,\n    data_fattura DATE NOT NULL,\n    cliente_id INT NOT NULL REFERENCES clienti(id_cliente),\n    totale_imponibile NUMERIC(12,2) NOT NULL CHECK (totale_imponibile >= 0),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva >= 0),\n    totale_fattura NUMERIC(12,2) NOT NULL CHECK (totale_fattura >= 0)\n);\n\nCREATE TABLE registrazioni_contabili (\n    id_registrazione INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT REFERENCES fatture(id_fattura),\n    conto_id INT NOT NULL REFERENCES piani_conto(id_conto),\n    centro_costo_id INT REFERENCES centri_costo(id_centro_costo),\n    data_registrazione DATE NOT NULL,\n    descrizione TEXT,\n    importo_dare NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    CHECK (importo_dare > 0 OR importo_avere > 0)\n);\n\nCREATE TABLE pagamenti (\n    id_pagamento INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id_fattura),\n    data_pagamento DATE NOT NULL,\n    importo_pagato NUMERIC(12,2) NOT NULL CHECK (importo_pagato > 0),\n    modalita_pagamento TEXT NOT NULL CHECK (modalita_pagamento IN ('bonifico', 'assegno', 'contanti', 'rid'))\n);\n\nCREATE TABLE preventivi (\n    id_preventivo INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    centro_costo_id INT NOT NULL REFERENCES centri_costo(id_centro_costo),\n    esercizio INT NOT NULL CHECK (esercizio BETWEEN 2000 AND 2100),\n    descrizione TEXT,\n    importo_previsto NUMERIC(12,2) NOT NULL CHECK (importo_previsto >= 0)\n);",
