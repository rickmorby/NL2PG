{
  "schema_ddl": "CREATE TABLE materie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_materia TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu BETWEEN 1 AND 36),\n    semestre INT NOT NULL CHECK (semestre IN (1, 2)),\n    prerequisito_id INT REFERENCES materie(id),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE esami_sostenuti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola_studente TEXT NOT NULL,\n    cognome_studente TEXT NOT NULL,\n    nome_studente TEXT NOT NULL,\n    materia_id INT NOT NULL REFERENCES materie(id),\n    data_esame DATE NOT NULL,\n    voto NUMERIC(4,1) CHECK (voto BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    UNIQUE (matricola_studente, materia_id, data_esame)\n);",
