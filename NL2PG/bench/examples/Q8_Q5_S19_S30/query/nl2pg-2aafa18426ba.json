  "feature_sql": [
    "self_join"
  ],
  "query": "SELECT m.denominazione AS materia, p.denominazione AS materia_prerequisito, m.cfu AS cfu_materia, COUNT(e.id) AS numero_esami_prerequisito, ROUND(AVG(e.voto), 1) AS voto_medio_prerequisito FROM materie m JOIN materie p ON m.prerequisito_id = p.id JOIN esami_sostenuti e ON e.materia_id = p.id WHERE m.semestre = 1 GROUP BY m.id, p.id, m.denominazione, p.denominazione, m.cfu ORDER BY voto_medio_prerequisito DESC, materia ASC;"
}