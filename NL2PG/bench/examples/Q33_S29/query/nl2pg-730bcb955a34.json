  "feature_sql": [
    "like"
  ],
  "query": "SELECT r.nome_reparto AS reparto, r.sede, COUNT(d.id) AS numero_dipendenti, ROUND(AVG(d.stipendio_mensile), 2) AS stipendio_medio_mensile FROM reparti r JOIN dipendenti d ON d.reparto_id = r.id WHERE r.nome_reparto LIKE '%zione%' OR r.sede = 'Milano' GROUP BY r.nome_reparto, r.sede ORDER BY stipendio_medio_mensile DESC, numero_dipendenti DESC;"
}