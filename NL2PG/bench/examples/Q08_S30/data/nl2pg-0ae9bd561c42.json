{
  "spec": {
    "domain": "sanità",
    "n_tables": 9,
    "hierarchy": "self_referential",
    "sql_features": [
      "self_join"
    ],
    "twist": [
      "distractor"
    ],
    "twist_rules": [
      {
        "twist_type": "distractor",
        "target_value": "medici",
        "obsolete_value": "rete_assistenziale_completa",
        "description": "La narrativa aziendale descrive un'ampia 'rete assistenziale completa' composta da 9 tabelle (pazienti, medici, referti, prescrizioni, appuntamenti, reparti, farmaci, esami_laboratorio, fatturazioni), ma la query primaria richiede esclusivamente un self-join sulla tabella medici (colonna medico_supervisore_id) per confrontare titolari e sostituti. Le altre 7 tabelle sono distrattori plausibili e semanticamente coerenti con il dominio sanità: il risolutore deve ignorarle senza modificare lo scheletro della query."
      }
    ],
    "spec_hash": "e52da2e1624297ba"
  },
  "schema_ddl": "CREATE TABLE reparti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    piano INT CHECK (piano >= 0),\n    telefono TEXT\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    specializzazione TEXT NOT NULL,\n    reparto_id INT REFERENCES reparti(id),\n    medico_supervisore_id INT REFERENCES medici(id),\n    ruolo TEXT NOT NULL DEFAULT 'titolare' CHECK (ruolo IN ('titolare', 'sostituto'))\n);\n\nCREATE TABLE pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    medico_curante_id INT REFERENCES medici(id)\n);\n\nCREATE TABLE appuntamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    data_ora TIMESTAMP NOT NULL,\n    motivo_visita TEXT,\n    durata_minuti INT CHECK (durata_minuti > 0)\n);\n\nCREATE TABLE referti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    appuntamento_id INT REFERENCES appuntamenti(id),\n    medico_redattore_id INT NOT NULL REFERENCES medici(id),\n    data_referto DATE NOT NULL,\n    contenuto TEXT NOT NULL\n);\n\nCREATE TABLE farmaci (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_commerciale TEXT NOT NULL UNIQUE,\n    principio_attivo TEXT NOT NULL,\n    prezzo_unitario NUMERIC(8,2) CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE prescrizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_prescrittore_id INT NOT NULL REFERENCES medici(id),\n    farmaco_id INT NOT NULL REFERENCES farmaci(id),\n    data_prescrizione DATE NOT NULL,\n    dosaggio TEXT NOT NULL\n);\n\nCREATE TABLE esami_laboratorio (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    tipo_esame TEXT NOT NULL,\n    valore_misurato NUMERIC(10,2),\n    unita_misura TEXT,\n    data_esame DATE NOT NULL\n);\n\nCREATE TABLE fatturazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    appuntamento_id INT REFERENCES appuntamenti(id),\n    importo_totale NUMERIC(10,2) NOT NULL CHECK (importo_totale >= 0),\n    data_fattura DATE NOT NULL,\n    saldato BOOLEAN NOT NULL DEFAULT FALSE\n);",
