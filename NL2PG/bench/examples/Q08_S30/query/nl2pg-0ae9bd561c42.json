  "query": "SELECT sup.nome AS nome_supervisore, sup.cognome AS cognome_supervisore, sup.specializzazione AS specializzazione_supervisore, COUNT(*) AS numero_collaboratori FROM medici m JOIN medici sup ON m.medico_supervisore_id = sup.id WHERE m.specializzazione = 'Cardiologia' GROUP BY sup.nome, sup.cognome, sup.specializzazione ORDER BY numero_collaboratori DESC, cognome_supervisore ASC;"
