  "schema_ddl": "CREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    titolo TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu BETWEEN 1 AND 30),\n    anno_corso INT NOT NULL CHECK (anno_corso BETWEEN 1 AND 3),\n    prerequisito_id INT REFERENCES corsi(id),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE esami (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    corso_id INT NOT NULL REFERENCES corsi(id),\n    matricola_studente TEXT NOT NULL,\n    data_appello DATE NOT NULL,\n    voto INT NOT NULL CHECK (voto BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
