  "feature_sql": [
    "correlated_subquery"
  ],
  "query": "SELECT f.ragione_sociale, f.citta, (SELECT COALESCE(ROUND(SUM(o.importo_totale), 2), 0) FROM ordini_acquisto AS o WHERE o.fornitore_id = f.id AND o.stato_ordine = 'confermato') AS valore_confermato FROM fornitori AS f WHERE f.attivo IS TRUE AND f.citta IN ('Torino', 'Bologna') ORDER BY valore_confermato DESC, f.ragione_sociale ASC, f.id"
}