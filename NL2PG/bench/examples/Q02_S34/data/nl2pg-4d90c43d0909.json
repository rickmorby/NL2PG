    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "clienti",
        "obsolete_value": "anagrafica_acquirenti",
        "description": "La tabella padre 'clienti' viene denominata 'anagrafica_acquirenti' nella prosa aziendale. L'agente deve risalire alla tabella reale 'clienti' e considerare che la tabella figlia 'ordini' contiene la FK nullable 'cliente_id' verso di essa."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_totale",
        "obsolete_value": "controvalore transazione",
        "description": "La colonna 'importo_totale' della tabella 'ordini' è indicata nei documenti commerciali con il gergo 'controvalore transazione'. L'agente deve mappare questo termine al nome colonna reale per formulare l'aggregatore scalare (SUM o AVG) senza GROUP BY, gestendo eventualmente gli ordini senza cliente tramite IS NULL o join esterno."
      }
    ],
    "spec_hash": "d99945727c77cda6"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT,\n    citta TEXT\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    scorte_disponibili INT NOT NULL DEFAULT 0 CHECK (scorte_disponibili >= 0)\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT REFERENCES clienti(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);",
