  "feature_sql": [
    "scalar_agg"
  ],
  "query": "SELECT COUNT(*) AS numero_ordini, SUM(o.importo_totale) AS fatturato_totale, ROUND(AVG(o.importo_totale), 2) AS scontrino_medio, MIN(o.importo_totale) AS importo_minimo, MAX(o.importo_totale) AS importo_massimo FROM ordini o JOIN prodotti p ON o.prodotto_id = p.id WHERE p.categoria = 'Informatica' AND o.quantita >= 2;"
}