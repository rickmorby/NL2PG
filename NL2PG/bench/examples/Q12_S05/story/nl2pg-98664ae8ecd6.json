{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_cliente TEXT NOT NULL UNIQUE,\n    ragione_sociale TEXT NOT NULL,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE corrieri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_corriere TEXT NOT NULL,\n    telefono_contatto TEXT\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    corriere_id INT NOT NULL REFERENCES corrieri(id),\n    stato_consegna TEXT NOT NULL DEFAULT 'in_preparazione' CHECK (stato_consegna IN ('in_preparazione', 'in_transito', 'consegnata', 'fallita')),\n    data_spedizione DATE NOT NULL,\n    data_consegna_prevista DATE,\n    indirizzo_destinazione TEXT NOT NULL,\n    CHECK (data_consegna_prevista IS NULL OR data_consegna_prevista >= data_spedizione)\n);\n\nCREATE TABLE colli (\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    numero_collo INT NOT NULL CHECK (numero_collo > 0),\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    contenuto TEXT NOT NULL,\n    PRIMARY KEY (spedizione_id, numero_collo)\n);",
