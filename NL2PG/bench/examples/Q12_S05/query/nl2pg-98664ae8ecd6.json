  "feature_sql": [
    "correlated_subquery"
  ],
  "query": "SELECT c.ragione_sociale, c.citta, (SELECT COUNT(*) FROM spedizioni AS s WHERE s.cliente_id = c.id AND s.stato_consegna = 'consegnata') AS spedizioni_consegnate FROM clienti AS c WHERE c.citta = 'Milano' AND EXISTS(SELECT 1 FROM spedizioni AS s2 WHERE s2.cliente_id = c.id AND s2.stato_consegna = 'in_transito') ORDER BY spedizioni_consegnate DESC, c.id"
}