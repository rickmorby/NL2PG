    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "spedizioni",
        "obsolete_value": "movimenti_merce",
        "description": "La tabella spedizioni viene denominata movimenti_merce nella prosa aziendale. Il progettista deve riconoscere che ogni riferimento ai movimenti di merce corrisponde alla tabella spedizioni nel database."
      },
      {
        "twist_type": "jargon",
        "target_value": "costo_trasporto",
        "obsolete_value": "tariffa_di_vettura",
        "description": "La colonna costo_trasporto della tabella spedizioni viene indicata con il gergo del settore come tariffa_di_vettura. La query richiede di aggregare o confrontare tale valore gestendo i NULL prodotti dal FULL OUTER JOIN tramite COALESCE."
      }
    ],
    "spec_hash": "4f23921bec93c402"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_cliente TEXT NOT NULL UNIQUE,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT,\n    citta TEXT,\n    email TEXT\n);\n\nCREATE TABLE vettori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    telefono TEXT,\n    nazione TEXT NOT NULL DEFAULT 'IT'\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    vettore_id INT REFERENCES vettori(id),\n    numero_documento TEXT NOT NULL UNIQUE,\n    data_spedizione DATE NOT NULL,\n    stato_spedizione TEXT NOT NULL DEFAULT 'in_preparazione',\n    peso_totale_kg NUMERIC(10,2) CHECK (peso_totale_kg > 0),\n    costo_trasporto NUMERIC(12,2) CHECK (costo_trasporto IS NULL OR costo_trasporto >= 0),\n    indirizzo_destinazione TEXT NOT NULL,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE colli (\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    numero_collo INT NOT NULL,\n    descrizione_contenuto TEXT,\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    dimensioni_cm TEXT,\n    PRIMARY KEY (spedizione_id, numero_collo)\n);",
