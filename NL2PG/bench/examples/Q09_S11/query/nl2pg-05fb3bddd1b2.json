  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT v.ragione_sociale, COUNT(*) AS spedizioni_consegnate, ROUND(AVG(s.costo_spedizione), 2) AS costo_medio, SUM(s.costo_spedizione) AS costo_totale FROM vettori v JOIN spedizioni s ON s.codice_vettore = v.codice_vettore WHERE s.stato_spedizione = 'consegnata' GROUP BY v.ragione_sociale HAVING COUNT(*) >= 10 ORDER BY costo_totale DESC;"
}