  "schema_ddl": "CREATE TABLE centro_di_costo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_reparto TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE transazioni_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    centro_di_costo_id INT NOT NULL REFERENCES centro_di_costo(id),\n    quota_movimentata NUMERIC(12,2) NOT NULL CHECK (quota_movimentata >= 0),\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    causale TEXT NOT NULL\n);\n\nCREATE TABLE registri_iva (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    transazione_id INT NOT NULL REFERENCES transazioni_contabili(id),\n    aliquota NUMERIC(4,2) NOT NULL CHECK (aliquota >= 0),\n    imposta NUMERIC(10,2) NOT NULL CHECK (imposta >= 0)\n);",
