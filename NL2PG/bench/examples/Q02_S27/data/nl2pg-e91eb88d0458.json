        "twist_type": "synonym",
        "target_value": "studenti",
        "obsolete_value": "iscritti",
        "description": "La tabella studenti, che contiene i dati anagrafici e la matricola di ciascun studente, viene denominata nella prosa aziendale come 'iscritti'. Il solver deve mappare il termine 'iscritti' alla tabella reale 'studenti' tramite la colonna implicita matricola presente nella tabella esami."
      },
      {
        "twist_type": "rephrase",
        "target_value": "voto",
        "obsolete_value": "valutazione conseguita",
        "description": "La colonna voto della tabella esami, utilizzata per il calcolo della media scalare (scalar_agg), viene indicata nella prosa aziendale con la perifrasi 'valutazione conseguita'. Il solver deve riconoscere che 'valutazione conseguita' si riferisce alla colonna voto quando calcola la media per studente."
      }
    ],
    "spec_hash": "5160e2fc7886d26a"
  },
  "schema_ddl": "CREATE TABLE studenti (\n    matricola TEXT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE,\n    citta_residenza TEXT,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE esami (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL,\n    corso TEXT NOT NULL,\n    voto INT NOT NULL CHECK (voto BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    cfu INT NOT NULL DEFAULT 6 CHECK (cfu > 0),\n    data_esame DATE NOT NULL\n);",
