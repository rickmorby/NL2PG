{
  "schema_ddl": "CREATE TABLE studenti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    matricola TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE registri_valutazioni (\n    id SERIAL PRIMARY KEY,\n    studente_id INT NOT NULL REFERENCES studenti(id),\n    voto_text TEXT NOT NULL CHECK (voto_text ~ '^[0-9]+$'),\n    punti_formativi TEXT NOT NULL CHECK (punti_formativi ~ '^[0-9]+$'),\n    indicatore_qualitativo_prestazione TEXT GENERATED ALWAYS AS (ROUND(CAST(voto_text AS NUMERIC) * 1.0)::TEXT) STORED,\n    voto_absoluto TEXT GENERATED ALWAYS AS (ABS(CAST(voto_text AS NUMERIC))::TEXT) STORED,\n    voto_quadrato TEXT GENERATED ALWAYS AS (POWER(CAST(voto_text AS NUMERIC), 2)::TEXT) STORED\n);",
