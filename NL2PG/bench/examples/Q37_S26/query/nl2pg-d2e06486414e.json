  "feature_sql": [
    "math_funcs"
  ],
  "query": "SELECT s.nome, s.cognome, AVG(CAST(rv.voto_text AS DECIMAL)) AS media_voti, ROUND(CAST(AVG(CAST(rv.voto_text AS DECIMAL)) AS DECIMAL), 2) AS media_voti_arrotondata FROM studenti AS s JOIN registri_valutazioni AS rv ON s.id = rv.studente_id GROUP BY s.nome, s.cognome ORDER BY media_voti_arrotondata DESC, s.nome, s.cognome"
}