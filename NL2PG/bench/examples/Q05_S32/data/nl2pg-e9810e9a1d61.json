  "schema_ddl": "CREATE TABLE centri_di_costo (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, codice_interno TEXT UNIQUE NOT NULL, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_by TEXT NOT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_by TEXT NOT NULL);\n\nCREATE TABLE conti_contabili (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, descrizione TEXT NOT NULL, natura_conto TEXT CHECK (natura_conto IN ('attivo', 'passivo', 'costo', 'ricavo')), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_by TEXT NOT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_by TEXT NOT NULL);\n\nCREATE TABLE registro_movimenti_contabili (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, data_operazione DATE NOT NULL, importo NUMERIC(15, 2) NOT NULL CHECK (importo <> 0), centro_di_costo_id INT REFERENCES centri_di_costo(id), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_by TEXT NOT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_by TEXT NOT NULL);\n\nCREATE TABLE dettagli_movimenti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, registro_id INT NOT NULL REFERENCES registro_movimenti_contabili(id), conto_id INT NOT NULL REFERENCES conti_contabili(id), descrizione_riga TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_by TEXT NOT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_by TEXT NOT NULL);\n\nCREATE TABLE log_audit_sistema (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, tabella_interessata TEXT NOT NULL, operazione TEXT NOT NULL, utente_esecutore TEXT NOT NULL, timestamp_evento TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, created_by TEXT NOT NULL, updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, updated_by TEXT NOT NULL);",
