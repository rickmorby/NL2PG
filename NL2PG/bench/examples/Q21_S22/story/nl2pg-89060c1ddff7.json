{
  "schema_ddl": "CREATE TABLE dim_tempo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data DATE NOT NULL UNIQUE,\n    giorno INT NOT NULL CHECK (giorno BETWEEN 1 AND 31),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    anno INT NOT NULL CHECK (anno BETWEEN 2000 AND 2100),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    giorno_settimana TEXT NOT NULL\n);\n\nCREATE TABLE dim_prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sku TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    sottocategoria TEXT,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario > 0),\n    costo_unitario NUMERIC(10,2) CHECK (costo_unitario >= 0)\n);\n\nCREATE TABLE dim_clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_cliente TEXT NOT NULL UNIQUE,\n    nome_cliente TEXT NOT NULL,\n    regione TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    segmentazione TEXT\n);\n\nCREATE TABLE dim_canali_vendita (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_canale TEXT NOT NULL UNIQUE,\n    tipo_canale TEXT NOT NULL\n);\n\nCREATE TABLE dim_promozioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_promozione TEXT NOT NULL UNIQUE,\n    nome_promozione TEXT NOT NULL,\n    tipo_sconto TEXT NOT NULL,\n    percentuale_sconto NUMERIC(5,2) CHECK (percentuale_sconto BETWEEN 0 AND 100)\n);\n\nCREATE TABLE dim_geografia (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_regione TEXT NOT NULL UNIQUE,\n    nome_regione TEXT NOT NULL,\n    codice_nazione TEXT NOT NULL,\n    nome_nazione TEXT NOT NULL\n);\n\nCREATE TABLE dim_dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_dipendente TEXT NOT NULL UNIQUE,\n    nome_dipendente TEXT NOT NULL,\n    ruolo TEXT NOT NULL,\n    reparto TEXT NOT NULL\n);\n\nCREATE TABLE transazioni_commerciali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_id INT NOT NULL REFERENCES dim_tempo(id),\n    prodotto_id INT NOT NULL REFERENCES dim_prodotti(id),\n    cliente_id INT NOT NULL REFERENCES dim_clienti(id),\n    canale_id INT NOT NULL REFERENCES dim_canali_vendita(id),\n    promozione_id INT REFERENCES dim_promozioni(id),\n    geografia_id INT NOT NULL REFERENCES dim_geografia(id),\n    dipendente_id INT REFERENCES dim_dipendenti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    sconto_applicato NUMERIC(10,2) DEFAULT 0 CHECK (sconto_applicato >= 0),\n    margine NUMERIC(10,2) \n);",
