  ],
  "query": "SELECT\n    numero_ordine,\n    INITCAP(cliente_nome) AS cliente,\n    data_ordine,\n    ROUND(importo_totale, 2)::numeric(12,2) AS importo_netto,\n    CASE WHEN note IS NULL THEN 'senza_note' ELSE note END AS nota_ordine,\n    ROW(stato_ordine, CASE WHEN note IS NULL THEN 'senza_note' ELSE note END) AS stato_e_nota\nFROM ordini\nWHERE stato_ordine IN ('confermato', 'spedito')\n  AND data_ordine BETWEEN DATE '2025-12-01' AND DATE '2026-02-28'\n  AND importo_totale >= 500\n  AND numero_ordine LIKE 'ORD-2026-%'\nORDER BY importo_totale DESC, id ASC\nLIMIT 15;"
}