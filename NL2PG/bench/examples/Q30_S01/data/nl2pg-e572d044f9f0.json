    "spec_hash": "6a293ba826e00607"
  },
  "schema_ddl": "CREATE TABLE ordini (\n    id INT PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    cliente_nome TEXT NOT NULL,\n    data_ordine DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa',\n    note TEXT\n);",
