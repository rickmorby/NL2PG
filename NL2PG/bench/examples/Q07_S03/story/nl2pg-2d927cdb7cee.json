{
  "schema_ddl": "CREATE TABLE utenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    numero_telefono TEXT NOT NULL UNIQUE,\n    data_registrazione TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE servizi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_servizio TEXT NOT NULL,\n    descrizione TEXT,\n    costo_mensile NUMERIC(10, 2) NOT NULL CHECK (costo_mensile >= 0)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    utente_id INT NOT NULL REFERENCES utenti(id),\n    data_attivazione DATE NOT NULL,\n    data_scadenza DATE,\n    stato TEXT NOT NULL DEFAULT 'attivo' CHECK (stato IN ('attivo', 'sospeso', 'chiuso'))\n);\n\nCREATE TABLE contratti_servizi (\n    contratto_id INT NOT NULL REFERENCES contratti(id),\n    servizio_id INT NOT NULL REFERENCES servizi(id),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    PRIMARY KEY (contratto_id, servizio_id)\n);",
