  "schema_ddl": "CREATE TABLE anagrafica_rapporti_bancari (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_iban TEXT NOT NULL UNIQUE,\n    intestatario TEXT NOT NULL,\n    saldo NUMERIC(15, 2) NOT NULL DEFAULT 0.00 CHECK (saldo >= 0),\n    flag_attivazione BOOLEAN NOT NULL DEFAULT TRUE,\n    deleted_at TIMESTAMP WITH TIME ZONE,\n    stato TEXT GENERATED ALWAYS AS (\n        CASE WHEN deleted_at IS NULL THEN 'attivo' ELSE 'eliminato' END\n    ) STORED\n);",
