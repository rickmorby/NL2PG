  "schema_ddl": "CREATE TABLE area_di_spesa_riferimento (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_centro TEXT NOT NULL, codice_centro TEXT UNIQUE NOT NULL);\n\nCREATE TABLE fornitori (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, ragione_sociale TEXT NOT NULL, partita_iva TEXT UNIQUE NOT NULL);\n\nCREATE TABLE fatture (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, numero_fattura TEXT NOT NULL, importo_lordo NUMERIC(15, 2) NOT NULL CHECK (importo_lordo >= 0), fornitore_id INT NOT NULL REFERENCES fornitori(id), centro_di_costo_id INT REFERENCES area_di_spesa_riferimento(id));\n\nCREATE TABLE pagamenti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, fattura_id INT NOT NULL REFERENCES fatture(id), data_pagamento DATE NOT NULL, importo_pagato NUMERIC(15, 2) NOT NULL CHECK (importo_pagato > 0));\n\nCREATE TABLE note_contabili (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, fattura_id INT REFERENCES fatture(id), descrizione TEXT, data_inserimento TIMESTAMP DEFAULT CURRENT_TIMESTAMP);",
