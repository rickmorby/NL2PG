  "feature_sql": [
    "scalar_agg"
  ],
  "query": "SELECT COUNT(*) FILTER (WHERE stato_transazione = 'elaborata') AS conteggio_transazioni_elaborate, COUNT(*) FILTER (WHERE stato_transazione = 'rimborsata') AS conteggio_transazioni_rimborsate, SUM(importo) FILTER (WHERE valuta = 'EUR' AND data_transazione BETWEEN DATE '2026-01-31' - INTERVAL '30 days' AND DATE '2026-01-31') AS totale_euro_ultimi_30_giorni, ROUND(AVG(importo) FILTER (WHERE stato_transazione IN ('elaborata', 'rimborsata')), 2) AS media_importo_transazioni_concluse FROM transazioni_finanziarie WHERE data_transazione >= '2025-10-01';"
}