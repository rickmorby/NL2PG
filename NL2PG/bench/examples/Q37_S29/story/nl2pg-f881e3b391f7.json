{
  "schema_ddl": "CREATE TABLE agenti_immobiliari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    data_assunzione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agente_id INT NOT NULL REFERENCES agenti_immobiliari(id),\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT CHECK (cap ~ '^[0-9]{5}$'),\n    superficie_mq NUMERIC(7,2) CHECK (superficie_mq > 0),\n    numero_vani INT CHECK (numero_vani > 0),\n    prezzo_intero BIGINT NOT NULL CHECK (prezzo_intero >= 0),\n    prezzo_decimali INT NOT NULL DEFAULT 0 CHECK (prezzo_decimali BETWEEN 0 AND 99),\n    descrizione TEXT,\n    inserito_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE clienti_acquirenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE offerte_acquisto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    cliente_id INT NOT NULL REFERENCES clienti_acquirenti(id),\n    offerta_intero BIGINT NOT NULL CHECK (offerta_intero > 0),\n    offerta_decimali INT NOT NULL DEFAULT 0 CHECK (offerta_decimali BETWEEN 0 AND 99),\n    stato_offerta TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_offerta IN ('in_attesa', 'accettata', 'rifiutata', 'ritirata')),\n    data_offerta DATE NOT NULL DEFAULT CURRENT_DATE,\n    scadenza_validita DATE,\n    CONSTRAINT chk_scadenza CHECK (scadenza_validita IS NULL OR scadenza_validita >= data_offerta)\n);",
