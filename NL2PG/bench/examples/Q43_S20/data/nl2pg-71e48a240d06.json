    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "dipendenti",
        "obsolete_value": "anagrafica_personale",
        "description": "La tabella dipendenti viene denominata anagrafica_personale nella prosa aziendale: i requisiti si riferiscono sempre all'anagrafica personale, costringendo a risalire alla tabella fisica dipendenti per costruire l'ordinamento ORDER BY su cognome, nome ed attributi enumerati."
      },
      {
        "twist_type": "jargon",
        "target_value": "stato_impiego",
        "obsolete_value": "regime contrattuale CCNL",
        "description": "La colonna enumerata stato_impiego (ENUM('in_prova','attivo','sospeso','cessato'), con ordine di definizione rilevante per l'ordinamento) viene indicata nei documenti aziendali con il gergo sindacale 'regime contrattuale CCNL': la query deve ordinare i dipendenti per questo campo sfruttando l'ordine dichiarativo del tipo ENUM, senza LIMIT."
      }
    ],
    "spec_hash": "31b6e77c1439fae5"
  },
  "schema_ddl": "CREATE TYPE stato_occupazionale AS ENUM ('in_prova', 'attivo', 'sospeso', 'cessato');\n\nCREATE TYPE modalita_contrattuale AS ENUM ('determinato', 'indeterminato', 'part_time', 'apprendistato');\n\nCREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    sede TEXT,\n    budget_annuo NUMERIC(12,2) CHECK (budget_annuo >= 0)\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL CHECK (data_nascita <= DATE '2007-12-31'),\n    data_assunzione DATE NOT NULL,\n    stato_impiego stato_occupazionale NOT NULL DEFAULT 'in_prova',\n    email TEXT UNIQUE,\n    stipendio_mensile NUMERIC(10,2) NOT NULL CHECK (stipendio_mensile >= 0),\n    dipartimento_id INT REFERENCES dipartimenti(id)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id) ON DELETE CASCADE,\n    tipologia modalita_contrattuale NOT NULL DEFAULT 'determinato',\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    retribuzione_mensile NUMERIC(10,2) NOT NULL CHECK (retribuzione_mensile >= 0),\n    CHECK (data_fine IS NULL OR data_fine > data_inizio)\n);\n\nCREATE TABLE ferie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id) ON DELETE CASCADE,\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL,\n    motivazione TEXT,\n    approvata BOOLEAN NOT NULL DEFAULT FALSE,\n    giorni_fruiti INT GENERATED ALWAYS AS ((data_fine - data_inizio) + 1) STORED,\n    CHECK (data_fine >= data_inizio)\n);",
