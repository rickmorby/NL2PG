  "query": "SELECT c.citta AS citta_cliente, COUNT(*) AS numero_spedizioni_consegnate, SUM(s.costo_totale) AS fatturato_totale, ROUND(AVG(s.peso_totale_kg), 2) AS peso_medio_spedizione_kg FROM spedizioni s JOIN clienti c ON s.cliente_id = c.id WHERE s.stato_spedizione = 'consegnata' AND s.data_spedizione BETWEEN '2026-01-01' AND '2026-01-31' AND s.deleted_at IS NULL GROUP BY c.citta ORDER BY fatturato_totale DESC;"
}