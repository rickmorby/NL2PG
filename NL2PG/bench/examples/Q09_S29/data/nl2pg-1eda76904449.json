  "schema_ddl": "CREATE TABLE magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    capacita_max NUMERIC(10,2) CHECK (capacita_max > 0)\n);\n\nCREATE TABLE consegne (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    magazzino_id INT NOT NULL REFERENCES magazzini(id),\n    data_consegna DATE NOT NULL,\n    peso_totale NUMERIC(10,2) CHECK (peso_totale > 0),\n    stato_consegna TEXT NOT NULL\n);",
