{
  "schema_ddl": "CREATE TYPE fase_contrattuale AS ENUM ('bozza', 'attiva', 'sospesa', 'scaduta', 'annullata');\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    fase_contrattuale fase_contrattuale NOT NULL DEFAULT 'bozza',\n    premio_annuale NUMERIC(12,2) NOT NULL CHECK (premio_annuale >= 0),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    CHECK (data_scadenza > data_emissione)\n);\n\nCREATE TABLE sinistri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    polizza_id INT NOT NULL REFERENCES polizze(id) ON DELETE CASCADE,\n    codice_sinistro TEXT NOT NULL UNIQUE,\n    data_evento DATE NOT NULL,\n    importo_richiesto NUMERIC(12,2) NOT NULL CHECK (importo_richiesto >= 0),\n    approvato BOOLEAN NOT NULL DEFAULT FALSE\n);",
