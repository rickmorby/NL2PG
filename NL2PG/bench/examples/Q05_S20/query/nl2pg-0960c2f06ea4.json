  "feature_sql": [
    "group_agg"
  ],
  "query": "SELECT p.fase_contrattuale, COUNT(DISTINCT p.id) AS numero_polizze, ROUND(AVG(p.premio_annuale), 2) AS premio_medio FROM polizze p WHERE p.fase_contrattuale IN ('attiva', 'sospesa', 'bozza') AND (p.premio_annuale BETWEEN 400 AND 2000) GROUP BY p.fase_contrattuale ORDER BY premio_medio DESC;"
}