{
  "schema_ddl": "CREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    data_assunzione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT,\n    telefono TEXT\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT,\n    superficie NUMERIC(7,2) CHECK (superficie > 0),\n    numero_locali INT CHECK (numero_locali > 0),\n    prezzo_richiesto NUMERIC(12,2) NOT NULL CHECK (prezzo_richiesto >= 0),\n    tipo_immobile TEXT NOT NULL CHECK (tipo_immobile IN ('appartamento', 'villa', 'attico', 'terreno', 'ufficio', 'negozio')),\n    stato TEXT NOT NULL CHECK (stato IN ('disponibile', 'riservato', 'venduto', 'ritirato')),\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    data_inserimento DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE proprieta (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    descrizione TEXT,\n    superficie NUMERIC(7,2) CHECK (superficie > 0),\n    prezzo NUMERIC(12,2) CHECK (prezzo >= 0),\n    proprietario_nome TEXT NOT NULL,\n    comune TEXT\n);\n\nCREATE TABLE unita_immobiliari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    superficie NUMERIC(7,2) CHECK (superficie > 0),\n    prezzo NUMERIC(12,2) CHECK (prezzo >= 0),\n    piano INT,\n    interno TEXT,\n    riscaldamento_autonomo BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE visite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_visita TIMESTAMP NOT NULL,\n    esito TEXT CHECK (esito IN ('positivo', 'negativo', 'da_contattare')),\n    note TEXT\n);\n\nCREATE TABLE offerte (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    importo_offerta NUMERIC(12,2) NOT NULL CHECK (importo_offerta > 0),\n    data_offerta DATE NOT NULL,\n    stato_offerta TEXT NOT NULL CHECK (stato_offerta IN ('in_attesa', 'accettata', 'rifiutata', 'ritirata'))\n);\n\nCREATE TABLE contratti_vendita (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL UNIQUE REFERENCES immobili(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    prezzo_finale NUMERIC(12,2) NOT NULL CHECK (prezzo_finale >= 0),\n    data_contratto DATE NOT NULL,\n    notaio TEXT\n);\n\nCREATE TABLE appuntamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    immobile_id INT REFERENCES immobili(id),\n    data_appuntamento TIMESTAMP NOT NULL,\n    tipo_appuntamento TEXT NOT NULL CHECK (tipo_appuntamento IN ('consulenza', 'visita', 'firma', 'valutazione'))\n);",
