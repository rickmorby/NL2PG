  "feature_sql": [
    "cte"
  ],
  "query": "WITH vendite_per_agente AS (\n    SELECT agente_id,\n           COUNT(*) AS numero_contratti,\n           SUM(prezzo_finale) AS fatturato_totale\n    FROM contratti_vendita\n    GROUP BY agente_id\n)\nSELECT a.nome,\n       a.cognome,\n       v.numero_contratti,\n       ROUND(v.fatturato_totale, 2) AS fatturato_agente\nFROM agenti a\nJOIN vendite_per_agente v ON a.id = v.agente_id\nWHERE a.cognome = 'Greco'\nORDER BY fatturato_agente DESC;"
}