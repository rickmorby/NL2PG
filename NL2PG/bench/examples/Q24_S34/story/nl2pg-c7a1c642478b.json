  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_cliente TEXT NOT NULL,\n    email TEXT UNIQUE NOT NULL\n);\n\nCREATE TABLE portafogli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    nome_portafoglio TEXT NOT NULL,\n    data_creazione TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE investimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    portafoglio_id INT REFERENCES portafogli(id),\n    ticker TEXT NOT NULL,\n    quantita NUMERIC(18, 8) NOT NULL CHECK (quantita > 0),\n    prezzo_acquisto NUMERIC(19, 4) NOT NULL CHECK (prezzo_acquisto >= 0)\n);",
