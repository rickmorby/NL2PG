  "schema_ddl": "CREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    premio_annuo NUMERIC(12,2) NOT NULL CHECK (premio_annuo >= 0),\n    data_sottoscrizione DATE NOT NULL DEFAULT CURRENT_DATE,\n    polizza_padre_id INT REFERENCES polizze(id) ON DELETE CASCADE,\n    CHECK (id <> polizza_padre_id),\n    CHECK (length(trim(numero_polizza)) > 0),\n    CHECK (length(trim(descrizione)) > 0)\n);",
