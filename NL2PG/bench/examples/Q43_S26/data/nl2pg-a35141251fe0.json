    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "registrazioni",
        "obsolete_value": "scritture_di_prima_nota",
        "description": "La tabella registrazioni, che contiene il giornale delle operazioni contabili dell'esercizio, viene denominata nella prosa aziendale come scritture_di_prima_nota. Le query devono risolvere questa denominazione verso il nome fisico reale della tabella."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo",
        "obsolete_value": "valore_nominalmente_espresso",
        "description": "La colonna importo della tabella movimenti_contabili è fisicamente di tipo TEXT pur contenendo valori logicamente numerici (es. '1250.50'); il gergo contabile della documentazione la indica come valore_nominalmente_espresso. Per ordinare correttamente i risultati con ORDER BY è obbligatorio applicare CAST(importo AS NUMERIC), altrimenti l'ordinamento lessicografico del testo produrrebbe sequenze errate (es. '950' dopo '1250')."
      }
    ],
    "spec_hash": "d8394b786178cad0"
  },
  "schema_ddl": "CREATE TABLE esercizi (\n    id INT PRIMARY KEY,\n    anno INT NOT NULL UNIQUE,\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL,\n    chiuso BOOLEAN NOT NULL DEFAULT FALSE,\n    CHECK (data_fine > data_inizio)\n);\n\nCREATE TABLE conti (\n    id INT PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    tipo_conto TEXT NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'costo', 'ricavo'))\n);\n\nCREATE TABLE registrazioni (\n    id INT PRIMARY KEY,\n    esercizio_id INT NOT NULL REFERENCES esercizi(id),\n    numero_registrazione INT NOT NULL,\n    data_registrazione DATE NOT NULL,\n    descrizione TEXT NOT NULL,\n    UNIQUE (esercizio_id, numero_registrazione),\n    CHECK (numero_registrazione > 0)\n);\n\nCREATE TABLE movimenti_contabili (\n    id INT PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni(id),\n    conto_id INT NOT NULL REFERENCES conti(id),\n    importo NUMERIC(12,2) NOT NULL,\n    dare_avere TEXT NOT NULL CHECK (dare_avere IN ('dare', 'avere')),\n    data_valuta DATE NOT NULL\n);",
