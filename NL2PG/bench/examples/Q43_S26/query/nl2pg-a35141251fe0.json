  "query": "SELECT r.descrizione AS descrizione_registrazione, c.codice_conto AS codice_conto, c.denominazione AS denominazione_conto, m.importo::numeric AS importo_movimento, m.data_valuta AS data_valuta FROM movimenti_contabili m JOIN registrazioni r ON m.registrazione_id = r.id JOIN conti c ON m.conto_id = c.id WHERE m.dare_avere = 'dare' AND c.tipo_conto = 'costo' ORDER BY importo_movimento DESC, data_valuta ASC, m.id ASC;"
}