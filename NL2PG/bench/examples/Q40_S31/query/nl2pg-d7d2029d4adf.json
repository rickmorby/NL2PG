{
  "schema_ddl": "CREATE TABLE periodi_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_periodo TEXT NOT NULL UNIQUE,\n    esercizio INT NOT NULL,\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL,\n    CHECK (data_fine >= data_inizio)\n);\n\nCREATE TABLE conti_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    tipo_conto TEXT NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'costo', 'ricavo', 'patrimonio'))\n);\n\nCREATE TABLE centri_di_costo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_centro TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    budget_annuale NUMERIC(14,2) CHECK (budget_annuale >= 0)\n);\n\nCREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    codice_fiscale TEXT,\n    totale_fatturato NUMERIC(14,2) DEFAULT 0 CHECK (totale_fatturato >= 0),\n    n_registrazioni INT DEFAULT 0 CHECK (n_registrazioni >= 0)\n);\n\nCREATE TABLE prima_nota_sintetica (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    periodo_id INT NOT NULL REFERENCES periodi_contabili(id),\n    conto_id INT NOT NULL REFERENCES conti_contabili(id),\n    centro_costo_id INT REFERENCES centri_di_costo(id),\n    fornitore_id INT REFERENCES fornitori(id),\n    voce_di_bilancio TEXT NOT NULL,\n    fornitore_nome TEXT,\n    valore_al_netto_iva NUMERIC(12,2) NOT NULL CHECK (valore_al_netto_iva >= 0),\n    importo_iva NUMERIC(12,2) DEFAULT 0 CHECK (importo_iva >= 0),\n    importo_totale NUMERIC(12,2) CHECK (importo_totale >= 0),\n    descrizione TEXT,\n    segno TEXT NOT NULL CHECK (segno IN ('D', 'A'))\n);",
