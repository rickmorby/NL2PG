  "feature_sql": [
    "in_condition"
  ],
  "query": "SELECT cdc.denominazione AS denominazione_centro, SUM(pns.valore_al_netto_iva) AS totale_netto_iva, COUNT(*) AS numero_registrazioni FROM prima_nota_sintetica pns JOIN conti_contabili cc ON pns.conto_id = cc.id JOIN centri_di_costo cdc ON pns.centro_costo_id = cdc.id WHERE cc.tipo_conto IN ('costo', 'ricavo') AND pns.segno = 'D' GROUP BY cdc.denominazione ORDER BY totale_netto_iva DESC;"
}