{
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL UNIQUE,\n    budget_annuale NUMERIC(15, 2) CHECK (budget_annuale >= 0)\n); CREATE TABLE risorse_censite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    stipendio_lordo NUMERIC(12,2) NOT NULL,\n    dipartimento_id INT REFERENCES dipartimenti(id)\n); CREATE TABLE storico_variazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    risorsa_id INT NOT NULL REFERENCES risorse_censite(id),\n    descrizione_variazione TEXT,\n    data_applicazione DATE DEFAULT CURRENT_DATE,\n    tipo_variazione TEXT CHECK (tipo_variazione IN ('PROMOZIONE', 'ADEGUAMENTO', 'BONUS'))\n);",
