  "feature_sql": [
    "case"
  ],
  "query": "SELECT r.nome, r.cognome, d.nome_dipartimento, COUNT(s.id) AS totale_variazioni, SUM(CASE WHEN s.tipo_variazione = 'PROMOZIONE' THEN 1 ELSE 0 END) AS numero_promozioni, SUM(CASE WHEN s.tipo_variazione = 'ADEGUAMENTO' THEN 1 ELSE 0 END) AS numero_adeguamenti, SUM(CASE WHEN s.tipo_variazione = 'BONUS' THEN 1 ELSE 0 END) AS numero_bonus FROM risorse_censite AS r JOIN dipartimenti AS d ON r.dipartimento_id = d.id LEFT JOIN storico_variazioni AS s ON r.id = s.risorsa_id GROUP BY r.nome, r.cognome, d.nome_dipartimento ORDER BY totale_variazioni DESC, r.cognome ASC, r.nome ASC, r.nome, r.cognome, d.nome_dipartimento"
}