  "feature_sql": [
    "distinct_on"
  ],
  "query": "SELECT DISTINCT ON (e.corso_id) c.titolo AS titolo_corso, c.docente AS docente_corso, INITCAP(s.nome || ' ' || s.cognome) AS studente_migliore, e.voto AS voto_ottenuto, e.data_esame AS data_esame_top FROM esami e JOIN corsi c ON c.id = e.corso_id JOIN studenti s ON s.id = e.studente_id WHERE e.voto >= 18 ORDER BY e.corso_id, e.voto DESC, e.data_esame ASC, e.id ASC;"
}