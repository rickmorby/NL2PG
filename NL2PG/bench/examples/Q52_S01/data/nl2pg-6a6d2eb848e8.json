  "schema_ddl": "CREATE TABLE contratti_assicurativi (\n    id SERIAL PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    cliente TEXT NOT NULL,\n    premio_annuo NUMERIC(12,2) NOT NULL CHECK (premio_annuo > 0),\n    data_sottoscrizione DATE NOT NULL,\n    data_scadenza DATE NOT NULL CHECK (data_scadenza > data_sottoscrizione),\n    stato TEXT NOT NULL DEFAULT 'attivo' CHECK (stato IN ('attivo', 'sospeso', 'scaduto', 'annullato')),\n    tipo_copertura TEXT NOT NULL CHECK (tipo_copertura IN ('auto', 'casa', 'salute', 'vita', 'responsabilità civile'))\n);",
