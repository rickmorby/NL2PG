    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "traffico_dati",
        "obsolete_value": "log_consumi",
        "description": "La tabella che registra il traffico dati degli utenti è denominata 'log_consumi' nella documentazione aziendale, mentre nel database è 'traffico_dati'."
      },
      {
        "twist_type": "jargon",
        "target_value": "volume_mb",
        "obsolete_value": "throughput",
        "description": "La colonna che rappresenta il volume di dati in megabyte è indicata come 'throughput' nei report tecnici, mentre nel database è 'volume_mb'."
      },
      {
        "twist_type": "polysemy",
        "target_value": "data_attivazione",
        "obsolete_value": "data",
        "description": "La colonna 'data_attivazione' (data di attivazione del contratto) viene spesso abbreviata come 'data' nei documenti, creando ambiguità con altre colonne di tipo data (es. 'data_ultimo_accesso')."
      }
    ],
    "spec_hash": "1f2c1976125baf02"
  },
  "schema_ddl": "CREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_attivazione TEXT NOT NULL,\n    data_scadenza TEXT,\n    stato_contratto TEXT NOT NULL CHECK (stato_contratto IN ('attivo', 'sospeso', 'terminato')),\n    CHECK (data_attivazione ~ '^\\d{4}-\\d{2}-\\d{2}$'),\n    CHECK (data_scadenza IS NULL OR data_scadenza ~ '^\\d{4}-\\d{2}-\\d{2}$')\n);\n\nCREATE TABLE utenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti(id) ON DELETE CASCADE,\n    nome_utente TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    data_ultimo_accesso TEXT,\n    CHECK (email ~ '^[^@]+@[^@]+\\.[^@]+$'),\n    CHECK (data_ultimo_accesso IS NULL OR data_ultimo_accesso ~ '^\\d{4}-\\d{2}-\\d{2}$')\n);\n\nCREATE TABLE traffico_dati (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    utente_id INT NOT NULL REFERENCES utenti(id) ON DELETE CASCADE,\n    data_registrazione TEXT NOT NULL,\n    volume_mb TEXT NOT NULL,\n    tipo_traffico TEXT NOT NULL CHECK (tipo_traffico IN ('mobile', 'fisso', 'roaming')),\n    CHECK (data_registrazione ~ '^\\d{4}-\\d{2}-\\d{2}$'),\n    CHECK (volume_mb ~ '^\\d+(\\.\\d+)?$'),\n    durata_sessione_minuti INT GENERATED ALWAYS AS (CAST(volume_mb AS NUMERIC) / 10.0) STORED\n);",
