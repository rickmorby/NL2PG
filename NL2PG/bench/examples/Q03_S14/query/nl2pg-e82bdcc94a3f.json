  "query": "SELECT s.destinatario, m.nome AS magazzino_partenza, m.citta AS citta_magazzino, s.peso_kg AS peso_spedizione, s.data_spedizione AS data_partenza, CASE WHEN s.data_consegna IS NULL THEN 'in attesa di consegna' ELSE 'consegnata il ' || s.data_consegna::text END AS esito_consegna FROM spedizioni s JOIN magazzini m ON s.magazzino_id = m.id WHERE s.stato = 'consegnata' AND s.peso_kg BETWEEN 2 AND 20 ORDER BY s.peso_kg DESC, s.data_spedizione ASC LIMIT 10;"
