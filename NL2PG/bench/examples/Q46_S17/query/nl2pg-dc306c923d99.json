{
  "schema_ddl": "CREATE TABLE conti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    saldo_iniziale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (saldo_iniziale >= 0),\n    deleted_at TIMESTAMP,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE registrazioni_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_scrittura TEXT NOT NULL UNIQUE,\n    data_registrazione DATE NOT NULL,\n    descrizione TEXT NOT NULL,\n    deleted_at TIMESTAMP,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_registrazione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni_contabili(id) ON DELETE CASCADE,\n    conto_id INT NOT NULL REFERENCES conti(id),\n    importo_dare NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    descrizione_riga TEXT,\n    deleted_at TIMESTAMP,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (importo_dare > 0 OR importo_avere > 0)\n);",
