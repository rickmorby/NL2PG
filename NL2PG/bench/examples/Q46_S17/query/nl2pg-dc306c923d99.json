  "feature_sql": [
    "relative_time"
  ],
  "query": "SELECT c.denominazione AS conto, c.codice_conto AS codice_conto, SUM(rr.importo_dare) AS totale_dare, SUM(rr.importo_avere) AS totale_avere, ROUND(SUM(rr.importo_dare - rr.importo_avere), 2) AS saldo_movimenti FROM conti c JOIN righe_registrazione rr ON rr.conto_id = c.id JOIN registrazioni_contabili reg ON reg.id = rr.registrazione_id WHERE reg.data_registrazione >= DATE '2026-01-28' - INTERVAL '90 days' AND c.deleted_at IS NULL AND reg.deleted_at IS NULL AND rr.deleted_at IS NULL GROUP BY c.codice_conto, c.denominazione ORDER BY saldo_movimenti DESC, c.codice_conto ASC;"
}