  "schema_ddl": "CREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    telefono TEXT,\n    email TEXT UNIQUE,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE anagrafica_utenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    data_nascita DATE NOT NULL,\n    sesso CHAR(1) NOT NULL CHECK (sesso IN ('M', 'F', 'X')),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    indirizzo_residenza TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE prestazioni_diagnostiche (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    anagrafica_utenti_id INT NOT NULL REFERENCES anagrafica_utenti(id),\n    codice_prestazione TEXT NOT NULL,\n    descrizione TEXT NOT NULL,\n    data_prestazione DATE NOT NULL,\n    costo NUMERIC(10,2) NOT NULL CHECK (costo >= 0),\n    stato TEXT NOT NULL CHECK (stato IN ('prenotata', 'eseguita', 'annullata'))\n);",
