  "feature_sql": [
    "distinct_on"
  ],
  "query": "SELECT DISTINCT ON (d.nome) d.nome, pa.cognome AS cognome_docente, pa.email AS email_docente FROM dipartimenti d LEFT JOIN personale_accademico pa ON d.id = pa.id_dipartimento WHERE d.nome LIKE '%Dipartimento%' AND d.codice_struttura IS NOT NULL ORDER BY d.nome, pa.cognome;"
}