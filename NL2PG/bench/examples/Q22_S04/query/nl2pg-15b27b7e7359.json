{
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_struttura TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE personale_accademico (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    id_dipartimento INT NOT NULL REFERENCES dipartimenti(id),\n    email TEXT NOT NULL UNIQUE CHECK (email ~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,4}$')\n);",
