  "query": "SELECT c.nome, c.cognome, c.citta, ultimo_ordine.data_ordine AS data_ultimo_ordine_consegnato, ultimo_ordine.importo_totale AS importo_ultimo_ordine FROM clienti AS c LEFT JOIN LATERAL (SELECT o.data_ordine, o.importo_totale FROM ordini AS o WHERE o.cliente_id = c.id AND o.stato = 'consegnato' ORDER BY o.data_ordine DESC LIMIT 1) AS ultimo_ordine ON TRUE WHERE c.citta = 'Milano' ORDER BY ultimo_ordine.importo_totale DESC NULLS LAST, c.id"
}