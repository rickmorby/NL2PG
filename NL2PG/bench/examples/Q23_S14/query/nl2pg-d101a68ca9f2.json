{
  "schema_ddl": "CREATE DOMAIN importo_euro AS NUMERIC(12,2) CHECK (VALUE >= 0);\n\nCREATE DOMAIN stato_contratto AS TEXT CHECK (VALUE IN ('proposta', 'compromesso', 'stipulato', 'annullato'));\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    indirizzo TEXT NOT NULL,\n    comune TEXT NOT NULL,\n    provincia CHAR(2) CHECK (LENGTH(TRIM(provincia)) = 2),\n    tipo_immobile TEXT NOT NULL CHECK (tipo_immobile IN ('appartamento', 'villa', 'terreno', 'ufficio', 'negozio')),\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    prezzo_richiesto importo_euro NOT NULL,\n    data_inserimento DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    data_stipula DATE NOT NULL,\n    importo importo_euro NOT NULL CHECK (importo > 0),\n    stato stato_contratto NOT NULL DEFAULT 'proposta',\n    note TEXT\n);",
