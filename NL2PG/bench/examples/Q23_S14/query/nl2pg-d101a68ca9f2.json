  "feature_sql": [
    "filtered_agg"
  ],
  "query": "SELECT i.comune, i.tipo_immobile, COUNT(*) AS totale_contratti, COUNT(*) FILTER (WHERE c.stato = 'stipulato') AS contratti_stipulati, ROUND(SUM(c.importo) FILTER (WHERE c.stato = 'stipulato'), 2) AS valore_totale_stipulato FROM immobili i JOIN contratti c ON c.immobile_id = i.id WHERE i.tipo_immobile IN ('appartamento', 'villa') GROUP BY i.comune, i.tipo_immobile ORDER BY valore_totale_stipulato DESC;"
}