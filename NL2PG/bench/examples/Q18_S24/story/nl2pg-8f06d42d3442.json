{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT,\n    citta_residenza TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE offerte_promo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_promo TEXT NOT NULL,\n    sconto_percentuale NUMERIC(5,2) NOT NULL CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    CHECK (data_fine IS NULL OR data_fine >= data_inizio)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE,\n    promo_id INT REFERENCES offerte_promo(id) ON DELETE RESTRICT,\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_attivazione DATE NOT NULL,\n    data_disdetta DATE,\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    CHECK (data_disdetta IS NULL OR data_disdetta >= data_attivazione)\n);\n\nCREATE TABLE sim (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT REFERENCES contratti(id) ON DELETE SET NULL,\n    iccid TEXT NOT NULL UNIQUE,\n    numero_msisdn TEXT NOT NULL UNIQUE,\n    stato_sim TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_sim IN ('attiva', 'sospesa', 'cessata')),\n    data_attivazione DATE NOT NULL\n);",
