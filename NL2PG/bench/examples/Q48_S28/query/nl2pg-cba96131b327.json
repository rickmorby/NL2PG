{
  "schema_ddl": "CREATE TABLE agenzie (\n    ag_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_agenzia TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    CONSTRAINT chk_nome_agenzia CHECK (length(nome_agenzia) > 0)\n);\n\nCREATE TABLE immobili (\n    codice_immobile TEXT PRIMARY KEY,\n    ag_id INT NOT NULL REFERENCES agenzie(ag_id),\n    indirizzo TEXT NOT NULL,\n    prezzo NUMERIC(12,2) NOT NULL CHECK (prezzo > 0),\n    superficie INT NOT NULL CHECK (superficie > 0)\n);\n\nCREATE TABLE contratti (\n    contratto_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_immobile TEXT NOT NULL REFERENCES immobili(codice_immobile),\n    tipo_contratto TEXT NOT NULL CHECK (tipo_contratto IN ('vendita', 'affitto')),\n    data_stipula DATE NOT NULL,\n    valore_transazione NUMERIC(12,2) NOT NULL CHECK (valore_transazione >= 0)\n);",
