  "query": "SELECT d.nome, d.cognome, c.tipo_contratto FROM dipendenti d JOIN contratti c ON d.id = c.dipendente_id WHERE c.data_fine IS NULL AND (c.tipo_contratto = 'tempo_indeterminato' OR c.tipo_contratto = 'apprendistato') ORDER BY d.cognome ASC, d.nome ASC, c.id ASC;"
