{
  "schema_ddl": "CREATE TABLE aree_funzionali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL,\n    codice_sede TEXT\n);\n\nCREATE TABLE dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    dipartimento_id INT REFERENCES aree_funzionali(id) ON DELETE SET NULL\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id) ON DELETE CASCADE,\n    tipo_contratto TEXT NOT NULL CHECK (tipo_contratto IN ('tempo_indeterminato', 'tempo_determinato', 'apprendistato')),\n    data_inizio DATE NOT NULL,\n    data_fine DATE\n);",
