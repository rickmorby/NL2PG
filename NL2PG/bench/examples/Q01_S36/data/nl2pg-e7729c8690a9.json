        "obsolete_value": "registrazione_contrattuale",
        "description": "La tabella polizze viene denominata registrazione_contrattuale nella prosa aziendale. La query deve quindi risolvere il nome reale della tabella senza effettuare join, applicando la WHERE sulle colonne locali."
      },
      {
        "twist_type": "jargon",
        "target_value": "dati_assicurato",
        "obsolete_value": "scheda tecnica del soggetto coperto",
        "description": "La colonna composita dati_assicurato (di tipo composito definito tramite CREATE TYPE) viene indicata nella documentazione aziendale con il gergo assicurativo 'scheda tecnica del soggetto coperto'. I campi interni del tipo composito devono essere interrogati con la notazione (dati_assicurato).campo sia nella SELECT che nella WHERE."
      }
    ],
    "spec_hash": "cce4b4cdb1aec7b7"
  },
  "schema_ddl": "CREATE TYPE tipo_soggetto_coperto AS (\n    nome TEXT,\n    cognome TEXT,\n    codice_fiscale TEXT,\n    data_nascita DATE\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    filiale TEXT\n);\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    agente_id INT REFERENCES agenti(id),\n    ramo_polizza TEXT NOT NULL CHECK (ramo_polizza IN ('auto', 'vita', 'casa', 'salute', 'responsabilita_civile')),\n    premio_annuo NUMERIC(10,2) NOT NULL CHECK (premio_annuo >= 0),\n    capitale_assicurato NUMERIC(12,2) NOT NULL CHECK (capitale_assicurato >= 0),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    dati_assicurato tipo_soggetto_coperto NOT NULL,\n    CHECK (data_scadenza > data_emissione)\n);",
