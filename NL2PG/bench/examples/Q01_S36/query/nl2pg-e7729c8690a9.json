  "feature_sql": [],
  "query": "SELECT c.nome AS nome_cliente, c.cognome AS cognome_cliente, COUNT(*) AS numero_polizze, ROUND(SUM(p.premio_annuo), 2) AS premio_totale, RANK() OVER (ORDER BY SUM(p.premio_annuo) DESC) AS posizione FROM clienti c JOIN polizze p ON p.cliente_id = c.id WHERE p.ramo_polizza = 'vita' AND p.data_emissione BETWEEN DATE '2024-01-01' AND DATE '2025-06-30' GROUP BY c.nome, c.cognome ORDER BY posizione ASC, cognome_cliente ASC, nome_cliente ASC;"
}