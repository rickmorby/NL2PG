  "feature_sql": [
    "full_outer_join"
  ],
  "query": "WITH clienti_premium AS (\n    SELECT s.id, s.ragione_sociale, c.limite_credito, c.sconto_percentuale\n    FROM clienti c\n    JOIN soggetti s ON s.id = c.id\n    WHERE c.limite_credito >= 20000\n),\nfornitori_affidabili AS (\n    SELECT s.id, s.ragione_sociale, f.punteggio_qualita, f.termine_pagamento_giorni\n    FROM fornitori f\n    JOIN soggetti s ON s.id = f.id\n    WHERE f.punteggio_qualita >= 7.50\n)\nSELECT COALESCE(cp.ragione_sociale, fa.ragione_sociale) AS ragione_sociale,\n       CASE\n           WHEN cp.id IS NOT NULL AND fa.id IS NOT NULL THEN 'cliente e fornitore'\n           WHEN cp.id IS NOT NULL THEN 'solo cliente'\n           ELSE 'solo fornitore'\n       END AS ruolo_riconciliato,\n       cp.limite_credito AS limite_credito_cliente,\n       cp.sconto_percentuale AS sconto_applicato_cliente,\n       fa.punteggio_qualita AS punteggio_qualita_fornitore,\n       CAST(ROUND(fa.termine_pagamento_giorni) AS INT) AS termine_pagamento_giorni\nFROM clienti_premium cp\nFULL OUTER JOIN fornitori_affidabili fa ON cp.ragione_sociale = fa.ragione_sociale\nORDER BY ruolo_riconciliato ASC, ragione_sociale ASC, limite_credito_cliente DESC NULLS LAST, COALESCE(cp.id, fa.id) ASC;"
}