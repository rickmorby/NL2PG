        "obsolete_value": "classificazione master data",
        "description": "La colonna discriminatore 'tipo_soggetto' della tabella base viene indicata con il gergo ERP 'classificazione master data'. Il solver deve mappare il termine tecnico di settore alla colonna discriminatore usata per instradare verso i sottotipi."
      },
      {
        "twist_type": "synonym",
        "target_value": "fornitori",
        "obsolete_value": "fonti di approvvigionamento",
        "description": "La tabella sottotipo 'fornitori' viene indicata nella prosa come 'fonti di approvvigionamento'. Il solver deve risolvere il sinonimo aziendale per identificare correttamente la tabella del sottotipo da joinare con FULL OUTER JOIN, preservando gli orfani di entrambi i lati tramite COALESCE o IS NULL."
      }
    ],
    "spec_hash": "55de69abdec4dd9b"
  },
  "schema_ddl": "CREATE TABLE soggetti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT UNIQUE,\n    tipo_soggetto TEXT NOT NULL CHECK (tipo_soggetto IN ('cliente', 'fornitore', 'dipendente')),\n    email_contatto TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE clienti (\n    id INT PRIMARY KEY REFERENCES soggetti(id) ON DELETE CASCADE,\n    limite_credito NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (limite_credito >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    data_primo_ordine DATE\n);\n\nCREATE TABLE fornitori (\n    id INT PRIMARY KEY REFERENCES soggetti(id) ON DELETE CASCADE,\n    partita_iva TEXT NOT NULL UNIQUE,\n    termine_pagamento_giorni INT NOT NULL DEFAULT 30 CHECK (termine_pagamento_giorni >= 0),\n    punteggio_qualita NUMERIC(3,1) CHECK (punteggio_qualita BETWEEN 0 AND 10)\n);\n\nCREATE TABLE dipendenti (\n    id INT PRIMARY KEY REFERENCES soggetti(id) ON DELETE CASCADE,\n    matricola TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL,\n    stipendio_mensile NUMERIC(10,2) NOT NULL CHECK (stipendio_mensile > 0)\n);",
