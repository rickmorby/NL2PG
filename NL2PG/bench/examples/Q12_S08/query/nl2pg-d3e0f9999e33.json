  "feature_sql": [
    "correlated_subquery"
  ],
  "query": "SELECT b.nome_beneficiario, b.causale, o.importo AS importo_bonifico, o.data_operazione, (SELECT COUNT(*) FROM bonifici b2 WHERE b2.nome_beneficiario = b.nome_beneficiario) AS bonifici_totali_beneficiario, ROUND(o.importo / NULLIF((SELECT AVG(o2.importo) FROM operazioni o2 JOIN bonifici b2 ON b2.id = o2.id WHERE b2.nome_beneficiario = b.nome_beneficiario), 0), 2) AS rapporto_importo_media FROM bonifici b JOIN operazioni o ON o.id = b.id WHERE o.tipo_operazione = 'bonifico' AND o.importo BETWEEN 500 AND 5000 AND b.causale IS NOT NULL ORDER BY o.importo DESC, b.id ASC LIMIT 15;"
}