{
  "schema_ddl": "CREATE TABLE movimenti_contabili (\n    id SERIAL PRIMARY KEY,\n    data_registrazione TEXT NOT NULL,\n    numero_conto TEXT NOT NULL,\n    descrizione_scrittura TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL,\n    tipo_scrittura TEXT NOT NULL,\n    documento_riferimento TEXT,\n    CHECK (data_registrazione ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\n    CHECK (tipo_scrittura IN ('attivo', 'passivo'))\n);",
