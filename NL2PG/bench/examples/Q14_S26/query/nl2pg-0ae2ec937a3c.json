  "query": "SELECT numero_conto, 'attivo' AS categoria_scrittura, COUNT(*) AS numero_scritture, ROUND(SUM(importo::numeric), 2) AS totale_importo FROM movimenti_contabili WHERE tipo_scrittura = 'attivo' GROUP BY numero_conto UNION ALL SELECT numero_conto, 'passivo' AS categoria_scrittura, COUNT(*) AS numero_scritture, ROUND(SUM(importo::numeric), 2) AS totale_importo FROM movimenti_contabili WHERE tipo_scrittura = 'passivo' GROUP BY numero_conto ORDER BY numero_conto ASC, categoria_scrittura ASC;"
}