  "query": "SELECT 'Attive' AS tipologia_portafoglio, contraente, COUNT(*) AS numero_polizze, ROUND(SUM(premio_annuo), 2) AS premio_totale_annuo FROM polizze WHERE stato_polizza = 'attiva' GROUP BY contraente UNION ALL SELECT 'Sospese' AS tipologia_portafoglio, contraente, COUNT(*) AS numero_polizze, ROUND(SUM(premio_annuo), 2) AS premio_totale_annuo FROM polizze WHERE stato_polizza = 'sospesa' GROUP BY contraente;"
