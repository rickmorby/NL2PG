{
  "schema_ddl": "CREATE TABLE polizze (\n    id INT PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    contraente TEXT NOT NULL,\n    ramo TEXT NOT NULL,\n    tipo_copertura TEXT NOT NULL CHECK (tipo_copertura IN ('vita', 'auto', 'casa', 'salute', 'responsabilita_civile')),\n    premio_annuo NUMERIC(10,2) NOT NULL CHECK (premio_annuo >= 0),\n    somma_assicurata NUMERIC(12,2) NOT NULL CHECK (somma_assicurata > 0),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    stato_polizza TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_polizza IN ('attiva', 'sospesa', 'scaduta', 'annullata')),\n    CHECK (data_scadenza > data_emissione)\n);",
