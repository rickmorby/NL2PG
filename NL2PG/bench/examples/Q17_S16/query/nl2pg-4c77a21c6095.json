  "query": "SELECT p.id AS polizza_id, ps.premio_annuo, AVG(ps.premio_annuo) OVER (PARTITION BY p.prodotto_id) AS media_premio_prodotto FROM polizze AS p JOIN polizze_storico AS ps ON p.id = ps.polizza_id ORDER BY ps.premio_annuo DESC, p.id LIMIT 10"
