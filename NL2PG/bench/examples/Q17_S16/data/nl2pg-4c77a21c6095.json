  "schema_ddl": "CREATE TABLE clienti (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome TEXT NOT NULL, codice_fiscale TEXT NOT NULL UNIQUE);\n\nCREATE TABLE prodotti_assicurativi (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_prodotto TEXT NOT NULL, descrizione TEXT);\n\nCREATE TABLE polizze (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, cliente_id INT NOT NULL REFERENCES clienti(id), prodotto_id INT NOT NULL REFERENCES prodotti_assicurativi(id), data_sottoscrizione DATE NOT NULL);\n\nCREATE TABLE polizze_storico (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT NOT NULL REFERENCES polizze(id), premio_annuo NUMERIC(12,2) NOT NULL CHECK (premio_annuo >= 0), valid_from TIMESTAMP NOT NULL, valid_to TIMESTAMP);\n\nCREATE TABLE sinistri (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, polizza_id INT NOT NULL REFERENCES polizze(id), data_evento DATE NOT NULL, importo_liquidato NUMERIC(12,2) DEFAULT 0 CHECK (importo_liquidato >= 0), creato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP);",
