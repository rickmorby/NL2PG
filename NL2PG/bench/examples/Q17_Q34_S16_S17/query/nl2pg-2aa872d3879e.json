  "query": "SELECT numero_linea, stato_precedente, stato_nuovo, timestamp_evento, ROW_NUMBER() OVER (PARTITION BY numero_linea ORDER BY timestamp_evento) AS progressivo_transizione FROM eventi_stato_linea WHERE flag_eliminato = FALSE AND stato_nuovo = 'attiva' ORDER BY numero_linea, timestamp_evento;"
