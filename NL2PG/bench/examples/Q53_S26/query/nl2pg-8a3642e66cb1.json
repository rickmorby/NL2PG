  "feature_sql": [
    "ordered_set_agg"
  ],
  "query": "SELECT e.nome_esame, l.citta, PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY CAST(ep.valore_esame AS DECIMAL)) AS mediana_valori FROM esami e JOIN esami_pazienti ep ON e.id = ep.esame_id JOIN laboratori l ON ep.laboratorio_id = l.id GROUP BY e.nome_esame, l.citta ORDER BY e.nome_esame, l.citta;"
}