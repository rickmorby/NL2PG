{
  "schema_ddl": "CREATE TABLE anagrafica_assistiti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    data_registrazione TEXT CHECK (data_registrazione ~ '^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}:\\d{2})?$')\n);\n\nCREATE TABLE esami (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_esame TEXT NOT NULL,\n    descrizione TEXT,\n    unita_misura TEXT NOT NULL\n);\n\nCREATE TABLE laboratori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_laboratorio TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE esami_pazienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES anagrafica_assistiti(id),\n    esame_id INT NOT NULL REFERENCES esami(id),\n    laboratorio_id INT NOT NULL REFERENCES laboratori(id),\n    valore_esame NUMERIC(12,2),\n    data_esame TIMESTAMP NOT NULL,\n    UNIQUE (paziente_id, esame_id, laboratorio_id, data_esame)\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    laboratorio_id INT REFERENCES laboratori(id)\n);",
