    "spec_hash": "99ab1327921d222a"
  },
  "schema_ddl": "CREATE TABLE articoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza INT NOT NULL CHECK (giacenza >= 0),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT UNIQUE,\n    codice_fiscale TEXT UNIQUE,\n    email TEXT,\n    telefono TEXT,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE vendite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    articolo_id INT NOT NULL REFERENCES articoli(id),\n    cliente_id INT REFERENCES clienti(id),\n    quantità INT NOT NULL CHECK (quantità > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(10,2) GENERATED ALWAYS AS (quantità * prezzo_unitario) STORED,\n    data_vendita TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
