{
  "schema_ddl": "CREATE TABLE dim_tempo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data DATE NOT NULL UNIQUE,\n    giorno INT NOT NULL CHECK (giorno BETWEEN 1 AND 31),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    anno INT NOT NULL,\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    giorno_settimana TEXT NOT NULL\n);\n\nCREATE TABLE dim_clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    categoria_cliente TEXT NOT NULL,\n    regione TEXT NOT NULL\n);\n\nCREATE TABLE dim_prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sku TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria_prodotto TEXT NOT NULL,\n    sottocategoria TEXT,\n    prezzo_unitario NUMERIC(10, 2) NOT NULL CHECK (prezzo_unitario > 0)\n);\n\nCREATE TABLE dim_canali_vendita (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_canale TEXT NOT NULL UNIQUE,\n    tipo_canale TEXT NOT NULL\n);\n\nCREATE TABLE dim_promozioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_promozione TEXT NOT NULL,\n    tipo_sconto TEXT NOT NULL,\n    percentuale_sconto NUMERIC(5, 2) CHECK (percentuale_sconto BETWEEN 0 AND 100),\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL CHECK (data_fine >= data_inizio)\n);\n\nCREATE TABLE dim_geografia (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    regione TEXT NOT NULL,\n    provincia TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    codice_postale TEXT\n);\n\nCREATE TABLE dim_dipendenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    ruolo TEXT NOT NULL,\n    reparto TEXT NOT NULL\n);\n\nCREATE TABLE dim_magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_magazzino TEXT NOT NULL UNIQUE,\n    indirizzo TEXT NOT NULL,\n    capacita_max INT CHECK (capacita_max > 0)\n);\n\nCREATE TABLE transazioni_commerciali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES dim_clienti(id),\n    prodotto_id INT NOT NULL REFERENCES dim_prodotti(id),\n    canale_vendita_id INT NOT NULL REFERENCES dim_canali_vendita(id),\n    promozione_id INT REFERENCES dim_promozioni(id),\n    dipendente_id INT REFERENCES dim_dipendenti(id),\n    magazzino_id INT REFERENCES dim_magazzini(id),\n    data_transazione DATE NOT NULL REFERENCES dim_tempo(data),\n    geografia_id INT REFERENCES dim_geografia(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10, 2) NOT NULL CHECK (prezzo_unitario > 0),\n    sconto_applicato NUMERIC(10, 2) DEFAULT 0 CHECK (sconto_applicato >= 0),\n    importo_totale NUMERIC(12, 2) GENERATED ALWAYS AS (quantita * prezzo_unitario - sconto_applicato) STORED\n);",
