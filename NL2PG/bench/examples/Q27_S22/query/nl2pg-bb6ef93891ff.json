  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT CASE WHEN GROUPING(p.categoria_prodotto) = 1 THEN 'Tutte le categorie' ELSE p.categoria_prodotto END AS categoria_prodotto, CASE WHEN GROUPING(c.regione) = 1 THEN 'Tutte le regioni' ELSE c.regione END AS regione_cliente, SUM(t.quantita) AS quantita_totale, ROUND(SUM(t.quantita * t.prezzo_unitario - COALESCE(t.sconto_applicato, 0)), 2) AS ricavo_totale, COUNT(*) AS numero_transazioni FROM transazioni_commerciali t JOIN dim_prodotti p ON t.prodotto_id = p.id JOIN dim_clienti c ON t.cliente_id = c.id JOIN dim_canali_vendita cv ON t.canale_vendita_id = cv.id WHERE cv.tipo_canale = 'Online' AND t.data_transazione BETWEEN DATE '2026-01-01' AND DATE '2026-12-31' GROUP BY GROUPING SETS ((p.categoria_prodotto, c.regione), (p.categoria_prodotto), (c.regione), ());"
}