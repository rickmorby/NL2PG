        "twist_type": "polysemy",
        "target_value": "tipo_trasporto",
        "obsolete_value": "modalità",
        "description": "Il termine 'modalità' viene utilizzato per indicare il tipo_trasporto, creando potenziale confusione con le modalità di pagamento presenti in altri moduli del sistema."
      }
