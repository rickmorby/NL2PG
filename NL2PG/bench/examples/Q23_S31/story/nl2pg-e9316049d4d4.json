{
  "schema_ddl": "CREATE TABLE fornitori (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_fornitore TEXT NOT NULL, n_spedizioni_totali INT DEFAULT 0);\n\nCREATE TABLE categorie (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nome_categoria TEXT NOT NULL);\n\nCREATE TABLE spedizioni (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, fornitore_id INT REFERENCES fornitori(id), categoria_id INT REFERENCES categorie(id), peso_kg NUMERIC(10, 2) CHECK (peso_kg > 0), flusso_di_avanzamento_logistico TEXT NOT NULL, tipo_trasporto TEXT NOT NULL, nome_categoria_denormalizzato TEXT, nome_fornitore_denormalizzato TEXT);\n\nCREATE TABLE statistiche_logistica (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, data_report DATE NOT NULL, totale_spedizioni_completate INT DEFAULT 0, totale_spedizioni_in_transito INT DEFAULT 0, CHECK (totale_spedizioni_completate >= 0 AND totale_spedizioni_in_transito >= 0));",
