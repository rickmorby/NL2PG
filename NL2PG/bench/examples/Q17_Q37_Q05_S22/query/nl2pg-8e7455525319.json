{
  "schema_ddl": "CREATE TABLE metodo_veneziano (\n    id SERIAL PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    dare NUMERIC(15,2) NOT NULL CHECK (dare >= 0),\n    avere NUMERIC(15,2) NOT NULL CHECK (avere >= 0),\n    giacenza NUMERIC(15,2) GENERATED ALWAYS AS (dare - avere) STORED,\n    descrizione TEXT,\n    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP\n);",
