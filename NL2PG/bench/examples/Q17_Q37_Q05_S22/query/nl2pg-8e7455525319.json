  "query": "SELECT descrizione, SUM(dare) AS totale_dare, SUM(avere) AS totale_avere, ROW_NUMBER() OVER (PARTITION BY descrizione ORDER BY data_registrazione DESC) AS riga_ordinata_per_data FROM metodo_veneziano WHERE data_registrazione BETWEEN '2025-11-01' AND '2026-03-31' GROUP BY descrizione, data_registrazione ORDER BY totale_dare DESC;"
