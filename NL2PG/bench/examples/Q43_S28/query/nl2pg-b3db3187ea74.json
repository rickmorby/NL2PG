  "feature_sql": [
    "sorting"
  ],
  "query": "SELECT d.nome, d.cognome, dep.nome_dipartimento, ROUND(d.stipendio_base, 2) AS stipendio_arrotondato FROM dip AS d JOIN dipartimenti AS dep ON d.id_reparto = dep.id_reparto WHERE (d.stipendio_base BETWEEN 40000 AND 60000) AND (d.nome = 'Andrea' OR d.nome = 'Sara') ORDER BY d.stipendio_base DESC, d.cognome ASC, d.emp_no"
}