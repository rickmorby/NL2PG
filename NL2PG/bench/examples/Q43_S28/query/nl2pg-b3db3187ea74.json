{
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id_reparto INT PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL,\n    budget_annuale NUMERIC(15, 2) CHECK (budget_annuale >= 0)\n);\n\nCREATE TABLE dip (\n    emp_no INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    id_reparto INT NOT NULL REFERENCES dipartimenti(id_reparto),\n    data_assunzione DATE NOT NULL DEFAULT CURRENT_DATE,\n    stipendio_base NUMERIC(12, 2) CHECK (stipendio_base > 0)\n);\n\nCREATE INDEX idx_emp_sorting ON dip (emp_no, data_assunzione);",
