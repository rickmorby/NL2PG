  "feature_sql": [
    "grouping_sets"
  ],
  "query": "WITH dati_movimenti AS (SELECT c.nome_conto, m.segno_movimento, m.valore_economico_operazione FROM movimenti_contabili m JOIN conti_contabili c ON m.conto_id = c.id) SELECT COALESCE(nome_conto, 'Tutti i conti') AS conto, COALESCE(segno_movimento, 'Tutti i segni') AS segno, SUM(valore_economico_operazione) AS totale FROM dati_movimenti GROUP BY GROUPING SETS ((nome_conto, segno_movimento), (nome_conto), (segno_movimento), ()) ORDER BY conto, segno;"
}