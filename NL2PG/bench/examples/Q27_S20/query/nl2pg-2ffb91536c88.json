{
  "schema_ddl": "CREATE TYPE stato_registrazione AS ENUM ('bozza', 'approvato', 'annullato');\n\nCREATE TABLE centri_costo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE conti_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    nome_conto TEXT NOT NULL\n);\n\nCREATE TABLE registrazioni_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    fase_contabile stato_registrazione NOT NULL,\n    descrizione_generale TEXT\n);\n\nCREATE TABLE movimenti_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni_contabili(id),\n    conto_id INT NOT NULL REFERENCES conti_contabili(id),\n    valore_economico_operazione NUMERIC(15, 2) NOT NULL CHECK (valore_economico_operazione <> 0),\n    segno_movimento TEXT NOT NULL CHECK (segno_movimento IN ('dare', 'avere'))\n);\n\nCREATE TABLE report_aggregati (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_report DATE NOT NULL,\n    centro_costo_id INT REFERENCES centri_costo(id),\n    totale_periodo NUMERIC(18, 2) DEFAULT 0,\n    note TEXT\n);",
