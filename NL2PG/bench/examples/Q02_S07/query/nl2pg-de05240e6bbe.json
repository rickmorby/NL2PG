{
  "schema_ddl": "CREATE TABLE dipartimenti_sanitari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    tipo_dipartimento TEXT NOT NULL,\n    dipartimento_padre_id INT REFERENCES dipartimenti_sanitari(id) ON DELETE SET NULL,\n    budget_annuale NUMERIC(15,2) CHECK (budget_annuale >= 0),\n    numero_medici INT DEFAULT 0 CHECK (numero_medici >= 0),\n    numero_pazienti INT DEFAULT 0 CHECK (numero_pazienti >= 0),\n    totale_pazienti_gestiti BIGINT GENERATED ALWAYS AS (numero_medici * 1000 + numero_pazienti) STORED\n);",
