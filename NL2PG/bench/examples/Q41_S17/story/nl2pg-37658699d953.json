  "schema_ddl": "CREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    contraente TEXT NOT NULL,\n    codice_fiscale_contraente TEXT NOT NULL UNIQUE,\n    ramo_assicurativo TEXT NOT NULL,\n    premio_annuo NUMERIC(10,2) NOT NULL CHECK (premio_annuo >= 0),\n    capitale_assicurato NUMERIC(12,2) NOT NULL CHECK (capitale_assicurato > 0),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL CHECK (data_scadenza > data_emissione),\n    deleted_at TIMESTAMP,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
