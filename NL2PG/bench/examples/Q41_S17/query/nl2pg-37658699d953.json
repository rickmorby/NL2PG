  "query": "SELECT numero_polizza, contraente, ramo_assicurativo, premio_annuo, capitale_assicurato, data_scadenza FROM polizze WHERE deleted_at IS NULL AND ramo_assicurativo = 'Auto' AND premio_annuo >= 500.00 ORDER BY premio_annuo DESC, numero_polizza ASC;"
