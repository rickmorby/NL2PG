  "feature_sql": [],
  "query": "SELECT c.titolo, d.nome AS dipartimento, COUNT(*) AS numero_esami_registrati, ROUND(AVG(i.voto), 2) AS media_voti, RANK() OVER (ORDER BY AVG(i.voto) DESC) AS posizione FROM corsi c JOIN dipartimenti d ON d.id = c.dipartimento_id JOIN iscrizioni i ON i.corso_id = c.id WHERE d.sede = 'Bologna' GROUP BY c.id, c.titolo, d.nome HAVING COUNT(*) >= 3 ORDER BY posizione ASC, c.titolo ASC, c.id ASC;"
}