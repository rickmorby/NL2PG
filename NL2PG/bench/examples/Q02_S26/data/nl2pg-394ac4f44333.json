  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE vendite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_vendita DATE NOT NULL,\n    importo_vendita NUMERIC(12,2) NOT NULL,\n    quantita TEXT NOT NULL\n);\n\nCREATE TABLE punti_vendita (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE transazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    vendita_id INT NOT NULL REFERENCES vendite(id),\n    punto_vendita_id INT NOT NULL REFERENCES punti_vendita(id),\n    valore_transazione NUMERIC(12,2) NOT NULL,\n    unita_movimentate TEXT NOT NULL\n);",
