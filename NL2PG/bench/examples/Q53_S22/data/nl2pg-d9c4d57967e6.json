  "schema_ddl": "CREATE TABLE dim_tempo (\n    id INT PRIMARY KEY,\n    data_completa DATE NOT NULL UNIQUE,\n    anno INT NOT NULL CHECK (anno BETWEEN 1900 AND 2100),\n    trimestre INT NOT NULL CHECK (trimestre BETWEEN 1 AND 4),\n    mese INT NOT NULL CHECK (mese BETWEEN 1 AND 12),\n    nome_mese TEXT NOT NULL,\n    giorno_settimana INT NOT NULL CHECK (giorno_settimana BETWEEN 1 AND 7)\n);\n\nCREATE TABLE dim_conti_contabili (\n    id INT PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    descrizione_conto TEXT NOT NULL,\n    classe_conto TEXT NOT NULL CHECK (classe_conto IN ('attivo', 'passivo', 'costo', 'ricavo', 'ordine')),\n    conto_padre_id INT REFERENCES dim_conti_contabili(id)\n);\n\nCREATE TABLE dim_centri_costo (\n    id INT PRIMARY KEY,\n    codice_centro_costo TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    sede TEXT NOT NULL,\n    responsabile TEXT\n);\n\nCREATE TABLE dim_divise (\n    id INT PRIMARY KEY,\n    codice_iso TEXT NOT NULL UNIQUE CHECK (LENGTH(codice_iso) = 3),\n    denominazione_divisa TEXT NOT NULL,\n    simbolo TEXT NOT NULL\n);\n\nCREATE TABLE dim_controparti (\n    id INT PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    codice_fiscale TEXT UNIQUE,\n    partita_iva TEXT UNIQUE,\n    tipo_controparte TEXT NOT NULL CHECK (tipo_controparte IN ('cliente', 'fornitore', 'dipendente', 'istituzione'))\n);\n\nCREATE TABLE fatti_movimenti_contabili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    tempo_id INT NOT NULL REFERENCES dim_tempo(id),\n    conto_id INT NOT NULL REFERENCES dim_conti_contabili(id),\n    centro_costo_id INT NOT NULL REFERENCES dim_centri_costo(id),\n    divisa_id INT NOT NULL REFERENCES dim_divise(id),\n    controparte_id INT REFERENCES dim_controparti(id),\n    importo NUMERIC(14,2) NOT NULL CHECK (importo <> 0),\n    saldo_dare NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_dare >= 0),\n    saldo_avere NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_avere >= 0),\n    numero_documenti INT NOT NULL DEFAULT 1 CHECK (numero_documenti > 0)\n);",
