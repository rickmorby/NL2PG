{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    citta TEXT,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE,\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'pagato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(10,2) NOT NULL CHECK (importo_totale >= 0),\n    PRIMARY KEY (id, data_ordine)\n) PARTITION BY RANGE (data_ordine);\n\nCREATE TABLE ordini_2024_primo_semestre PARTITION OF ordini FOR VALUES FROM ('2024-01-01') TO ('2024-07-01');\n\nCREATE TABLE ordini_2024_secondo_semestre PARTITION OF ordini FOR VALUES FROM ('2024-07-01') TO ('2025-01-01');\n\nCREATE TABLE ordini_storico PARTITION OF ordini DEFAULT;",
