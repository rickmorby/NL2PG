  "query": "SELECT c.citta, COUNT(*) AS numero_ordini, SUM(o.importo_totale) AS fatturato_totale, ROUND(CAST(AVG(o.importo_totale) AS DECIMAL), 2) AS scontrino_medio FROM clienti AS c JOIN ordini AS o ON o.cliente_id = c.id WHERE o.data_ordine BETWEEN CAST('2024-02-01' AS DATE) AND CAST('2024-03-31' AS DATE) AND o.stato_ordine = 'consegnato' GROUP BY c.citta ORDER BY fatturato_totale DESC, c.citta ASC;"
}