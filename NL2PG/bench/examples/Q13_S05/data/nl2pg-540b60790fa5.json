    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "righe_ordine",
        "obsolete_value": "movimenti_di_carico",
        "description": "La tabella debole righe_ordine viene denominata movimenti_di_carico nella prosa aziendale. Ogni riga e' identificabile solo insieme al suo ordine proprietario tramite la chiave composta (ordine_id, numero_riga), quindi le query devono unire movimenti_di_carico a ordini_acquisto prima di applicare filtri o verifiche di esistenza."
      },
      {
        "twist_type": "jargon",
        "target_value": "numero_riga",
        "obsolete_value": "progressivo_posizione",
        "description": "La colonna numero_riga, che costituisce la chiave parziale dell'entita' debole dipendente dalla PK di ordini_acquisto, e' indicata nei documenti aziendali con il gergo ERP 'progressivo_posizione'. Il solver deve riconoscere che progressivo_posizione corrisponde alla seconda componente della chiave composta di righe_ordine."
      }
    ],
    "spec_hash": "f695057f509b79c8"
  },
  "schema_ddl": "CREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    email_contatto TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE ordini_acquisto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    numero_ordine TEXT NOT NULL UNIQUE,\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'aperto' CHECK (stato_ordine IN ('aperto', 'confermato', 'evaso', 'annullato')),\n    note TEXT\n);\n\nCREATE TABLE righe_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini_acquisto(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    descrizione_articolo TEXT NOT NULL,\n    quantita NUMERIC(12,3) NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(12,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
