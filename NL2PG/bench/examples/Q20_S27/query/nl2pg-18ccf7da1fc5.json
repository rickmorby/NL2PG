{
  "schema_ddl": "CREATE TABLE corrieri (\n    codice_corriere INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    nome_corriere TEXT NOT NULL,\n    zona_operativa TEXT NOT NULL,\n    data_attivazione DATE NOT NULL,\n    CHECK (data_attivazione <= CURRENT_DATE)\n);\n\nCREATE TABLE spedizioni (\n    id INT PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,\n    codice_corriere INT NOT NULL,\n    destinazione TEXT NOT NULL,\n    peso_kg NUMERIC(10,2) NOT NULL CHECK (peso_kg > 0),\n    data_spedizione DATE NOT NULL,\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnato', 'annullato')),\n    CHECK (data_spedizione <= CURRENT_DATE)\n);",
