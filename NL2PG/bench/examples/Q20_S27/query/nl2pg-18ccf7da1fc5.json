  "feature_sql": [
    "right_outer_join"
  ],
  "query": "WITH corrieri_recenti AS (\n    SELECT codice_corriere, nome_corriere, zona_operativa, data_attivazione\n    FROM corrieri\n    WHERE data_attivazione >= DATE '2024-01-01' - INTERVAL '2 years'\n),\nspedizioni_consegnate AS (\n    SELECT codice_corriere, COUNT(*) AS numero_spedizioni, SUM(peso_kg) AS peso_totale\n    FROM spedizioni\n    WHERE stato_spedizione = 'consegnato'\n    GROUP BY codice_corriere\n)\nSELECT \n    cr.nome_corriere,\n    cr.zona_operativa,\n    COALESCE(sc.numero_spedizioni, 0) AS spedizioni_consegnate,\n    COALESCE(sc.peso_totale, 0) AS peso_totale_kg,\n    CASE \n        WHEN sc.numero_spedizioni > 0 THEN 'Attivo'\n        ELSE 'Inattivo'\n    END AS stato_operativo\nFROM corrieri_recenti cr\nRIGHT OUTER JOIN spedizioni_consegnate sc ON cr.codice_corriere = sc.codice_corriere\nORDER BY peso_totale_kg DESC, cr.nome_corriere;"
}