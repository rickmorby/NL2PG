  "feature_sql": [
    "correlated_subquery"
  ],
  "query": "SELECT i.indirizzo, i.citta, i.tipo_immobile, i.superficie_mq, i.prezzo_richiesto, (SELECT MAX(o.importo_offerta) FROM offerte o WHERE o.immobile_id = i.id) AS miglior_offerta_ricevuta, CASE WHEN (SELECT MAX(o.importo_offerta) FROM offerte o WHERE o.immobile_id = i.id) >= i.prezzo_richiesto THEN 'offerta almeno pari al prezzo richiesto' WHEN (SELECT MAX(o.importo_offerta) FROM offerte o WHERE o.immobile_id = i.id) IS NOT NULL THEN 'offerta inferiore al prezzo richiesto' ELSE 'nessuna offerta ricevuta' END AS esito_valutazione_offerte FROM immobili i WHERE i.citta = 'Milano' AND i.stato_vendita = 'disponibile' AND i.superficie_mq BETWEEN 80 AND 250 ORDER BY i.prezzo_richiesto DESC, i.superficie_mq DESC;"
}