{
  "schema_ddl": "CREATE TABLE proprietari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    email TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    matricola TEXT NOT NULL UNIQUE,\n    email TEXT\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    proprietario_id INT NOT NULL REFERENCES proprietari(id) ON DELETE RESTRICT ON UPDATE CASCADE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    tipo_immobile TEXT NOT NULL CHECK (tipo_immobile IN ('appartamento', 'villa', 'terreno', 'ufficio', 'negozio')),\n    superficie_mq NUMERIC(8,2) CHECK (superficie_mq > 0),\n    prezzo_richiesto NUMERIC(12,2) NOT NULL CHECK (prezzo_richiesto > 0),\n    stato_vendita TEXT NOT NULL DEFAULT 'disponibile' CHECK (stato_vendita IN ('disponibile', 'riservato', 'venduto')),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE offerte (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    acquirente TEXT NOT NULL,\n    importo_offerta NUMERIC(12,2) NOT NULL CHECK (importo_offerta > 0),\n    data_offerta DATE NOT NULL,\n    accettata BOOLEAN NOT NULL DEFAULT FALSE\n);\n\nCREATE TABLE visite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    agente_id INT NOT NULL REFERENCES agenti(id) ON DELETE RESTRICT ON UPDATE CASCADE,\n    data_visita DATE NOT NULL,\n    esito TEXT CHECK (esito IN ('positivo', 'negativo', 'da_definire'))\n);",
