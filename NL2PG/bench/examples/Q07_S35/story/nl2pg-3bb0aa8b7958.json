{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    citta TEXT,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE vendite (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    data_ordine DATE NOT NULL,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    PRIMARY KEY (id, data_ordine)\n) PARTITION BY RANGE (data_ordine);\n\nCREATE TABLE vendite_2023 PARTITION OF vendite\n    FOR VALUES FROM ('2023-01-01') TO ('2024-01-01');\n\nCREATE TABLE vendite_2024 PARTITION OF vendite\n    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');\nCREATE TABLE vendite_default PARTITION OF vendite DEFAULT;",
