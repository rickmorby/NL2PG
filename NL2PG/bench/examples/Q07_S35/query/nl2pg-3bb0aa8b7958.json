  "feature_sql": [
    "multi_join"
  ],
  "query": "SELECT c.citta, COUNT(*) AS numero_vendite, SUM(v.importo_totale) AS fatturato_totale, ROUND(CAST(AVG(v.importo_totale) AS DECIMAL), 2) AS scontrino_medio, RANK() OVER (ORDER BY SUM(v.importo_totale) DESC) AS posizione FROM vendite AS v JOIN clienti AS c ON c.id = v.cliente_id JOIN prodotti AS p ON p.id = v.prodotto_id WHERE p.categoria = 'Informatica' AND v.data_ordine >= CAST('2023-01-01' AS DATE) AND v.data_ordine < CAST('2024-01-01' AS DATE) GROUP BY c.citta ORDER BY fatturato_totale DESC, c.citta ASC LIMIT 5"
}