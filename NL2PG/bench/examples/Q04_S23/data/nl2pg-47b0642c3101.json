  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono_contatto TEXT,\n    citta_residenza TEXT,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE piani_tariffari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_piano TEXT NOT NULL UNIQUE,\n    descrizione TEXT,\n    giga_inclusi INT NOT NULL CHECK (giga_inclusi >= 0),\n    minuti_inclusi INT NOT NULL CHECK (minuti_inclusi >= 0),\n    sms_inclusi INT NOT NULL DEFAULT 0 CHECK (sms_inclusi >= 0),\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE sottoscrizioni_piano (\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    piano_id INT NOT NULL REFERENCES piani_tariffari(id),\n    data_attivazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_cessazione DATE,\n    stato_sottoscrizione TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_sottoscrizione IN ('attiva', 'sospesa', 'cessata')),\n    PRIMARY KEY (cliente_id, piano_id),\n    CHECK (data_cessazione IS NULL OR data_cessazione >= data_attivazione)\n);\n\nCREATE TABLE sim (\n    iccid TEXT PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_telefono TEXT NOT NULL UNIQUE,\n    stato_sim TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_sim IN ('attiva', 'disattivata', 'bloccata')),\n    data_emissione DATE NOT NULL DEFAULT CURRENT_DATE\n);",
