  "query": "SELECT c.nome, c.cognome, c.citta_residenza, p.nome_piano, p.canone_mensile AS canone_mensile_euro, s.data_attivazione FROM clienti AS c JOIN sottoscrizioni_piano AS s ON c.id = s.cliente_id JOIN piani_tariffari AS p ON s.piano_id = p.id WHERE s.stato_sottoscrizione = 'attiva' AND p.attivo IS TRUE ORDER BY p.canone_mensile DESC, c.cognome ASC, c.nome ASC, c.id"
}