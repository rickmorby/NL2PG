{
  "schema_ddl": "CREATE TABLE pazienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    telefono TEXT\n);\n\nCREATE TABLE reparti (\n    id INT PRIMARY KEY,\n    nome_reparto TEXT NOT NULL UNIQUE,\n    piano INT NOT NULL CHECK (piano >= 0),\n    posti_letto_totali INT NOT NULL CHECK (posti_letto_totali > 0)\n);\n\nCREATE TABLE medici (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    numero_albo TEXT UNIQUE\n);\n\nCREATE TABLE letti (\n    id INT PRIMARY KEY,\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    numero_letto INT NOT NULL CHECK (numero_letto > 0),\n    stato_letto TEXT NOT NULL DEFAULT 'libero' CHECK (stato_letto IN ('libero', 'occupato', 'manutenzione')),\n    UNIQUE (reparto_id, numero_letto)\n);\n\nCREATE TABLE ricoveri (\n    id INT PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    letto_id INT REFERENCES letti(id),\n    data_ricovero DATE NOT NULL,\n    data_dimissione DATE,\n    motivo_ricovero TEXT NOT NULL,\n    CHECK (data_dimissione IS NULL OR data_dimissione >= data_ricovero)\n);\n\nCREATE TABLE prescrizioni (\n    id INT PRIMARY KEY,\n    ricovero_id INT NOT NULL REFERENCES ricoveri(id),\n    farmaco TEXT NOT NULL,\n    dosaggio TEXT NOT NULL,\n    data_prescrizione DATE NOT NULL,\n    somministrato BOOLEAN NOT NULL DEFAULT FALSE\n);",
