  "feature_sql": [
    "natural_join"
  ],
  "query": "SELECT o.nome_operatore, c.stato_contratto, COUNT(*) AS numero_contratti, ROUND(AVG(pt.prezzo_mensile), 2) AS prezzo_medio_piano FROM operatori o NATURAL JOIN piani_tariffari pt NATURAL JOIN contratti c WHERE c.stato_contratto IN ('attivo', 'sospeso') AND pt.prezzo_mensile <= 30.00 GROUP BY o.nome_operatore, c.stato_contratto ORDER BY numero_contratti DESC, o.nome_operatore ASC LIMIT 15;"
}