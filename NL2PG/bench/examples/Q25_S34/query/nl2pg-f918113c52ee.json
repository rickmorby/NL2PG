  "feature_sql": [
    "natural_join"
  ],
  "query": "SELECT r.prodotto, SUM(r.quantita) AS unita_vendute, ROUND(SUM(r.quantita * r.prezzo_unitario), 2) AS ricavo_totale, COUNT(DISTINCT ordine_id) AS numero_ordini FROM ordini o NATURAL JOIN righe_ordini r WHERE o.stato = 'evaso' GROUP BY r.prodotto ORDER BY ricavo_totale DESC LIMIT 5;"
}