  "feature_sql": [
    "distinct_on"
  ],
  "query": "WITH totali_fattura AS (SELECT fattura_id, SUM(importo_totale) AS totale_fattura FROM righe_fattura GROUP BY fattura_id) SELECT DISTINCT ON (c.citta) c.citta AS citta_cliente, c.ragione_sociale, f.numero_documento, f.data_emissione, tf.totale_fattura FROM clienti c JOIN fatture_vendita f ON f.cliente_id = c.id JOIN totali_fattura tf ON tf.fattura_id = f.id WHERE f.stato_fattura = 'pagata' ORDER BY c.citta ASC, f.data_emissione DESC, f.id ASC;"
}