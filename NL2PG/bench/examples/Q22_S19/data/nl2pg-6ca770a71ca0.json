    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "fatture_vendita",
        "obsolete_value": "registro_documenti_attivi",
        "description": "La tabella fisica fatture_vendita viene denominata registro_documenti_attivi nella prosa aziendale. Il solver deve risalire al nome reale della tabella per costruire correttamente il percorso di join PK/FK verso righe_fattura e movimenti_contabili."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_totale",
        "obsolete_value": "imponibile consolidato",
        "description": "La colonna importo_totale della tabella righe_fattura è indicata nella narrativa con il gergo contabile 'imponibile consolidato'. Il solver deve mappare il termine tecnico-contabile alla colonna reale quando ordina le righe per selezionare la prima voce per gruppo con DISTINCT ON."
      },
      {
        "twist_type": "synonym",
        "target_value": "data_emissione",
        "obsolete_value": "data di registrazione documentale",
        "description": "La colonna data_emissione della tabella fatture_vendita è descritta nella prosa come 'data di registrazione documentale'. Il solver deve riconoscere il sinonimo e utilizzarlo come chiave di ordinamento coerente all'interno di DISTINCT ON per determinare quale riga vince in ciascun gruppo."
      }
    ],
    "spec_hash": "6e8a39dec48f2d21"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id SERIAL PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE fatture_vendita (\n    id SERIAL PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_documento TEXT NOT NULL UNIQUE,\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    stato_fattura TEXT NOT NULL DEFAULT 'emessa' CHECK (stato_fattura IN ('bozza', 'emessa', 'pagata', 'annullata')),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_fattura (\n    id SERIAL PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture_vendita(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL,\n    descrizione TEXT NOT NULL,\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(12,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(14,2) NOT NULL CHECK (importo_totale >= 0),\n    UNIQUE (fattura_id, numero_riga)\n);\n\nCREATE TABLE movimenti_contabili (\n    id SERIAL PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture_vendita(id) ON DELETE CASCADE,\n    codice_conto TEXT NOT NULL,\n    descrizione_movimento TEXT NOT NULL,\n    sezione_prima_nota TEXT NOT NULL CHECK (sezione_prima_nota IN ('dare', 'avere')),\n    importo_movimento NUMERIC(14,2) NOT NULL CHECK (importo_movimento >= 0),\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE\n);",
