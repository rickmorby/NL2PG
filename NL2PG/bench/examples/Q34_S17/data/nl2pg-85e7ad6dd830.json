    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "clienti",
        "obsolete_value": "anagrafica_acquirenti",
        "description": "La tabella clienti viene denominata anagrafica_acquirenti nella prosa aziendale; ogni riferimento agli acquirenti registrati punta fisicamente alla tabella clienti dello schema vendite."
      },
      {
        "twist_type": "jargon",
        "target_value": "deleted_at",
        "obsolete_value": "data di dismissione dal perimetro commerciale",
        "description": "La colonna deleted_at presente su tutte le tabelle dello schema (clienti, ordini, dettagli_ordine, prodotti, agenti) e' descritta con il gergo interno 'data di dismissione dal perimetro commerciale'; le query devono tradurre questa perifrasi nel filtro di cancellazione logica WHERE deleted_at IS NULL per considerare esclusivamente i record attivi, eventualmente combinato con filtri temporali come EXTRACT(unita FROM created_at) o created_at BETWEEN t1 AND t2."
      },
      {
        "twist_type": "polysemy",
        "target_value": "totale",
        "obsolete_value": "ammontare complessivo",
        "description": "Il termine 'totale' (perifrasi: ammontare complessivo) e' polisemico nello schema vendite: indica sia la colonna totale_ordine nell'intestazione degli ordini sia la colonna totale_riga nella tabella dettagli_ordine; solo il contesto della frase aziendale disambigua quale delle due colonne deve essere usata nelle aggregazioni."
      }
    ],
    "spec_hash": "dbc167068086cd4d"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    partita_iva TEXT UNIQUE,\n    email_contatto TEXT UNIQUE,\n    citta TEXT NOT NULL,\n    provincia TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    matricola_agente TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email_aziendale TEXT UNIQUE,\n    telefono TEXT,\n    data_assunzione DATE NOT NULL,\n    quota_provvigione NUMERIC(5,2) NOT NULL DEFAULT 5.00 CHECK (quota_provvigione BETWEEN 0 AND 100),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_sku TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0),\n    giacenza_magazzino INT NOT NULL DEFAULT 0 CHECK (giacenza_magazzino >= 0),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    agente_id INT REFERENCES agenti(id),\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    totale_ordine NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (totale_ordine >= 0),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE TABLE dettagli_ordine (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_percentuale NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    totale_riga NUMERIC(12,2) NOT NULL CHECK (totale_riga >= 0),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP,\n    UNIQUE (ordine_id, numero_riga)\n);",
