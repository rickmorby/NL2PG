  "feature_sql": [],
  "query": "SELECT c.ragione_sociale AS azienda, c.citta, COUNT(o.id) AS numero_ordini_confermati, SUM(o.totale_ordine) AS fatturato_totale, ROUND(AVG(o.totale_ordine), 2) AS valore_medio_ordine FROM clienti c JOIN ordini o ON o.cliente_id = c.id WHERE o.stato_ordine = 'confermato' GROUP BY c.ragione_sociale, c.citta ORDER BY fatturato_totale DESC LIMIT 10;"
}