  "feature_sql": [
    "self_join"
  ],
  "query": "SELECT padre.nome_conto AS conto_padre, figlio.natura_conto AS natura_conto_figlio, COUNT(rg.id) AS numero_movimenti, COALESCE(SUM(rg.importo_dare), 0) AS totale_dare, COALESCE(SUM(rg.importo_avere), 0) AS totale_avere FROM conti figlio JOIN conti padre ON figlio.conto_padre_id = padre.id LEFT JOIN righe_giornale rg ON rg.conto_id = figlio.id WHERE figlio.natura_conto IN ('costo', 'ricavo') GROUP BY padre.nome_conto, figlio.natura_conto ORDER BY totale_dare DESC, conto_padre ASC;"
}