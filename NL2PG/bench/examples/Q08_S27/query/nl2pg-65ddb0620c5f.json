{
  "schema_ddl": "CREATE TABLE conti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    nome_conto TEXT NOT NULL,\n    conto_padre_id INT,\n    livello_gerarchia INT NOT NULL DEFAULT 1 CHECK (livello_gerarchia BETWEEN 1 AND 6),\n    natura_conto TEXT NOT NULL CHECK (natura_conto IN ('attivo', 'passivo', 'costo', 'ricavo')),\n    saldo_apertura NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_apertura >= 0)\n);\n\nCREATE TABLE registrazioni_giornale (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_protocollo TEXT NOT NULL UNIQUE,\n    data_registrazione DATE NOT NULL,\n    causale TEXT NOT NULL,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_giornale (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    registrazione_id INT NOT NULL REFERENCES registrazioni_giornale(id),\n    conto_id INT NOT NULL REFERENCES conti(id),\n    importo_dare NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    descrizione_riga TEXT,\n    CHECK ((importo_dare > 0) OR (importo_avere > 0)),\n    CHECK (NOT (importo_dare > 0 AND importo_avere > 0))\n);",
