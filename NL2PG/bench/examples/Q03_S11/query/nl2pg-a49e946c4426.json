  "schema_ddl": "CREATE TABLE transazioni (\n    id_transazione BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_transazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    tipo_operazione TEXT NOT NULL CHECK (tipo_operazione IN ('versamento', 'prelievo', 'bonifico', 'addebito', 'accredito_interessi')),\n    importo NUMERIC(14,2) NOT NULL CHECK (importo <> 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR' CHECK (LENGTH(valuta) = 3),\n    descrizione TEXT\n);",
