{
  "schema_ddl": "CREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_ordine TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL,\n    categoria_prodotto TEXT NOT NULL,\n    canale_vendita TEXT NOT NULL DEFAULT 'online' CHECK (canale_vendita IN ('online', 'negozio_fisico', 'app_mobile')),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    sconto_applicato NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_applicato BETWEEN 0 AND 100),\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'spedito', 'consegnato', 'annullato')),\n    data_ordine DATE NOT NULL,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
