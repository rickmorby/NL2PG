  "query": "SELECT p.categoria, COUNT(DISTINCT p.id) AS numero_prodotti, SUM(p.prezzo_unitario) AS totale_prezzi FROM prodotti p GROUP BY p.categoria HAVING COUNT(DISTINCT p.id) > 1 AND SUM(p.prezzo_unitario) > 2000;"
