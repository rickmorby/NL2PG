    "sql_features": [
      "grouping_sets"
    ],
    "twist": [
      "rename",
      "synonym",
      "jargon"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "ordini",
        "obsolete_value": "registro_transazioni",
        "description": "La tabella ordini, che contiene i riferimenti ai clienti con importo_totale, stato e la colonna di cancellazione logica deleted_at, viene denominata registro_transazioni nella prosa aziendale."
      },
      {
        "twist_type": "synonym",
        "target_value": "deleted_at",
        "obsolete_value": "data_dismissione",
        "description": "La colonna deleted_at della tabella ordini, usata per la cancellazione logica dei record, viene indicata nella documentazione come data_dismissione; le query devono filtrare con deleted_at IS NULL o IS NOT NULL per includere o escludere gli ordini dismessi."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_totale",
        "obsolete_value": "GMV",
        "description": "La metrica importo_totale degli ordini viene espressa nella prosa aziendale con il gergo finanziario GMV (Gross Merchandise Value); le aggregazioni richieste con GROUPING SETS ((cliente_id), (stato), ()) vanno calcolate su tale colonna."
      }
    ],
    "spec_hash": "68453fe20eec6492"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE categorie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    categoria_id INT NOT NULL REFERENCES categorie(id),\n    nome TEXT NOT NULL,\n    descrizione TEXT,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato TEXT NOT NULL CHECK (stato IN ('in_attesa', 'pagato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    deleted_at TIMESTAMP,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE righe_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
