{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE sim (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_iccid TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_attivazione DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE offerte (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_offerta TEXT NOT NULL,\n    prezzo_mensile NUMERIC(8,2) NOT NULL CHECK (prezzo_mensile >= 0),\n    giga_inclusi INT NOT NULL CHECK (giga_inclusi >= 0)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_contratto TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    sim_id INT NOT NULL REFERENCES sim(id),\n    offerta_id INT NOT NULL REFERENCES offerte(id),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    CHECK (data_fine IS NULL OR data_fine >= data_inizio)\n);\n\nCREATE TABLE contratti_rescissi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_contratto TEXT NOT NULL,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_rescissione DATE NOT NULL,\n    motivo_rescissione TEXT NOT NULL\n);\n\nCREATE TABLE linee (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_linea TEXT NOT NULL UNIQUE,\n    stato TEXT NOT NULL CHECK (stato IN ('attiva', 'sospesa')),\n    contratto_id INT NOT NULL REFERENCES contratti(id)\n);\n\nCREATE TABLE ripetitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_ripetitore TEXT NOT NULL UNIQUE,\n    stato TEXT NOT NULL,\n    tecnologia TEXT NOT NULL CHECK (tecnologia IN ('2G', '3G', '4G', '5G'))\n);\n\nCREATE TABLE chiamate (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    linea_id INT NOT NULL REFERENCES linee(id),\n    ripetitore_id INT REFERENCES ripetitori(id),\n    durata_secondi INT NOT NULL CHECK (durata_secondi >= 0),\n    istante_chiamata TIMESTAMP NOT NULL\n);\n\nCREATE TABLE sms (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    linea_id INT NOT NULL REFERENCES linee(id),\n    numero_destinatario TEXT NOT NULL,\n    testo_messaggio TEXT,\n    inviato_il TIMESTAMP NOT NULL\n);\n\nCREATE TABLE dati_consumo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    linea_id INT NOT NULL REFERENCES linee(id),\n    giga_consumati NUMERIC(7,2) NOT NULL CHECK (giga_consumati >= 0),\n    mese_riferimento DATE NOT NULL\n);",
