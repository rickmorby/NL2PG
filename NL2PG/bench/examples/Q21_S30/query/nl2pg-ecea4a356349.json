  "feature_sql": [
    "cross_join"
  ],
  "query": "WITH tecnologie_rete AS (\n    SELECT DISTINCT tecnologia\n    FROM ripetitori\n),\ncatalogo_offerte AS (\n    SELECT nome_offerta,\n           ROUND(AVG(prezzo_mensile), 2) AS prezzo_medio_mensile\n    FROM offerte\n    WHERE prezzo_mensile BETWEEN 10 AND 30\n    GROUP BY nome_offerta\n),\ntraffico_per_combinazione AS (\n    SELECT r.tecnologia,\n           o.nome_offerta,\n           COUNT(*) AS numero_chiamate,\n           ROUND(SUM(ch.durata_secondi) / 60.0, 1) AS minuti_totali_voce\n    FROM chiamate ch\n    JOIN linee l ON ch.linea_id = l.id\n    JOIN contratti ct ON l.contratto_id = ct.id\n    JOIN offerte o ON ct.offerta_id = o.id\n    JOIN ripetitori r ON ch.ripetitore_id = r.id\n    WHERE l.stato = 'attiva'\n      AND ch.ripetitore_id IS NOT NULL\n    GROUP BY r.tecnologia, o.nome_offerta\n)\nSELECT t.tecnologia AS tecnologia_rete,\n       co.nome_offerta AS nome_offerta,\n       co.prezzo_medio_mensile AS prezzo_medio_mensile,\n       COALESCE(tpc.numero_chiamate, 0) AS numero_chiamate,\n       COALESCE(tpc.minuti_totali_voce, 0) AS minuti_totali_voce,\n       CASE WHEN COALESCE(tpc.numero_chiamate, 0) > 0 THEN 'traffico rilevato' ELSE 'nessun traffico' END AS esito_copertura\nFROM tecnologie_rete t\nCROSS JOIN catalogo_offerte co\nLEFT JOIN traffico_per_combinazione tpc\n       ON tpc.tecnologia = t.tecnologia\n      AND tpc.nome_offerta = co.nome_offerta\nORDER BY t.tecnologia, co.nome_offerta;"
}