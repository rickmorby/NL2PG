{
  "schema_ddl": "CREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    tipologia_prodotto TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    fornitore_primario TEXT NOT NULL,\n    quantita_disponibile INT NOT NULL CHECK (quantita_disponibile >= 0)\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    totale_speso NUMERIC(12,2) DEFAULT 0.00 CHECK (totale_speso >= 0)\n);\n\nCREATE TABLE movimenti_vendita (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    importo_totale NUMERIC(12,2) GENERATED ALWAYS AS (quantita * prezzo_unitario) STORED,\n    data_transazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    nome_categoria TEXT NOT NULL,\n    nome_fornitore TEXT NOT NULL\n);\n\nCREATE TABLE resi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    movimento_id INT NOT NULL REFERENCES movimenti_vendita(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    motivo TEXT,\n    data_reso TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE statistiche_vendite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    totale_venduto INT DEFAULT 0 CHECK (totale_venduto >= 0),\n    totale_incasso NUMERIC(12,2) DEFAULT 0.00 CHECK (totale_incasso >= 0),\n    media_prezzo NUMERIC(10,2) DEFAULT 0.00 CHECK (media_prezzo >= 0),\n    aggiornato_il TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);",
