{
  "schema_ddl": "CREATE TABLE cnt (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_conto VARCHAR(50) NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    tipo_conto VARCHAR(20) NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'costo', 'ricavo', 'patrimonio'))\n);\n\nCREATE TABLE reg (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    descrizione_registrazione TEXT NOT NULL\n);\n\nCREATE TABLE mov (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    reg_id INT NOT NULL REFERENCES reg(id) ON DELETE CASCADE,\n    cnt_id INT NOT NULL REFERENCES cnt(id),\n    imp NUMERIC(12, 2) NOT NULL CHECK (imp >= 0),\n    segno VARCHAR(1) NOT NULL CHECK (segno IN ('D', 'A'))\n);\n\nCREATE TABLE doc (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    reg_id INT NOT NULL REFERENCES reg(id) ON DELETE CASCADE,\n    numero_documento VARCHAR(50) NOT NULL,\n    data_documento DATE NOT NULL\n);\n\nCREATE TABLE aux (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cnt_id INT NOT NULL REFERENCES cnt(id),\n    note_ausiliarie TEXT,\n    valore_riferimento NUMERIC(12, 2) DEFAULT 0.00\n);",
