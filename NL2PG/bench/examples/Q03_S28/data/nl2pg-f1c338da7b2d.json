      {
        "twist_type": "synonym",
        "target_value": "imp",
        "obsolete_value": "importo",
        "description": "La colonna imp, abbreviazione di importo, può essere citata con il sinonimo importo o ammontare; la query Top-N deve usare il campo fisico imp."
