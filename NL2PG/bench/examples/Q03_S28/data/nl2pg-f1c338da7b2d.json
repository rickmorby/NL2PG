        "twist_type": "ambiguity",
        "target_value": "mov",
        "obsolete_value": "operazioni",
        "description": "Il termine operazioni è ambiguo nel linguaggio contabile e in questo schema corrisponde alla tabella mov dei movimenti, non alla tabella reg delle registrazioni."
      }
