  "schema_ddl": "CREATE TYPE stato_ordine AS ENUM ('pianificato', 'in_lavorazione', 'completato', 'annullato');\n\nCREATE TABLE ordini_produzione (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_ordine TEXT NOT NULL UNIQUE,\n    articolo TEXT NOT NULL,\n    quantita_richiesta INT NOT NULL CHECK (quantita_richiesta > 0),\n    stato_ordine stato_ordine NOT NULL DEFAULT 'pianificato',\n    data_pianificazione DATE NOT NULL,\n    data_consegna DATE,\n    CHECK (data_consegna IS NULL OR data_consegna >= data_pianificazione)\n);\n\nCREATE TABLE righe_ordini_produzione (\n    ordine_id INT NOT NULL REFERENCES ordini_produzione(id) ON DELETE CASCADE,\n    numero_riga INT NOT NULL CHECK (numero_riga > 0),\n    componente TEXT NOT NULL,\n    quantita_componente INT NOT NULL CHECK (quantita_componente > 0),\n    PRIMARY KEY (ordine_id, numero_riga)\n);",
