  "feature_sql": [],
  "query": "SELECT o.codice_ordine, o.articolo, o.quantita_richiesta, o.stato_ordine, o.data_pianificazione, o.data_consegna, (o.data_consegna - o.data_pianificazione) AS giorni_lead_time, (SELECT COUNT(*) FROM righe_ordini_produzione r WHERE r.ordine_id = o.id) AS numero_componenti FROM ordini_produzione o WHERE o.stato_ordine IN ('in_lavorazione', 'pianificato') AND o.quantita_richiesta BETWEEN 500 AND 2000 ORDER BY o.data_consegna ASC, o.codice_ordine ASC;"
}