    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "agenzie",
        "obsolete_value": "filiali",
        "description": "La tabella agenzie (padre nella relazione 1:N) viene denominata filiali nella prosa aziendale. Le query dovranno risolvere la corrispondenza tra filiali e la tabella fisica agenzie."
      },
      {
        "twist_type": "synonym",
        "target_value": "immobili",
        "obsolete_value": "unità abitative",
        "description": "La tabella immobili (figlia con FK nullable agenzia_id) viene indicata con il sinonimo unità abitative nella documentazione aziendale. Le query IS NULL / IS NOT NULL sulla FK dovranno riferirsi agli immobili tramite questa perifrasi."
      }
    ],
    "spec_hash": "79a0c028b69fdb7b"
  },
  "schema_ddl": "CREATE TABLE agenzie (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    telefono TEXT,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE agenti (\n    id SERIAL PRIMARY KEY,\n    agenzia_id INT NOT NULL REFERENCES agenzie(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    CHECK (nome <> '' AND cognome <> '')\n);\n\nCREATE TABLE immobili (\n    id SERIAL PRIMARY KEY,\n    agenzia_id INT REFERENCES agenzie(id),\n    indirizzo TEXT NOT NULL,\n    tipo_immobile TEXT NOT NULL CHECK (tipo_immobile IN ('appartamento', 'villa', 'attico', 'loft', 'terreno')),\n    metri_quadri INT NOT NULL CHECK (metri_quadri > 0),\n    prezzo NUMERIC(12,2) NOT NULL CHECK (prezzo >= 0),\n    stato TEXT NOT NULL DEFAULT 'disponibile' CHECK (stato IN ('disponibile', 'riservato', 'venduto'))\n);",
