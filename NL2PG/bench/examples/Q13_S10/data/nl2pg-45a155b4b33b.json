  "schema_ddl": "CREATE TABLE corriere (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_azienda TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_spedizione TEXT NOT NULL UNIQUE,\n    corriere_id INT NOT NULL REFERENCES corriere(id),\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    data_affidamento DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE colli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    spedizione_id INT NOT NULL REFERENCES spedizioni(id) ON DELETE CASCADE,\n    codice_collo TEXT NOT NULL UNIQUE,\n    descrizione_contenuto TEXT,\n    valore_dichiarato NUMERIC(10,2) CHECK (valore_dichiarato >= 0)\n);",
