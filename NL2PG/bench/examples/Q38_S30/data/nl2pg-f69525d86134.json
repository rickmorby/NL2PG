  "schema_ddl": "CREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE flussi_inbound_approvvigionamento (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE dettagli_flusso_inbound (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    flusso_inbound_id INT NOT NULL REFERENCES flussi_inbound_approvvigionamento(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_concordato NUMERIC(10,2) NOT NULL CHECK (prezzo_concordato >= 0)\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE ordini_cliente (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_emissione DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL,\n    valore_complessivo NUMERIC(12,2) NOT NULL CHECK (valore_complessivo >= 0)\n);\n\nCREATE TABLE ordini_cliente_storico (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_emissione DATE NOT NULL,\n    stato_ordine TEXT NOT NULL,\n    valore_complessivo NUMERIC(12,2) NOT NULL CHECK (valore_complessivo >= 0)\n);\n\nCREATE TABLE magazzini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_magazzino TEXT NOT NULL UNIQUE,\n    ubicazione TEXT NOT NULL\n);\n\nCREATE TABLE giacenze_articoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    magazzino_id INT NOT NULL REFERENCES magazzini(id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita_disponibile INT NOT NULL CHECK (quantita_disponibile >= 0)\n);\n\nCREATE TABLE listini_prezzi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE transazioni_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    flusso_inbound_id INT REFERENCES flussi_inbound_approvvigionamento(id),\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    importo NUMERIC(12,2) NOT NULL,\n    stato TEXT NOT NULL\n);",
