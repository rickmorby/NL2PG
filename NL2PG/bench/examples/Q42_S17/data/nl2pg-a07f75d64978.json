  "schema_ddl": "CREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    nome_cliente TEXT NOT NULL,\n    data_ordine DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    stato_ordine TEXT NOT NULL CHECK (stato_ordine IN ('in_attesa', 'confermato', 'spedito', 'completato', 'annullato')),\n    modalita_pagamento TEXT NOT NULL CHECK (modalita_pagamento IN ('carta', 'bonifico', 'contanti', 'paypal')),\n    note TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    deleted_at TIMESTAMP\n);\n\nCREATE INDEX idx_ordini_deleted_at ON ordini (deleted_at);\nCREATE INDEX idx_ordini_stato ON ordini (stato_ordine) WHERE deleted_at IS NULL;",
