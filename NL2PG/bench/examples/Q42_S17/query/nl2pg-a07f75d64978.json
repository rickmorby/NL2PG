  "query": "SELECT nome_cliente, numero_ordine, data_ordine, importo_totale, stato_ordine, modalita_pagamento FROM ordini WHERE deleted_at IS NULL AND (stato_ordine = 'annullato' OR modalita_pagamento = 'contanti') ORDER BY data_ordine DESC, importo_totale DESC;"
