{
  "schema_ddl": "CREATE TABLE magazzini (\n    magazzino_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    capacita_m3 NUMERIC(10,2) NOT NULL CHECK (capacita_m3 > 0)\n);\n\nCREATE TABLE prodotti (\n    prodotto_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0)\n);\n\nCREATE TABLE giacenze (\n    magazzino_id INT NOT NULL REFERENCES magazzini(magazzino_id),\n    prodotto_id INT NOT NULL REFERENCES prodotti(prodotto_id),\n    quantita INT NOT NULL CHECK (quantita >= 0),\n    data_rilevazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    PRIMARY KEY (magazzino_id, prodotto_id)\n);\n\nCREATE TABLE spedizioni (\n    spedizione_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    magazzino_id INT NOT NULL REFERENCES magazzini(magazzino_id),\n    data_spedizione DATE NOT NULL,\n    vettore TEXT NOT NULL,\n    stato TEXT NOT NULL CHECK (stato IN ('in_attesa', 'in_transito', 'consegnata', 'annullata'))\n);",
