  "schema_ddl": "CREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_spedizione TEXT NOT NULL UNIQUE,\n    destinatario_nome TEXT NOT NULL,\n    destinatario_cognome TEXT NOT NULL,\n    indirizzo_via TEXT NOT NULL,\n    indirizzo_numero_civico TEXT NOT NULL,\n    indirizzo_cap TEXT NOT NULL CHECK (indirizzo_cap ~ '^[0-9]{5}$'),\n    indirizzo_citta TEXT NOT NULL,\n    indirizzo_provincia TEXT NOT NULL CHECK (char_length(indirizzo_provincia) = 2),\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    volume_m3 NUMERIC(8,3) NOT NULL CHECK (volume_m3 >= 0),\n    stato_spedizione TEXT NOT NULL DEFAULT 'in_transito' CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnata', 'fallita')),\n    costo_spedizione NUMERIC(10,2) NOT NULL CHECK (costo_spedizione >= 0),\n    data_consegna_prevista DATE,\n    data_consegna_effettiva DATE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
