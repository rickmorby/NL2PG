  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT c.nome, c.stato, COUNT(DISTINCT s.tipo_srv) AS numero_tipi_servizi, SUM(f.imp) AS totale_fatturato FROM cli c JOIN srv s ON c.id = s.cli_id LEFT JOIN fatt f ON c.id = f.cli_id WHERE c.stato IN ('attivo', 'sospeso') GROUP BY c.nome, c.stato HAVING COUNT(DISTINCT s.tipo_srv) > 1 AND SUM(f.imp) > 50.0 ORDER BY totale_fatturato DESC;"
}