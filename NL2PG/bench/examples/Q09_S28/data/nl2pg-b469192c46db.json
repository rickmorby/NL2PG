  "schema_ddl": "CREATE TABLE cli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cod_fisc TEXT NOT NULL UNIQUE,\n    data_reg DATE NOT NULL,\n    stato TEXT NOT NULL CHECK (stato IN ('attivo', 'sospeso', 'chiuso'))\n);\n\nCREATE TABLE srv (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cli_id INT NOT NULL REFERENCES cli(id),\n    tipo_srv TEXT NOT NULL CHECK (tipo_srv IN ('voce', 'dati', 'tv', 'fonia_mobile')),\n    data_attiv DATE NOT NULL,\n    data_disattiv DATE,\n    CHECK (data_disattiv IS NULL OR data_disattiv >= data_attiv)\n);\n\nCREATE TABLE fatt (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cli_id INT NOT NULL REFERENCES cli(id),\n    srv_id INT REFERENCES srv(id),\n    data_fatt DATE NOT NULL,\n    imp NUMERIC(10,2) NOT NULL CHECK (imp >= 0),\n    pagato BOOLEAN DEFAULT FALSE\n);\n\nCREATE TABLE traff (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    srv_id INT NOT NULL REFERENCES srv(id),\n    data_rilev DATE NOT NULL,\n    qta_gb NUMERIC(10,2) NOT NULL CHECK (qta_gb >= 0),\n    tipo_traff TEXT NOT NULL CHECK (tipo_traff IN ('download', 'upload', 'totale'))\n);\n\nCREATE TABLE contr (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cli_id INT NOT NULL REFERENCES cli(id),\n    tipo_contr TEXT NOT NULL CHECK (tipo_contr IN ('residenziale', 'business', 'promo')),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    costo_mens NUMERIC(10,2) NOT NULL CHECK (costo_mens >= 0),\n    CHECK (data_fine IS NULL OR data_fine >= data_inizio)\n);",
