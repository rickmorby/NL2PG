  "query": "SELECT UPPER(ragione_sociale) AS ragione_sociale_normalizzata, INITCAP((sede).via) AS via_sede, (sede).citta AS citta_sede, CONCAT((sede).cap, ' ', (sede).provincia) AS cap_e_provincia, telefono_contatto AS telefono_referente FROM fornitori WHERE attivo IS TRUE AND (sede).citta = 'Milano' ORDER BY ragione_sociale_normalizzata, via_sede;"
