{
  "schema_ddl": "CREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL CHECK (stato_ordine IN ('in_attesa', 'confermato', 'pagato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    email_cliente TEXT NOT NULL,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL UNIQUE REFERENCES ordini(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    codice_tracciamento TEXT NOT NULL UNIQUE,\n    corriere TEXT NOT NULL,\n    indirizzo_destinazione TEXT NOT NULL,\n    citta_destinazione TEXT NOT NULL,\n    cap_destinazione TEXT NOT NULL CHECK (cap_destinazione ~ '^[0-9]{5}$'),\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione IN ('preparata', 'affidata_al_corriere', 'in_transito', 'consegnata', 'rimandata_al_mittente')),\n    data_spedizione DATE,\n    data_consegna_prevista DATE,\n    data_consegna_effettiva DATE,\n    costo_spedizione NUMERIC(8,2) NOT NULL DEFAULT 0 CHECK (costo_spedizione >= 0),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT chk_date_consegna CHECK (data_consegna_effettiva IS NULL OR data_spedizione IS NULL OR data_consegna_effettiva >= data_spedizione)\n);",
