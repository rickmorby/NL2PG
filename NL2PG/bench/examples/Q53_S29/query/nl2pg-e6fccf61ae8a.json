  "feature_sql": [
    "ordered_set_agg"
  ],
  "query": "SELECT a.nome, a.cognome, a.email, COUNT(*) AS numero_contratti, ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY c.prezzo_vendita)::numeric, 2) AS prezzo_mediano_vendita, SUM(c.provvigione) AS provvigioni_totali FROM agenti a JOIN contratti c ON c.agente_id = a.id JOIN immobili i ON i.id = c.immobile_id WHERE c.data_contratto BETWEEN DATE '2023-06-15' AND DATE '2024-12-31' AND i.tipo_immobile IN ('appartamento', 'attico', 'loft') GROUP BY a.nome, a.cognome, a.email HAVING COUNT(*) >= 3 ORDER BY prezzo_mediano_vendita DESC, a.email ASC;"
}