      "ordered_set_agg"
    ],
    "twist": [
      "rename",
      "synonym",
      "jargon"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "agenti",
        "obsolete_value": "consulenti_catastali_abilitati",
        "description": "La tabella agenti, che contiene l'anagrafica spezzata del personale commerciale (colonne nome e cognome separate), viene denominata nella prosa aziendale consulenti_catastali_abilitati. Il risolutore deve mappare la perifrasi alla tabella reale agenti."
      },
      {
        "twist_type": "synonym",
        "target_value": "cognome",
        "obsolete_value": "componente_familiare_dell'anagrafica",
        "description": "La colonna cognome della tabella agenti, che archivia la seconda parte del dato anagrafico logico unico spezzato su due colonne, viene indicata nei documenti come componente_familiare_dell'anagrafica. La query richiede il calcolo di mode() WITHIN GROUP (ORDER BY cognome) sulla colonna corretta dello split."
      },
      {
        "twist_type": "jargon",
        "target_value": "prezzo_vendita",
        "obsolete_value": "controvalore di realizzo dell'unità abitativa",
        "description": "La colonna prezzo_vendita della tabella contratti viene espressa nel linguaggio settoriale come controvalore di realizzo dell'unità abitativa. Il termine tecnico-immobiliare deve essere ricondotto alla colonna numerica effettiva su cui filtrare gli agenti prima di calcolare il valore modale del cognome."
      }
    ],
    "spec_hash": "8ef91d1bfabb5a4a"
  },
  "schema_ddl": "CREATE TABLE agenti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT UNIQUE,\n    telefono TEXT,\n    data_assunzione DATE NOT NULL\n);\n\nCREATE TABLE immobili (\n    id INT PRIMARY KEY,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    tipo_immobile TEXT NOT NULL CHECK (tipo_immobile IN ('appartamento', 'villa', 'attico', 'loft', 'rustico')),\n    superficie_mq NUMERIC(7,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani > 0)\n);\n\nCREATE TABLE contratti (\n    id INT PRIMARY KEY,\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    data_contratto DATE NOT NULL,\n    prezzo_vendita NUMERIC(12,2) NOT NULL CHECK (prezzo_vendita > 0),\n    provvigione NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (provvigione >= 0)\n);",
