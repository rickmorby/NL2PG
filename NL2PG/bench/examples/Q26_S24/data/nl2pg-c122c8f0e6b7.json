{
  "spec": {
    "domain": "assicurazioni",
    "n_tables": 2,
    "hierarchy": "one_to_many",
    "sql_features": [
      "anti_join"
    ],
    "twist": [
      "rename",
      "synonym"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "polizze",
        "obsolete_value": "contratti_di_copertura",
        "description": "La tabella padre polizze (pk: id_polizza) viene denominata contratti_di_copertura nella prosa aziendale. Il solver deve risalire alla tabella fisica polizze per costruire l'anti-join sulle polizze prive di sinistri."
      },
      {
        "twist_type": "synonym",
        "target_value": "sinistri",
        "obsolete_value": "pratiche_di_liquidazione",
        "description": "La tabella figlia sinistri (fk: polizza_id con ON DELETE SET NULL verso polizze.id_polizza) viene indicata come pratiche_di_liquidazione. Il solver deve riconoscere il sinonimo per formulare correttamente la condizione WHERE NOT EXISTS (SELECT 1 FROM sinistri WHERE sinistri.polizza_id = polizze.id_polizza), tenendo conto che le FK NULL derivanti da ON DELETE SET NULL non producono corrispondenze."
      }
    ],
    "spec_hash": "9049f80da07c84a9"
  },
  "schema_ddl": "CREATE TABLE polizze (\n    id_polizza INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    nome_contraente TEXT NOT NULL,\n    data_emissione DATE NOT NULL,\n    premio_annuo NUMERIC(10,2) NOT NULL CHECK (premio_annuo >= 0),\n    stato_polizza TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_polizza IN ('attiva', 'sospesa', 'scaduta', 'annullata'))\n);\n\nCREATE TABLE sinistri (\n    id_sinistro INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    polizza_id INT REFERENCES polizze(id_polizza) ON DELETE SET NULL ON UPDATE CASCADE,\n    data_accadimento DATE NOT NULL,\n    data_denuncia DATE NOT NULL,\n    descrizione_evento TEXT NOT NULL,\n    importo_danno NUMERIC(12,2) NOT NULL CHECK (importo_danno >= 0),\n    importo_liquidato NUMERIC(12,2) CHECK (importo_liquidato IS NULL OR importo_liquidato >= 0),\n    stato_pratica TEXT NOT NULL DEFAULT 'aperta' CHECK (stato_pratica IN ('aperta', 'in_valutazione', 'liquidata', 'respinta')),\n    CHECK (data_denuncia >= data_accadimento)\n);",
