  "query": "SELECT p.nome_contraente, p.numero_polizza, p.data_emissione, p.premio_annuo FROM polizze p WHERE p.stato_polizza = 'attiva' AND NOT EXISTS (SELECT 1 FROM sinistri s WHERE s.polizza_id = p.id_polizza) ORDER BY p.premio_annuo DESC, p.numero_polizza ASC;"
