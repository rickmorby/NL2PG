  "feature_sql": [
    "join"
  ],
  "query": "SELECT c.codice_conto, c.descrizione AS nome_conto, COUNT(m.id) AS numero_movimenti, SUM(m.importo_dare) AS totale_dare, SUM(m.importo_avere) AS totale_avere FROM conti_contabili c JOIN movimenti_contabili m ON m.conto_id = c.id WHERE c.tipo_conto = 'attivo' GROUP BY c.codice_conto, c.descrizione ORDER BY totale_dare DESC;"
}