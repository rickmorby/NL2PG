{
  "schema_ddl": "CREATE TABLE ospedali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_ospedale TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    totale_pazienti_ricoverati INT DEFAULT 0,\n    budget_annuale NUMERIC(12,2) CHECK (budget_annuale >= 0)\n);\n\nCREATE TABLE reparti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ospedale_id INT NOT NULL REFERENCES ospedali(id),\n    codifica_nosologica_reparto TEXT NOT NULL,\n    categoria_reparto TEXT NOT NULL,\n    numero_letti INT CHECK (numero_letti >= 0),\n    totale_medici INT DEFAULT 0\n);\n\nCREATE TABLE medici (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    nome_medico TEXT NOT NULL,\n    cognome_medico TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    numero_visite_effettuate INT DEFAULT 0\n);\n\nCREATE TABLE cartelle_cliniche (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    medico_id INT NOT NULL REFERENCES medici(id),\n    codice_fiscale_paziente TEXT NOT NULL,\n    nome_paziente TEXT NOT NULL,\n    cognome_paziente TEXT NOT NULL,\n    data_ricovero DATE NOT NULL,\n    diagnosi TEXT NOT NULL,\n    costo_totale_prestazione NUMERIC(10,2) CHECK (costo_totale_prestazione >= 0),\n    note_mediche TEXT\n);\n\nCREATE TABLE trattamenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cartella_id INT NOT NULL REFERENCES cartelle_cliniche(id),\n    descrizione_trattamento TEXT NOT NULL,\n    costo_unitario NUMERIC(8,2) CHECK (costo_unitario >= 0),\n    quantita INT CHECK (quantita > 0),\n    costo_complessivo NUMERIC(10,2) CHECK (costo_complessivo >= 0)\n);",
