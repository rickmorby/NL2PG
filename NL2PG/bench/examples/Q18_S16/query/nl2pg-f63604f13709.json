  "feature_sql": [
    "lateral"
  ],
  "query": "SELECT p.nome, p.categoria, p.unita_misura, sp.prezzo AS ultimo_prezzo, sp.codice_listino AS listino, sp.valid_from AS inizio_validita, CASE WHEN sp.prezzo >= 100 THEN 'fascia alta' WHEN sp.prezzo >= 50 THEN 'fascia media' ELSE 'fascia bassa' END AS fascia_prezzo FROM prodotti AS p LEFT JOIN LATERAL (SELECT s.prezzo, s.codice_listino, s.valid_from FROM storico_prezzi AS s WHERE s.prodotto_id = p.prodotto_id AND s.codice_listino = 'BASE' ORDER BY s.valid_from DESC LIMIT 1) AS sp ON TRUE WHERE p.categoria = 'Elettronica' AND p.attivo IS TRUE ORDER BY ultimo_prezzo DESC NULLS LAST, p.nome, p.prodotto_id"
}