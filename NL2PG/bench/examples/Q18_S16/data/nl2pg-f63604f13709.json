    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "prodotti",
        "obsolete_value": "anagrafica_articoli",
        "description": "La tabella prodotti viene denominata anagrafica_articoli nella prosa aziendale. La tabella contiene il catalogo con chiave primaria prodotto_id; la query deve risolvere il riferimento all'entita' reale prodotti."
      },
      {
        "twist_type": "jargon",
        "target_value": "storico_prezzi",
        "obsolete_value": "vigenze_listino",
        "description": "La tabella storico_prezzi, che conserva le versioni temporali dei prezzi con le colonne valid_from e valid_to, viene indicata con il gergo commerciale 'vigenze_listino'. Il solver deve mappare la perifrasi gergale alla tabella fisica dello storico."
      },
      {
        "twist_type": "polysemy",
        "target_value": "prezzo",
        "obsolete_value": "prezzo corrente",
        "description": "L'espressione 'prezzo corrente' nella prosa e' ambigua: puo' significare sia l'ultima versione registrata nello storico (ordinata per valid_from DESC) sia la versione valida alla data odierna (valid_from <= CURRENT_DATE AND (valid_to IS NULL OR valid_to > CURRENT_DATE)). La query LATERAL deve interpretarla come la versione valida oggi, selezionata con ORDER BY valid_from DESC LIMIT 1."
      }
    ],
    "spec_hash": "ccf88bedb91e97f0"
  },
  "schema_ddl": "CREATE TABLE prodotti (\n    prodotto_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sku TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    descrizione TEXT,\n    categoria TEXT NOT NULL,\n    unita_misura TEXT NOT NULL DEFAULT 'PZ',\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE storico_prezzi (\n    prodotto_id INT NOT NULL REFERENCES prodotti(prodotto_id) ON DELETE CASCADE,\n    valid_from DATE NOT NULL,\n    valid_to DATE,\n    prezzo NUMERIC(10,2) NOT NULL CHECK (prezzo >= 0),\n    codice_listino TEXT NOT NULL DEFAULT 'BASE',\n    PRIMARY KEY (prodotto_id, valid_from),\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);",
