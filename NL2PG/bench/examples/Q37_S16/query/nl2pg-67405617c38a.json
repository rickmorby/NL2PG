  "feature_sql": [
    "math_funcs"
  ],
  "query": "SELECT cl.nome || ' ' || cl.cognome AS cliente, cl.email, COUNT(*) AS ordini_validi, ROUND(AVG(o.importo_totale), 2) AS spesa_media_per_ordine, SUM(o.importo_totale) AS spesa_totale FROM clienti cl JOIN ordini o ON o.cliente_id = cl.id WHERE o.stato_ordine IN ('consegnato', 'spedito') AND cl.citta IS NOT NULL GROUP BY cl.nome, cl.cognome, cl.email HAVING COUNT(*) >= 2 ORDER BY spesa_totale DESC, cl.email ASC;"
}