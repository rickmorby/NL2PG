    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "righe_ordine",
        "obsolete_value": "posizioni_di_ordine",
        "description": "La tabella figlia righe_ordine, contenente la FK nullable ordine_id verso ordini_acquisto, viene denominata posizioni_di_ordine nella prosa aziendale. Le righe con ordine_id NULL rappresentano richieste non ancora assegnate a un ordine e vanno gestite con IS NULL o join esterni."
      },
      {
        "twist_type": "jargon",
        "target_value": "fornitori",
        "obsolete_value": "anagrafica_terzi",
        "description": "Nel gergo ERP la tabella fornitori è indicata come anagrafica_terzi (master data dei terzi). Il solver deve riconoscere che ogni riferimento all'anagrafica terzi nella prosa aziendale riguarda la tabella fornitori."
      },
      {
        "twist_type": "synonym",
        "target_value": "data_consegna",
        "obsolete_value": "termine_di_evasione",
        "description": "La colonna data_consegna della tabella righe_ordine è indicata come termine_di_evasione. È la colonna chiave per l'ordinamento della SELECT DISTINCT ON (articolo_id) ... ORDER BY articolo_id, data_consegna, dove la prima riga di ogni gruppo di articoli risulta vincente."
      }
    ],
    "spec_hash": "8f058a480620a25e"
  },
  "schema_ddl": "CREATE TABLE fornitori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    email TEXT,\n    telefono TEXT,\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE articoli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    unita_misura TEXT NOT NULL DEFAULT 'PZ'\n);\n\nCREATE TABLE ordini_acquisto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    fornitore_id INT NOT NULL REFERENCES fornitori(id),\n    data_ordine DATE NOT NULL,\n    stato_ordine TEXT NOT NULL DEFAULT 'aperto' CHECK (stato_ordine IN ('aperto', 'confermato', 'evaso', 'annullato')),\n    note TEXT\n);\n\nCREATE TABLE centri_costo (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_centro TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL\n);\n\nCREATE TABLE righe_ordine (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT REFERENCES ordini_acquisto(id),\n    articolo_id INT NOT NULL REFERENCES articoli(id),\n    centro_costo_id INT REFERENCES centri_costo(id),\n    quantita NUMERIC(12,3) NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    data_consegna DATE NOT NULL,\n    stato_riga TEXT NOT NULL DEFAULT 'da_assegnare' CHECK (stato_riga IN ('da_assegnare', 'assegnata', 'evasa', 'annullata')),\n    CHECK (stato_riga <> 'assegnata' OR ordine_id IS NOT NULL),\n    note TEXT\n);",
