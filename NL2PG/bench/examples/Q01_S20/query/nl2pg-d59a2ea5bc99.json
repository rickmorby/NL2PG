  "feature_sql": [],
  "query": "SELECT tipo, conto, COUNT(*) AS numero_operazioni, SUM(importo) AS totale_importi, ROUND(AVG(importo), 2) AS importo_medio FROM movimenti_contabili WHERE stato IN ('registrato', 'verificato') GROUP BY tipo, conto ORDER BY totale_importi DESC;"
