    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "chiamate",
        "obsolete_value": "registro_traffico_voce",
        "description": "La tabella chiamate, che registra gli eventi di traffico voce dei clienti, viene denominata registro_traffico_voce nella prosa aziendale. Le query devono risolvere il nome perifrastico sulla tabella fisica chiamate."
      },
      {
        "twist_type": "jargon",
        "target_value": "durata_minuti",
        "obsolete_value": "MOC",
        "description": "La colonna durata_minuti della tabella chiamate, fisicamente di tipo TEXT pur contenendo valori numerici da castare con CAST(durata_minuti AS NUMERIC), è indicata nella documentazione con il gergo di settore MOC (Minutes Of Consumption)."
      },
      {
        "twist_type": "synonym",
        "target_value": "clienti",
        "obsolete_value": "utenze",
        "description": "La tabella clienti, anagrafica degli abbonati del gestore, è sinonimizzata come utenze nella prosa aziendale. Le query devono mappare il termine utenze sulla tabella fisica clienti."
      }
    ],
    "spec_hash": "ae9dbf09779a380e"
  },
  "schema_ddl": "CREATE TABLE piani_tariffari (\n    id INT PRIMARY KEY,\n    nome_piano TEXT NOT NULL UNIQUE,\n    gestore TEXT NOT NULL,\n    canone_mensile NUMERIC(8,2) NOT NULL CHECK (canone_mensile >= 0),\n    minuti_inclusi INT NOT NULL DEFAULT 0 CHECK (minuti_inclusi >= 0)\n);\n\nCREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    citta_residenza TEXT,\n    email TEXT UNIQUE,\n    data_attivazione_contratto TEXT\n);\n\nCREATE TABLE abbonamenti (\n    id INT PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    piano_id INT NOT NULL REFERENCES piani_tariffari(id),\n    numero_msisdn TEXT NOT NULL UNIQUE,\n    stato TEXT NOT NULL CHECK (stato IN ('attivo', 'sospeso', 'disdetto')),\n    data_sottoscrizione TEXT\n);\n\nCREATE TABLE chiamate (\n    id BIGINT PRIMARY KEY,\n    abbonamento_id INT NOT NULL REFERENCES abbonamenti(id),\n    data_chiamata TEXT NOT NULL,\n    ora_inizio TEXT,\n    durata_minuti TEXT NOT NULL,\n    tipo_chiamata TEXT NOT NULL CHECK (tipo_chiamata IN ('uscita', 'entrata', 'persa', 'inoltrata')),\n    costo_euro NUMERIC(12,2),\n    CHECK (durata_minuti ~ '^[0-9]+([.][0-9]+)?$'),\n    CHECK (data_chiamata ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\n);",
