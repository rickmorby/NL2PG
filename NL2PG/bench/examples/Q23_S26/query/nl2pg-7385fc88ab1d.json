  "feature_sql": [
    "filtered_agg"
  ],
  "query": "SELECT p.gestore, COUNT(*) AS totale_chiamate, COUNT(*) FILTER (WHERE c.tipo_chiamata = 'uscita') AS chiamate_in_uscita, COUNT(*) FILTER (WHERE c.tipo_chiamata = 'entrata') AS chiamate_in_entrata, COUNT(*) FILTER (WHERE c.tipo_chiamata = 'persa') AS chiamate_perse, ROUND(SUM(c.costo_euro::NUMERIC) FILTER (WHERE a.stato = 'attivo'), 2) AS ricavo_abbonamenti_attivi_euro, ROUND(AVG(c.durata_minuti::NUMERIC), 2) AS durata_media_minuti FROM chiamate c JOIN abbonamenti a ON c.abbonamento_id = a.id JOIN piani_tariffari p ON a.piano_id = p.id WHERE c.data_chiamata >= '2026-01-12' GROUP BY p.gestore ORDER BY ricavo_abbonamenti_attivi_euro DESC;"
}