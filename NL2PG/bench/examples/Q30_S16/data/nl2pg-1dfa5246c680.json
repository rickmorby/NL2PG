    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "storico_prezzi",
        "obsolete_value": "archivio_listini",
        "description": "La tabella storico_prezzi, che conserva le versioni temporali dei prezzi dei prodotti (prodotto_id, prezzo_unitario, valid_from, valid_to), viene denominata archivio_listini nella prosa aziendale; il solver deve risalire al nome reale della tabella nello schema."
      },
      {
        "twist_type": "synonym",
        "target_value": "prezzo_unitario",
        "obsolete_value": "tariffa vigente",
        "description": "La colonna prezzo_unitario della tabella storico_prezzi viene indicata nei documenti aziendali con il sinonimo 'tariffa vigente'; i confronti tra versioni devono riferirsi alla colonna reale prezzo_unitario all'interno delle tuple ROW."
      },
      {
        "twist_type": "jargon",
        "target_value": "valid_from",
        "obsolete_value": "data di efficacia",
        "description": "La colonna valid_from, che marca l'inizio del periodo di validita' di ciascuna versione di prezzo, viene descritta con il gergo interno 'data di efficacia'; le query richieste devono usare WHERE ROW(prezzo_unitario, valid_from) = ROW(v1, t1) oppure ORDER BY storico_prezzi.valid_from per selezionare la versione corretta nel tempo."
      }
    ],
    "spec_hash": "6c5a2c306779275a"
  },
  "schema_ddl": "CREATE TABLE categorie (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE prodotti (\n    id INT PRIMARY KEY,\n    codice_sku TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    categoria_id INT NOT NULL REFERENCES categorie(id),\n    attivo BOOLEAN NOT NULL DEFAULT TRUE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE storico_prezzi (\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    valid_from TIMESTAMP NOT NULL,\n    valid_to TIMESTAMP,\n    PRIMARY KEY (prodotto_id, valid_from),\n    CHECK (valid_to IS NULL OR valid_to > valid_from)\n);\n\nCREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    email TEXT NOT NULL UNIQUE,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    citta TEXT\n);\n\nCREATE TABLE ordini (\n    id INT PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_ordine TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa',\n    totale NUMERIC(12,2) CHECK (totale >= 0)\n);",
