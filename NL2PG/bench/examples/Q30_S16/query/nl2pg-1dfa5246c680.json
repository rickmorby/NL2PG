  "query": "SELECT cl.citta, cl.nome || ' ' || cl.cognome AS cliente, o.totale AS importo_massimo, CAST(o.data_ordine AS DATE) AS giorno_ordine FROM ordini o JOIN clienti cl ON cl.id = o.cliente_id WHERE (o.cliente_id, o.totale) IN (SELECT cliente_id, MAX(totale) FROM ordini WHERE stato_ordine IN ('chiuso', 'spedito') AND data_ordine BETWEEN TIMESTAMP '2023-08-01' AND TIMESTAMP '2024-06-30' GROUP BY cliente_id) AND o.stato_ordine IN ('chiuso', 'spedito') AND o.data_ordine BETWEEN TIMESTAMP '2023-08-01' AND TIMESTAMP '2024-06-30' AND cl.citta IN ('Milano', 'Napoli') ORDER BY importo_massimo DESC, cl.email ASC;"
}