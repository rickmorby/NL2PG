  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT COALESCE(r.conto, 'TOTALE GENERALE') AS conto, COALESCE(r.centro_costo, 'TUTTI I CENTRI DI COSTO') AS centro_costo, COUNT(*) AS numero_registrazioni, SUM(r.importo) AS totale_importo, ROUND(AVG(r.importo), 2) AS importo_medio, MAX(r.data_registrazione) AS ultima_registrazione, GROUPING(r.conto) AS livello_conto, GROUPING(r.centro_costo) AS livello_centro_costo FROM registrazioni_contabili r WHERE r.data_registrazione BETWEEN DATE '2025-12-01' AND DATE '2026-01-31' AND r.descrizione IS NOT NULL GROUP BY GROUPING SETS ((r.conto, r.centro_costo), (r.conto), ()) ORDER BY livello_conto, livello_centro_costo, totale_importo DESC;"
}