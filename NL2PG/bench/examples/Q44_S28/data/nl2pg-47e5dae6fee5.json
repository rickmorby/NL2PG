        "obsolete_value": "pat_reg",
        "description": "La tabella dei pazienti è identificata nel database come pat_reg (Patient Registry)."
      },
      {
        "twist_type": "jargon",
        "target_value": "data_ricovero",
        "obsolete_value": "adm_ts",
        "description": "Il campo data_ricovero è memorizzato come adm_ts (Admission Timestamp) in formato stringa, richiedendo un cast esplicito a DATE."
      }
