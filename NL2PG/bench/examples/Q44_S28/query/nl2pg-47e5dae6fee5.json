{
  "schema_ddl": "CREATE TABLE pat_reg (\n    pat_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    pat_nm TEXT NOT NULL,\n    codice_fiscale_dimissione VARCHAR(16) UNIQUE NOT NULL,\n    dob DATE NOT NULL\n);\n\nCREATE TABLE doc_dim (\n    doc_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_medico VARCHAR(20) UNIQUE NOT NULL,\n    spec_desc TEXT NOT NULL\n);\n\nCREATE TABLE diag_dim (\n    diag_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_icd VARCHAR(10) UNIQUE NOT NULL,\n    diag_desc TEXT NOT NULL\n);\n\nCREATE TABLE ward_dim (\n    ward_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_reparto VARCHAR(10) UNIQUE NOT NULL,\n    ward_nm TEXT NOT NULL\n);\n\nCREATE TABLE adm_fact (\n    adm_id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    pat_id INT NOT NULL REFERENCES pat_reg(pat_id),\n    doc_id INT NOT NULL REFERENCES doc_dim(doc_id),\n    diag_id INT NOT NULL REFERENCES diag_dim(diag_id),\n    ward_id INT NOT NULL REFERENCES ward_dim(ward_id),\n    adm_ts VARCHAR(50) NOT NULL,\n    los_days INT CHECK (los_days >= 0),\n    tot_amt NUMERIC(10,2) CHECK (tot_amt >= 0.00)\n);",
