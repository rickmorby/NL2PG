  "feature_sql": [
    "cast"
  ],
  "query": "WITH stats_reparti AS (SELECT w.ward_nm, COUNT(a.adm_id) AS numero_ricoveri, AVG(a.tot_amt) AS media_costo FROM ward_dim w JOIN adm_fact a ON w.ward_id = a.ward_id WHERE (a.tot_amt BETWEEN 500.00 AND 5000.00) AND (w.ward_nm LIKE 'Reparto%' OR w.ward_nm = 'Pronto Soccorso') AND a.los_days IS NOT NULL GROUP BY w.ward_nm HAVING AVG(a.tot_amt) > 1000.00), classifica_reparti AS (SELECT ward_nm, numero_ricoveri, CAST(media_costo AS NUMERIC(10,2)) AS costo_medio_arrotondato, RANK() OVER (ORDER BY numero_ricoveri DESC) AS ranking FROM stats_reparti) SELECT ward_nm, numero_ricoveri, costo_medio_arrotondato, ranking FROM classifica_reparti WHERE EXISTS (SELECT 1 FROM adm_fact a2 WHERE a2.tot_amt > 1000) ORDER BY ranking ASC LIMIT 10;"
}