{
  "schema_ddl": "CREATE TABLE immobili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    codice_catastale TEXT NOT NULL,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    provincia TEXT,\n    cap TEXT,\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_locali INT NOT NULL DEFAULT 0 CHECK (numero_locali >= 0),\n    prezzo_richiesto NUMERIC(12,2) NOT NULL CHECK (prezzo_richiesto >= 0),\n    stato_annuncio TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_annuncio IN ('attivo', 'sospeso', 'venduto', 'ritirato')),\n    data_inserimento DATE NOT NULL DEFAULT CURRENT_DATE,\n    PRIMARY KEY (id, prezzo_richiesto)\n) PARTITION BY RANGE (prezzo_richiesto);\n\nCREATE TABLE immobili_popolari PARTITION OF immobili FOR VALUES FROM (0) TO (300000);\n\nCREATE TABLE immobili_lusso PARTITION OF immobili FOR VALUES FROM (300000) TO (MAXVALUE);",
