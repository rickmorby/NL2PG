{
  "schema_ddl": "CREATE TABLE polizze (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    codice_stato_ciclo TEXT NOT NULL CHECK (codice_stato_ciclo IN ('bozza', 'attiva', 'sospesa', 'scaduta', 'annullata')),\n    premio_annuo NUMERIC(15, 2) NOT NULL CHECK (premio_annuo >= 0),\n    massimale_copertura NUMERIC(15, 2) NOT NULL CHECK (massimale_copertura > 0),\n    data_emissione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_scadenza DATE NOT NULL,\n    CONSTRAINT check_date_validity CHECK (data_scadenza > data_emissione)\n);",
