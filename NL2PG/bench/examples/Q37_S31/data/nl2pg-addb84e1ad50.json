    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "registrazioni_contabili",
        "obsolete_value": "movimenti_finanziari",
        "description": "La tabella principale contenente le transazioni contabili è denominata 'movimenti_finanziari' nella documentazione aziendale, mentre nel database è 'registrazioni_contabili'."
      },
      {
        "twist_type": "jargon",
        "target_value": "ammortamento",
        "obsolete_value": "deprezzamento_annuale",
        "description": "Il campo che rappresenta l'ammortamento di un cespite viene indicato come 'deprezzamento_annuale' nei report interni, mentre nel database è 'ammortamento'."
      },
      {
        "twist_type": "polysemy",
        "target_value": "saldo",
        "obsolete_value": "disponibilità",
        "description": "Il termine 'saldo' nel database indica il valore contabile netto, mentre nella prosa aziendale viene spesso usato 'disponibilità' per riferirsi allo stesso concetto, creando ambiguità semantica."
      }
    ],
    "spec_hash": "15dec6a6ce960fa1"
  },
  "schema_ddl": "CREATE TABLE registrazioni_contabili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_registrazione DATE NOT NULL,\n    descrizione TEXT NOT NULL,\n    importo NUMERIC(15, 2) NOT NULL CHECK (importo != 0),\n    segno CHAR(1) NOT NULL CHECK (segno IN ('D', 'A')),\n    saldo NUMERIC(15, 2) GENERATED ALWAYS AS (importo * CASE WHEN segno = 'D' THEN -1 ELSE 1 END) STORED,\n    ammortamento NUMERIC(12, 2) DEFAULT 0 CHECK (ammortamento >= 0),\n    importo_arrotondato NUMERIC(15, 2) GENERATED ALWAYS AS (ROUND(importo, 2)) STORED,\n    importo_assoluto NUMERIC(15, 2) GENERATED ALWAYS AS (ABS(importo)) STORED\n);\n\nCREATE TABLE cespiti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    valore_iniziale NUMERIC(12, 2) NOT NULL CHECK (valore_iniziale > 0),\n    vita_utile INT NOT NULL CHECK (vita_utile > 0),\n    ammortamento_annuo NUMERIC(12, 2) GENERATED ALWAYS AS (valore_iniziale / vita_utile) STORED\n);\n\nCREATE TABLE bilancio (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    anno INT NOT NULL UNIQUE,\n    totale_attivo NUMERIC(15, 2) NOT NULL DEFAULT 0 CHECK (totale_attivo >= 0),\n    totale_passivo NUMERIC(15, 2) NOT NULL DEFAULT 0 CHECK (totale_passivo >= 0),\n    saldo_patrimoniale NUMERIC(15, 2) GENERATED ALWAYS AS (totale_attivo - totale_passivo) STORED\n);",
