  ],
  "query": "SELECT descrizione, ROUND(SUM(importo), 2) AS totale_importo, ROUND(AVG(importo), 2) AS importo_medio, COUNT(*) AS numero_registrazioni FROM registrazioni_contabili WHERE descrizione IN ('Incasso cliente', 'Vendita prodotto') AND segno = 'A' AND data_registrazione BETWEEN '2025-12-01' AND '2026-03-31' GROUP BY descrizione ORDER BY totale_importo DESC LIMIT 5;"
}