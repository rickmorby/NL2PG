{
  "schema_ddl": "CREATE TABLE cartelle_cliniche (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_paziente TEXT NOT NULL UNIQUE,\n    nome_paziente TEXT NOT NULL,\n    data_ricovero DATE NOT NULL,\n    reparto TEXT NOT NULL CHECK (reparto IN ('cardiologia', 'neurologia', 'ortopedia', 'pediatria', 'chirurgia')),\n    medico_responsabile TEXT NOT NULL\n);\n\nCREATE TABLE esami_diagnostici (\n    cartella_id INT NOT NULL REFERENCES cartelle_cliniche(id),\n    numero_esame INT NOT NULL CHECK (numero_esame > 0),\n    tipo_esame TEXT NOT NULL,\n    data_esame DATE NOT NULL,\n    esito TEXT,\n    referto_medico TEXT,\n    costo_esame NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (costo_esame >= 0),\n    PRIMARY KEY (cartella_id, numero_esame)\n);",
