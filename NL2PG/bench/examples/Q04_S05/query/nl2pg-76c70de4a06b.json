  "query": "SELECT c.nome_paziente, c.reparto, c.medico_responsabile, e.tipo_esame, e.esito, e.costo_esame AS costo_esame_euro FROM cartelle_cliniche c JOIN esami_diagnostici e ON c.id = e.cartella_id WHERE e.esito = 'patologico' AND c.reparto = 'cardiologia' ORDER BY e.costo_esame DESC;"
}