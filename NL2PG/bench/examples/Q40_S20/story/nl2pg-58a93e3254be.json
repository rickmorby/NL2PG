  "schema_ddl": "CREATE TYPE livello_priorita AS ENUM ('verde', 'gialla', 'rossa');\n\nCREATE TABLE pazienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE,\n    telefono TEXT\n);\n\nCREATE TABLE visite_mediche (\n    id INT PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    data_visita DATE NOT NULL,\n    ora_visita TIME,\n    motivo TEXT,\n    priorita livello_priorita NOT NULL DEFAULT 'verde',\n    medico TEXT,\n    esito TEXT,\n    CHECK (data_visita >= DATE '1950-01-01')\n);",
