  "query": "SELECT p.nome, p.cognome, p.codice_fiscale, v.data_visita, v.motivo, v.priorita, v.esito FROM pazienti p JOIN visite_mediche v ON v.paziente_id = p.id WHERE v.priorita IN ('rossa', 'gialla') AND v.data_visita BETWEEN DATE '2025-09-01' AND DATE '2026-01-31' AND v.esito IS NOT NULL ORDER BY v.data_visita ASC, p.cognome ASC, p.codice_fiscale ASC;"
}