  "query": "SELECT c.nome AS nome_cliente, c.cognome AS cognome_cliente, c.citta AS citta_cliente, p.numero_polizza, p.tipo_polizza, p.premio_annuo, p.capitale_assicurato FROM polizze p JOIN clienti c ON c.id = p.cliente_id WHERE p.stato_polizza = 'attiva' AND p.deleted_at IS NULL AND p.tipo_polizza IN ('vita', 'casa') ORDER BY p.premio_annuo DESC, p.numero_polizza ASC;"
