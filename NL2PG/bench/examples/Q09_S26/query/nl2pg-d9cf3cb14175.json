{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT,\n    email TEXT UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0)\n);",
