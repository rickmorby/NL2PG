  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT c.citta, COUNT(*) AS numero_ordini, SUM(o.importo_totale) AS fatturato_totale, ROUND(AVG(o.importo_totale), 2) AS scontrino_medio FROM clienti c JOIN ordini o ON c.id = o.cliente_id WHERE o.stato_ordine IN ('consegnato', 'spedito') GROUP BY c.citta HAVING SUM(o.importo_totale) > 50000 ORDER BY fatturato_totale DESC;"
}