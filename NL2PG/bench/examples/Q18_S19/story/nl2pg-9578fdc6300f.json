{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    data_nascita DATE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE conti_correnti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    iban TEXT NOT NULL UNIQUE,\n    saldo_disponibile NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_disponibile >= 0),\n    stato_conto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_conto IN ('attivo', 'sospeso', 'chiuso')),\n    data_apertura DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE strumenti_finanziari (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_isin TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    tipologia TEXT NOT NULL CHECK (tipologia IN ('azione', 'obbligazione', 'derivato', 'fondo', 'etf')),\n    emittente TEXT,\n    prezzo_unitario NUMERIC(12,4) NOT NULL CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE portafogli (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    nome_portafoglio TEXT NOT NULL,\n    data_creazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    UNIQUE (cliente_id, nome_portafoglio)\n);\n\nCREATE TABLE transazioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id INT NOT NULL REFERENCES conti_correnti(id),\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('addebito', 'accredito')),\n    importo_transazione NUMERIC(14,2) NOT NULL CHECK (importo_transazione > 0),\n    causale TEXT,\n    data_valuta DATE NOT NULL,\n    data_registrazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE operazioni_negoziazione (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    portafoglio_id INT NOT NULL REFERENCES portafogli(id),\n    strumento_id INT NOT NULL REFERENCES strumenti_finanziari(id),\n    direzione TEXT NOT NULL CHECK (direzione IN ('acquisto', 'vendita')),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_esecuzione NUMERIC(12,4) NOT NULL CHECK (prezzo_esecuzione >= 0),\n    controvalore NUMERIC(16,2) GENERATED ALWAYS AS (ROUND(quantita * prezzo_esecuzione, 2)) STORED,\n    data_esecuzione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);",
