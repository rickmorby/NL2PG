  "feature_sql": [
    "ordered_set_agg"
  ],
  "query": "SELECT nome_categoria AS categoria_prodotto, ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY importo)::numeric, 2) AS importo_mediano_vendita, ROUND(AVG(importo)::numeric, 2) AS importo_medio_vendita, COUNT(*) AS numero_vendite, ROUND(SUM(importo)::numeric, 2) AS fatturato_totale FROM vendite_flat WHERE data_vendita BETWEEN '2025-12-15' AND '2026-01-15' AND nome_categoria IN ('Elettronica', 'Informatica', 'Telefonia', 'Audio & Video') GROUP BY nome_categoria ORDER BY importo_mediano_vendita DESC;"
}