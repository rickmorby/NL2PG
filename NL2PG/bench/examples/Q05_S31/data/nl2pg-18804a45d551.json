  "schema_ddl": "CREATE TABLE movimenti_contabili (\n    id SERIAL PRIMARY KEY,\n    data_movimento DATE NOT NULL,\n    importo NUMERIC(15,2) NOT NULL CHECK (importo != 0),\n    nome_categoria TEXT NOT NULL,\n    nome_fornitore TEXT,\n    totale_per_categoria NUMERIC(15,2) GENERATED ALWAYS AS (importo) STORED,\n    conteggio_per_fornitore INT GENERATED ALWAYS AS (1) STORED\n);\n\nCREATE TABLE categorie_contabili (\n    id SERIAL PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    descrizione TEXT,\n    totale_movimenti NUMERIC(15,2) DEFAULT 0,\n    n_movimenti INT DEFAULT 0\n);\n\nCREATE TABLE fornitori (\n    id SERIAL PRIMARY KEY,\n    nome_fornitore TEXT NOT NULL UNIQUE,\n    codice_fiscale TEXT UNIQUE,\n    totale_speso NUMERIC(15,2) DEFAULT 0,\n    n_fatture INT DEFAULT 0\n);\n\nCREATE TABLE riepilogo_annuale (\n    id SERIAL PRIMARY KEY,\n    anno INT NOT NULL UNIQUE,\n    totale_movimenti_annuali NUMERIC(15,2) DEFAULT 0,\n    n_movimenti_annuali INT DEFAULT 0,\n    n_categorie_attive INT DEFAULT 0,\n    n_fornitori_attivi INT DEFAULT 0\n);",
