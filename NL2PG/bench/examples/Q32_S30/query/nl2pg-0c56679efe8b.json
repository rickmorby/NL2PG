  "feature_sql": [
    "values"
  ],
  "query": "WITH sedi_target(citta) AS (VALUES ('Milano'), ('Torino'), ('Bologna')) SELECT m.ubicazione AS citta, COUNT(DISTINCT mm.articolo_id) AS articoli_movimentati, SUM(mm.quantita) AS quantita_totale, ROUND(SUM(mm.quantita * mm.costo_unitario), 2) AS valore_carichi_euro FROM magazzini m JOIN movimenti_magazzino mm ON m.id = mm.magazzino_id JOIN sedi_target s ON m.ubicazione = s.citta WHERE mm.tipo_movimento = 'carico' GROUP BY m.ubicazione ORDER BY valore_carichi_euro DESC;"
}