    "sql_features": [
      "top_n"
    ],
    "twist": [
      "rename",
      "jargon",
      "synonym"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "movimenti_contabili",
        "obsolete_value": "prima_nota",
        "description": "La tabella principale del registro contabile si chiama movimenti_contabili ed è partizionata dichiarativamente con PARTITION BY RANGE sulla colonna data_registrazione. Nella prosa aziendale viene però sempre indicata come prima_nota, quindi il solver deve mappare tale denominazione alla tabella logica reale senza riferirsi esplicitamente alle partizioni."
      },
      {
        "twist_type": "jargon",
        "target_value": "saldo_residuo",
        "obsolete_value": "partita aperta",
        "description": "La colonna saldo_residuo di movimenti_contabili rappresenta l'importo ancora da incassare o pagare. Nel linguaggio aziendale viene descritta esclusivamente come 'partita aperta', un gergo contabile che il solver deve riconoscere per applicare correttamente filtri e ordinamenti (es. ORDER BY saldo_residuo DESC LIMIT n)."
      },
      {
        "twist_type": "synonym",
        "target_value": "causali_contabili",
        "obsolete_value": "codici operazione",
        "description": "La tabella di lookup causali_contabili contiene i codici delle tipologie di registrazione. Nei documenti aziendali viene citata come 'codici operazione': il solver deve identificare il sinonimo per effettuare correttamente il join con movimenti_contabili quando la query Top-N richiede il raggruppamento o il filtro per tipo di scrittura."
      }
    ],
    "spec_hash": "042b89b439c0dab1"
  },
  "schema_ddl": "CREATE TABLE causali_contabili (\n    id INT PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    segno TEXT NOT NULL CHECK (segno IN ('dare', 'avere'))\n);\n\nCREATE TABLE conti (\n    id INT PRIMARY KEY,\n    codice_conto TEXT NOT NULL UNIQUE,\n    denominazione TEXT NOT NULL,\n    tipo_conto TEXT NOT NULL CHECK (tipo_conto IN ('attivo', 'passivo', 'costo', 'ricavo')),\n    conto_padre_id INT REFERENCES conti(id)\n);\n\nCREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT\n);\n\nCREATE TABLE fornitori (\n    id INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT\n);\n\nCREATE TABLE movimenti_contabili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    data_registrazione DATE NOT NULL,\n    numero_protocollo INT NOT NULL,\n    causale_id INT NOT NULL REFERENCES causali_contabili(id),\n    conto_id INT NOT NULL REFERENCES conti(id),\n    cliente_id INT REFERENCES clienti(id),\n    fornitore_id INT REFERENCES fornitori(id),\n    importo_dare NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    saldo_residuo NUMERIC(14,2) NOT NULL DEFAULT 0 CHECK (saldo_residuo >= 0),\n    descrizione TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    PRIMARY KEY (id, data_registrazione)\n) PARTITION BY RANGE (data_registrazione);\n\nCREATE TABLE movimenti_contabili_2024 PARTITION OF movimenti_contabili\n    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');\n\nCREATE TABLE movimenti_contabili_2025 PARTITION OF movimenti_contabili\n    FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');\nCREATE TABLE movimenti_contabili_default PARTITION OF movimenti_contabili DEFAULT;",
