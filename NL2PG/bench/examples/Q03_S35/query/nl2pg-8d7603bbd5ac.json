  "query": "SELECT m.data_registrazione, cl.ragione_sociale, ca.codice AS codice_causale, m.descrizione, m.importo_dare FROM movimenti_contabili m JOIN clienti cl ON m.cliente_id = cl.id JOIN causali_contabili ca ON m.causale_id = ca.id WHERE m.data_registrazione BETWEEN DATE '2024-03-15' AND DATE '2024-06-30' AND ca.segno = 'dare' AND m.importo_dare > 0 ORDER BY m.importo_dare DESC, m.id ASC LIMIT 5;"
}