  "feature_sql": [
    "grouping_sets"
  ],
  "query": "SELECT\n    COALESCE(c.nome, 'Tutti i clienti') AS nome_cliente,\n    COALESCE(s.stato_spedizione, 'Tutti gli stati') AS stato_spedizione,\n    COUNT(DISTINCT o.id) AS numero_ordini,\n    SUM(o.importo_totale) AS totale_importo\nFROM clienti c\nFULL OUTER JOIN ordini o ON c.id = o.cliente_id\nFULL OUTER JOIN spedizioni s ON o.id = s.ordine_id\nGROUP BY GROUPING SETS (\n    (c.nome, s.stato_spedizione),\n    (c.nome),\n    (s.stato_spedizione),\n    ()\n)\nORDER BY\n    CASE WHEN c.nome IS NULL AND s.stato_spedizione IS NULL THEN 0 ELSE 1 END,\n    COALESCE(c.nome, 'ZZZ'),\n    COALESCE(s.stato_spedizione, 'ZZZ');"
}