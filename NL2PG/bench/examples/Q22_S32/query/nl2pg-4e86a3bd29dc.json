  ],
  "query": "SELECT DISTINCT ON (codice_pratica) codice_pratica, destinatario, citta_destinazione, peso_kg, created_at AS data_creazione FROM spedizioni WHERE stato_spedizione = 'in_transito' ORDER BY codice_pratica ASC, created_at DESC, id DESC;"
