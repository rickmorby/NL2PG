  "schema_ddl": "CREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_pratica TEXT NOT NULL,\n    destinatario TEXT NOT NULL,\n    citta_destinazione TEXT NOT NULL,\n    stato_spedizione TEXT NOT NULL,\n    peso_kg NUMERIC(8,2),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    created_by TEXT NOT NULL,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_by TEXT,\n    CONSTRAINT chk_peso_non_negativo CHECK (peso_kg IS NULL OR peso_kg >= 0),\n    CONSTRAINT chk_stato_valido CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnata', 'annullata'))\n);",
