{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT UNIQUE NOT NULL\n);\n\nCREATE TABLE categorie_prodotto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_categoria TEXT NOT NULL\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    categoria_id INT NOT NULL REFERENCES categorie_prodotto(id) ON DELETE RESTRICT,\n    nome TEXT NOT NULL,\n    prezzo NUMERIC(10,2) CHECK (prezzo >= 0)\n);\n\nCREATE TABLE ordini_cliente (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id) ON DELETE CASCADE,\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_evasione TEXT NOT NULL CHECK (stato_evasione IN ('attesa', 'completato', 'annullato'))\n);\n\nCREATE TABLE dettagli_ordine (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini_cliente(id) ON DELETE CASCADE,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id) ON DELETE RESTRICT,\n    quantita INT NOT NULL CHECK (quantita > 0)\n);",
