  "query": "SELECT c.intestatario, ROUND(AVG(c.saldo_iniziale), 2) AS saldo_medio, MAX(c.tasso_annuo) AS tasso_annuo_massimo, COUNT(*) AS numero_conti FROM conti c WHERE c.stato_conto = 'attivo' GROUP BY c.intestatario ORDER BY saldo_medio DESC;"
