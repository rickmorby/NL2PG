  "query": "WITH dettagli_bonifico AS (SELECT categoria_id, importo_dettaglio FROM dettagli_movimenti WHERE descrizione_dettaglio = 'Bonifico estero') SELECT COALESCE(cm.nome_categoria, 'N/D') AS nome_categoria, COALESCE(cm.descrizione, 'N/D') AS descrizione_categoria, COUNT(db.importo_dettaglio) AS numero_dettagli, COALESCE(SUM(db.importo_dettaglio), 0) AS totale_importo_dettagli FROM categorie_movimenti cm FULL OUTER JOIN dettagli_bonifico db ON cm.id = db.categoria_id GROUP BY COALESCE(cm.nome_categoria, 'N/D'), COALESCE(cm.descrizione, 'N/D') ORDER BY totale_importo_dettagli DESC, nome_categoria, descrizione_categoria LIMIT 20;"
}