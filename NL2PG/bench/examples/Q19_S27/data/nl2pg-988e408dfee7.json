  "schema_ddl": "CREATE TABLE conti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_conto TEXT NOT NULL UNIQUE,\n    giacenza NUMERIC(15,2) NOT NULL DEFAULT 0 CHECK (giacenza >= 0),\n    data_apertura DATE NOT NULL\n);\n\nCREATE TABLE movimenti_contabili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_anagrafico INT NOT NULL,\n    importo NUMERIC(15,2) NOT NULL CHECK (importo != 0),\n    data_operazione TIMESTAMP NOT NULL,\n    tipo_operazione TEXT NOT NULL CHECK (tipo_operazione IN ('addebitamento', 'accredito', 'bonifico'))\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE categorie_movimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE dettagli_movimenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    movimento_id INT NOT NULL,\n    categoria_id INT NOT NULL,\n    descrizione_dettaglio TEXT,\n    importo_dettaglio NUMERIC(15,2) NOT NULL CHECK (importo_dettaglio > 0)\n);",
