  "feature_sql": [
    "lateral"
  ],
  "query": "SELECT c.denominazione, INITCAP(c.citta) AS citta_cliente, f.numero_fattura, f.stato_fattura, f.importo_totale AS importo_fattura, COALESCE(ult.totale_incassato, 0)::NUMERIC(12,2) AS totale_incassato, ROUND(f.importo_totale - COALESCE(ult.totale_incassato, 0), 2) AS residuo_da_incassare, ult.ultimo_pagamento AS data_ultimo_pagamento, ult.metodo_ultimo_pagamento FROM clienti c JOIN fatture f ON f.cliente_id = c.id LEFT JOIN LATERAL (SELECT SUM(pg.importo) AS totale_incassato, MAX(pg.data_pagamento) AS ultimo_pagamento, (ARRAY_AGG(pg.metodo_pagamento ORDER BY pg.data_pagamento DESC, pg.id DESC))[1] AS metodo_ultimo_pagamento FROM pagamenti pg WHERE pg.fattura_id = f.id) ult ON TRUE WHERE f.stato_fattura IN ('emessa', 'parzialmente_pagata') AND f.data_fattura BETWEEN DATE '2025-11-01' AND DATE '2026-06-30' AND c.email IS NOT NULL ORDER BY residuo_da_incassare DESC, f.numero_fattura ASC;"
}