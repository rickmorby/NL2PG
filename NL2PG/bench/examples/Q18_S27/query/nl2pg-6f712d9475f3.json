{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    denominazione TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    partita_iva TEXT UNIQUE,\n    citta TEXT NOT NULL,\n    email TEXT\n);\n\nCREATE TABLE fatture (\n    id INT PRIMARY KEY,\n    numero_fattura TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL,\n    data_fattura DATE NOT NULL,\n    importo_totale NUMERIC(12,2) NOT NULL CHECK (importo_totale >= 0),\n    stato_fattura TEXT NOT NULL DEFAULT 'emessa' CHECK (stato_fattura IN ('emessa', 'pagata', 'parzialmente_pagata', 'annullata'))\n);\n\nCREATE TABLE pagamenti (\n    id INT PRIMARY KEY,\n    fattura_id INT NOT NULL,\n    data_pagamento DATE NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    metodo_pagamento TEXT NOT NULL DEFAULT 'bonifico'\n);\n\nCREATE TABLE rate (\n    id INT PRIMARY KEY,\n    fattura_id INT NOT NULL,\n    numero_rata INT NOT NULL,\n    data_scadenza DATE NOT NULL,\n    importo_rata NUMERIC(12,2) NOT NULL CHECK (importo_rata >= 0),\n    rata_saldata BOOLEAN NOT NULL DEFAULT FALSE\n);",
