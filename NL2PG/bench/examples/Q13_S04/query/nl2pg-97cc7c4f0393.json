  "query": "SELECT s.numero_telefono, s.operatore, s.stato, s.data_emissione FROM sim AS s WHERE s.stato = 'attiva' AND EXISTS(SELECT 1 FROM attivazione AS a WHERE a.id_sim = s.id_sim AND a.canale_attivazione = 'online') ORDER BY s.data_emissione DESC, s.id_sim"
