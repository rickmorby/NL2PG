{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    data_nascita DATE,\n    email TEXT UNIQUE\n);\n\nCREATE TABLE gestori (\n    id INT PRIMARY KEY,\n    nome_gestore TEXT NOT NULL UNIQUE,\n    partita_iva TEXT NOT NULL UNIQUE,\n    sede_legale TEXT\n);\n\nCREATE TABLE abbonamenti (\n    id INT PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    gestore_id INT NOT NULL REFERENCES gestori(id),\n    numero_telefono TEXT NOT NULL UNIQUE,\n    piano_tariffario TEXT NOT NULL,\n    data_attivazione DATE NOT NULL,\n    stato TEXT NOT NULL CHECK (stato IN ('attivo', 'sospeso', 'disdetto'))\n);\n\nCREATE TABLE traffico_voce (\n    id INT PRIMARY KEY,\n    abbonamento_id INT NOT NULL REFERENCES abbonamenti(id),\n    data_chiamata DATE NOT NULL,\n    minuti_consumati NUMERIC(8,2) NOT NULL CHECK (minuti_consumati >= 0),\n    costo_chiamata NUMERIC(8,2) NOT NULL CHECK (costo_chiamata >= 0),\n    destinazione TEXT\n);",
