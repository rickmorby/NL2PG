  "feature_sql": [
    "subquery",
    "correlated_subquery",
    "scalar_agg"
  ],
  "query": "SELECT c.nome, c.cognome, c.citta, COALESCE((SELECT SUM(tv.costo_chiamata) FROM traffico_voce tv JOIN abbonamenti a2 ON tv.abbonamento_id = a2.id WHERE a2.cliente_id = c.id AND a2.stato = 'attivo'), 0) AS totale_costo_chiamate, (SELECT ROUND(AVG(ric.totale_cliente), 2) FROM (SELECT SUM(tv2.costo_chiamata) AS totale_cliente FROM abbonamenti a3 JOIN traffico_voce tv2 ON tv2.abbonamento_id = a3.id WHERE a3.stato = 'attivo' GROUP BY a3.cliente_id) AS ric) AS media_costo_per_cliente FROM clienti c WHERE c.citta = 'Bari' AND EXISTS (SELECT 1 FROM abbonamenti a WHERE a.cliente_id = c.id AND a.stato = 'attivo') ORDER BY totale_costo_chiamate DESC, c.codice_fiscale ASC;"
}