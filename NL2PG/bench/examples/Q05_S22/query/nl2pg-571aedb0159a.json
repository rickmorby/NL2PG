  "feature_sql": [
    "group_agg"
  ],
  "query": "SELECT d.citta AS citta_destinazione, COUNT(*) AS numero_spedizioni, SUM(s.peso_kg) AS peso_totale_kg, ROUND(AVG(s.costo_spedizione), 2) AS costo_medio_spedizione FROM spedizioni s JOIN destinazioni d ON s.destinazione_id = d.id WHERE s.data_spedizione BETWEEN '2025-11-01' AND '2026-01-31' AND d.nazione = 'Italia' GROUP BY d.citta ORDER BY peso_totale_kg DESC LIMIT 5;"
}