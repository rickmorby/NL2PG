    "twist": [
      "rename",
      "synonym",
      "jargon"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "spedizioni",
        "obsolete_value": "movimenti_merce",
        "description": "La tabella dei fatti centrale spedizioni viene denominata movimenti_merce nella prosa aziendale; il risolutore deve riconoscere che movimenti_merce corrisponde alla fact table spedizioni dello star schema."
      },
      {
        "twist_type": "synonym",
        "target_value": "peso_kg",
        "obsolete_value": "tonnellaggio",
        "description": "La colonna peso_kg della tabella dei fatti viene indicata nella documentazione aziendale con il sinonimo tonnellaggio; le query che filtrano o aggregano sul peso devono mappare tonnellaggio su peso_kg."
      },
      {
        "twist_type": "jargon",
        "target_value": "quantita_colli",
        "obsolete_value": "unita_movimentate",
        "description": "Nel gergo del settore logistico, la colonna quantita_colli della fact table viene indicata come unita_movimentate; il conteggio dei gruppi richiesto (GROUP BY con COUNT) deve operare sulle spedizioni raggruppate, mentre il termine unita_movimentate si riferisce alla metrica quantita_colli."
      }
    ],
    "spec_hash": "ef031a11e9a3b632"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_cliente TEXT NOT NULL UNIQUE,\n    ragione_sociale TEXT NOT NULL,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE vettori (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_vettore TEXT NOT NULL,\n    telefono TEXT\n);\n\nCREATE TABLE destinazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    citta TEXT NOT NULL,\n    provincia TEXT,\n    nazione TEXT NOT NULL\n);\n\nCREATE TABLE mezzi_trasporto (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    targa TEXT NOT NULL UNIQUE,\n    tipo_mezzo TEXT NOT NULL CHECK (tipo_mezzo IN ('camion', 'furgone', 'tir'))\n);\n\nCREATE TABLE spedizioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    vettore_id INT NOT NULL REFERENCES vettori(id),\n    destinazione_id INT NOT NULL REFERENCES destinazioni(id),\n    mezzo_id INT NOT NULL REFERENCES mezzi_trasporto(id),\n    data_spedizione DATE NOT NULL,\n    peso_kg NUMERIC(10,2) NOT NULL CHECK (peso_kg > 0),\n    quantita_colli INT NOT NULL CHECK (quantita_colli > 0),\n    costo_spedizione NUMERIC(12,2) NOT NULL CHECK (costo_spedizione >= 0)\n);",
