  "feature_sql": [
    "offset_fetch"
  ],
  "query": "SELECT t.data_operazione AS data_movimento, t.tipo_movimento, t.descrizione, t.importo, t.valuta, t.riferimento_esterno FROM transazioni t WHERE t.deleted_at IS NULL AND t.valuta = 'EUR' AND t.tipo_movimento IN ('VERSAMENTO', 'BONIFICO_IN_ENTRATA') ORDER BY t.data_operazione DESC, t.importo DESC OFFSET 10 ROWS FETCH FIRST 10 ROWS ONLY;"
