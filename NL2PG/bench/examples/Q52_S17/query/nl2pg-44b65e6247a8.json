{
  "schema_ddl": "CREATE TABLE transazioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    data_operazione DATE NOT NULL,\n    tipo_movimento TEXT NOT NULL CHECK (tipo_movimento IN ('VERSAMENTO', 'PRELIEVO', 'BONIFICO_IN_USCITA', 'BONIFICO_IN_ENTRATA', 'ADDEBITO_SDD', 'ACCREDITO_F24')),\n    descrizione TEXT NOT NULL,\n    importo NUMERIC(14,2) NOT NULL CHECK (importo <> 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR' CHECK (char_length(valuta) = 3),\n    riferimento_esterno TEXT,\n    deleted_at TIMESTAMP,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (deleted_at IS NULL OR deleted_at >= created_at)\n);",
