  "query": "SELECT i.indirizzo, i.tipo_immobile, i.superficie_mq, i.prezzo_richiesto, COUNT(o.id) AS offerte_in_attesa FROM immobili i LEFT JOIN offerte o ON o.immobile_id = i.id AND o.stato_offerta = 'in_attesa' WHERE i.citta = 'Milano' AND EXISTS (SELECT 1 FROM visite v WHERE v.immobile_id = i.id AND v.esito = 'interessato') GROUP BY i.id, i.indirizzo, i.tipo_immobile, i.superficie_mq, i.prezzo_richiesto ORDER BY offerte_in_attesa DESC, i.prezzo_richiesto DESC, i.id ASC;"
