  "feature_sql": [],
  "query": "SELECT rep.nome_reparto AS reparto, rep.piano AS piano, COUNT(*) AS ricoveri_totali, COUNT(*) FILTER (WHERE rc.stato_ricovero = 'attivo') AS ricoveri_attivi FROM pazienti p JOIN ricoveri rc ON rc.paziente_id = p.id JOIN reparti rep ON rc.reparto_id = rep.id WHERE p.nome = 'Alessandra' GROUP BY rep.nome_reparto, rep.piano ORDER BY ricoveri_totali DESC, reparto ASC;"
}