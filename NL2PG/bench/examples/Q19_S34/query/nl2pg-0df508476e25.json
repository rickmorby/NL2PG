  "feature_sql": [
    "full_outer_join"
  ],
  "query": "SELECT COALESCE(d.nome_dipartimento, 'Personale non assegnato') AS nome_dipartimento,\n       COALESCE(d.sede, 'N/D') AS sede,\n       COUNT(e.id_dipendente) AS numero_dipendenti,\n       COALESCE(ROUND(SUM(e.retribuzione_lorda_annua), 2), 0) AS massa_retributiva_annua,\n       COALESCE(ROUND(SUM(e.retribuzione_lorda_annua) FILTER (WHERE e.stato_contrattuale = 'sospeso'), 2), 0) AS massa_retributiva_sospesi,\n       CASE\n           WHEN d.id_dipartimento IS NULL THEN 'dipendente non assegnato'\n           WHEN COUNT(e.id_dipendente) = 0 THEN 'dipartimento vuoto'\n           ELSE 'dipartimento attivo'\n       END AS stato_riconciliazione\nFROM dipartimenti d\nFULL OUTER JOIN dipendenti e ON d.id_dipartimento = e.id_dipartimento\nWHERE e.stato_contrattuale IS DISTINCT FROM 'cessato'\nGROUP BY d.id_dipartimento, d.nome_dipartimento, d.sede\nORDER BY massa_retributiva_annua DESC, nome_dipartimento;"
}