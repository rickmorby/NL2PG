    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "dipendenti",
        "obsolete_value": "anagrafica_collaboratori",
        "description": "La tabella dipendenti viene denominata anagrafica_collaboratori nella prosa aziendale: le query devono risolvere il riferimento alla tabella fisica dipendenti, che contiene la chiave primaria id_dipendente e la foreign key nullable id_dipartimento verso i dipartimenti."
      },
      {
        "twist_type": "jargon",
        "target_value": "retribuzione_lorda_annua",
        "obsolete_value": "RAL",
        "description": "La colonna retribuzione_lorda_annua della tabella dipendenti è indicata nei documenti HR con l'acronimo di gergo settoriale RAL (Retribuzione Annua Lorda): le richieste che menzionano la RAL vanno mappate sulla colonna retribuzione_lorda_annua."
      },
      {
        "twist_type": "polysemy",
        "target_value": "stato_contrattuale",
        "obsolete_value": "stato",
        "description": "Il termine ambiguo 'stato' usato nella prosa si riferisce alla colonna stato_contrattuale della tabella dipendenti (valori come attivo, sospeso, cessato) e non allo stato civile presente nell'anagrafica: occorre disambiguare correttamente quando la richiesta parla dello 'stato' di un collaboratore."
      }
    ],
    "spec_hash": "360ca85691caa62d"
  },
  "schema_ddl": "CREATE TABLE dipartimenti (\n    id_dipartimento SERIAL PRIMARY KEY,\n    nome_dipartimento TEXT NOT NULL UNIQUE,\n    sede TEXT,\n    budget_annuo NUMERIC(12,2) CHECK (budget_annuo >= 0)\n);\n\nCREATE TABLE dipendenti (\n    id_dipendente SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    stato_civile TEXT,\n    retribuzione_lorda_annua NUMERIC(12,2) NOT NULL CHECK (retribuzione_lorda_annua > 0),\n    stato_contrattuale TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contrattuale IN ('attivo', 'sospeso', 'cessato')),\n    data_assunzione DATE NOT NULL,\n    id_dipartimento INT REFERENCES dipartimenti(id_dipartimento) ON DELETE SET NULL ON UPDATE CASCADE\n);\n\nCREATE TABLE contratti (\n    id_contratto SERIAL PRIMARY KEY,\n    dipendente_id INT NOT NULL REFERENCES dipendenti(id_dipendente) ON DELETE CASCADE ON UPDATE CASCADE,\n    tipo_contratto TEXT NOT NULL CHECK (tipo_contratto IN ('indeterminato', 'determinato', 'apprendistato', 'part_time')),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    livello_inquadramento TEXT,\n    CHECK (data_fine IS NULL OR data_fine >= data_inizio)\n);",
