  "feature_sql": [
    "subquery"
  ],
  "query": "SELECT i.indirizzo, i.comune, i.tipologia, i.superficie_mq, i.prezzo_richiesto, ROUND((SELECT AVG(prezzo_richiesto) FROM immobili WHERE tipologia = 'appartamento'), 2) AS prezzo_medio_appartamenti FROM immobili i WHERE i.comune = 'Milano' AND i.stato = 'disponibile' AND i.prezzo_richiesto > (SELECT AVG(prezzo_richiesto) FROM immobili WHERE tipologia = 'appartamento') ORDER BY i.prezzo_richiesto DESC;"
}