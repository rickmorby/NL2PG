  "query": "SELECT DISTINCT p.nome, p.cognome, p.codice_fiscale FROM pazienti p WHERE EXISTS (SELECT 1 FROM visite v WHERE v.paziente_id = p.id AND v.esito = 'ricovero consigliato') ORDER BY p.cognome, p.nome;"
