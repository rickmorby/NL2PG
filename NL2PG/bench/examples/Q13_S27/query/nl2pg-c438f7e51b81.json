{
  "schema_ddl": "CREATE TABLE pazienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    CHECK (LENGTH(codice_fiscale) = 16)\n);\n\nCREATE TABLE visite (\n    id INT PRIMARY KEY,\n    paziente_id INT NOT NULL,\n    data_visita DATE NOT NULL,\n    motivo_visita TEXT,\n    esito TEXT,\n    CHECK (paziente_id > 0)\n);\n\nCREATE TABLE ricoveri (\n    id INT PRIMARY KEY,\n    paziente_id INT NOT NULL,\n    data_ingresso DATE NOT NULL,\n    data_dimissione DATE,\n    reparto TEXT NOT NULL,\n    CHECK (data_dimissione IS NULL OR data_dimissione >= data_ingresso)\n);\n\nCREATE TABLE referti (\n    id INT PRIMARY KEY,\n    visita_id INT NOT NULL,\n    data_referto DATE NOT NULL,\n    contenuto TEXT NOT NULL,\n    medico_redattore TEXT NOT NULL,\n    CHECK (visita_id > 0)\n);",
