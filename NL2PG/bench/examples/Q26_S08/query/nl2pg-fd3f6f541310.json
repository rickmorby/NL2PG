  "query": "SELECT p.intestatario, pa.targa, pa.marca_veicolo, pa.modello_veicolo, p.premio_annuo AS premio_annuo_euro FROM polizze p JOIN polizze_auto pa ON pa.id_polizza = p.id_polizza WHERE p.stato_polizza = 'attiva' AND NOT EXISTS (SELECT 1 FROM sinistri s WHERE s.id_polizza = p.id_polizza) ORDER BY p.premio_annuo DESC, pa.targa ASC;"
}