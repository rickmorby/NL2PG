{
  "spec": {
    "domain": "immobiliare",
    "n_tables": 3,
    "hierarchy": "one_to_many",
    "sql_features": [
      "right_outer_join"
    ],
    "twist": [
      "rename",
      "jargon"
    ],
    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "immobili",
        "obsolete_value": "unita_abitative",
        "description": "La tabella immobili viene denominata unita_abitative nella prosa aziendale. Lo schema fisico mantiene il nome immobili, mentre le query e i requisiti si riferiscono sempre a unita_abitative, obbligando a risalire alla tabella corretta. La tabella immobili contiene la FK id_agenzia verso agenzie con ON DELETE SET NULL e viene referenziata da contratti tramite id_immobile con ON DELETE CASCADE."
      },
      {
        "twist_type": "jargon",
        "target_value": "prezzo_richiesto",
        "obsolete_value": "valore di listino",
        "description": "La colonna prezzo_richiesto della tabella immobili viene indicata nella documentazione aziendale con il gergo immobiliare 'valore di listino'. Il solver deve mappare il termine tecnico di settore alla colonna reale del database quando costruisce la RIGHT OUTER JOIN tra contratti e immobili, dove le righe di contratti preservate con NULL indicano immobili assenti per effetto delle azioni referenziali dichiarate."
      }
    ],
    "spec_hash": "a31571b8334df431"
  },
  "schema_ddl": "CREATE TABLE agenzie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    indirizzo_sede TEXT,\n    telefono TEXT,\n    email TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    id_agenzia INT REFERENCES agenzie(id) ON DELETE SET NULL ON UPDATE CASCADE,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT,\n    superficie_mq NUMERIC(7,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani > 0),\n    prezzo_richiesto NUMERIC(12,2) NOT NULL CHECK (prezzo_richiesto >= 0),\n    stato TEXT NOT NULL DEFAULT 'disponibile' CHECK (stato IN ('disponibile', 'riservato', 'venduto', 'affittato')),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    id_immobile INT NOT NULL REFERENCES immobili(id) ON DELETE CASCADE ON UPDATE CASCADE,\n    tipo_contratto TEXT NOT NULL CHECK (tipo_contratto IN ('vendita', 'affitto')),\n    data_firma DATE NOT NULL,\n    data_inizio DATE,\n    data_fine DATE,\n    controvalore NUMERIC(12,2) NOT NULL CHECK (controvalore >= 0),\n    cliente_nome TEXT NOT NULL,\n    cliente_codice_fiscale TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_fine IS NULL OR data_inizio IS NULL OR data_fine >= data_inizio)\n);",
