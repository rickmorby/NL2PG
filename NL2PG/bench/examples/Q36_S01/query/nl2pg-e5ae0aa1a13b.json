  "query": "SELECT UPPER(intestatario) AS intestatario_maiuscolo, SUBSTRING(iban, 1, 2) AS codice_paese_iban, saldo AS saldo_conto FROM conti_correnti WHERE filiale = 'Milano Duomo' AND saldo >= 50000 ORDER BY saldo DESC, iban ASC;"
