  "feature_sql": [],
  "query": "SELECT descrizione, COUNT(*) AS numero_transazioni, SUM(importo_lordo) AS totale_importo_lordo, AVG(importo_lordo) AS media_importo, MAX(importo_lordo) AS importo_massimo, MIN(importo_lordo) AS importo_minimo FROM transazioni WHERE stato_pagamento IS FALSE AND importo_lordo BETWEEN 100.00 AND 500.00 AND (descrizione LIKE '%Vendita%' OR descrizione IS NULL) GROUP BY descrizione ORDER BY totale_importo_lordo DESC NULLS LAST LIMIT 10;"
