  "feature_sql": [
    "right_outer_join"
  ],
  "query": "SELECT p.nome_piano AS nome_piano, p.tecnologia AS tecnologia, p.prezzo_mensile AS prezzo_mensile_euro, COUNT(c.id) AS contratti_attivi, COALESCE(SUM(p.prezzo_mensile), 0) AS ricavo_mensile_potenziale FROM contratti c RIGHT JOIN piani_tariffari p ON c.piano_id = p.id AND c.stato_contratto = 'attivo' WHERE p.tecnologia = 'mobile' GROUP BY p.nome_piano, p.tecnologia, p.prezzo_mensile ORDER BY contratti_attivi DESC, p.nome_piano ASC;"
}