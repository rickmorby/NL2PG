{
  "schema_ddl": "CREATE TABLE clienti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    utenza_attiva BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE piani_tariffari (\n    id SERIAL PRIMARY KEY,\n    nome_piano TEXT NOT NULL UNIQUE,\n    tecnologia TEXT NOT NULL CHECK (tecnologia IN ('mobile', 'fibra')),\n    prezzo_mensile NUMERIC(8,2) NOT NULL CHECK (prezzo_mensile >= 0)\n);\n\nCREATE TABLE contratti (\n    id SERIAL PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    piano_id INT REFERENCES piani_tariffari(id),\n    data_attivazione DATE NOT NULL,\n    data_disdetta DATE,\n    stato_contratto TEXT NOT NULL DEFAULT 'attivo' CHECK (stato_contratto IN ('attivo', 'sospeso', 'cessato')),\n    CHECK (data_disdetta IS NULL OR data_disdetta >= data_attivazione)\n);\n\nCREATE TABLE contratti_mobile (\n    id_contratto INT PRIMARY KEY REFERENCES contratti(id),\n    numero_msisdn TEXT NOT NULL UNIQUE,\n    traffico_dati_gb INT NOT NULL CHECK (traffico_dati_gb >= 0),\n    minuti_inclusi INT NOT NULL CHECK (minuti_inclusi >= 0)\n);\n\nCREATE TABLE contratti_fibra (\n    id_contratto INT PRIMARY KEY REFERENCES contratti(id),\n    traffico_dati_gb INT NOT NULL CHECK (traffico_dati_gb >= 0),\n    velocita_download_mbps INT NOT NULL CHECK (velocita_download_mbps > 0),\n    indirizzo_installazione TEXT NOT NULL\n);",
