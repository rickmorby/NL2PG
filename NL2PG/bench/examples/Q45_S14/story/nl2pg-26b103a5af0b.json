  "schema_ddl": "CREATE DOMAIN importo_positivo AS NUMERIC(12,2) CHECK (VALUE >= 0);\n\nCREATE DOMAIN stato_contratto AS TEXT CHECK (VALUE IN ('proposto', 'attivo', 'sospeso', 'concluso', 'risolto'));\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    indirizzo TEXT NOT NULL,\n    comune TEXT NOT NULL,\n    provincia CHAR(2),\n    cap CHAR(5),\n    superficie_mq NUMERIC(8,2) NOT NULL CHECK (superficie_mq > 0),\n    numero_vani INT NOT NULL CHECK (numero_vani > 0),\n    classe_energetica CHAR(2)\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_contratto TEXT NOT NULL UNIQUE,\n    immobile_id INT NOT NULL REFERENCES immobili(id) ON DELETE CASCADE,\n    canone importo_positivo NOT NULL,\n    deposito_cauzionale importo_positivo NOT NULL DEFAULT 0,\n    stato stato_contratto NOT NULL DEFAULT 'proposto',\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    CHECK (data_fine IS NULL OR data_fine > data_inizio)\n);",
