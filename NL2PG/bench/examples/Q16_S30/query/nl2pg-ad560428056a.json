  "query": "WITH RECURSIVE gerarchia_dipartimenti AS ( SELECT id_nodo, nome_dipartimento, id_nodo_padre, 1 AS livello_gerarchico, nome_dipartimento AS percorso_completo FROM albero_organizzativo_interno WHERE id_nodo_padre IS NULL UNION ALL SELECT a.id_nodo, a.nome_dipartimento, a.id_nodo_padre, g.livello_gerarchico + 1 AS livello_gerarchico, g.percorso_completo || ' -> ' || a.nome_dipartimento AS percorso_completo FROM albero_organizzativo_interno a JOIN gerarchia_dipartimenti g ON a.id_nodo_padre = g.id_nodo ) SELECT g.nome_dipartimento AS dipartimento, g.livello_gerarchico, g.percorso_completo, COUNT(d.id_docente) AS numero_docenti FROM gerarchia_dipartimenti g LEFT JOIN docenti d ON g.id_nodo = d.id_nodo_dipartimento GROUP BY g.nome_dipartimento, g.livello_gerarchico, g.percorso_completo ORDER BY g.percorso_completo;"
}