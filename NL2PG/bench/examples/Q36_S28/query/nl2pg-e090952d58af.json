  "query": "WITH clienti_formattati AS (SELECT id, UPPER(nome) AS nome_maiuscolo, LOWER(cognome) AS cognome_minuscolo, UPPER(CONCAT(nome, ' ', cognome)) AS nome_completo_maiuscolo, REGEXP_REPLACE(telefono, '[^0-9]', '', 'g') AS telefono_pulito FROM cl WHERE telefono IS NOT NULL), immobili_formattati AS (SELECT id, INITCAP(indirizzo) AS indirizzo_capitalizzato, citta, LENGTH(cap) AS lunghezza_cap FROM imm) SELECT cf.nome_completo_maiuscolo AS cliente, cf.cognome_minuscolo AS cognome_cliente, if.citta AS citta_immobile, if.indirizzo_capitalizzato AS indirizzo, cf.telefono_pulito AS telefono, contr.canone_mensile AS canone_mensile, contr.stato AS stato_contratto FROM contr JOIN clienti_formattati AS cf ON contr.cl_id = cf.id JOIN immobili_formattati AS if ON contr.imm_id = if.id WHERE contr.stato = 'attivo' AND if.lunghezza_cap BETWEEN 4 AND 6 ORDER BY cf.nome_completo_maiuscolo, if.citta, contr.id"
}