  "schema_ddl": "CREATE TABLE cl (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE imm (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    cap TEXT NOT NULL,\n    mq NUMERIC(6,2) NOT NULL CHECK (mq > 0),\n    prezzo NUMERIC(10,2) NOT NULL CHECK (prezzo > 0)\n);\n\nCREATE TABLE contr (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cl_id INT NOT NULL REFERENCES cl(id),\n    imm_id INT NOT NULL REFERENCES imm(id),\n    data_inizio DATE NOT NULL,\n    data_fine DATE,\n    canone_mensile NUMERIC(10,2) NOT NULL CHECK (canone_mensile > 0),\n    stato TEXT NOT NULL DEFAULT 'attivo'\n);\n\nCREATE TABLE pag (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contr_id INT NOT NULL REFERENCES contr(id),\n    data_pagamento DATE NOT NULL,\n    importo NUMERIC(10,2) NOT NULL CHECK (importo > 0),\n    modalita TEXT NOT NULL\n);\n\nCREATE TABLE ag (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);",
