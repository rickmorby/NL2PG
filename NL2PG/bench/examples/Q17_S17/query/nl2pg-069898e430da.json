  "feature_sql": [
    "window"
  ],
  "query": "SELECT m.nome, m.cognome, m.specializzazione, COUNT(v.id) AS numero_visite, RANK() OVER (ORDER BY COUNT(v.id) DESC) AS posizione FROM medici m JOIN visite v ON v.medico_id = m.id WHERE v.deleted_at IS NULL AND m.specializzazione IN ('Cardiologia', 'Dermatologia', 'Neurologia') GROUP BY m.id, m.nome, m.cognome, m.specializzazione ORDER BY posizione ASC, m.id ASC;"
}