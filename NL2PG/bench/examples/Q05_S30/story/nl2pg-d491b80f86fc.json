{
  "schema_ddl": "CREATE TABLE clienti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono TEXT,\n    data_apertura_relazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    CHECK (LENGTH(codice_fiscale) = 16)\n);\n\nCREATE TABLE filiali (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_filiale TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    indirizzo TEXT,\n    codice_abi TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE conti_correnti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    filiale_id INT NOT NULL REFERENCES filiali(id),\n    iban TEXT NOT NULL UNIQUE,\n    saldo_attuale NUMERIC(14,2) NOT NULL DEFAULT 0,\n    stato_conto TEXT NOT NULL DEFAULT 'ATTIVO' CHECK (stato_conto IN ('ATTIVO', 'SOSPESO', 'CHIUSO')),\n    data_apertura DATE NOT NULL DEFAULT CURRENT_DATE\n);\n\nCREATE TABLE transazioni (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id BIGINT NOT NULL REFERENCES conti_correnti(id),\n    tipo_transazione TEXT NOT NULL CHECK (tipo_transazione IN ('VERSAMENTO', 'PRELIEVO', 'BONIFICO_USCITA', 'BONIFICO_INGRESSO', 'PAGAMENTO_POS', 'ADDEBITO_SDD', 'COMMISSIONE')),\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    valuta TEXT NOT NULL DEFAULT 'EUR',\n    data_transazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    descrizione TEXT\n);\n\nCREATE TABLE movimenti_contabili (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id BIGINT NOT NULL REFERENCES conti_correnti(id),\n    numero_protocollo TEXT NOT NULL UNIQUE,\n    causale_contabile TEXT NOT NULL,\n    importo_dare NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_dare >= 0),\n    importo_avere NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_avere >= 0),\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    CHECK ((importo_dare = 0) <> (importo_avere = 0))\n);\n\nCREATE TABLE bonifici (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id BIGINT NOT NULL REFERENCES conti_correnti(id),\n    iban_beneficiario TEXT NOT NULL,\n    nome_beneficiario TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo > 0),\n    stato_bonifico TEXT NOT NULL DEFAULT 'INVIATO' CHECK (stato_bonifico IN ('INVIATO', 'ESEGUITO', 'RIFIUTATO')),\n    data_esecuzione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE carte_bancarie (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    conto_id BIGINT NOT NULL REFERENCES conti_correnti(id),\n    numero_carta TEXT NOT NULL UNIQUE,\n    tipo_carta TEXT NOT NULL CHECK (tipo_carta IN ('DEBITO', 'CREDITO', 'PREPAGATA')),\n    data_scadenza DATE NOT NULL,\n    limite_spesa_giornaliero NUMERIC(10,2) NOT NULL DEFAULT 500 CHECK (limite_spesa_giornaliero > 0)\n);\n\nCREATE TABLE prestiti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    importo_capitale NUMERIC(14,2) NOT NULL CHECK (importo_capitale > 0),\n    tasso_interesse NUMERIC(5,2) NOT NULL CHECK (tasso_interesse >= 0 AND tasso_interesse <= 30),\n    durata_mesi INT NOT NULL CHECK (durata_mesi BETWEEN 6 AND 480),\n    rata_mensile NUMERIC(12,2) NOT NULL CHECK (rata_mensile > 0),\n    stato_prestito TEXT NOT NULL DEFAULT 'ATTIVO' CHECK (stato_prestito IN ('ATTIVO', 'ESTINTO', 'SOFFERENZA'))\n);\n\nCREATE TABLE investimenti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    strumento TEXT NOT NULL CHECK (strumento IN ('AZIONI', 'OBBLIGAZIONI', 'FONDO_COMUNE', 'ETF')),\n    valore_investito NUMERIC(14,2) NOT NULL CHECK (valore_investito > 0),\n    rendimento_annuo_pct NUMERIC(6,2) NOT NULL DEFAULT 0,\n    data_sottoscrizione DATE NOT NULL DEFAULT CURRENT_DATE\n);",
