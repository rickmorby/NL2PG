  "feature_sql": [],
  "query": "SELECT c.nome_conto, c.tipo_conto, COUNT(*) AS numero_conti, ROUND(AVG(EXTRACT(YEAR FROM c.aperto_il))::numeric, 1) AS anno_medio_apertura FROM conti c WHERE c.tipo_conto IN ('costo', 'ricavo') AND c.aperto_il BETWEEN DATE '2019-01-01' AND DATE '2024-12-31' GROUP BY c.nome_conto, c.tipo_conto ORDER BY numero_conti DESC, c.nome_conto ASC;"
