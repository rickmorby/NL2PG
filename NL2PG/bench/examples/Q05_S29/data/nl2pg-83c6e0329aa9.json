  "schema_ddl": "CREATE TABLE prestiti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_contratto TEXT NOT NULL UNIQUE,\n    cliente_nome TEXT NOT NULL,\n    cliente_cognome TEXT NOT NULL,\n    importo_erogato NUMERIC(14,2) NOT NULL CHECK (importo_erogato > 0),\n    tasso_annuo NUMERIC(5,2) NOT NULL CHECK (tasso_annuo >= 0 AND tasso_annuo <= 100),\n    data_inizio DATE NOT NULL,\n    data_fine DATE NOT NULL,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT chk_date_prestito CHECK (data_fine >= data_inizio)\n);\n\nCREATE TABLE rate (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    prestito_id BIGINT NOT NULL REFERENCES prestiti(id) ON DELETE CASCADE,\n    numero_rata INT NOT NULL,\n    scadenza DATE NOT NULL,\n    quota_capitale NUMERIC(12,2) NOT NULL CHECK (quota_capitale >= 0),\n    quota_interessi NUMERIC(12,2) NOT NULL CHECK (quota_interessi >= 0),\n    pagata BOOLEAN NOT NULL DEFAULT FALSE,\n    data_pagamento DATE,\n    nota TEXT,\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT uq_rata_prestito UNIQUE (prestito_id, numero_rata),\n    CONSTRAINT chk_numero_rata CHECK (numero_rata > 0),\n    CONSTRAINT chk_importo_rata_positivo CHECK (quota_capitale + quota_interessi > 0)\n);",
