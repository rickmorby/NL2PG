{
  "schema_ddl": "CREATE TABLE agenzie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    telefono TEXT\n);\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agenzia_id INT NOT NULL REFERENCES agenzie(id),\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    telefono TEXT\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    data_stipula DATE NOT NULL,\n    condizioni_contrattuali TEXT NOT NULL\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agenzia_id INT NOT NULL REFERENCES agenzie(id),\n    agente_rif_id INT NOT NULL REFERENCES agenti(id),\n    indirizzo TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    prezzo_richiesto NUMERIC(12,2) NOT NULL CHECK (prezzo_richiesto >= 0),\n    stato_immobile TEXT NOT NULL CHECK (stato_immobile IN ('libero', 'occupato', 'in_ristrutturazione')),\n    totale_visite INT DEFAULT 0 CHECK (totale_visite >= 0),\n    nome_agenzia_denorm TEXT,\n    nome_agente_denorm TEXT\n);",
