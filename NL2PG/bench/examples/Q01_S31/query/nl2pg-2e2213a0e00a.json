  "feature_sql": [],
  "query": "SELECT a.nome AS nome_agenzia, a.citta AS citta_agenzia, COUNT(DISTINCT ag.id) AS totale_agenti, COUNT(DISTINCT i.id) AS totale_immobili, ROUND(AVG(i.prezzo_richiesto), 2) AS prezzo_medio_richiesto, COUNT(DISTINCT c.id) AS totale_contratti FROM agenzie a LEFT JOIN agenti ag ON a.id = ag.agenzia_id LEFT JOIN immobili i ON a.id = i.agenzia_id LEFT JOIN contratti c ON ag.id = c.agente_id GROUP BY a.nome, a.citta ORDER BY totale_contratti DESC, prezzo_medio_richiesto DESC;"
}