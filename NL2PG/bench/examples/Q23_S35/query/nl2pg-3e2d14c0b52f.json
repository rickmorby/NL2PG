  "query": "SELECT r.nome_reparto AS reparto, r.edificio, COUNT(*) AS visite_totali, COUNT(*) FILTER (WHERE v.esito_ricovero = 'dimesso') AS visite_dimessi, COUNT(*) FILTER (WHERE v.esito_ricovero = 'in_corso') AS visite_in_corso, COUNT(*) FILTER (WHERE v.costo_visita > 200) AS visite_costose, ROUND(AVG(v.durata_minuti)::numeric, 2) AS durata_media_minuti FROM reparti r JOIN medici m ON m.reparto_id = r.id JOIN visite_mediche v ON v.medico_id = m.id WHERE v.data_visita BETWEEN DATE '2024-02-10' AND DATE '2024-12-31' GROUP BY r.nome_reparto, r.edificio ORDER BY visite_totali DESC, r.nome_reparto ASC, r.edificio ASC;"
}