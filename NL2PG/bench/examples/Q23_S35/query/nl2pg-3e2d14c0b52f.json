{
  "schema_ddl": "CREATE TABLE reparti (\n    id SERIAL PRIMARY KEY,\n    nome_reparto TEXT NOT NULL UNIQUE,\n    edificio TEXT NOT NULL,\n    numero_letti INT NOT NULL CHECK (numero_letti >= 0)\n);\n\nCREATE TABLE medici (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    reparto_id INT NOT NULL REFERENCES reparti(id),\n    costo_orario NUMERIC(8,2) NOT NULL CHECK (costo_orario >= 0)\n);\n\nCREATE TABLE pazienti (\n    id SERIAL PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    citta TEXT NOT NULL,\n    recapito_telefonico TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE tipi_visita (\n    id SERIAL PRIMARY KEY,\n    codice_tipo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    costo_base NUMERIC(10,2) NOT NULL CHECK (costo_base >= 0)\n);\n\nCREATE TABLE visite_mediche (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    tipo_visita_id INT NOT NULL REFERENCES tipi_visita(id),\n    data_visita DATE NOT NULL,\n    esito_ricovero TEXT CHECK (esito_ricovero IN ('dimesso', 'trasferito', 'decesso', 'in_corso')),\n    costo_visita NUMERIC(10,2) NOT NULL CHECK (costo_visita >= 0),\n    durata_minuti INT CHECK (durata_minuti > 0),\n    PRIMARY KEY (id, data_visita)\n) PARTITION BY RANGE (data_visita);\n\nCREATE TABLE visite_mediche_storico PARTITION OF visite_mediche\n    FOR VALUES FROM ('2000-01-01') TO ('2030-01-01');",
