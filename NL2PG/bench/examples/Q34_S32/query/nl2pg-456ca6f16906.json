  "feature_sql": [],
  "query": "SELECT s.codice_spedizione, c.ragione_sociale AS cliente, c.citta AS citta_cliente, v.nome_vettore AS vettore, s.stato, s.peso_kg, s.data_spedizione FROM spedizioni s JOIN clienti c ON c.id = s.cliente_id LEFT JOIN vettori v ON v.id = s.vettore_id WHERE s.stato IN ('in_transito', 'rimandata') AND s.data_spedizione BETWEEN DATE '2026-01-01' AND DATE '2026-03-31' ORDER BY s.data_spedizione DESC, s.codice_spedizione ASC;"
}