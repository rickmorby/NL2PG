{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    codice_fiscale TEXT UNIQUE,\n    indirizzo_sede TEXT,\n    citta TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE prodotti_servizi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_articolo TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    unita_misura TEXT NOT NULL DEFAULT 'pz',\n    prezzo_listino NUMERIC(10,2) NOT NULL CHECK (prezzo_listino >= 0)\n);\n\nCREATE TABLE fatture (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_fattura TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    imponibile_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (imponibile_totale >= 0),\n    iva_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (iva_totale >= 0),\n    totale_documento NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (totale_documento >= 0),\n    stato TEXT NOT NULL DEFAULT 'emessa' CHECK (stato IN ('bozza', 'emessa', 'pagata', 'annullata')),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    modificato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (data_scadenza >= data_emissione)\n);\n\nCREATE TABLE righe_fattura (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id) ON DELETE CASCADE,\n    prodotto_id INT REFERENCES prodotti_servizi(id),\n    descrizione_riga TEXT NOT NULL,\n    quantita NUMERIC(10,3) NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva >= 0 AND aliquota_iva <= 100),\n    imponibile_riga NUMERIC(12,2) NOT NULL CHECK (imponibile_riga >= 0)\n);\n\nCREATE TABLE pagamenti_fattura (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id) ON DELETE CASCADE,\n    data_pagamento DATE NOT NULL,\n    importo_pagato NUMERIC(12,2) NOT NULL CHECK (importo_pagato > 0),\n    modalita TEXT NOT NULL DEFAULT 'bonifico' CHECK (modalita IN ('bonifico', 'assegno', 'contanti', 'rid', 'riba'))\n);",
