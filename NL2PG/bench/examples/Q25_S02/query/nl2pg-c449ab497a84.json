  "feature_sql": [
    "natural_join"
  ],
  "query": "WITH clienti_base AS (SELECT id AS cliente_id, nome FROM clienti WHERE nome IS NOT NULL), ordini_consegnati AS (SELECT cliente_id, stato FROM ordini WHERE stato = 'consegnato') SELECT c.nome, COUNT(*) AS numero_ordini_consegnati FROM clienti_base c NATURAL JOIN ordini_consegnati o GROUP BY c.nome ORDER BY numero_ordini_consegnati DESC;"
}