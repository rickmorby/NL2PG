  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT d.nome, d.cognome, AVG(d.stipendio) AS stipendio_medio, COUNT(*) AS numero_dipendenti FROM dipendenti d WHERE d.stipendio IS NOT NULL GROUP BY d.nome, d.cognome HAVING COUNT(*) > 1 AND AVG(d.stipendio) > 45000.00;"
