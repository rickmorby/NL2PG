  "schema_ddl": "CREATE TABLE operazioni_finanziarie (\n    id SERIAL PRIMARY KEY,\n    tipo_operazione TEXT NOT NULL CHECK (tipo_operazione IN ('accredito', 'addebito', 'bonifico', 'investimento', 'prelievo')),\n    importo_lordo NUMERIC(15,2) NOT NULL CHECK (importo_lordo >= 0),\n    data_operazione DATE NOT NULL,\n    descrizione TEXT,\n    categoria TEXT CHECK (categoria IN ('stipendio', 'utenze', 'alimentari', 'trasporti', 'intrattenimento', 'investimenti', 'altro')),\n    stato TEXT NOT NULL DEFAULT 'registrata' CHECK (stato IN ('registrata', 'contabilizzata', 'annullata')),\n    conto_corrente TEXT,\n    note TEXT\n);",
