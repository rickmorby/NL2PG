  "feature_sql": [
    "recursive_cte"
  ],
  "query": "WITH RECURSIVE gerarchia AS (SELECT id_operatore, nome, cognome, ruolo, unita_operativa, 0 AS livello_gerarchico FROM operatori_sanitari WHERE id_supervisore IS NULL UNION ALL SELECT o.id_operatore, o.nome, o.cognome, o.ruolo, o.unita_operativa, g.livello_gerarchico + 1 FROM operatori_sanitari o JOIN gerarchia g ON o.id_supervisore = g.id_operatore) SELECT nome, cognome, ruolo, unita_operativa, livello_gerarchico FROM gerarchia WHERE unita_operativa IN ('Cardiologia', 'Radiologia') ORDER BY livello_gerarchico ASC, cognome ASC, nome ASC, id_operatore ASC;"
}