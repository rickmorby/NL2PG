{
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_contratto TEXT NOT NULL UNIQUE,\n    data_stipula DATE NOT NULL,\n    canale_vendita TEXT NOT NULL CHECK (canale_vendita IN ('diretto', 'rivenditore', 'online'))\n);\n\nCREATE TABLE offerte (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti(id),\n    nome_offerta TEXT NOT NULL,\n    sconto_percentuale NUMERIC(5,2) NOT NULL CHECK (sconto_percentuale BETWEEN 0 AND 100),\n    data_presentazione DATE NOT NULL\n);\n\nCREATE TABLE storico_contratti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    contratto_id INT NOT NULL REFERENCES contratti(id),\n    versione INT NOT NULL,\n    valore_offerta NUMERIC(12,2) NOT NULL CHECK (valore_offerta >= 0),\n    stato_versione TEXT NOT NULL CHECK (stato_versione IN ('bozza', 'attiva', 'sostituita', 'scaduta')),\n    valido_dal DATE NOT NULL,\n    valido_al DATE,\n    annotazioni TEXT,\n    CHECK (valido_al IS NULL OR valido_al >= valido_dal),\n    UNIQUE (contratto_id, versione)\n);",
