  "feature_sql": [
    "overlaps"
  ],
  "query": "SELECT c.ragione_sociale, ct.numero_contratto, ct.canale_vendita, sc.stato_versione, sc.valore_offerta, sc.annotazioni AS annotazioni_versione, CASE WHEN sc.valido_al IS NULL THEN 'aperta' ELSE 'chiusa' END AS tipo_validita, COALESCE(sc.valido_al, DATE '2026-06-30') AS fine_validita_considerata FROM storico_contratti sc JOIN contratti ct ON sc.contratto_id = ct.id JOIN clienti c ON ct.cliente_id = c.id WHERE (sc.valido_dal, COALESCE(sc.valido_al, DATE '2026-06-30')) OVERLAPS (DATE '2025-12-22', DATE '2026-01-04') AND ct.canale_vendita IN ('diretto', 'rivenditore') AND c.citta IN ('Milano', 'Roma') ORDER BY sc.valore_offerta DESC, sc.id ASC;"
}