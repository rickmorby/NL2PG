{
  "schema_ddl": "CREATE TABLE depositi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_deposito TEXT NOT NULL UNIQUE,\n    nome_deposito TEXT NOT NULL,\n    citta TEXT NOT NULL,\n    regione TEXT NOT NULL,\n    capienza_massima_kg NUMERIC(12,2) NOT NULL CHECK (capienza_massima_kg > 0)\n);\n\nCREATE TABLE corrieri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    telefono_contatto TEXT\n);\n\nCREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email_contatto TEXT UNIQUE\n);\n\nCREATE TABLE spedizioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    deposito_id INT NOT NULL REFERENCES depositi(id),\n    corriere_id INT NOT NULL REFERENCES corrieri(id),\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    numero_tracking TEXT NOT NULL UNIQUE,\n    data_spedizione DATE NOT NULL,\n    data_consegna_effettiva DATE,\n    peso_kg NUMERIC(8,2) NOT NULL CHECK (peso_kg > 0),\n    tariffa_base NUMERIC(10,2) NOT NULL CHECK (tariffa_base >= 0),\n    costo_per_km NUMERIC(6,3) NOT NULL CHECK (costo_per_km >= 0),\n    supplemento_urgenza NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (supplemento_urgenza >= 0),\n    costo_trasporto NUMERIC(10,2) NOT NULL CHECK (costo_trasporto >= 0),\n    stato_spedizione TEXT NOT NULL CHECK (stato_spedizione IN ('in_preparazione', 'in_transito', 'consegnata', 'fallita')),\n    CHECK (data_consegna_effettiva IS NULL OR data_consegna_effettiva >= data_spedizione)\n);",
