  "query": "WITH benchmark_aziendale AS (SELECT ROUND(AVG(costo_trasporto), 2) AS costo_medio_aziendale FROM spedizioni), statistiche_deposito AS (SELECT d.nome_deposito, d.citta, COUNT(*) AS numero_spedizioni, SUM(s.costo_trasporto) AS costo_totale_periodo, ROUND(AVG(s.costo_trasporto), 2) AS costo_medio_spedizione, COUNT(*) FILTER (WHERE s.stato_spedizione = 'fallita') AS spedizioni_fallite FROM depositi d JOIN spedizioni s ON s.deposito_id = d.id WHERE s.data_spedizione BETWEEN DATE '2025-11-01' AND DATE '2025-12-31' AND s.stato_spedizione IN ('consegnata', 'fallita') GROUP BY d.nome_deposito, d.citta HAVING COUNT(*) >= 5) SELECT sd.nome_deposito, sd.citta, sd.numero_spedizioni, sd.costo_totale_periodo, sd.costo_medio_spedizione, sd.spedizioni_fallite, b.costo_medio_aziendale, RANK() OVER (ORDER BY sd.costo_totale_periodo DESC) AS posizione_per_costo FROM statistiche_deposito sd CROSS JOIN benchmark_aziendale b ORDER BY posizione_per_costo, sd.nome_deposito;"
}