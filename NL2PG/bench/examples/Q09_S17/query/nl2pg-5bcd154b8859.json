  "feature_sql": [
    "group_agg",
    "having"
  ],
  "query": "SELECT m.specializzazione, COUNT(*) AS numero_visite_urgenza, ROUND(SUM(v.costo), 2) AS ricavo_totale_urgenze, ROUND(AVG(v.costo), 2) AS costo_medio_visita FROM visite v JOIN medici m ON v.medico_id = m.id WHERE v.tipo_visita = 'urgenza' AND v.deleted_at IS NULL AND v.data_visita BETWEEN '2025-06-01' AND '2025-12-31' GROUP BY m.specializzazione HAVING COUNT(*) > 5 ORDER BY ricavo_totale_urgenze DESC;"
}