{
  "schema_ddl": "CREATE TABLE agenzie (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE\n);\n\nCREATE TABLE agenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agenzia_id INT NOT NULL REFERENCES agenzie(id),\n    nome TEXT NOT NULL,\n    email TEXT NOT NULL\n);\n\nCREATE TABLE immobili (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    agente_id INT NOT NULL REFERENCES agenti(id),\n    titolo TEXT NOT NULL,\n    prezzo NUMERIC(12,2) CHECK (prezzo >= 0),\n    superficie INT CHECK (superficie > 0)\n);\n\nCREATE TABLE visite (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    immobile_id INT NOT NULL REFERENCES immobili(id),\n    data_visita TIMESTAMP NOT NULL,\n    esito TEXT NOT NULL\n);",
