  "feature_sql": [
    "scalar_agg"
  ],
  "query": "SELECT COUNT(*) AS numero_fatture_pagate, SUM(importo) AS totale_fatturato, ROUND(AVG(importo), 2) AS importo_medio, MIN(importo) AS importo_minimo, MAX(importo) AS importo_massimo FROM fatture WHERE stato_fattura = 'pagata' AND data_emissione BETWEEN '2026-01-01' AND '2026-06-30';"
