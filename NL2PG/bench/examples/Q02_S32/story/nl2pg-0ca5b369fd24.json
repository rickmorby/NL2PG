  "schema_ddl": "CREATE TABLE fatture (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_fattura TEXT NOT NULL UNIQUE,\n    data_emissione DATE NOT NULL,\n    cliente_denominazione TEXT NOT NULL,\n    importo NUMERIC(12,2) NOT NULL CHECK (importo >= 0),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva >= 0 AND aliquota_iva <= 100),\n    stato_fattura TEXT NOT NULL DEFAULT 'emessa' CHECK (stato_fattura IN ('emessa', 'pagata', 'scaduta', 'annullata')),\n    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    created_by TEXT NOT NULL,\n    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_by TEXT\n);",
