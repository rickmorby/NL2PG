  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    telefono TEXT,\n    citta TEXT,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE prodotti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_prodotto TEXT NOT NULL UNIQUE,\n    descrizione TEXT NOT NULL,\n    categoria TEXT NOT NULL,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza_magazzino INT NOT NULL DEFAULT 0 CHECK (giacenza_magazzino >= 0)\n);\n\nCREATE TABLE ordini (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    cliente_id INT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_corrente TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_corrente IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) CHECK (importo_totale >= 0)\n);\n\nCREATE TABLE righe_ordine (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    prodotto_id INT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0)\n);\n\nCREATE TABLE storico_stato_ordine (\n    ordine_id INT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    numero_versione INT NOT NULL CHECK (numero_versione > 0),\n    stato_precedente TEXT CHECK (stato_precedente IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    stato_nuovo TEXT NOT NULL CHECK (stato_nuovo IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    data_variazione TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    valido_dal TIMESTAMP NOT NULL,\n    valido_al TIMESTAMP,\n    utente_modifica TEXT NOT NULL,\n    PRIMARY KEY (ordine_id, numero_versione),\n    CHECK (valido_al IS NULL OR valido_al > valido_dal)\n);\n\nCREATE INDEX idx_storico_stato_ordine_ordine ON storico_stato_ordine (ordine_id, data_variazione);",
