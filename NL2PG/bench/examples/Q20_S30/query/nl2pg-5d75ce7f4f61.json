  "query": "SELECT s.corriere, s.stato_spedizione, COUNT(o.numero_ordine) AS numero_ordini_collegati, ROUND(COALESCE(SUM(o.importo_totale), 0), 2) AS valore_complessivo_ordini FROM ordini o RIGHT JOIN spedizioni s ON o.id_ordine = s.ordine_id WHERE s.corriere IN ('DHL', 'UPS') GROUP BY s.corriere, s.stato_spedizione ORDER BY valore_complessivo_ordini DESC, s.corriere ASC;"
