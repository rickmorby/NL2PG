{
  "schema_ddl": "CREATE TABLE categorie_prodotto (\n    id_categoria INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome_categoria TEXT NOT NULL UNIQUE,\n    descrizione TEXT\n);\n\nCREATE TABLE prodotti (\n    id_prodotto INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_prodotto TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    categoria_id INT NOT NULL REFERENCES categorie_prodotto(id_categoria),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza_magazzino INT NOT NULL DEFAULT 0 CHECK (giacenza_magazzino >= 0)\n);\n\nCREATE TABLE clienti (\n    id_cliente INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    codice_fiscale TEXT UNIQUE,\n    partita_iva TEXT UNIQUE,\n    email TEXT,\n    citta TEXT,\n    data_registrazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    cliente_attivo BOOLEAN NOT NULL DEFAULT TRUE\n);\n\nCREATE TABLE archivio_clienti (\n    id_cliente INT PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    email TEXT,\n    citta TEXT,\n    data_archiviazione DATE NOT NULL DEFAULT CURRENT_DATE,\n    motivo_archiviazione TEXT\n);\n\nCREATE TABLE ordini (\n    id_ordine INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id_cliente),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'confermato', 'spedito', 'completato', 'annullato')),\n    importo_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_totale >= 0)\n);\n\nCREATE TABLE righe_ordine (\n    id_riga_ordine INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id_prodotto),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    sconto_applicato NUMERIC(5,2) NOT NULL DEFAULT 0 CHECK (sconto_applicato BETWEEN 0 AND 100),\n    aliquota_iva NUMERIC(5,2) NOT NULL DEFAULT 22.00 CHECK (aliquota_iva BETWEEN 0 AND 100),\n    margine_percentuale NUMERIC(5,2) CHECK (margine_percentuale BETWEEN -100 AND 100)\n);\n\nCREATE TABLE preventivi (\n    id_preventivo INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_preventivo TEXT NOT NULL UNIQUE,\n    cliente_id INT NOT NULL REFERENCES clienti(id_cliente),\n    data_emissione DATE NOT NULL DEFAULT CURRENT_DATE,\n    data_scadenza DATE,\n    valore_stimato NUMERIC(12,2) NOT NULL CHECK (valore_stimato >= 0),\n    stato_preventivo TEXT NOT NULL DEFAULT 'bozza' CHECK (stato_preventivo IN ('bozza', 'inviato', 'accettato', 'rifiutato', 'scaduto'))\n);\n\nCREATE TABLE resi (\n    id_reso INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    prodotto_id INT NOT NULL REFERENCES prodotti(id_prodotto),\n    data_reso DATE NOT NULL DEFAULT CURRENT_DATE,\n    motivo_reso TEXT,\n    quantita_resa INT NOT NULL CHECK (quantita_resa > 0),\n    valore_rimborso NUMERIC(10,2) NOT NULL CHECK (valore_rimborso >= 0)\n);\n\nCREATE TABLE fatture (\n    id_fattura INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_fattura TEXT NOT NULL UNIQUE,\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    data_fattura DATE NOT NULL DEFAULT CURRENT_DATE,\n    imponibile NUMERIC(12,2) NOT NULL CHECK (imponibile >= 0),\n    iva_totale NUMERIC(12,2) NOT NULL CHECK (iva_totale >= 0),\n    totale_fattura NUMERIC(12,2) NOT NULL CHECK (totale_fattura >= 0)\n);\n\nCREATE TABLE pagamenti (\n    id_pagamento INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    fattura_id INT NOT NULL REFERENCES fatture(id_fattura),\n    data_pagamento DATE NOT NULL DEFAULT CURRENT_DATE,\n    metodo_pagamento TEXT NOT NULL CHECK (metodo_pagamento IN ('bonifico', 'carta', 'contanti', 'assegno')),\n    importo_pagato NUMERIC(12,2) NOT NULL CHECK (importo_pagato >= 0)\n);\n\nCREATE TABLE spedizioni (\n    id_spedizione INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id INT NOT NULL REFERENCES ordini(id_ordine),\n    corriere TEXT NOT NULL,\n    indirizzo_destinazione TEXT NOT NULL,\n    data_spedizione DATE,\n    data_consegna_prevista DATE,\n    stato_spedizione TEXT NOT NULL DEFAULT 'preparazione' CHECK (stato_spedizione IN ('preparazione', 'in_transito', 'consegnata', 'fallita'))\n);",
