  "feature_sql": [
    "in_condition"
  ],
  "query": "SELECT r.nome_reparto, COUNT(*) AS numero_ricoveri_gravi, ROUND(AVG(rc.data_dimissione - rc.data_ingresso), 1) AS durata_media_giorni, ROUND(SUM(rc.costo_giornaliero * (rc.data_dimissione - rc.data_ingresso)), 2) AS costo_totale_stimato FROM ricoveri rc JOIN medici m ON rc.medico_id = m.id JOIN reparti r ON m.reparto_id = r.id WHERE rc.gravita IN ('4', '5') GROUP BY r.nome_reparto ORDER BY costo_totale_stimato DESC, r.nome_reparto ASC LIMIT 10;"
}