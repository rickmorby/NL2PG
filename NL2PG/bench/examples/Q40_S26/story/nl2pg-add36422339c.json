{
  "schema_ddl": "CREATE TABLE pazienti (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_nascita DATE NOT NULL,\n    telefono_contatto TEXT\n);\n\nCREATE TABLE reparti (\n    id INT PRIMARY KEY,\n    nome_reparto TEXT NOT NULL UNIQUE,\n    piano INT CHECK (piano >= 0),\n    posti_letto_totali INT CHECK (posti_letto_totali >= 0)\n);\n\nCREATE TABLE medici (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    specializzazione TEXT NOT NULL,\n    reparto_id INT NOT NULL REFERENCES reparti(id)\n);\n\nCREATE TABLE ricoveri (\n    id INT PRIMARY KEY,\n    paziente_id INT NOT NULL REFERENCES pazienti(id),\n    medico_id INT NOT NULL REFERENCES medici(id),\n    data_ingresso DATE NOT NULL,\n    data_dimissione DATE,\n    gravita TEXT CHECK (gravita IN ('1', '2', '3', '4', '5')),\n    motivo_ricovero TEXT NOT NULL,\n    costo_giornaliero NUMERIC(10,2) CHECK (costo_giornaliero >= 0),\n    CHECK (data_dimissione IS NULL OR data_dimissione >= data_ingresso)\n);",
