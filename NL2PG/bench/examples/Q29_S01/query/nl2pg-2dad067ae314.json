  "query": "SELECT c.numero_mittente, c.numero_destinatario, c.data_ora, ROUND(c.durata_secondi::numeric / 60, 2) AS durata_minuti, (SELECT COUNT(DISTINCT x.numero_destinatario) FROM chiamate x WHERE x.numero_mittente = c.numero_mittente AND x.stato_chiamata = 'completata') AS destinatari_unici_mittente FROM chiamate c WHERE c.stato_chiamata = 'completata' AND c.tipo_chiamata IN ('voce', 'video') ORDER BY c.durata_secondi DESC, c.id_chiamata ASC LIMIT 15;"
}