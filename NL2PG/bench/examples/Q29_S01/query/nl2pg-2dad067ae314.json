{
  "schema_ddl": "CREATE TABLE chiamate (\n    id_chiamata BIGINT PRIMARY KEY,\n    numero_mittente TEXT NOT NULL,\n    numero_destinatario TEXT NOT NULL,\n    data_ora TIMESTAMP NOT NULL,\n    durata_secondi INT NOT NULL CHECK (durata_secondi >= 0),\n    tipo_chiamata TEXT NOT NULL CHECK (tipo_chiamata IN ('voce', 'video', 'internazionale', 'roaming')),\n    stato_chiamata TEXT NOT NULL DEFAULT 'completata' CHECK (stato_chiamata IN ('completata', 'persa', 'inoltrata'))\n);\n\nCREATE INDEX idx_chiamate_mittente ON chiamate (numero_mittente);\n\nCREATE INDEX idx_chiamate_data_ora ON chiamate (data_ora);",
