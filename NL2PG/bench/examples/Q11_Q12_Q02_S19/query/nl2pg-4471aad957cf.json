  "feature_sql": [
    "subquery",
    "correlated_subquery"
  ],
  "query": "SELECT m.categoria, m.esborso_netto, m.data_transazione FROM movimenti_finanziari AS m WHERE m.esborso_netto > (SELECT AVG(sub.esborso_netto) FROM movimenti_finanziari AS sub WHERE sub.categoria = m.categoria) AND m.categoria IN (SELECT cat.categoria FROM (SELECT categoria FROM movimenti_finanziari GROUP BY categoria) AS cat) ORDER BY m.esborso_netto DESC, m.id"
}