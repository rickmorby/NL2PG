{
  "schema_ddl": "CREATE TABLE reparti (\n    id_reparto INT PRIMARY KEY,\n    nome_reparto TEXT NOT NULL UNIQUE,\n    codice_centro_costo TEXT NOT NULL UNIQUE,\n    budget_annuo NUMERIC(12,2) CHECK (budget_annuo >= 0)\n);\n\nCREATE TABLE dipendenti (\n    id_dipendente INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL,\n    stipendio_mensile NUMERIC(10,2) NOT NULL CHECK (stipendio_mensile > 0),\n    id_reparto INT NOT NULL REFERENCES reparti(id_reparto) ON DELETE RESTRICT\n);\n\nCREATE TABLE buste_paga (\n    id_busta_paga BIGINT PRIMARY KEY,\n    id_dipendente INT NOT NULL REFERENCES dipendenti(id_dipendente) ON DELETE CASCADE,\n    periodo_riferimento DATE NOT NULL,\n    importo_lordo NUMERIC(10,2) NOT NULL CHECK (importo_lordo >= 0),\n    importo_netto NUMERIC(10,2) NOT NULL CHECK (importo_netto >= 0),\n    CHECK (importo_netto <= importo_lordo),\n    UNIQUE (id_dipendente, periodo_riferimento)\n);",
