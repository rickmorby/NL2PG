  "feature_sql": [
    "case"
  ],
  "query": "SELECT CASE WHEN d.stipendio_mensile >= 4500 THEN 'Fascia Alta' WHEN d.stipendio_mensile >= 3000 THEN 'Fascia Media' ELSE 'Fascia Base' END AS fascia_stipendiale, COUNT(*) AS numero_dipendenti, ROUND(CAST(AVG(d.stipendio_mensile) AS DECIMAL), 2) AS stipendio_medio, MIN(d.stipendio_mensile) AS stipendio_minimo, MAX(d.stipendio_mensile) AS stipendio_massimo FROM dipendenti AS d JOIN reparti AS r ON d.id_reparto = r.id_reparto WHERE r.nome_reparto LIKE 'Produzione%' GROUP BY fascia_stipendiale ORDER BY numero_dipendenti DESC, fascia_stipendiale ASC"
}