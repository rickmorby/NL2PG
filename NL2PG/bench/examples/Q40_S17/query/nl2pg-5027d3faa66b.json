  "query": "SELECT numero_ordine, nome_cliente, importo_totale, stato_ordine, modalita_pagamento, data_ordine, CASE WHEN importo_totale >= 500 THEN 'ordine_premium' ELSE 'ordine_standard' END AS fascia_importo FROM ordini WHERE stato_ordine IN ('pagato', 'spedito') AND modalita_pagamento IN ('paypal', 'carta_credito') AND deleted_at IS NULL AND data_ordine BETWEEN DATE '2026-01-01' AND DATE '2026-03-31' ORDER BY importo_totale DESC, numero_ordine ASC;"
}