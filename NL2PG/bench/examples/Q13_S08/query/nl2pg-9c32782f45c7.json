  ],
  "query": "SELECT sf.nome,\n       sf.emittente,\n       sf.valuta,\n       sf.valore_nominale,\n       sf.data_emissione,\n       ob.tasso_cedola,\n       ob.rating\nFROM strumenti_finanziari sf\nJOIN obbligazioni ob ON ob.id = sf.id\nWHERE sf.stato = 'attivo'\n  AND sf.valuta = 'EUR'\n  AND ob.tipo_tasso = 'fisso'\n  AND EXISTS (\n      SELECT 1\n      FROM strumenti_finanziari altri\n      WHERE altri.emittente = sf.emittente\n        AND altri.stato = 'sospeso'\n  )\nORDER BY sf.data_emissione DESC, sf.codice_isin ASC;"
}