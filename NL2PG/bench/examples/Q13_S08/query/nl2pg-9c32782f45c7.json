{
  "schema_ddl": "CREATE TABLE strumenti_finanziari (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_isin TEXT NOT NULL UNIQUE,\n    emittente TEXT NOT NULL,\n    data_emissione DATE NOT NULL,\n    valore_nominale NUMERIC(14,2) NOT NULL CHECK (valore_nominale > 0),\n    valuta CHAR(3) NOT NULL,\n    stato TEXT NOT NULL DEFAULT 'attivo' CHECK (stato IN ('attivo', 'sospeso', 'delistato'))\n);\n\nCREATE TABLE obbligazioni (\n    id INT PRIMARY KEY REFERENCES strumenti_finanziari(id) ON DELETE CASCADE,\n    tasso_cedola NUMERIC(6,3) NOT NULL CHECK (tasso_cedola >= 0),\n    tipo_tasso TEXT NOT NULL CHECK (tipo_tasso IN ('fisso', 'variabile')),\n    data_scadenza DATE NOT NULL,\n    rating TEXT CHECK (rating IN ('AAA', 'AA', 'A', 'BBB', 'BB', 'B', 'CCC', 'D'))\n);\n\nCREATE TABLE azioni (\n    id INT PRIMARY KEY REFERENCES strumenti_finanziari(id) ON DELETE CASCADE,\n    ticker TEXT NOT NULL UNIQUE,\n    quantita_azioni_emesse BIGINT NOT NULL CHECK (quantita_azioni_emesse > 0),\n    dividendo_per_azione NUMERIC(10,4) NOT NULL DEFAULT 0 CHECK (dividendo_per_azione >= 0),\n    settore TEXT NOT NULL\n);",
