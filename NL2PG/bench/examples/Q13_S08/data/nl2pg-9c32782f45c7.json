    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "strumenti_finanziari",
        "obsolete_value": "prodotti_di_investimento",
        "description": "La tabella base della gerarchia ISA, strumenti_finanziari, viene denominata prodotti_di_investimento nella prosa aziendale. Il solver deve riconoscere che la tabella generica che contiene l'entita' padre e le chiavi primarie e' strumenti_finanziari."
      },
      {
        "twist_type": "jargon",
        "target_value": "obbligazioni",
        "obsolete_value": "titoli di debito a reddito fisso",
        "description": "La tabella sottotipo obbligazioni, collegata a strumenti_finanziari tramite FK verso la chiave primaria della tabella base, viene indicata con il gergo finanziario 'titoli di debito a reddito fisso'. Le query con NOT EXISTS devono verificare l'assenza di corrispondenza proprio su questa tabella specializzata."
      },
      {
        "twist_type": "synonym",
        "target_value": "azioni",
        "obsolete_value": "quote di partecipazione societaria",
        "description": "La tabella sottotipo azioni, anch'essa collegata a strumenti_finanziari tramite FK verso la chiave primaria della tabella base, viene descritta come 'quote di partecipazione societaria'. Il solver deve mappare questo sinonimo alla tabella azioni quando ricompone la gerarchia ISA o filtra sul discriminatore."
      }
    ],
    "spec_hash": "e16a551e0d83c41a"
  },
  "schema_ddl": "CREATE TABLE strumenti_finanziari (\n    id INT PRIMARY KEY,\n    nome TEXT NOT NULL,\n    codice_isin TEXT NOT NULL UNIQUE,\n    emittente TEXT NOT NULL,\n    data_emissione DATE NOT NULL,\n    valore_nominale NUMERIC(14,2) NOT NULL CHECK (valore_nominale > 0),\n    valuta CHAR(3) NOT NULL,\n    stato TEXT NOT NULL DEFAULT 'attivo' CHECK (stato IN ('attivo', 'sospeso', 'delistato'))\n);\n\nCREATE TABLE obbligazioni (\n    id INT PRIMARY KEY REFERENCES strumenti_finanziari(id) ON DELETE CASCADE,\n    tasso_cedola NUMERIC(6,3) NOT NULL CHECK (tasso_cedola >= 0),\n    tipo_tasso TEXT NOT NULL CHECK (tipo_tasso IN ('fisso', 'variabile')),\n    data_scadenza DATE NOT NULL,\n    rating TEXT CHECK (rating IN ('AAA', 'AA', 'A', 'BBB', 'BB', 'B', 'CCC', 'D'))\n);\n\nCREATE TABLE azioni (\n    id INT PRIMARY KEY REFERENCES strumenti_finanziari(id) ON DELETE CASCADE,\n    ticker TEXT NOT NULL UNIQUE,\n    quantita_azioni_emesse BIGINT NOT NULL CHECK (quantita_azioni_emesse > 0),\n    dividendo_per_azione NUMERIC(10,4) NOT NULL DEFAULT 0 CHECK (dividendo_per_azione >= 0),\n    settore TEXT NOT NULL\n);",
