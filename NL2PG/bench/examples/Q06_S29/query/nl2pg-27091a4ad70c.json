{
  "schema_ddl": "CREATE TABLE fornitori (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ragione_sociale TEXT NOT NULL,\n    partita_iva TEXT NOT NULL UNIQUE,\n    email_contatto TEXT,\n    citta TEXT NOT NULL\n);\n\nCREATE TABLE clienti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono TEXT,\n    citta_residenza TEXT NOT NULL\n);\n\nCREATE TABLE prodotti (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice_prodotto TEXT NOT NULL UNIQUE,\n    nome_prodotto TEXT NOT NULL,\n    descrizione TEXT,\n    prezzo_unitario NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario >= 0),\n    giacenza_magazzino INT NOT NULL DEFAULT 0 CHECK (giacenza_magazzino >= 0),\n    fornitore_id BIGINT NOT NULL REFERENCES fornitori(id)\n);\n\nCREATE TABLE ordini (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_ordine TEXT NOT NULL UNIQUE,\n    cliente_id BIGINT NOT NULL REFERENCES clienti(id),\n    data_ordine DATE NOT NULL DEFAULT CURRENT_DATE,\n    stato_ordine TEXT NOT NULL DEFAULT 'in_attesa' CHECK (stato_ordine IN ('in_attesa', 'confermato', 'spedito', 'consegnato', 'annullato')),\n    importo_totale NUMERIC(12,2) NOT NULL DEFAULT 0 CHECK (importo_totale >= 0)\n);\n\nCREATE TABLE dettagli_ordine (\n    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    ordine_id BIGINT NOT NULL REFERENCES ordini(id) ON DELETE CASCADE,\n    prodotto_id BIGINT NOT NULL REFERENCES prodotti(id),\n    quantita INT NOT NULL CHECK (quantita > 0),\n    prezzo_unitario_vendita NUMERIC(10,2) NOT NULL CHECK (prezzo_unitario_vendita >= 0),\n    UNIQUE (ordine_id, prodotto_id)\n);",
