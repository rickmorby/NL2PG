  "query": "SELECT o.numero_ordine, c.nome || ' ' || c.cognome AS cliente, c.citta_residenza, o.data_ordine, o.importo_totale FROM ordini o JOIN clienti c ON o.cliente_id = c.id WHERE o.stato_ordine = 'consegnato' AND o.importo_totale > 500 AND o.data_ordine >= '2026-01-01' ORDER BY o.importo_totale DESC;"
}