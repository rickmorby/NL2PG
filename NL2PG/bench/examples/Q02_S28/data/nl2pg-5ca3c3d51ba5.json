    "twist_rules": [
      {
        "twist_type": "jargon",
        "target_value": "esm",
        "obsolete_value": "prove di profitto",
        "description": "La tabella esm (abbreviazione di esami) viene indicata nella narrativa aziendale con il gergo burocratico 'prove di profitto'. Il risolutore deve decodificare che ogni menzione delle prove di profitto si riferisce alle righe della tabella esm su cui effettuare l'aggregazione scalare."
      },
      {
        "twist_type": "synonym",
        "target_value": "dnt",
        "obsolete_value": "corpo insegnante",
        "description": "La tabella dnt (abbreviazione di docenti) è denominata nei documenti con il sinonimo 'corpo insegnante'. Il mapping semantico richiesto collega il sinonimo usato nella prosa all'identificatore abbreviato dnt nello schema."
      },
      {
        "twist_type": "rephrase",
        "target_value": "vot_fin",
        "obsolete_value": "esito definitivo della valutazione",
        "description": "La colonna vot_fin (voto finale) della tabella esm è descritta nella prosa aziendale con la perifrasi 'esito definitivo della valutazione'. La query di aggregazione scalare (ad esempio AVG o MAX) deve essere applicata proprio a questa colonna dopo aver riconosciuto la perifrasi."
      }
    ],
    "spec_hash": "625287695b1bc785"
  },
  "schema_ddl": "CREATE TABLE dpt (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL UNIQUE,\n    sede TEXT NOT NULL\n);\n\nCREATE TABLE dnt (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dpt_id INT NOT NULL REFERENCES dpt(id),\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    data_assunzione DATE NOT NULL,\n    CHECK (data_assunzione >= DATE '1950-01-01')\n);\n\nCREATE TABLE std (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    matricola TEXT NOT NULL UNIQUE,\n    data_immatricolazione DATE NOT NULL,\n    CHECK (data_immatricolazione >= DATE '1900-01-01')\n);\n\nCREATE TABLE crs (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    dnt_id INT NOT NULL REFERENCES dnt(id),\n    titolo TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu BETWEEN 1 AND 30),\n    anno_accademico INT NOT NULL CHECK (anno_accademico BETWEEN 1900 AND 2100)\n);\n\nCREATE TABLE esm (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    std_id INT NOT NULL REFERENCES std(id),\n    crs_id INT NOT NULL REFERENCES crs(id),\n    data_esame DATE NOT NULL,\n    vot_fin INT NOT NULL CHECK (vot_fin BETWEEN 18 AND 30),\n    lode BOOLEAN NOT NULL DEFAULT FALSE,\n    UNIQUE (std_id, crs_id, data_esame)\n);",
