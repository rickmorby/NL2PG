  "schema_ddl": "CREATE TABLE docenti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    email TEXT NOT NULL UNIQUE,\n    dipartimento TEXT NOT NULL\n);\n\nCREATE TABLE corsi (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    codice TEXT NOT NULL UNIQUE,\n    titolo TEXT NOT NULL,\n    cfu INT NOT NULL CHECK (cfu BETWEEN 1 AND 30),\n    docente_id INT NOT NULL REFERENCES docenti(id),\n    corso_padre_id INT REFERENCES corsi(id),\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    CHECK (corso_padre_id IS NULL OR corso_padre_id <> id)\n);",
