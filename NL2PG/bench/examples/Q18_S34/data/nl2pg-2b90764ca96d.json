    "twist_rules": [
      {
        "twist_type": "rename",
        "target_value": "polizze",
        "obsolete_value": "contratti_di_copertura",
        "description": "La tabella fisica 'polizze' (con FK nullable id_cliente verso 'clienti') viene denominata 'contratti_di_copertura' nella prosa aziendale. Il progettista deve riconoscere che i riferimenti ai contratti di copertura corrispondono alla tabella polizze."
      },
      {
        "twist_type": "jargon",
        "target_value": "importo_liquidato",
        "obsolete_value": "somma_erogata_a_saldo_evento",
        "description": "La colonna 'importo_liquidato' della tabella 'liquidazioni' viene indicata nel linguaggio settoriale come 'somma erogata a saldo evento'. Le query devono mappare questa perifrasi gergale del settore assicurativo sulla colonna reale importo_liquidato."
      }
    ],
    "spec_hash": "b437e9bee4a7cef2"
  },
  "schema_ddl": "CREATE TABLE clienti (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    nome TEXT NOT NULL,\n    cognome TEXT NOT NULL,\n    codice_fiscale TEXT NOT NULL UNIQUE,\n    email TEXT UNIQUE,\n    telefono TEXT,\n    data_nascita DATE,\n    creato_il TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE polizze (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    numero_polizza TEXT NOT NULL UNIQUE,\n    id_cliente INT REFERENCES clienti(id),\n    ramo TEXT NOT NULL CHECK (ramo IN ('auto', 'casa', 'vita', 'salute', 'responsabilita_civile')),\n    premio_annuo NUMERIC(10,2) NOT NULL CHECK (premio_annuo >= 0),\n    massimale NUMERIC(12,2) NOT NULL CHECK (massimale > 0),\n    data_emissione DATE NOT NULL,\n    data_scadenza DATE NOT NULL,\n    stato_polizza TEXT NOT NULL DEFAULT 'attiva' CHECK (stato_polizza IN ('attiva', 'sospesa', 'scaduta', 'stornata')),\n    CHECK (data_scadenza > data_emissione)\n);\n\nCREATE TABLE sinistri (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    polizza_id INT NOT NULL REFERENCES polizze(id),\n    data_evento DATE NOT NULL,\n    data_denuncia DATE NOT NULL,\n    descrizione TEXT NOT NULL,\n    importo_danno_stimato NUMERIC(12,2) NOT NULL CHECK (importo_danno_stimato >= 0),\n    stato_sinistro TEXT NOT NULL DEFAULT 'aperto' CHECK (stato_sinistro IN ('aperto', 'in_valutazione', 'liquidato', 'respinto')),\n    CHECK (data_denuncia >= data_evento)\n);\n\nCREATE TABLE liquidazioni (\n    id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    sinistro_id INT NOT NULL REFERENCES sinistri(id),\n    importo_liquidato NUMERIC(12,2) NOT NULL CHECK (importo_liquidato >= 0),\n    data_liquidazione DATE NOT NULL,\n    modalita_pagamento TEXT NOT NULL CHECK (modalita_pagamento IN ('bonifico', 'assegno', 'accredito_conto_corrente')),\n    note TEXT\n);",
