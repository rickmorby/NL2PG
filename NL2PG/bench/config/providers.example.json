{
  "chains": {
    "default": [
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "critic": [
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "judge": [
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "calibration": [
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ]
  },
  "models": {
