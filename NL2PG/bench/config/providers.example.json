{
  "chains": {
    "default": [
      "kilo/ling-flash",
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "critic": [
      "kilo/ling-flash",
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "judge": [
      "kilo/ling-flash",
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ],
    "calibration": [
      "kilo/ling-flash",
      "nous/laguna-s",
      "nous/step-flash",
      "openrouter/nemotron-120b"
    ]
  },
  "models": {
    "kilo/ling-flash": {
      "provider": "openai",
      "model": "inclusionai/ling-3.0-flash:free",
      "temperature": 0.7,
      "request_timeout": 60,
      "rpm": 30,
      "structured_output": true,
      "base_url": "https://api.kilo.ai/api/gateway",
      "api_key": "YOUR_KILO_API_KEY_HERE"
    },
    "nous/laguna-s": {
      "provider": "openai",
      "model": "poolside/laguna-s-2.1:free",
      "temperature": 0.7,
      "request_timeout": 60,
      "rpm": 30,
      "structured_output": true,
      "base_url": "https://inference-api.nousresearch.com/v1",
      "api_key": "YOUR_NOUS_API_KEY_HERE"
    },
    "nous/step-flash": {
      "provider": "openai",
      "model": "stepfun/step-3.7-flash:free",
      "temperature": 0.7,
      "request_timeout": 60,
      "rpm": 30,
      "structured_output": true,
      "base_url": "https://inference-api.nousresearch.com/v1",
      "api_key": "YOUR_NOUS_API_KEY_HERE"
    },
    "openrouter/nemotron-120b": {
      "provider": "openai",
      "model": "nvidia/nemotron-3-super-120b-a12b:free",
      "temperature": 0.7,
      "request_timeout": 60,
      "rpm": 30,
      "structured_output": true,
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "YOUR_OPENROUTER_API_KEY_HERE"
    }
  }
